,"the-kingfish-company-yellowtail-split-loins-copy"],"star_rating":"all","max_reviews":20,"quote_marks_size":"small","product_name_text_size":"small","verified_badge_style":"icon","card_height":"medium","text_size":"small","stars_size":"medium","arrows_position":"bottom","max_width":1100,"corner_styling":"soft","quote_marks_style":"serif","card_color":"#f9f9f9","stars_and_quote_marks_color":"#7bc3f3","text_color":"#000000","arrows_color":"#000000","show_border":false,"border_color":"#108474","show_drop_shadow":false,"transition_speed":5,"header_text":"Seatopians love Yellowtail","show_average_rating":true}}},"block_order":["judge_me_reviews_testimonials_carousel_xAyhW3"],"settings":{"color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":72,"padding_bottom":72,"divider":false,"full_width":false,"rounded":false}},"blog-posts":{"type":"blog-posts","settings":{"blog":"seafood-recipes","post_limit":8,"columns":3,"carousel_on_desktop":true,"show_view_all":true,"columns_mobile":"1","swipe_on_mobile":true,"image_ratio":"landscape","show_tags":false,"show_date":false,"show_comments":false,"show_author":false,"show_excerpt":false,"heading":"Get inspired with more Yellowtail recipes","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"<p>Love this Yellowtail recipe? There's more. We 💙 inspiring you to prepare clean seafood at home. Don't forget forget, every Seatopia box comes with a <a href=\"https://seatopia.fish/pages/unleash-your-inner-chef\" title=\"https://seatopia.fish/pages/unleash-your-inner-chef\">FREE Virtual Cooking Class  </a>where you will learn more about preparing delicious Yellowtail fish recipes at home.</p>","highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":32,"padding_bottom":32,"divider":false,"full_width":false,"rounded":true}},"faq_y7bYXm":{"type":"faq","blocks":{"question_HqJmpL":{"type":"question","settings":{"title":"What is yellowtail fish?","text":"<p>“Yellowtail” is a common name that refers to several species of amberjack fish in the <em>Seriola</em> genus. These fish are known for their firm texture, rich flavor, and signature yellow stripe or tail.</p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_JPVGpd":{"type":"question","settings":{"title":"Is yellowtail the same as hamachi?","text":"<p>Almost! <em>Hamachi</em> is the Japanese name for <em>Seriola quinqueradiata</em>, also called <strong>Japanese yellowtail</strong>. It’s typically a younger fish (harvested at ~10–15 lbs) with a buttery, delicate flavor—often used in sushi.</p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_WT7Ajb":{"type":"question","settings":{"title":"What’s Dutch yellowtail or California yellowtail?","text":"<p><strong>Dutch yellowtail</strong> – also <em>Seriola lalandi</em>, sustainably farmed in the Netherlands under pristine conditions. Seatopia sources this variety—it’s clean, regenerative, and sushi-grade.<br/><strong>California yellowtail</strong> – <em>Seriola dorsalis</em>, a wild Pacific species found off the U.S. West Coast, often used in poke or grilled dishes.</p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_NP3LDg":{"type":"question","settings":{"title":"Which yellowtail is best for sushi?","text":"<p>The best sushi-grade yellowtail comes from clean, low-density farms like those partnered with Seatopia—where fish are raised without antibiotics or pollutants and lab-tested for mercury and microplastics.</p>","highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["question_HqJmpL","question_JPVGpd"