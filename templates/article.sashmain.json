{"sections":{"main-article-banner":{"type":"main-article-banner","blocks":{"spacing":{"type":"spacing","settings":{"height":68,"height_mobile":0}},"title":{"type":"title","settings":{"title_size":"title-lg tracking-heading","show_tags":true,"show_date":false,"show_comments":false,"show_author":true}}},"block_order":["spacing","title"],"settings":{"transparent_header":true,"show_image":true,"image_height":"750px","content_position":"md:items-center md:justify-center","text_alignment":"left","image_height_mobile":"auto","content_position_mobile":"items-end justify-center","text_alignment_mobile":"left","color_text":"#ffffff","color_overlay":"#000000","overlay_opacity":40,"padding_top":0,"padding_bottom":0,"divider":false,"full_width":true,"rounded":true,"enable_parallax":true,"parallax_direction":"vertical"}},"rich_text_GwTC9y":{"type":"rich-text","blocks":{"heading_Vtiaka":{"type":"heading","disabled":true,"settings":{"heading":"Rich text","heading_size":"title-lg tracking-heading","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_LKwCEE":{"type":"text","settings":{"text":"<p>Halloween celebrates the strange — the unseen, the misunderstood, the things that make us squirm.<br/><br/>But beneath the cobwebs and costumes lies something far older: Samhain, the Celtic festival marking the end of harvest and the beginning of darkness — a season when the veil between worlds thins and we’re reminded that life depends on decay.<br/><br/>At Seatopia, we believe the same is true of our food system. For too long, farmed fish and insects as food have been treated like monsters under the bed of modern nutrition — unfamiliar, unappetizing, maybe even unnatural.<br/>But when we look closely — past the fear and into the biology — we see something else entirely.<br/><br/>Not a horror story, but a restoration of balance.Make our chef-inspired Citrus Pan-Seared Yellowtail with peach and cucumber—clean, regenerative, sushi-grade seafood tested to the <a href=\"/pages/why-clean-seafood-matters\" title=\"Why Clean Seafood Matters\">Seatopia Standard™</a>. </p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"button_cANENg":{"type":"button","disabled":true,"settings":{"button_label":"Button label","button_link":"","button_style":"primary","button_size":"md","button_external":false,"button_icon":true}}},"block_order":["heading_Vtiaka","text_LKwCEE","button_cANENg"],"name":"t:sections.rich-text.presets.name","settings":{"custom-class":"","text_alignment":"left","text_alignment_mobile":"left","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":20,"padding_bottom":20,"divider":false,"narrow":true,"rounded":false}},"rich_text_WRbr8f":{"type":"rich-text","blocks":{"heading_twTaWy":{"type":"heading","settings":{"heading":"Why Bugs (and Algae) Belong in the Blue Food Revolution","heading_size":"title-sm","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_g3x8EH":{"type":"text","settings":{"text":"<p>Insects and algae are nature’s most efficient recyclers.They convert what’s left behind into life itself — producing clean, nutrient-dense energy with almost no waste.</p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"button_TJkQcj":{"type":"button","disabled":true,"settings":{"button_label":"Button label","button_link":"","button_style":"primary","b