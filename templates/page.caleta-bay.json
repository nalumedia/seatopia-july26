ow":false,"rounded":false}},"portfolio_khhjiy":{"type":"portfolio","blocks":{"profile_FtXEVP":{"type":"profile","settings":{"image":"shopify:\/\/shop_images\/Screenshot_2025-05-22_at_1.58.12_PM.png","heading":"Black Garlic Sashimi","text":"<p>Harness the health benefits of regenerative seafood + organic superfoods in this elegant, umami-rich dish. Each ingredient offers a medicinal boost to vitality + wellness, while delighting the senses with bold flavors and vibrant presentation.<\/p><p>👉🏽 <a href=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/black-garlic-tamari-steelhead-with-activated-charcoal-and-fresh-wasabi\" target=\"_blank\" title=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/black-garlic-tamari-steelhead-with-activated-charcoal-and-fresh-wasabi\">Get the Recipe<\/a><\/p>","color_text":"#ffffff","color_background":"#171717"}},"profile_9abkc4":{"type":"profile","settings":{"image":"shopify:\/\/shop_images\/Screenshot_2025-05-22_at_1.59.47_PM.png","heading":"Beet Cured Lox","text":"<p>Discover the art of curing seafood with this Beet-Cured Steelhead Lox recipe. Featuring the earthy sweetness of organic beets, a botanical hint of gin, and fresh dill, this dish is a eye-catching and nutrient-rich delicacy. Perfectly paired with a crisp green salad and a bright touch of lemon zest, it’s a gourmet creation loaded with omega-3s and antioxidants to nourish your body and elevate your well-being.<\/p><p>👉🏽 <a href=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/beet-cured-steelhead-lox-recipe\" target=\"_blank\" title=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/beet-cured-steelhead-lox-recipe\">Get the recipe<\/a><\/p>","color_text":"#ffffff","color_background":"#171717"}},"profile_tPnk6G":{"type":"profile","settings":{"image":"shopify:\/\/shop_images\/Screenshot_2025-05-22_at_2.01.10_PM.png","heading":"Maple Steelhead on Polenta","text":"<p>Elevate your dinner with this stunning dish featuring Seatopia’s sushi-grade steelhead loin baked to perfection with a maple garlic glaze. Plated on a creamy polenta base and garnished with dark pepper, pomegranate seeds, and extra virgin olive oil, this recipe is the perfect balance of sweet, savory, and vibrant freshness. Simple to make and full of omega-3s, it's a nourishing delight for any occasion.<\/p><p>👉🏽 <a href=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/polenta-salmon-garlic-pom\" target=\"_blank\" title=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/polenta-salmon-garlic-pom\">Get the recipe<\/a><\/p>","color_text":"#ffffff","color_background":"#171717"}}},"block_order":["profile_FtXEVP","profile_9abkc4","profile_tPnk6G"],"custom_css":["\/* Center the tiles inside the grid *\/.portfolio.card-grid {display: flex; flex-wrap: wrap; justify-content: center; gap: 2rem; padding: 1rem; text-align: center;}"," \/* Optional: center the parent container if needed *\/.card-grid--4 {justify-content: center;}",".grid {justify-content: center;}",".profile.card {max-width: clamp(250px, 25vw, 300px); width: 100%;}"],"name":"t:sections.portfolio.presets.name","settings":{"columns":4,"carousel_on_desktop":false,"layout":"default","image_ratio":"portrait","image_ratio_mobile":"portrait","columns_mobile":"1","swipe_on_mobile":true,"heading":"Steelhead Trout Recipes","heading_size":"title-md","heading_alignment":"text-center justify-center","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":60,"padding_bottom":60,"divider":false,"full_width":false,"rounded":false}},"map_LW4PtC":{"type":"map","name":"t:sections.map.presets.name","settings":{"transparent_header":false,"map_address":"Caleta Bay, Chile","map_api_key":"AIzaSyB_I3DlYvmrlYUbo8f