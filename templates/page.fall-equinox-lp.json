    "recipe_cards": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_id": "autumn-recipes",
        "liquid": "<style>\n  .sea-rx {\n    --ink: #171717;\n    --muted: #5c5c5c;\n    --line: #e5e2dc;\n    --wash: #faf8f4;\n    --gold: #bb8f50;\n    color: var(--ink);\n  }\n  .sea-rx__head {\n    max-width: 62ch;\n    margin: 0 0 26px;\n  }\n  .sea-rx__eyebrow {\n    font-size: 11px;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n    color: var(--gold);\n    font-weight: 600;\n    margin: 0 0 8px;\n  }\n  .sea-rx__title {\n    font-size: clamp(24px, 3vw, 32px);\n    line-height: 1.15;\n    font-weight: 600;\n    margin: 0 0 10px;\n  }\n  .sea-rx__lede {\n    font-size: 15px;\n    line-height: 1.55;\n    color: var(--muted);\n    margin: 0;\n  }\n  .sea-rx__grid {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 22px;\n  }\n  .sea-rx__card {\n    background: var(--wash);\n    border: 1px solid var(--line);\n    border-radius: 18px;\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n  }\n  .sea-rx__media {\n    margin: 0;\n    aspect-ratio: 3 / 2;\n    overflow: hidden;\n    background: #eee;\n  }\n  .sea-rx__media img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n  .sea-rx__body {\n    padding: 20px 22px 22px;\n    display: flex;\n    flex-direction: column;\n    flex: 1 1 auto;\n  }\n  .sea-rx__name {\n    font-size: 18px;\n    line-height: 1.25;\n    font-weight: 600;\n    margin: 0 0 10px;\n  }\n  .sea-rx__name a {\n    color: inherit;\n    text-decoration: none;\n  }\n  .sea-rx__name a:hover {\n    text-decoration: underline;\n    text-underline-offset: 3px;\n  }\n  .sea-rx__meta {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 6px 10px;\n    margin: 0 0 12px;\n  }\n  .sea-rx__chip {\n    font-size: 11.5px;\n    font-weight: 600;\n    letter-spacing: .04em;\n    color: var(--muted);\n    background: #fff;\n    border: 1px solid var(--line);\n    border-radius: 999px;\n    padding: 4px 10px;\n  }\n  .sea-rx__note {\n    font-size: 14px;\n    line-height: 1.55;\n    color: var(--muted);\n    margin: 0 0 18px;\n  }\n  .sea-rx__foot {\n    margin-top: auto;\n    padding-top: 16px;\n    border-top: 1px solid var(--line);\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    flex-wrap: wrap;\n  }\n  .sea-rx__buy {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 10px 18px;\n    border-radius: 999px;\n    background: var(--ink);\n    color: #fff;\n    font-size: 14px;\n    font-weight: 600;\n    text-decoration: none;\n  }\n  .sea-rx__buy:hover {\n    opacity: .88;\n  }\n  .sea-rx__price {\n    font-size: 13.5px;\n    color: var(--muted);\n  }\n  .sea-rx__view {\n    font-size: 13.5px;\n    font-weight: 600;\n    color: var(--ink);\n    text-decoration: underline;\n    text-underline-offset: 3px;\n  }\n  @media (max-width: 749px) {\n    .sea-rx__grid {\n      grid-template-columns: 1fr;\n      gap: 18px;\n    }\n  }\n\n  .sea-rx__media {\n    position: relative;\n  }\n  .sea-rx__media img {\n    transition: opacity .45s ease;\n  }\n  .sea-rx__media img.is-hover {\n    position: absolute;\n    inset: 0;\n    opacity: 0;\n  }\n  .sea-rx__card:hover .sea-rx__media img.is-hover,\n  .sea-rx__card:focus-within .sea-rx__media img.is-hover {\n    opacity: 1;\n  }\n  .sea-rx__form {\n    margin: 0;\n  }\n  .sea-rx__buy {\n    border: 0;\n    cursor: pointer;\n    font-family: inherit;\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .sea-rx__media img {\n      transition: none;\n    }\n  }\n</style>\n<div class=\"sea-rx\">\n  <div class=\"sea-rx__head\">\n    <p class=\"sea-rx__eyebrow\">The autumn menu</p>\n    <h2 class=\"sea-rx__title\">Four dinners, and everything you need to cook them.</h2>\n    <p class=\"sea-rx__lede\">\n      Four beautiful dinners to celebrate the equinox, each written out step by step &mdash; with the\n      seafood a click away.\n    </p>\n  </div>\n\n  <div class=\"sea-rx__grid\">\n    <article class=\"sea-rx__card\">\n      <figure class=\"sea-rx__media\">\n        <img src=\"{{ '20260825-Stetten-Wilson-219.jpg' | file_url }}&amp;width=760\"\n             alt=\"Whole Roasted Trout with Blistered Grapes and Baby Potatoes\" width=\"760\" height=\"507\" loading=\"lazy\" decoding=\"async\">\n        <img class=\"is-hover\" src=\"{{ '20260825-Stetten-Wilson-216.jpg' | file_url }}&amp;width=760\"\n             alt=\"\" aria-hidden=\"true\" width=\"760\" height=\"507\" loading=\"lazy\" decoding=\"async\">\n      </figure>\n      <div class=\"sea-rx__body\">\n        <h3 class=\"sea-rx__name\"><a href=\"/blogs/seafood-recipes/whole-roasted-trout-blistered-grapes-potatoes\">Whole Roasted Trout with Blistered Grapes and Baby Potatoes</a></h3>\n        <p class=\"sea-rx__meta\">\n          <span class=\"sea-rx__chip\">50 min</span>\n          <span class=\"sea-rx__chip\">Serves 2</span>\n          <span class=\"sea-rx__chip\">A confident first whole fish</span>\n        </p>\n        <p class=\"sea-rx__note\">One sheet pan. Potatoes get a head start, grapes go in last, and the fish comes off the bone in three movements.</p>\n        {%- assign p = all_products['whole-trout-12oz'] -%}\n        <div class=\"sea-rx__foot\">\n          {%- if p != blank and p.available -%}\n            {%- form 'product', p, id: 'rx-whole-trout-12oz', data-type: 'add-to-cart-form', class: 'sea-rx__form', is: 'product-form' -%}\n              <input type=\"hidden\" name=\"id\" value=\"{{ p.selected_or_first_available_variant.id }}\">\n              <div class=\"product-form__error-message\" role=\"alert\" hidden></div>\n              <button type=\"submit\" name=\"add\" class=\"sea-rx__buy product-form__submit\">\n                <span class=\"btn-text\"><span>Add the {{ p.title }}</span></span>\n              </button>\n            {%- endform -%}\n            <span class=\"sea-rx__price\">from {{ p.price_min | money }}</span>\n          {%- endif -%}\n          <a class=\"sea-rx__view\" href=\"/blogs/seafood-recipes/whole-roasted-trout-blistered-grapes-potatoes\">Full recipe &rarr;</a>\n        </div>\n      </div>\n    </article>\n    <article class=\"sea-rx__card\">\n      <figure class=\"sea-rx__media\">\n        <img src=\"{{ '20260825-Stetten-Wilson-112.jpg' | file_url }}&amp;width=760\"\n             alt=\"Butter Pumpkin Shrimp with Toasted Coconut, Lime and Fresno\" width=\"760\" height=\"507\" loading=\"lazy\" decoding=\"async\">\n        <img class=\"is-hover\" src=\"{{ '20260825-Stetten-Wilson-104.jpg' | file_url }}&amp;width=760\"\n             alt=\"\" aria-hidden=\"true\" width=\"760\" height=\"507\" loading=\"lazy\" decoding=\"async\">\n      </figure>\n      <div class=\"sea-rx__body\">\n        <h3 class=\"sea-rx__name\"><a href=\"/blogs/seafood-recipes/butter-pumpkin-shrimp-curry\">Butter Pumpkin Shrimp with Toasted Coconut, Lime and Fresno</a></h3>\n        <p class=\"sea-rx__meta\">\n          <span class=\"sea-rx__chip\">50 min</span>\n          <span class=\"sea-rx__chip\">Serves 4</span>\n          <span class=\"sea-rx__chip\">Family style, no technique</span>\n        </p>\n        <p class=\"sea-rx__note\">If you like butter chicken you will like this. The sauce is roasted squash through a blender, not an hour of reducing.</p>\n        {%- assign p = all_products['black-tiger-shrimp-mangrove-regeneration'] -%}\n        <div class=\"sea-rx__foot\">\n          {%- if p != blank and p.available -%}\n            {%- form 'product', p, id: 'rx-black-tiger-shrimp-mangrove-regeneration', data-type: 'add-to-cart-form', class: 'sea-rx__form', is: 'product-form' -%}\n              <input type=\"hidden\" name=\"id\" value=\"{{ p.selected_or_first_available_variant.id }}\">\n              <div class=\"product-form__error-message\" role=\"alert\" hidden></div>\n              <button type=\"submit\" name=\"add\" class=\"sea-rx__buy product-form__submit\">\n                <span class=\"btn-text\"><span>Add the {{ p.title }}</span></span>\n              </button>\n            {%- endform -%}\n            <span class=\"sea-rx__price\">from {{ p.price_min | money }}</span>\n          {%- endif -%}\n          <a class=\"sea-rx__view\" href=\"/blogs/seafood-recipes/butter-pumpkin-shrimp-curry\">Full recipe &rarr;</a>\n        </div>\n      </div>\n    </article>\n    <article class=\"sea-rx__card\">\n      <figure class=\"sea-rx__media\">\n        <img src=\"{{ '20260825-Stetten-Wilson-314.jpg' | file_url }}&amp;width=760\"\n             alt=\"Apple Cider Poached Steelhead with Braised Leeks\" width=\"760\" height=\"507\" loading=\"lazy\" decoding=\"async\">\n        <img class=\"is-hover\" src=\"{{ '20260825-Stetten-Wilson-316.jpg' | file_url }}&amp;width=760\"\n             alt=\"\" aria-hidden=\"true\" width=\"760\" height=\"507\" loading=\"lazy\" decoding=\"async\">\n      </figure>\n      <div class=\"sea-rx__body\">\n        <h3 class=\"sea-rx__name\"><a href=\"/blogs/seafood-recipes/apple-cider-poached-steelhead-braised-leeks\">Apple Cider Poached Steelhead with Braised Leeks</a></h3>\n        <p class=\"sea-rx__meta\">\n          <span class=\"sea-rx__chip\">45 min</span>\n          <span class=\"sea-rx__chip\">Serves 2</span>\n          <span class=\"sea-rx__chip\">Gentle, worth a thermometer</span>\n        </p>\n        <p class=\"sea-rx__note\">Held at 160 to 175&deg;F the loin stays silky rather than firming up. Brown butter and tarragon mustard to finish.</p>\n        {%- assign p = all_products['steelhead-sashimi-loin-12oz'] -%}\n        <div class=\"sea-rx__foot\">\n          {%- if p != blank and p.available -%}\n            {%- form 'product', p, id: 'rx-steelhead-sashimi-loin-12oz', data-type: 'add-to-cart-form', class: 'sea-rx__form', is: 'product-form' -%}\n              <input type=\"hidden\" name=\"id\" value=\"{{ p.selected_or_first_available_variant.id }}\">\n              <div class=\"product-form__error-message\" role=\"alert\" hidden></div>\n              <button type=\"submit\" name=\"add\" class=\"sea-rx__buy product-form__submit\">\n                <span class=\"btn-text\"><span>Add the {{ p.title }}</span></span>\n              </button>\n            {%- endform -%}\n            <span class=\"sea-rx__price\">from {{ p.price_min | money }}</span>\n          {%- endif -%}\n          <a class=\"sea-rx__view\" href=\"/blogs/seafood-recipes/apple-cider-poached-steelhead-braised-leeks\">Full recipe &rarr;</a>\n        </div>\n      </div>\n    </article>\n    <article class=\"sea-rx__card\">\n      <figure class=\"sea-rx__media\">\n        <img src=\"{{ '20260825-Stetten-Wilson-245.jpg' | file_url }}&amp;width=760\"\n             alt=\"Crispy Branzino with Warm Farro, Maitake and Asian Pear\" width=\"760\" height=\"507\" loading=\"lazy\" decoding=\"async\">\n        <img class=\"is-hover\" src=\"{{ '20260825-Stetten-Wilson-242.jpg' | file_url }}&amp;width=760\"\n             alt=\"\" aria-hidden=\"true\" width=\"760\" height=\"507\" loading=\"lazy\" decoding=\"async\">\n      </figure>\n      <div class=\"sea-rx__body\">\n        <h3 class=\"sea-rx__name\"><a href=\"/blogs/seafood-recipes/branzino-warm-farro-maitake-salad\">Crispy Branzino with Warm Farro, Maitake and Asian Pear</a></h3>\n        <p class=\"sea-rx__meta\">\n          <span class=\"sea-rx__chip\">50 min</span>\n          <span class=\"sea-rx__chip\">Serves 2</span>\n          <span class=\"sea-rx__chip\">One technique to nail</span>\n        </p>\n        <p class=\"sea-rx__note\">Crisp skin is thirty seconds under a spatula. Better the next day, and good at room temperature.</p>\n        {%- assign p = all_products['branzino-bundle-2x-6oz-portions'] -%}\n        <div class=\"sea-rx__foot\">\n          {%- if p != blank and p.available -%}\n            {%- form 'product', p, id: 'rx-branzino-bundle-2x-6oz-portions', data-type: 'add-to-cart-form', class: 'sea-rx__form', is: 'product-form' -%}\n              <input type=\"hidden\" name=\"id\" value=\"{{ p.selected_or_first_available_variant.id }}\">\n              <div class=\"product-form__error-message\" role=\"alert\" hidden></div>\n              <button type=\"submit\" name=\"add\" class=\"sea-rx__buy product-form__submit\">\n                <span class=\"btn-text\"><span>Add the {{ p.title }}</span></span>\n              </button>\n            {%- endform -%}\n            <span class=\"sea-rx__price\">from {{ p.price_min | money }}</span>\n          {%- endif -%}\n          <a class=\"sea-rx__view\" href=\"/blogs/seafood-recipes/branzino-warm-farro-maitake-salad\">Full recipe &rarr;</a>\n        </div>\n      </div>\n    </article>\n  </div>\n</div>\n",
