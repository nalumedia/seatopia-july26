    "image_with_text_CTQibA": {
      "type": "image-with-text",
      "blocks": {
        "heading_A4FdAK": {
          "type": "heading",
          "settings": {
            "heading": "Crafted in Ojai by Chef Miriam Thom",
            "heading_size": "title-md",
            "heading_tag": "h2",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "text_rqtRhg": {
          "type": "text",
          "settings": {
            "text": "<p>Co-created in the magical Valley of the Moon in Ojai, California, this season's menu comes alive through the vision of Miriam Thom. Miriam Thom is a new mum to Winona Oros, a content creator, writer, and chef based in Ojai, California. Working across mediums, she explores regenerative narratives through storytelling and immersive experiences. Her practice is grounded in inquiry into community, place, and the sacred intelligence of nature. </p><p>Stay connected with Miriam’s work on Instagram <a href=\"https://www.instagram.com/miriamthom/ \" title=\"https://www.instagram.com/miriamthom/ \">@miriamthom</a> or through <a href=\"https://miriamthom.substack.com/ \" title=\"https://miriamthom.substack.com/ \">Ikigai World on Substack</a>. </p><p>All photography credited to: Devin Wilson @<a href=\"https://www.instagram.com/devin.r.wilson/#\">devin.r.wilson</a></p>",
            "text_size": "subtext-md",
            "text_max_size": 32,
            "text_font": "body",
            "secondary_color": false,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
