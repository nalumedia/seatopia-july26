          "type": "review",
          "settings": {
            "image": "shopify://shop_images/gp.png",
            "image_url": "shopify://pages/ambassadors",
            "title": "Gwenyth Paltrow",
            "job": "Celebrity & Wellness Guru",
            "Start_number": "5",
            "text": "<p>“I’m cooking with seafood from this company I found called Seatopia that does all sustainable seafood, and mercury tests all their products which is really good!</p>",
            "block_background": "",
            "block_text_color": ""
          }
        },
        "review_WRNcEN": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/Mark_hyman.png",
            "image_url": "shopify://blogs/seafood-recipes/asian-scallop-crudo-with-citrus-soy-marinade",
            "title": "Dr. Mark Hyman",
            "job": "Leader in Functional Medicine",
            "Start_number": "5",
            "text": "<p>“We are what foods we eats and thanks to Seatopia the next generation of omega-rich, microalgae-fed farmed seafood can help us live more vital lives with mitigated exposure to heavy metals, microplastics, GMOs or antibiotics”</p>",
            "block_background": "",
