ext":"none","highlighted_scribble":"circle"}}},"block_order":["heading_PMBeRc"],"custom_css":[],"settings":{"text_alignment":"left","text_alignment_mobile":"center","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":60,"padding_bottom":32,"divider":false,"narrow":false,"rounded":false}},"rich_text_ENwwLT":{"type":"rich-text","blocks":{"text_aXfMMX":{"type":"text","settings":{"text":"<p>SeaCorp’s regenerative farmed scallops are a culinary and environmental triumph—raised in the nutrient-rich waters of Sechura Bay, Peru, using centuries-old aquaculture traditions refined through modern sustainability practices. Suspended in the clean, oxygenated flow of the Humboldt Current, these sushi-grade scallops develop exceptional sweetness, pristine flavor, and buttery texture, all while helping to restore marine ecosystems. Filter-feeding naturally on plankton and never exposed to synthetic additives or contaminants, SeaCorp’s scallops are not only clean and delicious—they're part of a food system that actively sequesters carbon and improves ocean health. A natural work of art, ready to plate.<br\/><br\/><br\/><\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["text_aXfMMX"],"settings":{"custom-class":"","section_id":"","text_alignment":"left","text_alignment_mobile":"center","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":60,"divider":false,"narrow":false,"rounded":false}},"collage_DpiTir":{"type":"collage","blocks":{"image_fbk9FG":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/Screenshot_2025-06-04_at_8.15.47_AM.png","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}},"image_tEppWi":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/Screenshot_2025-06-04_at_8.15.25_AM.png","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}},"image_YdEwXg":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/Screenshot_2025-06-04_at_8.16.36_AM.png","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}},"image_6EVEmG":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/3041450-slide-s-5-timely-a-plan-to-invest-in-a-future-that-includes-mm7907110628014027_1296x_5f895fca-b80f-4e33-84bb-08bc3bc93f0a.jpg","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}}},"block_order":["image_fbk9FG","image_tEppWi","image_YdEwXg","image_6EVEmG"],"settings":{"heading":"Raised in the cold, rich waters of the Humbolt current","heading_size":"title-md","heading_alignment":"text-center md:items-center","heading_tag":"h2","subheading":"","description":"<p>Nestled along the northern coast of Peru, Sechura Bay has supported aquaculture for over a millennium. Enriched by the cold, plankton-dense waters of the Humboldt Current, the bay offers ideal conditions for raising bivalves in harmony with nature. SeaCorp’s farm operates in these pristine waters, where constant tidal movement provides natural filtration and nutrition for scallops without artificial inputs. The region’s unique ecology and cultural heritage make it a remarkable site for regenerative aquaculture—where time-tested knowledge and biodiversity converge to create food that feeds both people and the planet.<\/p>","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":0,"divider":false,"full_width":false,"rounded":false,"enable_parallax":true}},"video_with_text_FUAJfD":{"type":"video-with-text","blocks":{"heading_3hdhjW":{"type":"heading","settings":{"heading":"A new wave of farming rooted in old wisdom","heading_size":"title-md","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_KKca6r":{"type":"text","settings":{"text":"<p>SeaCorp is a Peruvian company founded with a deep commitment to sustainability, community, and culinary excellence. Led by local aquaculture experts and environmental stewards, the team operates from Lima and Sechura with boots on the ground and hearts in the water. The team oversees the entire lifecycle—from hatchery to harvest—ensuring traceability, quality, and environmental integrity at every step. With over 1,000 years of aquaculture history behind them and modern certifications like ASC and Friends of the Sea guiding their work, the people of SeaCorp embody a new generation of seafood farmers rooted in old wisdom and future-forward thinking.<\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"button_Kx44Ar":{"type":"button","disabled":true,"settings":{"button_label":"Button label","button_link":"","button_style":"primary","button_size":"md","button_external":false,"button_icon":true}}},"block_order":["heading_3hdhjW","text_KKca6r","button_Kx44Ar"],"settings":{"video_url":"https:\/\/www.youtube.com\/watch?v=mLLkGD70me4","cover_image":"shopify:\/\/shop_images\/Screenshot_2025-06-04_at_8.14.03_AM.png","description":"","enable_video_autoplay":false,"enable_video_looping":false,"image_height":"adapt","video_width":"medium","layout":"video_first","text_alignment":"left","content_position":"align-self-center","video_url_mobile":"","image_height_mobile":"auto","text_alignment_mobile":"left","color_text":"","color_background":"","gradient_background":"","color_background_2":"","gradient_background_2":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":72,"padding_bottom":72,"divider":false,"full_width":false,"rounded":false,"enable_parallax":false,"parallax_direction":"vertical"}},"image_with_text_overlay_tC8T8E":{"type":"image-with-text-overlay","settings":{"section_id":"","transparent_header":false,"image":"shopify:\/\/shop_images\/pexels-photo-3947347.jpg","image_height":"850px","content_width":"small","content_position":"md:items-center md:justify-center","text_alignment":"left","image_height_mobile":"auto","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","color_text":"#ffffff","color_highlight":"#e0a580","gradient_highlight":"","color_button_text":"#171717","color_button_background":"#ffffff","color_button_gradient":"","color_overlay":"#171717","overlay_opacity":70,"padding_top":0,"padding_bottom":0,"divider":false,"full_width":true,"rounded":false,"enable_parallax":true,"narrow":false,"parallax_direction":"vertical"}},"featured_collection_PeAA7p":{"type":"featured-collection","custom_css":["\/* Center and limit the size of product tiles *\/.card-grid {display: flex; flex-wrap: wrap; justify-content: center; gap: 2rem; \/* Adjust spacing between tiles *\/ margin: 0 auto; padding: 1rem;}"," \/* Restrict individual product card width *\/.card-grid .product-card {max-width: 280px; \/* Or 240px for tighter grid *\/ flex: 1 1 240px;}"," \/* Optional: center content inside each product card *\/"],"settings":{"collection":"","products":["half-shell-scallops-2x-12oz-bag","scallop-meat-16oz"],"product_limit":6,"columns":4,"carousel_on_desktop":true,"show_view_all":false,"columns_mobile":"1","swipe_on_mobile":true,"heading":"Peruvian Scallops","heading_size":"title-md","heading_alignment":"text-center md:items-center","heading_tag":"h2","subheading":"from Seacorp Peru","description":"<p>Scallops (<em>Argopecten purpuratus<\/em>) are unique among bivalves—natural swimmers with up to 200 tiny iridescent eyes and a high glycogen content that gives their meat a signature sweetness. Unlike oysters or clams, which are eaten whole, scallops are prized for their muscle only—the part that gives them power to swim. That glycogen caramelizes beautifully when seared, creating the iconic golden crust chefs crave. Grown suspended in mid-water “lantern nets” away from seabed pollutants, SeaCorp’s scallops filter phytoplankton from clean ocean currents, making them one of the most sustainable, low-impact, and flavorful protein sources in the ocean.<\/p>","highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":60,"padding_bottom":32,"divider":false,"full_width":false,"rounded":false}},"rich_text_tYfEAp":{"type":"rich-text","blocks":{"heading_zMMcwg":{"type":"heading","settings":{"heading":"Lab tested to ensure it meet's the Seatopia Standard","heading_size":"title-lg tracking-heading","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_Lbgpq6":{"type":"text","settings":{"text":"","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"button_JKJaFE":{"type":"button","disabled":true,"settings":{"button_label":"Button label","button_link":"","button_style":"primary","button_size":"md","button_external":false,"button_icon":true}}},"block_order":["heading_zMMcwg","text_Lbgpq6","button_JKJaFE"],"settings":{"custom-class":"","section_id":"","text_alignment":"center","text_alignment_mobile":"left","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":32,"divider":false,"narrow":true,"rounded":false}},"rich_text_fDqEkm":{"type":"rich-text","blocks":{"text_e9xqD8":{"type":"text","settings":{"text":"<p>SeaCorp’s scallops are raised without any added feed. As filter feeders, they thrive on naturally occurring plankton flowing through the Humboldt Current—a zero-input food source that requires no fishmeal, no antibiotics, and no human intervention. Farming takes place in hanging lantern nets, where scallops are gently suspended off the seafloor for optimal water flow and cleanliness. Within 14 months at sea following a one-month hatchery phase, the scallops are harvested and individually quick frozen within 3 hours—preserving freshness without the use of chemical preservatives like sodium triphosphate. As they grow, their shells lock carbon out of the water column in the form of calcium carbonate, quietly helping mitigate ocean acidification. It’s seafood that’s good for the body, the palate, and the planet.<\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"text_xQLbtt":{"type":"text","name":"Legacy Tests","disabled":true,"settings":{"text":"<p><strong>Scallop Meat<\/strong><\/p><ul><li><a href=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0222\/9882\/0682\/files\/Scallop_Meat_389.pdf?v=1714203423\" target=\"_blank\" title=\"Mercury Testing for Scallop Meat:  Regenerative Farmed Peruvian Scallops - 389\"><em>Lot # 389 Report Date: 04\/24\/24 Results: &lt; 0.010 PPM<\/em><\/a><\/li><li><a href=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0222\/9882\/0682\/files\/Scallop_Meat_457.pdf?v=1705609767\" target=\"_blank\" title=\"Mercury Testing for Scallop Meat:  Regenerative Farmed Peruvian Scallops - 457\"><em>Lot # 457 Report Date: 12\/08\/2023 Results: 0.01 PPM<\/em><\/a><\/li><li><a href=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0222\/9882\/0682\/files\/Artesean_Scallops_2759.pdf?v=1705516793\" target=\"_blank\" title=\"Mercury Testing for Artesean Scallops - 2759\"><em>Lot # 2759 Report Date: 11\/30\/23 Results: 0.01 PPM<\/em><\/a><\/li><li><a href=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0222\/9882\/0682\/files\/Artesean_Scallops_219.pdf?v=1705516793\" target=\"_blank\" title=\"Mercury Testing for Artesean Scallops - 219\"><em>Lot # 219 Report Date: 06\/22\/23 Results: 0.01 PPM<\/em><\/a><\/li><li><a href=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0222\/9882\/0682\/files\/Artesean_Scallops_8424.pdf?v=1705516793\" target=\"_blank\" title=\"Mercury Testing for Artesean Scallops - 8424\"><em>Lot # 8424 Report Date: 06\/06\/23 Results: 0.012 PPM<\/em><\/a><\/li><li><a href=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0222\/9882\/0682\/files\/Artesean_Scallops_7643.pdf?v=1705516793\" target=\"_blank\" title=\"Mercury Testing for Artesean Scallops - 7643\"><em>Lot # 7643 Report Date: 06\/06\/23 Results: 0.01 PPM<\/em><\/a><\/li><li><a href=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0222\/9882\/0682\/files\/Artesean_Scallops_7509.pdf?v=1705516793\" target=\"_blank\" title=\"Mercury Testing for Artesean Scallops - 7509\"><em>Lot # 7509 Report Date: 06\/06\/23 Results: 0.01 PPM<\/em><\/a><\/li><li><a href=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0222\/9882\/0682\/files\/Artesean_Scallops_496.pdf?v=1705516793\" target=\"_blank\" title=\"Mercury Testing for Artesean Scallops - 496\"><em>Lot # 496 Report Date: 06\/06\/23 Results: 0.01 PPM<\/em><\/a><\/li><li><a href=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0222\/9882\/0682\/files\/Artesean_Scallops_398.pdf?v=1705516793\" target=\"_blank\" title=\"Mercury Testing for Artesean Scallops - 398\"><em>Lot # 398 Report Date: 06\/06\/23 Results: 0.01 PPM<\/em><\/a><\/li><\/ul><p><strong>Scallop Half Shell<\/strong><\/p><ul><li><a href=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0222\/9882\/0682\/files\/Scallop_Half_Shell_1289.pdf?v=1714203423\" target=\"_blank\" title=\"Mercury Testing for Artesean Scallops - 1289\"><em>Lot # 1289 Report Date: 04\/24\/24 Results: &lt; 0.010 PPM<\/em><\/a><\/li><li><a href=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0222\/9882\/0682\/files\/Artesean_Scallop_half_shell_935.pdf?v=1708911991\" target=\"_blank\" title=\"Mercury Testing for Artesean Scallops - 2759\"><em>Lot # 935 Report Date: 02\/09\/24 Results: 0.010 PPM<\/em><\/a><\/li><\/ul>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["text_e9xqD8","text_xQLbtt"],"settings":{"custom-class":"","section_id":"","text_alignment":"left","text_alignment_mobile":"center","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":0,"divider":false,"narrow":true,"rounded":false}},"custom_liquid_rgQ9BW":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"section_id":"","liquid":"<div class=\"seatopia-edacious-results-block\">\n  <div\n    data-edacious-results='{\"brand\":\"seatopia\",\"product\":\"half-shell-scallops\",\"config\":\"2gl7st\"}'\n  ><\/div>\n