    "rich_text_intro": {
      "type": "rich-text",
      "blocks": {
        "text_intro": {
          "type": "text",
          "settings": {
            "text": "<p>King Salmon seared skin down until the skin shatters, lifted out to rest partway through, then finished in the pan. A spoonful of snap pea pesto underneath and roasted broccoli alongside.</p><p>The rest is the whole idea. Taking the fish off the heat for four minutes lets the middle catch up while the skin stays crisp instead of scorching &mdash; and salting it an hour or more ahead dries the skin so it crisps at all.</p>",
            "text_size": "subtext-md",
            "text_max_size": 32,
            "text_font": "body",
            "secondary_color": false,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
