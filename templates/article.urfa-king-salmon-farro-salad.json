    "pull_temp": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_id": "pull-temperature",
        "liquid": "\n<style>\n  .sea-temp {\n    --ink:#171717; --muted:#5c5c5c; --line:#e5e2dc; --wash:#faf8f4; --gold:#bb8f50;\n    color: var(--ink); background: #fff;\n    border: 1px solid var(--line); border-radius: 20px; padding: 30px;\n  }\n  .sea-temp__eyebrow {\n    font-size: 11px; letter-spacing: .14em; text-transform: uppercase;\n    color: var(--gold); font-weight: 600; margin: 0 0 8px;\n  }\n  .sea-temp__heading { font-size: clamp(23px, 2.8vw, 30px); line-height: 1.15; font-weight: 600; margin: 0 0 10px; }\n  .sea-temp__lede { font-size: 15px; line-height: 1.55; color: var(--muted); margin: 0 0 30px; max-width: 62ch; }\n\n  .sea-temp__rail { position: relative; margin: 0 0 12px; padding-top: 34px; }\n  .sea-temp__bar {\n    height: 14px; border-radius: 999px; overflow: hidden;\n    background: linear-gradient(90deg, #e7c9a8 0%, #dd9a5e 34%, #c96b3a 58%, #a8a29a 100%);\n  }\n  .sea-temp__zone {\n    position: absolute; top: 28px; bottom: -6px;\n    left: 25%; width: 25%;\n    border: 2px solid var(--ink); border-radius: 10px;\n    background: rgba(23,23,23,.05);\n    pointer-events: none;\n  }\n  .sea-temp__zone span {\n    position: absolute; left: 50%; top: -26px; transform: translateX(-50%);\n    white-space: nowrap;\n    font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;\n    color: #fff; background: var(--ink); padding: 4px 10px; border-radius: 999px;\n  }\n  .sea-temp__ticks {\n    display: grid; grid-template-columns: repeat(4, 1fr);\n    margin: 12px 0 0; padding: 0; list-style: none;\n    border-top: 1px solid var(--line);\n  }\n  .sea-temp__ticks li {\n    padding: 14px 14px 0 0; position: relative;\n  }\n  .sea-temp__ticks li:before {\n    content: \"\"; position: absolute; left: 0; top: -1px;\n    width: 2px; height: 9px; background: #cfc8bb;\n  }\n  .sea-temp__ticks li.is-target:before { background: var(--ink); height: 13px; width: 3px; }\n  .sea-temp__chip {\n    display: none;\n    font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;\n    color: #fff; background: var(--ink); padding: 3px 9px; border-radius: 999px;\n    margin: 0 0 7px;\n  }\n  .sea-temp__deg { display: block; font-size: 17px; font-weight: 700; line-height: 1.2; margin: 0 0 4px; }\n  .sea-temp__ticks li.is-target .sea-temp__deg { color: var(--ink); }\n  .sea-temp__what { display: block; font-size: 13.5px; font-weight: 600; line-height: 1.35; margin: 0 0 5px; }\n  .sea-temp__why { display: block; font-size: 13px; line-height: 1.5; color: var(--muted); margin: 0; }\n\n  .sea-temp__foot {\n    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 320px);\n    gap: 30px; align-items: center;\n    margin: 28px 0 0; padding-top: 22px; border-top: 1px solid var(--line);\n  }\n  .sea-temp__carry { margin: 0; font-size: 14.5px; line-height: 1.6; color: var(--muted); }\n  .sea-temp__carry b { color: var(--ink); }\n  .sea-temp__cta {\n    display: inline-flex; align-items: center; gap: 8px; margin-top: 14px;\n    padding: 11px 20px; border: 1px solid var(--ink); border-radius: 999px;\n    font-size: 14.5px; font-weight: 600; text-decoration: none;\n    color: var(--ink); background: #fff;\n    transition: background .18s ease, color .18s ease;\n  }\n  .sea-temp__cta:hover { background: var(--ink); color: #fff; }\n  .sea-temp__figure { margin: 0; }\n  .sea-temp__figure img {\n    width: 100%; height: auto; display: block;\n    border-radius: 16px; box-shadow: 0 14px 34px -22px rgba(0,0,0,.5);\n  }\n  @media (max-width: 989px) {\n    .sea-temp { padding: 22px; }\n    .sea-temp__rail { display: none; }\n    .sea-temp__chip { display: inline-block; }\n    .sea-temp__ticks { display: grid; grid-template-columns: 1fr; gap: 12px; border-top: 0; }\n    .sea-temp__ticks li {\n      padding: 15px 17px;\n      border: 1px solid var(--line); border-radius: 14px; background: var(--wash);\n    }\n    .sea-temp__ticks li:before { display: none; }\n    .sea-temp__ticks li.is-target { border-color: var(--ink); background: #fff; }\n    .sea-temp__foot { grid-template-columns: 1fr; gap: 22px; }\n    .sea-temp__figure { order: -1; }\n  }\n</style>\n\n<div class=\"sea-temp\">\n  <p class=\"sea-temp__eyebrow\">The only number that matters</p>\n  <h2 class=\"sea-temp__heading\">Pull it at 120&ndash;125&deg;F and let the plate do the rest.</h2>\n  <p class=\"sea-temp__lede\">\n    King Salmon is a fatty fillet, which buys you a little forgiveness &mdash; but not much. The window between\n    silky and chalky is about ten degrees wide, and it closes while the skillet is still in your hand.\n    Six to nine minutes in a 375&deg;F oven gets you there; a thermometer tells you when.\n  </p>\n\n  <div class=\"sea-temp__rail\">\n    <div class=\"sea-temp__bar\"></div>\n    <div class=\"sea-temp__zone\"><span>Pull here</span></div>\n  </div>\n\n  <ul class=\"sea-temp__ticks\">\n    <li>\n      <span class=\"sea-temp__deg\">110&deg;F</span>\n      <span class=\"sea-temp__what\">Not yet</span>\n      <span class=\"sea-temp__why\">Still raw through the middle and the flakes will not separate. Give it another two minutes.</span>\n    </li>\n    <li class=\"is-target\">\n      <span class=\"sea-temp__chip\">Pull here</span>\n      <span class=\"sea-temp__deg\">120&ndash;125&deg;F</span>\n      <span class=\"sea-temp__what\">Tender, just-set &mdash; the target</span>\n      <span class=\"sea-temp__why\">Slightly translucent at the very center, glossy, and it flakes under light pressure. Rest 2&ndash;3 minutes.</span>\n    </li>\n    <li>\n      <span class=\"sea-temp__deg\">130&deg;F</span>\n      <span class=\"sea-temp__what\">Fully opaque</span>\n      <span class=\"sea-temp__why\">Firmer and still good, but the fat has begun to render out rather than sit in the flesh.</span>\n    </li>\n    <li>\n      <span class=\"sea-temp__deg\">140&deg;F+</span>\n      <span class=\"sea-temp__what\">Past it</span>\n      <span class=\"sea-temp__why\">White albumin beading on the surface, dry mouthfeel. This is what most people mean by not liking salmon.</span>\n    </li>\n  </ul>\n\n  <div class=\"sea-temp__foot\">\n    <div>\n      <p class=\"sea-temp__carry\">\n        <b>Account for carryover.</b> A rested fillet climbs roughly 5&deg;F off the heat, so 122&deg;F in the skillet\n        lands near 127&deg;F on the plate. Probe the thickest point, angled in from the side rather than\n        straight down through the crisp skin you just worked for &mdash; and check the thin tail separately,\n        because it will be done first.\n      </p>\n      <a class=\"sea-temp__cta\" href=\"/products/digital-thermometer\" title=\"Digital Thermometer\">\n        <span>Shop the thermometer</span>\n        <svg viewBox=\"0 0 24 24\" width=\"17\" height=\"17\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n          <path d=\"M5 12h14\"></path><path d=\"m13 6 6 6-6 6\"></path>\n        </svg>\n      </a>\n    </div>\n    <figure class=\"sea-temp__figure\">\n      <img src=\"{{ 'urfa-ora-king-salmon-farro-salad-overhead.jpg' | file_url }}\"\n           alt=\"Overhead view of Urfa pepper King Salmon on warm apple and farro salad with avocado and pickled red onion\"\n           width=\"1200\" height=\"900\" loading=\"lazy\" decoding=\"async\">\n    </figure>\n  </div>\n</div>\n",
        "padding_top": 12,
        "padding_bottom": 44,
        "divider": false,
        "narrow": false,
        "rounded": false,
        "color_text": "",
        "color_background": "",
        "gradient_background": "",
        "color_button_text": "",
        "color_button_background": "",
        "color_button_gradient": ""
      }
    },
