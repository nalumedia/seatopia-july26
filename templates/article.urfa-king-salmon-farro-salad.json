    "pepper_note": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_id": "know-the-pepper",
        "liquid": "\n<style>\n  .sea-pepper {\n    --ink:#171717; --muted:#5c5c5c; --line:#e5e2dc; --wash:#faf8f4; --gold:#bb8f50;\n    color: var(--ink); background: var(--wash);\n    border: 1px solid var(--line); border-radius: 20px; padding: 30px;\n  }\n  .sea-pepper__grid {\n    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 300px);\n    gap: 34px; align-items: center;\n  }\n  .sea-pepper__eyebrow {\n    font-size: 11px; letter-spacing: .14em; text-transform: uppercase;\n    color: var(--gold); font-weight: 600; margin: 0 0 8px;\n  }\n  .sea-pepper__heading { font-size: clamp(23px, 2.8vw, 30px); line-height: 1.15; font-weight: 600; margin: 0 0 10px; }\n  .sea-pepper__lede { font-size: 15px; line-height: 1.55; color: var(--muted); margin: 0 0 22px; }\n  .sea-pepper__rows { display: grid; gap: 14px; }\n  .sea-pepper__row {\n    background: #fff; border: 1px solid var(--line); border-radius: 14px;\n    padding: 15px 17px;\n    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px 16px; align-items: center;\n  }\n  .sea-pepper__row--pick { border-color: var(--gold); box-shadow: 0 0 0 1px var(--gold); }\n  .sea-pepper__name {\n    grid-column: 1; margin: 0;\n    font-size: 15px; font-weight: 600; line-height: 1.3;\n    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;\n  }\n  .sea-pepper__tag {\n    font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;\n    color: #fff; background: var(--gold); padding: 3px 8px; border-radius: 999px;\n  }\n  .sea-pepper__meter { grid-column: 2; grid-row: 1; display: flex; gap: 4px; align-items: center; }\n  .sea-pepper__pip {\n    width: 9px; height: 9px; border-radius: 50%;\n    background: #fff; border: 1.5px solid #d8cfc0;\n  }\n  .sea-pepper__pip.is-on { background: #b8462f; border-color: #b8462f; }\n  .sea-pepper__note {\n    grid-column: 1 / -1; margin: 0;\n    font-size: 13.5px; line-height: 1.5; color: var(--muted);\n  }\n  .sea-pepper__legend {\n    margin: 16px 0 0; padding-top: 14px; border-top: 1px solid var(--line);\n    font-size: 13px; line-height: 1.55; color: var(--muted);\n  }\n  .sea-pepper__figure { margin: 0; }\n  .sea-pepper__figure img {\n    width: 100%; height: auto; display: block;\n    border-radius: 16px; box-shadow: 0 14px 34px -22px rgba(0,0,0,.5);\n  }\n  .sea-pepper__cap { margin: 10px 0 0; font-size: 12.5px; line-height: 1.5; color: var(--muted); }\n  @media (max-width: 989px) {\n    .sea-pepper { padding: 22px; }\n    .sea-pepper__grid { grid-template-columns: 1fr; gap: 24px; }\n    .sea-pepper__figure { order: -1; }\n  }\n</style>\n\n<div class=\"sea-pepper\">\n  <div class=\"sea-pepper__grid\">\n\n    <div class=\"sea-pepper__body\">\n      <p class=\"sea-pepper__eyebrow\">Know the pepper</p>\n      <h2 class=\"sea-pepper__heading\">Urfa is not a chili flake, and the difference is the whole dish.</h2>\n      <p class=\"sea-pepper__lede\">\n        Urfa (you will also see it sold as <em>isot</em>) is dried in the sun by day and wrapped to sweat overnight,\n        which is why it comes out almost black and tastes of raisin, tobacco and cocoa instead of straight heat.\n        The heat arrives late and stays low. That slow, dark sweetness is what makes it sit so well against\n        rich salmon and sweet apple &mdash; a hotter, brighter flake fights both.\n      </p>\n\n      <div class=\"sea-pepper__rows\">\n        <div class=\"sea-pepper__row sea-pepper__row--pick\">\n          <p class=\"sea-pepper__name\">\n            <span>Urfa / isot</span>\n            <span class=\"sea-pepper__tag\">As written</span>\n          </p>\n          <div class=\"sea-pepper__meter\" role=\"img\" aria-label=\"Heat: 2 out of 5\">\n            <span class=\"sea-pepper__pip is-on\"></span>\n            <span class=\"sea-pepper__pip is-on\"></span>\n            <span class=\"sea-pepper__pip\"></span>\n            <span class=\"sea-pepper__pip\"></span>\n            <span class=\"sea-pepper__pip\"></span>\n          </div>\n          <p class=\"sea-pepper__note\">Dark maroon, faintly oily, coarse. Raisin and cocoa up front, heat well behind it. Use a generous pinch &mdash; it is a finishing pepper, not a seasoning.</p>\n        </div>\n\n        <div class=\"sea-pepper__row\">\n          <p class=\"sea-pepper__name\"><span>Aleppo / pul biber</span></p>\n          <div class=\"sea-pepper__meter\" role=\"img\" aria-label=\"Heat: 3 out of 5\">\n            <span class=\"sea-pepper__pip is-on\"></span>\n            <span class=\"sea-pepper__pip is-on\"></span>\n            <span class=\"sea-pepper__pip is-on\"></span>\n            <span class=\"sea-pepper__pip\"></span>\n            <span class=\"sea-pepper__pip\"></span>\n          </div>\n          <p class=\"sea-pepper__note\">The closest easy swap and the one named in the recipe. Brighter red, fruitier, a little hotter and a lot less smoky. Use the same amount.</p>\n        </div>\n\n        <div class=\"sea-pepper__row\">\n          <p class=\"sea-pepper__name\"><span>Crushed red pepper flake</span></p>\n          <div class=\"sea-pepper__meter\" role=\"img\" aria-label=\"Heat: 5 out of 5\">\n            <span class=\"sea-pepper__pip is-on\"></span>\n            <span class=\"sea-pepper__pip is-on\"></span>\n            <span class=\"sea-pepper__pip is-on\"></span>\n            <span class=\"sea-pepper__pip is-on\"></span>\n            <span class=\"sea-pepper__pip is-on\"></span>\n          </div>\n          <p class=\"sea-pepper__note\">Works, but change the dose: use about a third as much, and add a pinch of smoked paprika to stand in for the missing depth.</p>\n        </div>\n      </div>\n\n      <p class=\"sea-pepper__legend\">\n        Pips are relative heat within this trio, not a measurement. If your jar of Urfa smells like tobacco and\n        leaves a little oil on your fingers, it is the good stuff.\n      </p>\n    </div>\n\n    <figure class=\"sea-pepper__figure\">\n      <img src=\"{{ 'urfa-farro-salad-mise-en-place.jpg' | file_url }}\"\n           alt=\"Mise en place on a wooden board: cilantro, avocado, sliced apple, sultana raisins, toasted pepitas, pickled red onions and Urfa pepper\"\n           width=\"1200\" height=\"900\" loading=\"lazy\" decoding=\"async\">\n      <p class=\"sea-pepper__cap\">Everything for the salad, prepped and portioned before the farro goes on.</p>\n    </figure>\n\n  </div>\n</div>\n",
        "padding_top": 44,
