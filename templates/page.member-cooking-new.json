tings":{}},"spinning_text_UM9kie":{"type":"spinning_text","settings":{"text":"Featured product"}}},"block_order":["title_qatmGe","description_3t6j8r","variant_picker_rX9AaG","buy_buttons_9QQWDb","pickup_availability_g6aNwr","share_YPkYtn","read_more_UPLh7F","spinning_text_UM9kie"],"disabled":true,"settings":{"product":"seatopia-regenerative-seafood-bundle","enable_sticky_info":true,"show_chef_notes":true,"media_size":66,"gallery_layout":"thumbnail","thumbnail_position":"beside","image_ratio":"adapt_first","image_zoom":"lightbox","hide_variants":false,"enable_video_autoplay":false,"enable_video_looping":false,"mobile_layout":"partial","image_ratio_mobile":"adapt_first","mobile_thumbnail":false,"padding_top":72,"padding_bottom":72,"divider":false,"full_width":false,"rounded":false}},"custom_image_with_txt_founder_Mp8tUW":{"type":"custom-image-with-txt-founder","blocks":{"heading_43LVcC":{"type":"heading","settings":{"heading":"The importance of good basics","heading_size":"title-md","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_Q6dfji":{"type":"text","settings":{"text":"<p>Welcome to Seatopia 101 — your introduction to mastering clean, sushi-grade seafood at home.<\/p><p>In this 1:1 virtual session, a member of our Culinary Team will guide you through the essential techniques that ensure every Seatopia meal is safe, delicious, and effortless.<\/p><p>You’ll learn how to:<\/p><ul><li><strong>Handle & Defrost Properly<\/strong> — the best methods for thawing sushi-grade seafood while preserving texture and nutrients.<\/li><li><strong>Prep & Cook with Confidence<\/strong> — how to season, sear, and finish your fish using clean, simple techniques.<\/li><li><strong>Build Kitchen Readiness<\/strong> — setting up your tools, oils, and workspace for success.<\/li><\/ul><p>Whether you’re brand new to cooking seafood or just refining your skills, this session will help you handle Seatopia products with confidence and reverence — honoring both your health and the ocean that sustains us.<\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"spacing_DbQJUU":{"type":"spacing","settings":{"height":40,"height_mobile":28}},"button_qxjzyj":{"type":"button","settings":{"button_label":"Book your seafood basics class","button_link":"https:\/\/calendly.com\/101-seafood\/defrostingbasicis?back=1&month=2025-12","button_style":"primary","button_size":"md","button_external":true,"button_icon":true}}},"block_order":["heading_43LVcC","text_Q6dfji","spacing_DbQJUU","button_qxjzyj"],"settings":{"custom_class":"","image":"shopify:\/\/shop_images\/steelhead-sashimi-loin-643979.png","image_height":"100vh","image_width":"medium","layout":"text_first","text_alignment":"left","content_position":"align-self-center","image_mobile":"shopify:\/\/shop_images\/steelhead-sashimi-loin-643979.png","image_height_mobile":"auto","text_alignment_mobile":"left","color_text":"","color_background":"","container_color_bg":"","gradient_background":"","color_background_2":"","gradient_background_2":"","color_highlight":"","gradient_highlight":"","color_button_text":"#ffffff","color_button_background":"#ff7755","color_button_gradient":"","padding_top":100,"padding_bottom":100,"divider":false,"full_width":false,"rounded":false,"enable_parallax":true,"parallax_direction":"vertical"}},"custom_image_with_txt_founder_UmGdNH":{"type":"custom-image-with-txt-founder","blocks":{"heading_rb3LEz":{"type":"heading","settings":{"heading":"Getting that perfectly crispy skin in the pan","heading_size":"title-md","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_UYRzrP":{"type":"text","settings":{"text":"<p>Learn how to achieve that first, unforgettable bite of crispy, golden fish skin — without sticking, tearing, or guesswork. In this interactive 1:1 session, you’ll cook alongside a member of the Seatopia Culinary Team and master the chef-approved parchment paper method that makes crispy skin foolproof at home.<\/p><p>This is a hands-on, cook-along experience designed to build confidence with skin-on seafood and clean pan-frying techniques.<\/p><p><strong>What you’ll learn during the session<\/strong><\/p><ul><li>The No-Stick Method — how to pan-fry with parchment paper for even crisping and easy release<\/li><li>The Science of Crispiness — why moisture control, timing, and salt placement matter<\/li><li>Finishing & Plating — how to preserve crunch and pair your fish with clean, vibrant flavors<\/li><\/ul><p>Some pre-reading and prep is required, so please read the booking pages notes attentively to make the most of your class.<\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"spacing_LTY7Qf":{"type":"spacing","settings":{"height":40,"height_mobile":28}},"button_yqpX3W":{"type":"button","settings":{"button_label":"Learn how to get crispy skin","button_link":"https:\/\/calendly.com\/101-seafood\/defrostingbasicis?back=1&month=2025-12","button_style":"primary","button_size":"md","button_external":true,"button_icon":true}}},"block_order":["heading_rb3LEz","text_UYRzrP","spacing_LTY7Qf","button_yqpX3W"],"settings":{"custom_class":"","image":"shopify:\/\/shop_images\/Seatopia.E-Book-22.jpg","image_height":"100vh","image_width":"small","layout":"image_first","text_alignment":"left","content_position":"align-self-center","image_mobile":"shopify:\/\/shop_images\/Seatopia.E-Book-22.jpg","image_height_mobile":"auto","text_alignment_mobile":"left","color_text":"","color_background":"","container_color_bg":"","gradient_background":"","color_background_2":"","gradient_background_2":"","color_highlight":"","gradient_highlight":"","color_button_text":"#ffffff","color_button_background":"#ff7755","color_button_gradient":"","padding_top":100,"padding_bottom":100,"divider":false,"full_width":false,"rounded":false,"enable_parallax":true,"parallax_direction":"vertical"}},"custom_image_with_txt_founder_rzE9aj":{"type":"custom-image-with-txt-founder","blocks":{"heading_G6mXDy":{"type":"heading","settings":{"heading":"The secrets of miso marinade","heading_size":"title-md","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_KkhDTy":{"type":"text","settings":{"text":"<p>Discover one of Japan’s oldest culinary secrets — the <strong>miso marinade<\/strong>, a centuries-old technique that both preserves and elevates seafood.<\/p><p>In this <strong>hands-on, cook-along virtual session<\/strong>, you’ll work alongside a member of the Seatopia Culinary Team to transform your Seatopia fillet into a golden, umami-rich dish that’s as nourishing as it is delicious.<\/p><p>This session is designed to build confidence with clean marinades, gentle fermentation, and simple cooking techniques that respect the purity of sushi-grade seafood.<\/p><p><strong>What you’ll learn during the session<\/strong><\/p><ul><li>The Art of Miso Marination — how miso, honey, and vinegar work together to tenderize and infuse deep umami<\/li><li>Cooking to Perfection — how to broil, bake, or pan-sear for caramelized depth and flaky texture<\/li><li>Balancing Flavor & Function — pairing your fish with clean sides like greens, soba noodles, or rice<\/li><\/ul><p>Some pre-reading and prep is required, so please read the booking pages notes attentively to make the most of your class.<\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"spacing_nEPjqg":{"type":"spacing","settings":{"height":40,"height_mobile":28}},"button_QXEtyq":{"type":"button","settings":{"button_label":"Learn all about miso marinade","button_link":"https:\/\/calendly.com\/101-seafood\/defrostingbasicis?back=1&month=2025-12","button_style":"primary","button_size":"md","button_external":true,"button_icon":true}}},"block_order":["heading_G6mXDy","text_KkhDTy","spacing_nEPjqg","button_QXEtyq"],"settings":{"custom_class":"","image":"shopify:\/\/shop_images\/broiled_miso.jpg","image_height":"100vh","image_width":"small","layout":"text_first","text_alignment":"left","content_position":"align-self-center","image_mobile":"shopify:\/\/shop_images\/broiled_miso.jpg","image_height_mobile":"auto","text_alignment_mobile":"left","color_text":"","color_background":"","container_color_bg":"","gradient_background":"","color_background_2":"","gradient_background_2":"","color_highlight":"","gradient_highlight":"","color_button_text":"#ffffff","color_button_background":"#ff7755","color_button_gradient":"","padding_top":100,"padding_bottom":100,"divider":false,"full_width":false,"rounded":false,"enable_parallax":true,"parallax_direction":"vertical"}},"image_with_text_overlay_EN7K98":{"type":"image-with-text-overlay","blocks":{"heading_MtGkh7":{"type":"heading","settings":{"heading":"Take the next steps in your Seafood journey","heading_size":"title-lg tracking-heading","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_teEbhD":{"type":"text","settings":{"text":"<p>You have the basics down but want to take your craft to the next level? Book your free seafood 201 and learn how to make sushi, ceviche and delicious poke bowls.<\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["heading_MtGkh7","text_teEbhD"],"name":"t:sections.image-with-text-overlay.presets.name","settings":{"transparent_header":false,"image":"shopify:\/\/shop_images\/20260614-Stetten-Wilson-245.jpg","image_height":"650px","content_width":"small","content_position":"md:items-end md:justify-start","text_alignment":"left","image_height_mobile":"auto","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","color_text":"#ffffff","color_highlight":"#e0a580","gradient_highlight":"","color_button_text":"#171717","color_button_background":"#ffffff","color_button_gradient":"","color_overlay":"#171717","overlay_opacity":29,"padding_top":0,"padding_bottom":0,"divider":false,"full_width":true,"rounded":true,"enable_parallax":true,"narrow":false,"parallax_direction":"vertical"}},"custom_image_with_txt_founder_7baWjJ":{"type":"custom-image-with-txt-founder","blocks":{"heading_GYyeBg":{"type":"heading","settings":{"heading":"Poke bowls with tamari, ginger and garlic","heading_size":"title-md","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_xPzwkN":{"type":"text","settings":{"text":"<p>Learn the art of building a clean, vibrant poke bowl that honors the purity of your Seatopia seafood. In this interactive 1:1 session, you’ll cook alongside a member of the Seatopia Culinary Team while refining knife skills, seasoning technique, and bowl composition.<\/p><p>This is a <strong>hands-on, cook-along experience<\/strong> designed to help you feel confident preparing raw, sushi-grade seafood at home.<\/p><p><strong>What you’ll learn during the session<\/strong><\/p><ul><li><strong>Cube & Season Seafood<\/strong> — cut sushi-grade fish into clean, even bites<\/li><li><strong>Build Flavor Layers<\/strong> — balance tamari, ginger, and garlic without overpowering the fish<\/li><li><strong>Assemble the Bowl<\/strong> — pair seafood with rice, greens, and toppings for a nutrient-dense, restaurant-quality result<\/li><\/ul><p>To make the most of our time together, please review the materials in the booking link below <strong>before your call<\/strong>. This allows us to spend the session cooking, tasting, and refining — not just explaining basics.<\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"spacing_FPByaU":{"type":"spacing","settings":{"height":40,"height_mobile":28}},"button_McRBGN":{"type":"button","settings":{"button_label":"Make some great Poke","button_link":"https:\/\/calendly.com\/101-seafood\/poke?back=1&month=2025-12","button_style":"primary","button_size":"md","button_external":true,"button_icon":true}}},"block_order":["heading_GYyeBg","text_xPzwkN","spacing_FPByaU","button_McRBGN"],"settings":{"custom_class":"","image":"shopify:\/\/shop_images\/mercury-tested-poke.jpg","image_height":"100vh","image_width":"medium","layout":"image_first","text_alignment":"left","content_position":"align-self-center","image_height_mobile":"auto","text_alignment_mobile":"left","color_text":"","color_background":"","container_color_bg":"","gradient_background":"","color_background_2":"","gradient_background_2":"","color_highlight":"","gradient_highlight":"","color_button_text":"#ffffff","color_button_background":"#ff7755","color_button_gradient":"","padding_top":100,"padding_bottom":100,"divider":false,"full_width":false,"rounded":false,"enable_parallax":true,"parallax_direction":"vertical"}},"custom_image_with_txt_founder_xDfJbt":{"type":"custom-image-with-txt-founder","blocks":{"heading_wXYHJw":{"type":"heading","settings":{"heading":"The ancient art of ceviche","heading_size":"title-md","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_nMtNCT":{"type":"text","settings":{"text":"<p>Experience the bright, refreshing flavors of coastal ceviche — the ultimate clean, no-heat seafood preparation. This hands-on class will guide you through balancing acidity, texture, and herbs to create your own masterpiece.<\/p><p>You’ll learn how to:<\/p><ul><li><strong>Dice & Cure Seafood<\/strong> — using citrus acids for a safe, flavorful “cold cook.”<\/li><li><strong>Balance Brightness & Salt<\/strong> — to highlight the fish’s natural sweetness.<\/li><li><strong>Build a Ceviche Bowl<\/strong> — with avocado, herbs, onions, and a touch of heat.<\/li><\/ul><p>To make the most of our time together, please review the materials in the booking link below <strong>before your call<\/strong>. This allows us to spend the session cooking, tasting, and refining — not just explaining basics.<\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"spacing_EriTfQ":{"type":"spacing","settings":{"height":40,"height_mobile":28}},"button_ET4E8X":{"type":"button","settings":{"button_label":"Learn everything about Ceviche","button_link":"https:\/\/calendly.com\/101-seafood\/ceviche-class?back=1&month=2025-12","button_style":"primary","button_size":"md","button_external":true,"button_icon":true}}},"block_order":["heading_wXYHJw","text_nMtNCT","spacing_EriTfQ","button_ET4E8X"],"settings":{"custom_class":"","image":"shopify:\/\/shop_images\/Seatopia.E-Book-8.jpg","image_height":"100vh","image_width":"small","layout":"text_first","text_alignment":"left","content_position":"align-self-center","image_mobile":"shopify:\/\/shop_images\/Seatopia.E-Book-8.jpg","image_height_mobile":"auto","text_alignment_mobile":"left","color_text":"","color_background":"","container_color_bg":"","gradient_background":"","color_background_2":"","gradient_background_2":"","color_highlight":"","gradient_highlight":"","color_button_text":"#ffffff","color_button_background":"#ff7755","color_button_gradient":"","padding_top":100,"padding_bottom":100,"divider":false,"full_width":false,"rounded":false,"enable_parallax":true,"parallax_direction":"vertical"}},"custom_image_with_txt_founder_4xEwxF":{"type":"custom-image-with-txt-founder","blocks":{"heading_KEpgxc":{"type":"heading","settings":{"heading":"Become a sushi chef","heading_size":"title-md","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_TzA4wE":{"type":"text","settings":{"text":"<p>Bring the sushi bar home with <strong>Seatopia 201: Hand Rolls at Home<\/strong> — a fun, interactive class that teaches you how to assemble stunning temaki hand rolls using sushi-grade seafood, fresh ingredients, and clean techniques.<\/p><p>You’ll learn how to:<\/p><ul><li><strong>Slice Sushi-Grade Fish<\/strong> — thinly and evenly for easy rolling.<\/li><li><strong>Build the Perfect Roll<\/strong> — using nori, seasoned rice, and vibrant toppings.<\/li><li><strong>Balance Texture & Temperature<\/strong> — so every bite feels fresh, clean, and oceanic.<\/li><\/ul><p><strong>Prep Reminder:<\/strong><\/p><p>Before your session, thaw one Seatopia fillet (Salmon, Yellowtail, or Steelhead). Have ready: sushi rice (warm or room temperature), nori sheets, soy or tamari, sesame oil, avocado, cucumber, scallions, and a small bowl of water for sealing your rolls.<\/p><p>Perfect for date nights, family dinners, or simply mastering the art of sushi simplicity.<\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"spacing_3GxyWR":{"type":"spacing","settings":{"height":40,"height_mobile":28}},"button_FHKW7k":{"type":"button","settings":{"button_label":"Book your free Sushi class","button_link":"https:\/\/calendly.com\/101-seafood\/hand-roll-class?back=1&month=2025-12","button_style":"primary","button_size":"md","button_external":true,"button_icon":true}}},"block_order":["heading_KEpgxc","text_TzA4wE","spacing_3GxyWR","button_FHKW7k"],"settings":{"custom_class":"","image":"shopify:\/\/shop_images\/seatopia-sushi-date-night-box-8.jpg","image_height":"100vh","image_width":"medium","layout":"image_first","text_alignment":"left","content_position":"align-self-center","image_mobile":"shopify:\/\/shop_images\/seatopia-sushi-date-night-box-8.jpg","image_height_mobile":"auto","text_alignment_mobile":"left","color_text":"","color_background":"","container_color_bg":"","gradient_background":"","color_background_2":"","gradient_background_2":"","color_highlight":"","gradient_highlight":"","color_button_text":"#ffffff","color_button_background":"#ff7755","color_button_gradient":""