{"sections":{"rich_text_QGGaPA":{"type":"rich-text","blocks":{"heading_bja3iB":{"type":"heading","settings":{"heading":"Start your culinary journey with a member cooking class","heading_size":"title-lg tracking-heading","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_Jz9FfA":{"type":"text","settings":{"text":"<p>We love helping people like you make omega-rich, delicious, certified-clean seafood recipes at home. That is why we offer FREE 1:1 Member Cooking Classes with every order. 1:1’s help us help you have an incredible experience at home and are our way of saying thanks for voting with your fork for a healthier regenerative seafood supply chain.<\/p><p><\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["heading_bja3iB","text_Jz9FfA"],"name":"t:sections.rich-text.presets.name","settings":{"custom-class":"","text_alignment":"center","text_alignment_mobile":"center","heading":"","heading_size":"title-md","heading_alignment":"text-center md:items-center","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":72,"padding_bottom":100,"divider":false,"narrow":false,"rounded":false}},"image_with_text_overlay_LkUzgb":{"type":"image-with-text-overlay","settings":{"transparent_header":false,"image":"shopify:\/\/shop_images\/James_Cook_ing.jpg","image_height":"850px","content_width":"small","content_position":"md:items-center md:justify-start","text_alignment":"left","image_mobile":"shopify:\/\/shop_images\/James_Cook_ing.jpg","image_height_mobile":"100vh","content_posit