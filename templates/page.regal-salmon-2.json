_tag":"h1","highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["heading_PMBeRc"],"custom_css":[],"settings":{"text_alignment":"left","text_alignment_mobile":"center","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":60,"padding_bottom":32,"divider":false,"narrow":false,"rounded":false}},"rich_text_ENwwLT":{"type":"rich-text","blocks":{"text_aXfMMX":{"type":"text","settings":{"text":"<p>Regal Salmon represents the enduring craft of New Zealand salmon farming—refined over decades to produce fish of exceptional purity, consistency, and flavour. Raised in the cold, fast-moving waters of the Marlborough Sounds, Regal salmon is known for its clean taste, firm yet delicate texture, and natural balance of richness without excess. It is a salmon shaped not by extremity, but by precision—designed to perform beautifully across everyday cooking as well as refined culinary applications. Trusted by chefs and households alike, Regal is a benchmark for dependable, high-quality King salmon, grown with respect for both the fish and its environment.</p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["text_aXfMMX"],"settings":{"custom-class":"","text_alignment":"left","text_alignment_mobile":"center","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":60,"divider":false,"narrow":false,"rounded":false}},"video_with_text_FUAJfD":{"type":"video-with-text","blocks":{"heading_3hdhjW":{"type":"heading","settings":{"heading":"Generations of Craft and Stewardship","heading_size":"title-md","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_KKca6r":{"type":"text","settings":{"text":"<p>Behind Regal Salmon is the deep-rooted expertise of the New Zealand King Salmon Company—a group of farmers, scientists, and water stewards who have spent decades refining their approach. Every stage of the life cycle is carefully managed, from freshwater hatcheries to ocean harvest, with a focus on fish health, welfare, and consistency. Feeding is precise, observation is constant, and decisions are guided by long-term sustainability rather than short-term gain. The result is a salmon that reflects quiet mastery, less about pushing extremes, more about getting every detail right.</p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"button_Kx44Ar":{"type":"button","disabled":true,"settings":{"button_label":"Button label","button_link":"","button_style":"primary","button_size":"md","button_external":false,"button_icon":true}}},"block_order":["heading_3hdhjW","text_KKca6r","button_Kx44Ar"],"settings":{"video_url":"https://www.youtube.com/watch?v=af0AFFgleYA","cover_image":"shopify://shop_images/Screenshot_2026-04-28_at_18.12.41.png","description":"","enable_video_autoplay":false,"enable_video_looping":false,"image_height":"adapt","video_width":"medium","layout":"video_first","text_alignment":"left","content_position":"align-self-center","video_url_mobile":"","image_height_mobile":"auto","text_alignment_mobile":"left","color_text":"","color_background":"","gradient_background":"","color_background_2":"","gradient_background_2":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":72,"padding_bottom":72,"divider":false,"full_width":false,"rounded":false,"enable_parallax":false,"parallax_direction":"vertical"}},"collage_DpiTir":{"type":"collage","blocks":{"image_j3jWR4":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify://shop_images/Screenshot_2026-04-28_at_18.14.23.png","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}},"image_7fiqzh":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify://shop_images/Screenshot_2026-04-28_at_18.14.06.png","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}},"image_KxrKPV":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify://shop_images/new-zealand-king-salmon-farm-2.jpg","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}},"image_b7LfNg":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify://shop_images/new-zealand-king-salmon-farm-1.jpg","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}}},"block_order":["image_j3jWR4","image_7fiqzh","image_KxrKPV","image_b7LfNg"],"settings":{"heading":"Cold Waters, Natural Balance","heading_size":"title-md","heading_alignment":"text-center md:items-center","heading_tag":"h2","subheading":"","description":"<p>Regal salmon are raised in the sheltered inlets and open bays of New Zealand’s Marlborough Sounds—an environment defined by cold ocean currents, steady tidal movement, and remarkable water clarity. These conditions create a naturally oxygen-rich habitat where salmon can grow steadily and without stress. The remoteness of the region, combined with strict environmental management, ensures low-impact farming and exceptional water quality year-round. It is this balance of nature and stewardship that gives Regal salmon its signature clean flavour and consistent structure.</p>","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":52,"divider":false,"full_width":false,"rounded":false,"enable_parallax":true}},"image_with_text_overlay_tC8T8E":{"type":"image-with-text-overlay","settings":{"transparent_header":false,"image":"shopify://shop_images/farm-te-pangu-3-hero.jpg","image_height":"850px","content_width":"small","content_position":"md:items-center md:justify-center","text_alignment":"left","image_height_mobile":"auto","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","color_text":"#ffffff","color_highlight":"#e0a580","gradient_highlight":"","color_button_text":"#171717","color_button_background":"#ffffff","color_button_gradient":"","color_overlay":"#171717","overlay_opacity":70,"padding_top":0,"padding_bottom":0,"divider":false,"full_width":true,"rounded":false,"enable_parallax":true,"narrow":false,"parallax_direction":"vertical"}},"featured_collection_PeAA7p":{"type":"featured-collection","disabled":true,"custom_css":["/* Center and limit the size of product tiles */.card-grid {display: flex; flex-wrap: wrap; justify-content: center; gap: 2rem; /* Adjust spacing between tiles */ margin: 0 auto; padding: 1rem;}"," /* Restrict individual product card width */.card-grid .product-card {max-width: 280px; /* Or 240px for tighter grid */ flex: 1 1 240px;}"," /* Optional: center content inside each product card */"],"settings":{"collection":"","products":["buy-ora-king-salmon-portion-new-zealand"],"product_limit":6,"columns":4,"carousel_on_desktop":true,"show_view_all":false,"columns_mobile":"1","swipe_on_mobile":true,"heading":"King Salmon","heading_size":"title-md","heading_alignment":"text-center md:items-center","heading_tag":"h2","subheading":"from Ōra King","description":"<p>Ōra King raises <em>Oncorhynchus tshawytscha</em>, also known as Chinook or King salmon—the largest and most prized of the Pacific salmon species. Known for its buttery richness and fine marbling, this species is genetically predisposed to high fat content, resulting in luxurious texture and depth of flavor. In aquaculture, it thrives in cold, oxygenated water, with slower growth cycles that allow time for flavor and structure to develop. For chefs, King salmon offers exceptional versatility—delicate enough for crudo or tartare, but rich enough to hold up on the grill or in a slow roast.</p>","highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":60,"padding_bottom":32,"divider":false,"full_width":false,"rounded":false}},"rich_text_tYfEAp":{"type":"rich-text","blocks":{"heading_zMMcwg":{"type":"heading","settings":{"heading":"Sustainably Fed, Ethically Farmed, Lab-Tested to Meet the Seatopia Standard","heading_size":"title-lg tracking-heading","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_Lbgpq6":{"type":"text","settings":{"text":"","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"button_JKJaFE":{"type":"button","disabled":true,"settings":{"button_label":"Button label","button_link":"","button_style":"primary","button_size":"md","button_external":false,"button_icon":true}}},"block_order":["heading_zMMcwg","text_Lbgpq6","button_JKJaFE"],"disabled":true,"settings":{"custom-class":"","text_alignment":"center","text_alignment_mobile":"left","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":32,"padding_bottom":32,"divider":false,"narrow":true,"rounded":false}},"rich_text_fDqEkm":{"type":"rich-text","blocks":{"text_e9xqD8":{"type":"text","settings":{"text":"<p>Ōra King salmon are fed a specially formulated diet that mirrors the nutrition of their wild counterparts—rich in high-quality marine proteins and oils, carefully balanced with plant-based ingredients to promote health and sustainability. Their feed is free from antibiotics and GMO ingredients, and the farm operates under Best Aquaculture Practices (BAP) and Global GAP certifications. Stocking densities are kept low to reduce stress and encourage natural behavior, and regular audits ensure environmental responsibility at every step. By raising their fish slowly, with intention and precision, the Ōra King team delivers salmon that is as ethically raised as it is exquisite to eat.</p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["text_e9xqD8"],"disabled":true,"settings":{"custom-class":"","text_alignment":"left","text_alignment_mobile":"center","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":0,"divider":false,"narrow":true,"rounded":false}},"portfolio_khhjiy":{"type":"portfolio","blocks":{"profile_FtXEVP":{"type":"profile","settings":{"image":"shopify://shop_images/Screenshot_2025-06-25_at_8.44.12_AM.png","heading":"Broiled Miso  Salmon Bowl","text":"<p>This ritualistic recipe celebrates the art of a 48-hour marinade, blending saké, miso, and coconut sugar to create a deeply flavorful glaze. We'll guide you through every step—from preparing the marinade to broiling the salmon to perfection and plating it with sushi rice, purple broccolini, pickled onions, and creamy avocado.</p><p>👉🏽 <a href=\"https://seatopia.fish/blogs/seafood-recipes/broiled-miso-salmon-bowl-sushi-rice-avocado\" target=\"_blank\" title=\"https://seatopia.fish/blogs/seafood-recipes/broiled-miso-salmon-bowl-sushi-rice-avocado\">Get the Recipe</a></p>","color_text":"#ffffff","color_background":"#171717"}},"profile_9abkc4":{"type":"profile","settings":{"image":"shopify://shop_images/Screenshot_2025-06-25_at_8.45.54_AM.png","heading":"Spirulina-Infused Crudo","text":"<p><em>Prepare Steelhead Crudo with green spirulina emulsion. Seatopia’s sushi-grade seafood delivers abundant Omega-3s to support heart and brain health.</em></p><p>👉🏽 <a href=\"https://seatopia.fish/blogs/seafood-recipes/spirulina-infused-crudo-with-seatopia-steelhead\" target=\"_blank\" title=\"https://seatopia.fish/blogs/seafood-recipes/spirulina-infused-crudo-with-seatopia-steelhead\">Get the recipe</a></p>","color_text":"#ffffff","color_background":"#171717"}},"profile_tPnk6G":{"type":"profile","settings":{"image":"shopify://shop_images/Screenshot_2025-06-25_at_8.47.03_AM.png","heading":"Salmon Poke Bowl","text":"<p>Join us in this new recipe where we dive into the traditional flavors of Hawaii with a classic Salmon Poke, made with New Zealand King Salmon from Seatopia. This step-by-step guide walks you through preparing a flavorful poke, marrying the rich taste of sushi-grade salmon, loaded with omega-3s, with the freshness of pickled ginger and garlic, known for their digestive and immune-supporting properties. Perfectly paired with organic sushi rice and creamy avocado, this dish is a true celebration of Hawaiian cuisine and wholesome nourishment.</p><p>👉🏽 <a href=\"https://seatopia.fish/blogs/seafood-recipes/salmon-poke-101-tamari-ginger-garlic\" target=\"_blank\" title=\"https://seatopia.fish/blogs/seafood-recipes/salmon-poke-101-tamari-ginger-garlic\">Get the recipe</a></p>","color_text":"#ffffff","color_background":"#171717"}}},"block_order":["profile_FtXEVP","profile_9abkc4","profile_tPnk6G"],"custom_css":["/* Center the tiles inside the grid */.portfolio.card-grid {display: flex; flex-wrap: wrap; justify-content: center; gap: 2rem; padding: 1rem; text-align: center;}"," /* Optional: center the parent container if needed */.card-grid--4 {justify-content: center;}",".grid {justify-content: center;}",".profile.card {max-width: clamp(250px, 25vw, 300px); width: 100%;}"],"settings":{"columns":4,"carousel_on_desktop":false,"layout":"default","image_ratio":"portrait","image_ratio_mobile":"portrait","columns_mobile":"1","swipe_on_mobile":true,"heading":"King Salmon Recipes","heading_size":"title-md","heading_alignment":"text-center justify-center","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":60,"padding_bottom":60,"divider":false,"full_width":false,"rounded":false}},"map_LW4PtC":{"type":"map","settings":{"transparent_header":false,"map_address":"Totaranui 7282 New Zealand","map_api_key":"AIzaSyB_I3DlYvmrlYUbo8fKz9ABuxCbZN5PCLY","map_zoom":12,"map_style":"silver","image_height":"650px","content_position":"md:items-end md:justify-start","text_alignment":"left","content_position_mobile":"image_first","image_height_mobile":"400px","text_alignment_mobile":"left","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":""