    "watch_the_bowl": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_id": "watch-the-bowl",
        "liquid": "\n<style>\n  .sea-watch {\n    --ink: #171717;\n    --muted: #5c5c5c;\n    --line: #e5e2dc;\n    --wash: #faf8f4;\n    --gold: #bb8f50;\n    color: var(--ink);\n  }\n  .sea-watch__grid {\n    display: grid;\n    grid-template-columns: minmax(0, 300px) minmax(0, 1fr);\n    gap: 40px;\n    align-items: center;\n  }\n  .sea-watch__player {\n    position: relative;\n    margin: 0;\n    aspect-ratio: 9 / 16;\n    border-radius: 20px;\n    overflow: hidden;\n    background: #111 url(\"{{ 'kayla-dunham-recipe-video-poster.jpg' | file_url }}\") center / cover no-repeat;\n    box-shadow: 0 0 0 1px var(--line), 0 18px 40px -24px rgba(0, 0, 0, .55);\n  }\n  .sea-watch__player video {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    opacity: 0;\n    transition: opacity .35s ease;\n  }\n  .sea-watch__player.is-playing video {\n    opacity: 1;\n  }\n  .sea-watch__play {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border: 0;\n    padding: 0;\n    cursor: pointer;\n    background: linear-gradient(180deg, rgba(0,0,0,.05) 0%, rgba(0,0,0,.35) 100%);\n    transition: opacity .25s ease;\n  }\n  .sea-watch__player.is-playing .sea-watch__play {\n    opacity: 0;\n    pointer-events: none;\n  }\n  .sea-watch__play span {\n    width: 66px;\n    height: 66px;\n    border-radius: 50%;\n    background: rgba(255, 255, 255, .94);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    box-shadow: 0 6px 20px -6px rgba(0, 0, 0, .5);\n    transition: transform .18s ease;\n  }\n  .sea-watch__play:hover span {\n    transform: scale(1.07);\n  }\n  .sea-watch__play svg {\n    width: 22px;\n    height: 22px;\n    margin-left: 3px;\n    fill: var(--ink);\n  }\n  .sea-watch__badge {\n    position: absolute;\n    top: 14px;\n    left: 14px;\n    z-index: 2;\n    font-size: 11px;\n    font-weight: 600;\n    letter-spacing: .12em;\n    text-transform: uppercase;\n    color: #fff;\n    background: rgba(23, 23, 23, .62);\n    backdrop-filter: blur(6px);\n    padding: 6px 11px;\n    border-radius: 999px;\n    pointer-events: none;\n  }\n  .sea-watch__player.is-playing .sea-watch__badge {\n    opacity: 0;\n    transition: opacity .25s ease;\n  }\n  .sea-watch__eyebrow {\n    font-size: 11px;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n    color: var(--gold);\n    font-weight: 600;\n    margin: 0 0 10px;\n  }\n  .sea-watch__heading {\n    font-size: clamp(26px, 3.2vw, 34px);\n    line-height: 1.15;\n    font-weight: 600;\n    margin: 0 0 14px;\n  }\n  .sea-watch__lede {\n    font-size: 16px;\n    line-height: 1.6;\n    color: var(--muted);\n    margin: 0 0 24px;\n    max-width: 54ch;\n  }\n  .sea-watch__chapters {\n    list-style: none;\n    margin: 0 0 26px;\n    padding: 0;\n    border-top: 1px solid var(--line);\n  }\n  .sea-watch__chapters li {\n    display: flex;\n    gap: 16px;\n    align-items: baseline;\n    padding: 11px 0;\n    border-bottom: 1px solid var(--line);\n    font-size: 15px;\n    line-height: 1.45;\n  }\n  .sea-watch__chapters b {\n    flex: 0 0 46px;\n    font-variant-numeric: tabular-nums;\n    font-size: 13px;\n    font-weight: 600;\n    color: var(--gold);\n    letter-spacing: .04em;\n  }\n  .sea-watch__follow {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 11px 20px;\n    border: 1px solid var(--ink);\n    border-radius: 999px;\n    font-size: 15px;\n    font-weight: 600;\n    text-decoration: none;\n    color: var(--ink);\n    background: #fff;\n    transition: background .18s ease, color .18s ease;\n  }\n  .sea-watch__follow:hover {\n    background: var(--ink);\n    color: #fff;\n  }\n  .sea-watch__follow svg {\n    width: 18px;\n    height: 18px;\n  }\n  @media (max-width: 989px) {\n    .sea-watch__grid {\n      grid-template-columns: 1fr;\n      gap: 28px;\n      justify-items: center;\n      text-align: left;\n    }\n    .sea-watch__player {\n      width: min(78vw, 300px);\n    }\n    .sea-watch__body {\n      width: 100%;\n    }\n  }\n</style>\n\n<div class=\"sea-watch\">\n  <div class=\"sea-watch__grid\">\n    <figure class=\"sea-watch__player\" data-sea-video>\n      <span class=\"sea-watch__badge\">0:45</span>\n      <video\n        preload=\"none\"\n        playsinline\n        loop\n        poster=\"{{ 'kayla-dunham-recipe-video-poster.jpg' | file_url }}\"\n        data-src-hd=\"https://cdn.shopify.com/videos/c/vp/694d94e9f3d34f1c885ba1b9613e8d72/694d94e9f3d34f1c885ba1b9613e8d72.HD-720p-4.5Mbps-93227493.mp4\"\n        data-src-sd=\"https://cdn.shopify.com/videos/c/vp/694d94e9f3d34f1c885ba1b9613e8d72/694d94e9f3d34f1c885ba1b9613e8d72.SD-480p-1.5Mbps-93227493.mp4\"\n        aria-label=\"Kayla Dunham makes the hot honey King Salmon bowl\"></video>\n      <button class=\"sea-watch__play\" type=\"button\" aria-label=\"Play the 45 second recipe video\">\n        <span>\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M8 5v14l11-7z\"></path></svg>\n        </span>\n      </button>\n    </figure>\n\n    <div class=\"sea-watch__body\">\n      <p class=\"sea-watch__eyebrow\">Forty-five seconds with Kayla</p>\n      <h2 class=\"sea-watch__heading\">From the tide pools to the table</h2>\n      <p class=\"sea-watch__lede\">The whole thing, start to finish &mdash; a morning at the tide pools, the King Salmon\n        box coming out of the freezer, and lunch on the couch about twenty-five minutes later. Sound on if you want it.</p>\n      <ol class=\"sea-watch__chapters\">\n        <li><b>0:02</b> Low tide on the Westside &mdash; leave it better than you found it</li>\n        <li><b>0:12</b> The King Salmon portion, lab numbers printed right on the pack</li>\n        <li><b>0:17</b> Sea salt, cracked pepper, chili flakes, hot honey</li>\n        <li><b>0:22</b> Ten minutes at 400&deg;F and the honey lacquers over</li>\n        <li><b>0:37</b> Built, carried to the couch, gone</li>\n      </ol>\n      <a class=\"sea-watch__follow\"\n         href=\"https://www.instagram.com/kayladunham/\"\n         target=\"_blank\"\n         rel=\"noopener noreferrer\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n          <rect x=\"2\" y=\"2\" width=\"20\" height=\"20\" rx=\"5\"></rect>\n          <circle cx=\"12\" cy=\"12\" r=\"4\"></circle>\n          <circle cx=\"17.5\" cy=\"6.5\" r=\"1.2\" fill=\"currentColor\" stroke=\"none\"></circle>\n        </svg>\n        <span>Follow @kayladunham</span>\n      </a>\n    </div>\n  </div>\n</div>\n\n<script>\n  (function () {\n    document.querySelectorAll('[data-sea-video]').forEach(function (frame) {\n      var video = frame.querySelector('video');\n      var button = frame.querySelector('.sea-watch__play');\n      if (!video || !button) return;\n\n      button.addEventListener('click', function () {\n        if (!video.currentSrc && !video.src) {\n          // Source media queries are not honoured for video, so pick the rendition here.\n          var wide = window.matchMedia('(min-width: 600px)').matches;\n          video.src = wide ? video.dataset.srcHd : video.dataset.srcSd;\n        }\n        frame.classList.add('is-playing');\n        video.controls = true;\n        var played = video.play();\n        if (played && played.catch) {\n          played.catch(function () {\n            video.muted = true;\n            video.play();\n          });\n        }\n      });\n\n      video.addEventListener('pause', function () {\n        if (video.currentTime === 0 || video.ended) {\n          frame.classList.remove('is-playing');\n          video.controls = false;\n        }\n      });\n    });\n  })();\n</script>\n",
