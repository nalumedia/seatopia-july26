      "blocks": {
        "glance_time": {
          "type": "column",
          "settings": {
            "icon": "time",
            "custom_icon": "",
            "heading": "45 minutes, start to finish",
            "text": "<p>30 minutes of prep — most of which is the salmon marinating hands-off — plus 15 minutes of cooking. Start the rice first and every component finishes at the same time.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "glance_serves": {
          "type": "column",
          "settings": {
            "icon": "users",
            "custom_icon": "",
            "heading": "Serves 3 generously",
            "text": "<p>Two 6 oz salmon portions, 1 cup of dry jasmine rice, and one ripe mango. Everything doubles cleanly — no recalculating the coconut milk ratio.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "glance_heat": {
          "type": "column",
          "settings": {
            "icon": "lightning",
            "custom_icon": "",
            "heading": "400°F for 10–12 minutes",
            "text": "<p>One pan, no flipping, no searing, no splatter. Bake until the salmon flakes with a fork — about 130°F at the thickest point before it rests.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "glance_spice": {
          "type": "column",
          "settings": {
            "icon": "alert",
            "custom_icon": "",
            "heading": "Heat you control",
            "text": "<p>The glaze is 1:1:1 Dijon, honey, and sriracha. Move the sriracha up or down and nothing else in the recipe has to change — see the heat chart below.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
