    "shrimp_note": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_id": "one-loin-four-cuts",
        "liquid": "<style>\n  .sea-pepper {\n    --ink: #171717;\n    --muted: #5c5c5c;\n    --line: #e5e2dc;\n    --wash: #faf8f4;\n    --gold: #bb8f50;\n    color: var(--ink);\n    background: var(--wash);\n    border: 1px solid var(--line);\n    border-radius: 20px;\n    padding: 30px;\n  }\n  .sea-pepper__grid {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) minmax(0, 300px);\n    gap: 34px;\n    align-items: center;\n  }\n  .sea-pepper__eyebrow {\n    font-size: 11px;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n    color: var(--gold);\n    font-weight: 600;\n    margin: 0 0 8px;\n  }\n  .sea-pepper__heading {\n    font-size: clamp(23px, 2.8vw, 30px);\n    line-height: 1.15;\n    font-weight: 600;\n    margin: 0 0 10px;\n  }\n  .sea-pepper__lede {\n    font-size: 15px;\n    line-height: 1.55;\n    color: var(--muted);\n    margin: 0 0 22px;\n  }\n  .sea-pepper__rows {\n    display: grid;\n    gap: 14px;\n  }\n  .sea-pepper__row {\n    background: #fff;\n    border: 1px solid var(--line);\n    border-radius: 14px;\n    padding: 15px 17px;\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) auto;\n    gap: 10px 16px;\n    align-items: center;\n  }\n  .sea-pepper__row--pick {\n    border-color: var(--gold);\n    box-shadow: 0 0 0 1px var(--gold);\n  }\n  .sea-pepper__name {\n    grid-column: 1;\n    margin: 0;\n    font-size: 15px;\n    font-weight: 600;\n    line-height: 1.3;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    flex-wrap: wrap;\n  }\n  .sea-pepper__tag {\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n    color: #fff;\n    background: var(--gold);\n    padding: 3px 8px;\n    border-radius: 999px;\n  }\n  .sea-pepper__meter {\n    grid-column: 2;\n    grid-row: 1;\n    display: flex;\n    gap: 4px;\n    align-items: center;\n  }\n  .sea-pepper__pip {\n    width: 9px;\n    height: 9px;\n    border-radius: 50%;\n    background: #fff;\n    border: 1.5px solid #d8cfc0;\n  }\n  .sea-pepper__pip.is-on {\n    background: #b8462f;\n    border-color: #b8462f;\n  }\n  .sea-pepper__note {\n    grid-column: 1 / -1;\n    margin: 0;\n    font-size: 13.5px;\n    line-height: 1.5;\n    color: var(--muted);\n  }\n  .sea-pepper__legend {\n    margin: 16px 0 0;\n    padding-top: 14px;\n    border-top: 1px solid var(--line);\n    font-size: 13px;\n    line-height: 1.55;\n    color: var(--muted);\n  }\n  .sea-pepper__figure {\n    margin: 0;\n  }\n  .sea-pepper__figure img {\n    width: 100%;\n    height: auto;\n    display: block;\n    border-radius: 16px;\n    box-shadow: 0 14px 34px -22px rgba(0,0,0,.5);\n  }\n  .sea-pepper__cap {\n    margin: 10px 0 0;\n    font-size: 12.5px;\n    line-height: 1.5;\n    color: var(--muted);\n  }\n  @media (max-width: 989px) {\n    .sea-pepper {\n      padding: 22px;\n    }\n    .sea-pepper__grid {\n      grid-template-columns: 1fr;\n      gap: 24px;\n    }\n    .sea-pepper__figure {\n      order: -1;\n    }\n  }\n</style>\n\n<div class=\"sea-pepper\">\n  <div class=\"sea-pepper__grid\">\n\n    <div class=\"sea-pepper__body\">\n      <p class=\"sea-pepper__eyebrow\">One loin, four cuts</p>\n      <h2 class=\"sea-pepper__heading\">The same piece of fish, sliced four ways.</h2>\n      <p class=\"sea-pepper__lede\">\n        Pat the loin dry and work with your sharpest knife, using long single strokes rather than sawing.\n        Cut the neatest pieces first for crudo and nigiri, then the strips for the rolls, and chop whatever\n        is left for the gunkan.\n      </p>\n\n      <div class=\"sea-pepper__rows\">\n      <div class=\"sea-pepper__row\">\n        <p class=\"sea-pepper__name\">\n          <span>Crudo</span>\n          <span class=\"sea-pepper__tag\">Thinnest</span>\n        </p>\n        <div class=\"sea-pepper__meter\" role=\"img\" aria-label=\"Slice thickness: 1 out of 5\">\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        </div>\n        <p class=\"sea-pepper__note\">Long, thin slices across the grain, laid flat on a plate so the soy, sesame and citrus can reach every piece.</p>\n      </div>\n      <div class=\"sea-pepper__row sea-pepper__row--pick\">\n        <p class=\"sea-pepper__name\">\n          <span>Nigiri</span>\n          <span class=\"sea-pepper__tag\">Thin slabs</span>\n        </p>\n        <div class=\"sea-pepper__meter\" role=\"img\" aria-label=\"Slice thickness: 2 out of 5\">\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        </div>\n        <p class=\"sea-pepper__note\">Slices a little thicker, cut at an angle so each one drapes over a small mound of rice.</p>\n      </div>\n      <div class=\"sea-pepper__row\">\n        <p class=\"sea-pepper__name\">\n          <span>Rolls and hand rolls</span>\n          <span class=\"sea-pepper__tag\">Batons</span>\n        </p>\n        <div class=\"sea-pepper__meter\" role=\"img\" aria-label=\"Slice thickness: 4 out of 5\">\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        </div>\n        <p class=\"sea-pepper__note\">Long strips about the width of a finger, to run the length of the roll or the cone.</p>\n      </div>\n      <div class=\"sea-pepper__row\">\n        <p class=\"sea-pepper__name\">\n          <span>Spicy gunkan</span>\n          <span class=\"sea-pepper__tag\">Chopped</span>\n        </p>\n        <div class=\"sea-pepper__meter\" role=\"img\" aria-label=\"Slice thickness: 3 out of 5\">\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        </div>\n        <p class=\"sea-pepper__note\">Trimmings and ends, chopped small and folded into the spicy mayo. Nothing from the loin goes to waste.</p>\n      </div>\n      </div>\n\n      <p class=\"sea-pepper__legend\">\n        The dots show slice thickness, thinnest first. Slice the fish last, right before the table is set,\n        and keep anything you are not using in the fridge.\n      </p>\n    </div>\n\n    <figure class=\"sea-pepper__figure\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0222/9882/0682/files/IMG_4251.jpg?width=700\" alt=\"Slicing a skinless steelhead loin into thin pieces on a wooden board\" width=\"1320\" height=\"2273\" loading=\"lazy\" decoding=\"async\">\n      <figcaption class=\"sea-pepper__cap\">\n        Long, single strokes with a sharp knife give clean edges.\n      </figcaption>\n    </figure>\n\n  </div>\n</div>",
