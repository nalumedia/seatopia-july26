    "faq_shrimp": {
      "type": "faq",
      "blocks": {
        "q_raw": {
          "type": "question",
          "settings": {
            "title": "Can I eat the steelhead raw?",
            "text": "<p>The Steelhead Sashimi Loin is sold for exactly this. Read what sashimi-grade means to us above. Eating raw or undercooked meat, poultry, seafood, shellfish or eggs may increase your risk of foodborne illness, especially with certain medical conditions. Consult your doctor if you think you may be sensitive.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_thaw": {
          "type": "question",
          "settings": {
            "title": "How do I thaw fish I am going to eat raw?",
            "text": "<p>In the refrigerator, in its sealed pack, overnight. Never on the counter or in warm water. Keep it cold until you slice it, and slice it while it is still very cold &mdash; it holds its shape and cuts cleanly. Eat it the day you thaw it.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_rice": {
          "type": "question",
          "settings": {
            "title": "How do I keep the sushi rice from going gummy or hard?",
            "text": "<p>Rinse the rice until the water runs nearly clear before cooking, then fold the seasoning in with a cutting motion rather than stirring. Keep it covered with a damp towel at room temperature. Refrigerated sushi rice turns hard, so make it the same day.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_gunkan": {
          "type": "question",
          "settings": {
            "title": "What is gunkan?",
            "text": "<p>&ldquo;Battleship&rdquo; sushi: an oval of rice wrapped in a tall strip of nori, leaving a little well on top for something loose &mdash; here the spicy salmon. Wet your hands so the rice does not stick, and wrap the nori just before serving so it stays crisp.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_ahead": {
          "type": "question",
          "settings": {
            "title": "What can I make ahead?",
            "text": "<p>The sauces and the cooked shrimp, both kept in the fridge. Make the rice a couple of hours ahead at most and keep it at room temperature. Slice the steelhead last.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_lox": {
          "type": "question",
          "settings": {
            "title": "Can I use the smoked steelhead instead of raw?",
            "text": "<p>In the hand rolls, yes &mdash; Anna uses either. Cold-Smoked Steelhead Lox is ready to eat straight from the pack. It is saltier than raw fish, so go lighter on the soy sauce.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
      "block_order": [
        "q_raw",
        "q_thaw",
        "q_rice",
        "q_gunkan",
        "q_ahead",
        "q_lox"
      ],
