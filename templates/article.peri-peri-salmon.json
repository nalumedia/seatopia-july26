ng: 20px;\n      gap: 16px;\n    }\n    .sea-collab__follow {\n      width: 100%;\n      justify-content: center;\n    }\n    .sea-collab__name {\n      font-size: 19px;\n    }\n  }\n</style>\n\n{%- assign collab_avatar = 'getaway-plate-avatar.jpg' | file_url -%}\n\n<div class=\"sea-collab\">\n  {%- if collab_avatar != blank -%}\n    <div class=\"sea-collab__avatar\">\n      <img src=\"{{ collab_avatar }}\" alt=\"Getaway Plate\" width=\"136\" height=\"136\" loading=\"lazy\" decoding=\"async\">\n    </div>\n  {%- endif -%}\n\n  <div class=\"sea-collab__body\">\n    <p class=\"sea-collab__eyebrow\">Getaway Plate &times; Seatopia</p>\n    <p class=\"sea-collab__name\">Recipe by Getaway Plate</p>\n    <p class=\"sea-collab__role\">Travel-inspired home cooking &mdash; the dishes worth bringing back from somewhere, cooked on an ordinary weeknight</p>\n    <p class=\"sea-collab__cred\">Serves 2 to 4 &middot; 25 minutes of prep, 10 of it marinating &middot; grilled on a sheet pan</p>\n  </div>\n\n  <a class=\"sea-collab__follow\" href=\"https://www.instagram.com/getaway_plate\" target=\"_blank\" rel=\"noopener noreferrer\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n      <rect x=\"2\" y=\"2\" width=\"20\" height=\"20\" rx=\"5\"></rect>\n      <circle cx=\"12\" cy=\"12\" r=\"4\"></circle>\n      <circle cx=\"17.5\" cy=\"6.5\" r=\"1.2\" fill=\"currentColor\" stroke=\"none\"></circle>\n    </svg>\n    <span>Follow</span>\n  </a>\n</div>\n",
