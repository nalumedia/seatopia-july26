    "faq": {
      "type": "faq",
      "blocks": {
        "q_thaw": {
          "type": "question",
          "settings": {
            "title": "How do I thaw the shrimp?",
            "text": "<p>Move the bag to the fridge the night before. Once thawed, peel the shrimp, pull off the tails so the rolls are easy to eat, and pat them dry. They arrive already deveined.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_done": {
          "type": "question",
          "settings": {
            "title": "How do I know the shrimp are cooked?",
            "text": "<p>They curl into a C and turn pink and opaque all the way through, usually in 2&ndash;3 minutes at a gentle simmer. Move them straight into ice water so they stop cooking.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_tear": {
          "type": "question",
          "settings": {
            "title": "Why does my rice paper tear?",
            "text": "<p>It was soaked too long. Dip each sheet for only 2&ndash;3 seconds, until just pliable: it keeps softening on the board. Roll on a damp cutting board, leave about 2 inches clear on every side, and keep a few extra sheets on hand.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_ahead": {
          "type": "question",
          "settings": {
            "title": "Can I make them ahead?",
            "text": "<p>Poach the shrimp, cook the noodles, cut the vegetables and mix the sauce up to a day ahead, and store each separately in the fridge. Roll close to serving time.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_hold": {
          "type": "question",
          "settings": {
            "title": "How long do rolled rolls keep?",
            "text": "<p>About 2 hours at room temperature under a damp towel. Keep them from touching, or they stick together and tear.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_sauce": {
          "type": "question",
          "settings": {
            "title": "My sauce got thick. What do I do?",
            "text": "<p>It thickens as it sits. Whisk in a splash of hot water just before serving.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
      "block_order": [
        "q_thaw",
        "q_done",
        "q_tear",
        "q_ahead",
