    "faq": {
      "type": "faq",
      "blocks": {
        "q_who": {
          "type": "question",
          "settings": {
            "title": "<strong>Who sees my results?</strong>",
            "text": "<p>Your results are private to you in your Seatopia account.</p>"
          }
        },
        "q_register": {
          "type": "question",
          "settings": {
            "title": "<strong>Already mailed your sample but didn’t register?</strong>",
            "text": "<p>Register now with the barcode on your kit so the lab can match it, on our <a href=\"/pages/omegaindex\">Omega Index page</a>.</p>"
          }
        },
        "q_barcode": {
          "type": "question",
          "settings": {
            "title": "<strong>Lost your barcode?</strong>",
            "text": "<p>Contact us at <a href=\"mailto:nemo@seatopia.fish\">nemo@seatopia.fish</a> and we’ll help you locate it.</p>"
          }
        },
        "q_when": {
          "type": "question",
          "settings": {
            "title": "<strong>When should I retest?</strong>",
            "text": "<p>Your first result is a baseline. Red blood cells live about 120 days, so your Omega-3 Index reflects roughly the past 3–4 months. Take it, change one thing, retest in four months.</p>"
          }
        }
      },
