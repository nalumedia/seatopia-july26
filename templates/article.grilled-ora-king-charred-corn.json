            "custom_icon": "",
            "heading": "About 45 minutes",
            "text": "<p>Ten minutes to get the grill to 450&deg;F, fifteen for the vegetables and salsa, and about 8 for the salmon.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "g_serves": {
