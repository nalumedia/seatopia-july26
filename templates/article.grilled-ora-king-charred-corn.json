    "faq": {
      "type": "faq",
      "blocks": {
        "q_thaw": {
          "type": "question",
          "settings": {
            "title": "How do I thaw the salmon?",
            "text": "<p>Move the fillets to the fridge the night before. Take them out of the packaging and pat them dry before you oil and salt them.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_done": {
          "type": "question",
          "settings": {
            "title": "How do I know the salmon is done?",
            "text": "<p>After 3&ndash;4 minutes a side it should be browned outside and just flake at the thickest part. The FDA conservatively suggests cooking fish to an internal temperature of 145&deg;F. Eating raw or undercooked seafood may increase your risk of foodborne illness, especially with certain medical conditions.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_tear": {
          "type": "question",
          "settings": {
            "title": "Can I make it without a grill?",
            "text": "<p>Yes. Cook the vegetables and the salmon in a pan on the stove, preferably cast iron or stainless steel.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_ahead": {
          "type": "question",
          "settings": {
            "title": "Can I meal prep it?",
            "text": "<p>Yes. Store extras in the fridge for up to 3 days, with the vinaigrette in its own jar. It’s good cold, so no need to reheat.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_hold": {
          "type": "question",
          "settings": {
            "title": "Will another salmon work?",
            "text": "<p>Any Seatopia salmon fillet works. Thinner fillets cook faster, so start checking a minute sooner on each side.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_sauce": {
          "type": "question",
          "settings": {
            "title": "Why skin side up first?",
            "text": "<p>It gives the top a good sear while the fillet firms up, so it’s easier to flip in one piece.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
      "block_order": [
        "q_thaw",
        "q_done",
        "q_tear",
        "q_ahead",
        "q_hold",
        "q_sauce"
      ],
