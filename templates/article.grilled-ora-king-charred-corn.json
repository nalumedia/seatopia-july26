            "icon": "users",
            "custom_icon": "",
            "heading": "Serves 3",
            "text": "<p>Three fillets of our King Salmon, one per plate, over the salsa with greens and avocado on the side.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "g_rice": {
          "type": "column",
          "settings": {
            "icon": "heart",
            "custom_icon": "",
            "heading": "Grill or stovetop",
            "text": "<p>Jason cooks over an open fire. A cast iron or stainless pan on the stove works for everything.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
