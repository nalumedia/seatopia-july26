    "heat_note": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_id": "how-it-comes-together",
        "liquid": "<style>\n  .sea-pepper {\n    --ink: #171717;\n    --muted: #5c5c5c;\n    --line: #e5e2dc;\n    --wash: #faf8f4;\n    --gold: #bb8f50;\n    color: var(--ink);\n    background: var(--wash);\n    border: 1px solid var(--line);\n    border-radius: 20px;\n    padding: 30px;\n  }\n  .sea-pepper__grid {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) minmax(0, 300px);\n    gap: 34px;\n    align-items: center;\n  }\n  .sea-pepper__eyebrow {\n    font-size: 11px;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n    color: var(--gold);\n    font-weight: 600;\n    margin: 0 0 8px;\n  }\n  .sea-pepper__heading {\n    font-size: clamp(23px, 2.8vw, 30px);\n    line-height: 1.15;\n    font-weight: 600;\n    margin: 0 0 10px;\n  }\n  .sea-pepper__lede {\n    font-size: 15px;\n    line-height: 1.55;\n    color: var(--muted);\n    margin: 0 0 22px;\n  }\n  .sea-pepper__rows {\n    display: grid;\n    gap: 14px;\n  }\n  .sea-pepper__row {\n    background: #fff;\n    border: 1px solid var(--line);\n    border-radius: 14px;\n    padding: 15px 17px;\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) auto;\n    gap: 10px 16px;\n    align-items: center;\n  }\n  .sea-pepper__row--pick {\n    border-color: var(--gold);\n    box-shadow: 0 0 0 1px var(--gold);\n  }\n  .sea-pepper__name {\n    grid-column: 1;\n    margin: 0;\n    font-size: 15px;\n    font-weight: 600;\n    line-height: 1.3;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    flex-wrap: wrap;\n  }\n  .sea-pepper__tag {\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n    color: #fff;\n    background: var(--gold);\n    padding: 3px 8px;\n    border-radius: 999px;\n  }\n  .sea-pepper__meter {\n    grid-column: 2;\n    grid-row: 1;\n    display: flex;\n    gap: 4px;\n    align-items: center;\n  }\n  .sea-pepper__pip {\n    width: 9px;\n    height: 9px;\n    border-radius: 50%;\n    background: #fff;\n    border: 1.5px solid #d8cfc0;\n  }\n  .sea-pepper__pip.is-on {\n    background: #b8462f;\n    border-color: #b8462f;\n  }\n  .sea-pepper__note {\n    grid-column: 1 / -1;\n    margin: 0;\n    font-size: 13.5px;\n    line-height: 1.5;\n    color: var(--muted);\n  }\n  .sea-pepper__legend {\n    margin: 16px 0 0;\n    padding-top: 14px;\n    border-top: 1px solid var(--line);\n    font-size: 13px;\n    line-height: 1.55;\n    color: var(--muted);\n  }\n  .sea-pepper__figure {\n    margin: 0;\n  }\n  .sea-pepper__figure img {\n    width: 100%;\n    height: auto;\n    display: block;\n    border-radius: 16px;\n    box-shadow: 0 14px 34px -22px rgba(0,0,0,.5);\n  }\n  .sea-pepper__cap {\n    margin: 10px 0 0;\n    font-size: 12.5px;\n    line-height: 1.5;\n    color: var(--muted);\n  }\n  @media (max-width: 989px) {\n    .sea-pepper {\n      padding: 22px;\n    }\n    .sea-pepper__grid {\n      grid-template-columns: 1fr;\n      gap: 24px;\n    }\n    .sea-pepper__figure {\n      order: -1;\n    }\n  }\n  .sea-pepper__step {\n    grid-column: 2;\n    grid-row: 1;\n    font-size: 11px;\n    font-weight: 600;\n    letter-spacing: .1em;\n    text-transform: uppercase;\n    color: var(--gold);\n  }\n  .sea-pepper__figure video {\n    width: 100%;\n    height: auto;\n    aspect-ratio: 9 / 16;\n    object-fit: cover;\n    display: block;\n    border-radius: 16px;\n    background: #e9e4dc;\n    box-shadow: 0 14px 34px -22px rgba(0,0,0,.5);\n  }\n</style>\n\n<div class=\"sea-pepper\">\n  <div class=\"sea-pepper__grid\">\n\n    <div class=\"sea-pepper__body\">\n      <p class=\"sea-pepper__eyebrow\">How it comes together</p>\n      <h2 class=\"sea-pepper__heading\">Vegetables first, salmon last.</h2>\n      <p class=\"sea-pepper__lede\">\n        Make the vinaigrette before you light the grill, so it has time to sit while everything chars.\n      </p>\n\n      <div class=\"sea-pepper__rows\">\n      <div class=\"sea-pepper__row\">\n        <p class=\"sea-pepper__name\">\n          <span>Make the vinaigrette</span>\n          <span class=\"sea-pepper__tag\">2 minutes</span>\n        </p>\n        <span class=\"sea-pepper__step\">Step 1</span>\n        <p class=\"sea-pepper__note\">Cilantro, garlic, olive oil, lime juice, oregano, chili flakes and salt, stirred together in a small jar.</p>\n      </div>\n      <div class=\"sea-pepper__row\">\n        <p class=\"sea-pepper__name\">\n          <span>Heat the grill</span>\n          <span class=\"sea-pepper__tag\">To 450&deg;F</span>\n        </p>\n        <span class=\"sea-pepper__step\">Step 2</span>\n        <p class=\"sea-pepper__note\">Get the grill hot before anything goes on: vegetables first, salmon last.</p>\n      </div>\n      <div class=\"sea-pepper__row\">\n        <p class=\"sea-pepper__name\">\n          <span>Char the vegetables</span>\n          <span class=\"sea-pepper__tag\">5&ndash;7 minutes</span>\n        </p>\n        <span class=\"sea-pepper__step\">Step 3</span>\n        <p class=\"sea-pepper__note\">Corn rubbed with oil and paprika, the poblano and the green onions, turned until charred evenly.</p>\n      </div>\n      <div class=\"sea-pepper__row\">\n        <p class=\"sea-pepper__name\">\n          <span>Saut&eacute; the zucchini</span>\n          <span class=\"sea-pepper__tag\">About 5 minutes</span>\n        </p>\n        <span class=\"sea-pepper__step\">Step 4</span>\n        <p class=\"sea-pepper__note\">In a cast iron or stainless pan set on the grill, with a tablespoon of oil, salt and pepper.</p>\n      </div>\n      <div class=\"sea-pepper__row\">\n        <p class=\"sea-pepper__name\">\n          <span>Build the salsa</span>\n          <span class=\"sea-pepper__tag\">5 minutes</span>\n        </p>\n        <span class=\"sea-pepper__step\">Step 5</span>\n        <p class=\"sea-pepper__note\">Corn cut off the cob, poblano and green onions chopped, then tossed with the zucchini, tomatoes, oil and lime.</p>\n      </div>\n      <div class=\"sea-pepper__row sea-pepper__row--pick\">\n        <p class=\"sea-pepper__name\">\n          <span>Grill the salmon</span>\n          <span class=\"sea-pepper__tag\">6&ndash;8 minutes</span>\n        </p>\n        <span class=\"sea-pepper__step\">Step 6</span>\n        <p class=\"sea-pepper__note\">Patted dry, oiled and salted, skin side up for 3&ndash;4 minutes, flipped for 3&ndash;4 more, then a squeeze of lemon.</p>\n      </div>\n      <div class=\"sea-pepper__row\">\n        <p class=\"sea-pepper__name\">\n          <span>Plate it</span>\n          <span class=\"sea-pepper__tag\">2 minutes</span>\n        </p>\n        <span class=\"sea-pepper__step\">Step 7</span>\n        <p class=\"sea-pepper__note\">Salsa down, salmon on top, greens and avocado alongside, and the vinaigrette spooned over everything.</p>\n      </div>\n      </div>\n\n      <p class=\"sea-pepper__legend\">\n        No grill? Cook the vegetables and the salmon in a cast iron or stainless pan on the stove.\n      </p>\n    </div>\n\n    {%- comment -%} Silent copy of Jason's reel. The original voiceover makes a red health claim about omega-3s (claims guide §4.G), so only this audio-free upload is used. Do not swap in the original. {%- endcomment -%}\n    <figure class=\"sea-pepper__figure\">\n      <video class=\"sea-pepper__loop\" muted loop playsinline preload=\"none\" disablepictureinpicture disableremoteplayback\n        poster=\"https://cdn.shopify.com/s/files/1/0222/9882/0682/files/pabst-grilled-salmon-step-7-grill-the-salmon-option-3.jpg?width=700\" width=\"606\" height=\"1080\"\n        data-src=\"https://cdn.shopify.com/videos/c/vp/50073e240b794066a77bf013799a4d55/50073e240b794066a77bf013799a4d55.HD-720p-2.1Mbps-100879207.mp4\"\n        aria-label=\"Jason grilling corn, peppers and king salmon over a fire by a creek, then plating it on charred corn salsa\"></video>\n      <figcaption class=\"sea-pepper__cap\">\n        Jason cooks it start to finish by the creek.\n      </figcaption>\n    </figure>\n\n  </div>\n</div>\n\n<script>\n  (function () {\n    var v = document.querySelector('.sea-pepper__loop');\n    if (!v) return;\n    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;\n    var start = function () {\n      if (!v.src) v.src = v.getAttribute('data-src');\n      var p = v.play();\n      if (p && p.catch) p.catch(function () {});\n    };\n    if (!('IntersectionObserver' in window)) { start(); return; }\n    new IntersectionObserver(function (entries) {\n      entries.forEach(function (e) { if (e.isIntersecting) { start(); } else if (v.src) { v.pause(); } });\n    }, { rootMargin: '200px' }).observe(v);\n  })();\n</script>\n",
