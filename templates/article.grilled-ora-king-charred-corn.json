    "rich_text_intro": {
      "type": "rich-text",
      "blocks": {
        "text_intro": {
          "type": "text",
          "settings": {
            "text": "<p>Rich, flaky Ōra King salmon grilled over the fire, with a charred corn salsa and a cilantro lime vinaigrette.</p><p>The corn, poblano and green onions char right on the grate, then get tossed with zucchini, cherry tomatoes and lime. The smoky, bright salsa and the zesty vinaigrette cut through the richness of the salmon.</p>",
            "text_size": "subtext-md",
            "text_max_size": 32,
            "text_font": "body",
            "secondary_color": false,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
