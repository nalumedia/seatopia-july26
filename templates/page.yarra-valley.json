hlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["heading_PMBeRc"],"custom_css":[],"settings":{"text_alignment":"left","text_alignment_mobile":"center","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":60,"padding_bottom":32,"divider":false,"narrow":false,"rounded":false}},"rich_text_ENwwLT":{"type":"rich-text","blocks":{"text_aXfMMX":{"type":"text","settings":{"text":"<p>At Yarra Valley, Atlantic salmon are raised with care in spring-fed waters at the foot of Australia’s Victorian Alps. Known for producing some of the finest roe in the world, the farm’s success lies in slow, hands-on aquaculture and a deep respect for animal welfare. Fish are hand-milked once annually, returned to spawn again, yielding caviar with vibrant pearls, clean brine, and delicate pop. Whether savored by the spoonful or served over scrambled eggs or oysters, this is roe with unmistakable freshness and a traceable story of craftsmanship from river to tin.<\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["text_aXfMMX"],"settings":{"custom-class":"","section_id":"","text_alignment":"left","text_alignment_mobile":"center","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":60,"divider":false,"narrow":false,"rounded":false}},"collage_DpiTir":{"type":"collage","blocks":{"image_j3jWR4":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/Screen_Shot_2025-07-01_at_8.40.25_PM.png","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}},"image_7fiqzh":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/Screen_Shot_2025-07-01_at_8.46.20_PM.png","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}},"image_KxrKPV":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/yarra-valley-first-harvest-salmon-caviar-30g-365244.png","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}},"image_b7LfNg":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/yarra-valley-first-harvest-salmon-caviar-30g-360055.png","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}}},"block_order":["image_j3jWR4","image_7fiqzh","image_KxrKPV","image_b7LfNg"],"settings":{"heading":"Hand Harvested, Traditionally Raised","heading_size":"title-md","heading_alignment":"text-center md:items-center","heading_tag":"h2","subheading":"","description":"<p>Yarra Valley Caviar operates in the cool-climate high country of southeastern Australia, near the headwaters of the Rubicon River. Here, oxygen-rich spring water flows from alpine streams into gravity-fed raceways and ponds. Surrounded by eucalyptus forests and misty hills, the farm enjoys ideal growing conditions: clean water, moderate temperatures, and isolation from pollutants or urban runoff. The location’s  ecosystem not only supports exceptional fish health it shapes the flavor and clarity of the roe itself. <\/p>","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":0,"divider":false,"full_width":false,"rounded":false,"enable_parallax":true}},"video_with_text_FUAJfD":{"type":"video-with-text","blocks":{"heading_3hdhjW":{"type":"heading","settings":{"heading":"Artisan Aquaculture by Design","heading_size":"title-md","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_KKca6r":{"type":"text","settings":{"text":"<p>Yarra Valley Caviar is run by a team of devoted aquaculturists who blend traditional methods with modern precision. With decades of experience and an ethos rooted in respect for the fish, the land, and the consumer they’ve earned the trust of top chefs and sustainability advocates alike. The team handles each fish by hand throughout its life, carefully observing seasonal rhythms and prioritizing quality over yield. Their commitment to ethical husbandry is perhaps best seen in their harvesting technique: a gentle hand-milking process that leaves the fish alive and thriving for future seasons.<\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"button_Kx44Ar":{"type":"button","disabled":true,"settings":{"button_label":"Button label","button_link":"","button_style":"primary","button_size":"md","button_external":false,"button_icon":true}}},"block_order":["heading_3hdhjW","text_KKca6r","button_Kx44Ar"],"settings":{"video_url":"https:\/\/www.youtube.com\/watch?v=8M9Wzuqichw","cover_image":"shopify:\/\/shop_images\/yarra-valley-golden-pearls-brook-trout-roe-30g-tin-827771.png","description":"","enable_video_autoplay":false,"enable_video_looping":false,"image_height":"adapt","video_width":"medium","layout":"video_first","text_alignment":"left","content_position":"align-self-center","video_url_mobile":"","image_height_mobile":"auto","text_alignment_mobile":"left","color_text":"","color_background":"","gradient_background":"","color_background_2":"","gradient_background_2":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":72,"padding_bottom":72,"divider":false,"full_width":false,"rounded":false,"enable_parallax":false,"parallax_direction":"vertical"}},"image_with_text_overlay_tC8T8E":{"type":"image-with-text-overlay","settings":{"section_id":"","transparent_header":false,"image":"shopify:\/\/shop_images\/Screen_Shot_2025-07-01_at_8.51.31_PM.png","image_height":"850px","content_width":"small","content_position":"md:items-center md:justify-center","text_alignment":"left","image_height_mobile":"auto","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","color_text":"#ffffff","color_highlight":"#e0a580","gradient_highlight":"","color_button_text":"#171717","color_button_background":"#ffffff","color_button_gradient":"","color_overlay":"#171717","overlay_opacity":70,"padding_top":0,"padding_bottom":0,"divider":false,"full_width":true,"rounded":false,"enable_parallax":true,"narrow":false,"parallax_direction":"vertical"}},"featured_collection_PeAA7p":{"type":"featured-collection","custom_css":["\/* Center and limit the size of product tiles *\/.card-grid {display: flex; flex-wrap: wrap; justify-content: center; gap: 2rem; \/* Adjust spacing between tiles *\/ margin: 0 auto; padding: 1rem;}"," \/* Restrict individual product card width *\/.card-grid .product-card {max-width: 280px; \/* Or 240px for tighter grid *\/ flex: 1 1 240px;}"," \/* Optional: center content inside each product card *\/"],"settings":{"collection":"","products":["lab-tested-salmon-roe-caviar"],"product_limit":6,"columns":4,"carousel_on_desktop":true,"show_view_all":false,"columns_mobile":"1","swipe_on_mobile":true,"heading":"Atlantic Salmon Roe","heading_size":"title-md","heading_alignment":"text-center md:items-center","heading_tag":"h2","subheading":"from Yarra Valley","description":"<p>Yarra Valley Caviar raises <em>Oncorhynchus mykiss<\/em> (rainbow trout) and <em>Salmo salar<\/em> (Atlantic salmon), both species renowned for their adaptability to cold, clean freshwater systems and for producing high-quality roe. Rainbow trout, native to North America, thrive in high-flow systems and develop roe with brilliant color and subtle sweetness. Atlantic salmon, originally from the North Atlantic, grow well in the region’s cooler ponds and yield larger, firmer pearls with a rich, briny flavor. Both species are perfectly suited to aquaculture here. Hardy, fast-growing, and gentle on the environment when farmed correctly.<\/p>","highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":60,"padding_bottom":32,"divider":false,"full_width":false,"rounded":false}},"rich_text_tYfEAp":{"type":"rich-text","blocks":{"heading_zMMcwg":{"type":"heading","settings":{"heading":"Traditional Methods and Commitment to Environmental Focus","heading_size":"title-lg tracking-heading","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_Lbgpq6":{"type":"text","settings":{"text":"","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"button_JKJaFE":{"type":"button","disabled":true,"settings":{"button_label":"Button label","button_link":"","button_style":"primary","button_size":"md","button_external":false,"button_icon":true}}},"block_order":["heading_zMMcwg","text_Lbgpq6","button_JKJaFE"],"settings":{"custom-class":"","section_id":"","text_alignment":"center","text_alignment_mobile":"left","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":32,"divider":false,"narrow":true,"rounded":false}},"rich_text_fDqEkm":{"type":"rich-text","blocks":{"text_e9xqD8":{"type":"text","settings":{"text":"<p>The fish at Yarra Valley Caviar are raised on a carefully formulated feed designed to support fish health, roe quality, and responsible aquaculture practices. The diet includes responsibly sourced marine ingredients, plant-based nutrients, vitamins, and essential oils, and is produced under globally recognized feed safety and quality standards.<br\/>The feed is formulated without added growth hormones and without the routine use of antibiotics.<br\/>The farm uses naturally flowing water systems designed to minimize energy use while maintaining exceptional water quality. Fish are monitored closely and only milked when the roe reaches peak maturity, helping preserve the texture, integrity, and flavor of the caviar.<br\/><br\/>This patient, low-intervention approach reflects Yarra Valley Caviar’s commitment to quality, animal welfare, and long-term environmental stewardship.<\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["text_e9xqD8"],"settings":{"custom-class":"","section_id":"","text_alignment":"left","text_alignment_mobile":"center","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":40,"divider":false,"narrow":true,"rounded":false}},"custo