    "faq": {
      "type": "faq",
      "blocks": {
        "q_cook": {
          "type": "question",
          "settings": {
            "title": "Do I need to cook the trout?",
            "text": "<p>No. Our Smoked Trout is hot-smoked and ready to eat. It warms through in the oven with the eggs, and the flakes you save for the top go on cold.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_eggs": {
          "type": "question",
          "settings": {
            "title": "How do I know when the eggs are done?",
            "text": "<p>When the whites are opaque and just set and the yolks still have a gentle wobble. Check at 7 minutes and take the skillet out as soon as they get there, because the hot cast iron keeps cooking them. Eating raw or undercooked meat, poultry, seafood, shellfish or eggs may increase your risk of foodborne illness, especially with certain medical conditions. If you prefer firm yolks, give it a few more minutes.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_roe": {
          "type": "question",
          "settings": {
            "title": "How do I thaw the salmon roe?",
            "text": "<p>The tins arrive frozen. Defrost the tin under cool running water before opening, then keep it in the fridge until you need it. Serve it with a non-metallic spoon, add it at the very end so it keeps its pop, and eat an opened tin within 5 days.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_pan": {
          "type": "question",
          "settings": {
            "title": "What if I don&rsquo;t have a cast-iron skillet?",
            "text": "<p>Any 10-inch ovenproof skillet works. Cast iron holds the most heat, so in a lighter pan the eggs may need a minute or two longer.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_ahead": {
          "type": "question",
          "settings": {
            "title": "Can I prep anything ahead?",
            "text": "<p>Dice the potatoes and chop the shallot, garlic and herbs ahead, and thaw the trout and the roe in the fridge the day before. The skillet itself is best cooked and served straight away.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_more": {
          "type": "question",
          "settings": {
            "title": "How do I make it for four?",
            "text": "<p>Double everything and use two skillets, or a 12-inch skillet with eight eggs. Keep the potatoes in an even layer so they still crisp.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
      "block_order": [
        "q_cook",
        "q_eggs",
        "q_roe",
        "q_pan",
        "q_ahead",
        "q_more"
      ],
