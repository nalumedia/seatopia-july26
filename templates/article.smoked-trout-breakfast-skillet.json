    "meal_prep": {
      "type": "image-with-text",
      "blocks": {
        "m_sub": {
          "type": "subheading",
          "settings": {
            "subheading": "Fold it in gently",
            "subheading_size": "subtitle-md",
            "secondary_color": true
          }
        },
        "m_head": {
          "type": "heading",
          "settings": {
            "heading": "Keep the trout in large flakes",
            "heading_size": "title-md",
            "heading_tag": "h2",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "m_text": {
          "type": "text",
          "settings": {
            "text": "<p>Our Smoked Trout is hot-smoked and ready to eat, so it only needs to warm through. Thaw it in the fridge overnight, lift the fillet away from the skin, and break it by hand into big pieces. Take the skillet off the heat before you fold it in, and go gently so it stays in flakes. Save a few to scatter on top at the end: they keep their delicate texture and smoky flavor.</p>",
            "text_size": "subtext-md",
            "text_max_size": 32,
            "text_font": "body",
            "secondary_color": false,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "m_btn": {
          "type": "button",
          "settings": {
