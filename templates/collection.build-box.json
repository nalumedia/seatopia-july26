bf8511eee5d19f65b58bb7b22e2e2d18da0d923.png","image_2":"shopify:\/\/shop_images\/13790a30cb3194acbd14d8d220cc50792178cdcb.png","image_3":"shopify:\/\/shop_images\/f88a9485a6af58ac72bcc50b08501620906af330_1.png","image_4":"shopify:\/\/shop_images\/5730a625ef10deb6ffae6019f943a8276bcfd9cc.png","image_5":"shopify:\/\/shop_images\/media-element_Picture.png","image_height_mobile":"500px","content_position_mobile":"items-center justify-start","text_alignment_mobile":"left","color_text":"#ffffff","color_highlight":"#e0a580","gradient_highlight":"","color_button_text":"#171717","color_button_background":"#ffffff","color_button_gradient":"","color_overlay":"#171717","overlay_opacity":100,"padding_top":0,"padding_bottom":0,"divider":false,"full_width":true,"rounded":true,"enable_parallax":false}},"recently-viewed":{"type":"recently-viewed","disabled":true,"settings":{"product_limit":6,"columns":4,"carousel_on_desktop":true,"columns_mobile":"1","swipe_on_mobile":true,"heading":"Recently Viewed","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"","highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":72,"padding_bottom":80,"divider":false,"full_width":false,"rounded":true}},"empty_space_3YHEPC":{"type":"empty-space","name":"t:sections.empty-space.presets.name","settings":{"desktop_height":60,"mobile_height":32,"color_background":"","gradient_background":""}},"rich_text_Exb8XA":{"type":"rich-text","blocks":{"heading_6FDNA4":{"type":"heading","settings":{"heading":"Half of the world's seafood comes from farms - only a fraction of a fraction meets the  Seatopia Standard™","heading_size":"title-lg tracking-heading","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_DEPbbN":{"type":"text","settings":{"text":"<p>Seatopia is the only seafood company in the world that lab tests to ensure your seafood is omega rich, mercury safe, free from detectable microplastics. <\/p><p>We lab test all our seafood products (a product is any piece of seafood that you purchase from Seatopia to enjoy at home) to ensure that it meets <a href=\"https:\/\/seatopia.fish\/pages\/why-clean-seafood-matters\" title=\"https:\/\/seatopia.fish\/pages\/why-clean-seafood-matters\">the Seatopia Standard<\/a>. We believe that testing provides transparency, accountability, and most importantly piece of mind so that you can enjoy delicious seafood at home. <a href=\"https:\/\/seatopia.fish\/pages\/why-clean-seafood-matters\" title=\"https:\/\/seatopia.fish\/pages\/why-clean-seafood-matters\">Learn more about our testing commitment<\/a>. <\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"button_j77WEP":{"type":"button","disabled":true,"settings":{"button_label":"Button label","button_link":"","button_style":"primary","button_size":"md","button_external":false,"button_icon":true}}},"block_order":["heading_6FDNA4","text_DEPbbN","button_j77WEP"],"name":"t:sections.rich-text.presets.name","settings":{"custom-class":"","text_alignment":"left","text_alignment_mobile":"left","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":20,"padding_bottom":0,"divider":false,"narrow":true,"rounded":false}},"custom_liquid_ah9y9X":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"liquid":"<iframe src=\"https:\/\/app.lightlabs.com\/comprehensive-testing-report\/83\/636\" style=\"width: 100%; height: 800px; border: none;\"><\/iframe>","color_text":"","color_background":"","gradient_background":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":72,"padding_bottom":72,"divider":false,"narrow":false,"rounded":false}},"faq_FEA9Ab":{"type":"faq","blocks":{"question_fVCt4D":{"type":"question","settings":{"title":"Is Seatopia seafood fresh or frozen?","text":"<p>Every box is shipped snap frozen guaranteed direct to your door. We work closely with our farm partners to ensure our seafood is some of the freshest you can buy. Blast freezing at peak freshness makes for perfect texture and taste. <\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_PgWWHc":{"type":"question","settings":{"title":"Do I have to be home for delivery?","text":"<p>No you do not! We deliver in an insulated box with the optimal amount of dry ice so that your seafood remains frozen until at least the end of your delivery day. You will receive notifications when your seafood is delivered.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_edN94K":{"type":"question","settings":{"title":"I love it! What are the portion sizes?","text":"<p>Portions are individually sealed so they can be enjoyed over time. Portions sizes are listed on the individual products. <\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_pLXnV8":{"type":"question","settings":{"title":"Amazing! How long does seafood last in the freezer?","text":"<p>Properly frozen seafood can last <strong>months<\/strong> in the freezer, but quality depends on the species and how it’s packed. At Seatopia, our seafood is snap-frozen and vacuum-sealed at peak freshness — preserving texture, flavor, and nutrients.<\/p><p>Fatty fish like (like salmon, steelhead, kingfish): Best within <strong>2–3 months<\/strong><\/p><p>Lean white fish (like barramundi, branzino, bream): Best within <strong>6–8 months<\/strong><br\/><\/p><p>Shellfish (like shrimp, scallops): Best within <strong>3–6 months<\/strong><br\/><\/p><p>Smoked seafood:  Enjoy within <strong>1–2 months<\/strong><br\/>For maximum quality, keep your freezer at <strong>0°F or below<\/strong> and avoid repeated thawing and refreezing. While frozen seafood stays safe indefinitely, we recommend enjoying it within these windows for the best flavor and texture.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["question_fVCt4D","question_PgWWHc","question_edN94K","question_pLXnV8"],"name":"t:sections.faq.presets.name","settings":{"style":"with-border","heading":"Frequently Asked Questions","heading_size":"title-md","heading_alignment":"text-center md:items-center","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","color_overlay":"#ffffff","overlay_opacity":4,"padding_top":0,"padding_bottom":72,"divider":false,"narrow":true,"rounded":false}},"blog_posts_fhpxkV":{"type":"blog-posts","name":"t:sections.blog-posts.presets.name","settings":{"blog":"seafood-recipes","post_limit":3,"columns":3,"carousel_on_desktop":false,"show_view_all":false,"columns_mobile":"1","swipe_on_mobile":true,"image_ratio":"square","show_tags":false,"show_date":false,"show_comments":false,"show_author":false,"show_excerpt":false,"heading":"Gourmet Seafood Recipes","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"","highlighted_text":"none","highlighted_