        "s_sear": {
          "type": "content",
          "settings": {
            "image": "shopify://shop_images/IMG_5335_53f4c8bb-a677-48fb-af2a-2728757bbcc4.heic",
            "subheading": "Step 5",
            "heading": "Crisp the fish in a second skillet",
            "heading_tag": "h3",
            "text": "<p>Avocado oil in a separate skillet over medium-high until glossy. Fish skin-side down, pressed gently with a spatula for the first few seconds so the skin does not buckle. Cook without moving until the skin is golden and crisp, then lift it out.</p>",
            "button_label": "",
            "button_link": "",
