mage":"shopify:\/\/shop_images\/Caleta_bay_Steelhead_Sahimi.jpg","image_ratio":"adapt","content_position":"md:items-start md:justify-end","text_alignment":"right","image_ratio_mobile":"portrait","content_position_mobile":"items-start justify-end","text_alignment_mobile":"right","highlighted_text":"text","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"#fde047","gradient_highlight":"","color_overlay":"#000000","overlay_opacity":40}},"image_Y438TK":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":true,"image":"shopify:\/\/shop_images\/seatopia-sushi-date-night-box-11_6bae8f18-4cdf-4dc2-bfaf-61ca180a624e.jpg","image_ratio":"square","content_position":"md:items-end md:justify-end","text_alignment":"right","image_mobile":"shopify:\/\/shop_images\/gumusdoga-branzino-6oz-filet-683087.webp","image_ratio_mobile":"landscape","content_position_mobile":"items-end justify-end","text_alignment_mobile":"right","highlighted_text":"text","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"#fde047","gradient_highlight":"","color_overlay":"#000000","overlay_opacity":40}}},"block_order":["image_FTThdx","image_qH7QeL","image_xkYmWL","image_Y438TK"],"settings":{"heading":"Delicious seafood that meets the Seatopia Standard™","heading_size":"title-sm","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h3","subheading":"","description":"<p>Seatopia is the only seafood company in the world that lab tests to ensure your seafood is omega rich, mercury safe, free from detectable microplastics.<\/p><p>We lab test all our seafood products (a product is any piece of seafood that you purchase from Seatopia to enjoy at home) to ensure that it meets the Seatopia Standard. We believe that testing provides transparency, accountability, and most importantly piece of mind.<\/p>","button_label":"","button_link":"shopify:\/\/collections\/add-ons-1","button_external":false,"button_icon":true,"highlighted_text":"scribble","highlighted_scribble":"basic-underline","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"#1c2427","color_button_gradient":"","padding_top":20,"padding_bottom":20,"divider":true,"full_width":false,"rounded":true,"enable_parallax":true}},"image_with_text_XUDGWK":{"type":"image-with-text","blocks":{"heading_UpLLPe":{"type":"heading","settings":{"heading":"From box to date in minutes","heading_size":"title-md","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_qC3cyK":{"type":"text","settings":{"text":"<p>The cleanest seafood on the planet is as easy as...<\/p><p><strong>01 - <\/strong>Slice sushi-grade loin and garnish with caviar, wasabi and soy sauce<\/p><p><strong>02 <\/strong>- Pan sear with sea salt and pepper and squeeze some lemon on top<\/p><p><strong>03<\/strong> - Drizzle olive oil, grate lime, add sea salt to the scallops <br\/><em>(if you added scallops to your box)<\/em><\/p><p><strong>04 <\/strong>- Bake a loin with garlic and onions<\/p><p>Choose your option for the perfect date night.<\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["heading_UpLLPe","text_qC3cyK"],"name":"t:sections.image-with-text.presets.name","settings":{"custom_class":"","image":"shopify:\/\/shop_images\/5._Yarra-valley-salmon-roe-caviar-1.jpg","image_height":"100vh","image_width":"medium","layout":"image_first","text_alignment":"left","content_position":"align-self-center","image_height_mobile":"auto","text_alignment_mobile":"left","color_text":"","color_background":"","gradient_background":"","color_background_2":"","gradient_background_2":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":72,"padding_bottom":72,"divider":false,"full_width":false,"rounded":false,"enable_parallax":true,"parallax_direction":"vertical"}},"image_with_text_yeFNJz":{"type":"image-with-text","blocks":{"heading_fHfhTb":{"type":"heading","settings":{"heading":"A stay-in ritual designed to unfold from night to morning.","heading_size":"title-md","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_REatYX":{"type":"text","settings":{"text":"<p>Give your eggs benedict that special something with our Salmon Roe Caviar and Cold Smoked Salmon.<\/p><p><strong>Prep the base<\/strong><br\/>Toast 2 split English muffins (or bread slices) until golden.<br\/> Layer each half with folded slices of cold-smoked salmon (don’t pack it tight - keep it airy).<\/p><p><br\/><strong>Poach the eggs<\/strong><br\/>Bring a pot of water to a gently simmer and add a splash of vinegar.<br\/>Crack 4 fresh eggs into the water and poach 2½–3 min (set whites, runny yolk). Lift onto paper towel.<\/p><p><br\/><strong>Warm hollandaise<\/strong><br\/>Whisk (or blend) 2 egg yolks + 1 tbsp lemon juice + pinch salt into a bowl set in hot water, then slowly stream in 100 g warm melted butter until thick. Keep just warm, not hot. (if you are not comfortable with this, store bought hollandaise works great, too)<\/p><p><br\/><strong>Assemble & finish<\/strong><br\/>Set the eggs on the salmon, spoon over hollandaise.<br\/>Top with a small spoon of salmon roe caviar on each egg.<\/p><p><br\/>Finish with black pepper + a few chives or dill tips.<br\/><\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["heading_fHfhTb","text_REatYX"],"name":"t:sections.image-with-text.presets.name","settings":{"custom_class":"","image":"shopify:\/\/shop_images\/Eggs_benedict_royal.png","image_height":"100vh","image_width":"medium","layout":"text_first","text_alignment":"left","content_position":"align-self-center","image_height_mobile":"auto","text_alignment_mobile":"left","color_text":"","color_background":"","gradient_background":"","color_background_2":"","gradient_background_2":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":72,"padding_bottom":72,"divider":false,"full_width":false,"rounded":false,"enable_parallax":true,"parallax_direction":"vertical"}},"175815325305d321d0":{"type":"apps","blocks":{"judge_me_reviews_testimonials_carousel_TGMfDm":{"type":"shopify:\/\/apps\/judge-me-reviews\/blocks\/testimonials_carousel\/61ccd3b1-a9f2-4160-9fe9-4fec8413e5d8","settings":{"show_sample_reviews":true,"reviews_selection":"all","products":[],"star_rating":"all","max_reviews":20,"quote_marks_size":"small","product_name_text_size":"small","verified_badge_style":"icon","card_height":"medium","text_size":"small","stars_size":"medium","arrows_position":"bottom","max_width":1100,"corner_styling":"soft","quote_marks_style":"serif","card_color":"#F9F9F9","stars_and_quote_marks_color":"#108474","text_color":"#000000","arrows_color":"#000000","show_border":false,"border_color":"#108474","show_drop_shadow":false,"transition_speed":5,"header_text":"Customers are saying","show_average_rating":true}},"judge_me_reviews_verified_badge_RAPnUJ":{"type":"shopify:\/\/apps\/judge-me-reviews\/blocks\/verified_badge\/61ccd3b1-a9f2-4160-9fe9-4fec8413e5d8","settings":{}}},"block_order":["judge_me_reviews_testimonials_carousel_TGMfDm","judge_me_reviews_verified_badge_RAPnUJ"],"settings":{"color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":72,"padding_bottom":72,"divider":false,"full_width":false,"rounded":false}},"product-details":{"type":"product-details","blocks":{"collapsible_tab-1":{"type":"collapsible_tab","disabled":true,"settings":{"icon":"none","icon_width":24,"heading":"Certificate of Analysis","content":"<p>We lab test a sample from all our seafood products to verify that they are mercury safe (contain less than .01ppm of mercury) and have zero detectable microplastics.<br\/><br\/><br\/>Here are the latest lab tests for Esteros Lubimar Bream:<\/p><p><a href=\"https:\/\/drive.google.com\/file\/d\/1FpEzXFvvHrzYF4qarvlsaoTFqZbwydxz\/view?usp=sharing\" target=\"_blank\">Bream Lot BR-0001<\/a><\/p><p><br\/>You can <a href=\"https:\/\/seatopia.fish\/pages\/seatopia-testing-commitment\">learn more about Seatopia's Testing Commitment here (https:\/\/seatopia.fish\/pages\/seatopia-testing-commitment)<\/a>.<\/p>","metafields":""}},"collapsible_tab-2":{"type":"collapsible_tab","disabled":true,"settings":{"icon":"none","icon_width":24,"heading":"Shipping Policy","content":"<p>Order cutoff for each week is Sunday night. We pack and ship outstanding orders Monday through Wednesday, with delivery generally to be expected on Wednesday through Friday. When your order is ready to ship, UPS tracking information will be sent via email (and or SMS) with a tentative delivery ETA.<\/p><p>*UPS will provide live tracking information with an approximate delivery window but there is no exact time slot. <\/p><p>Need to Reschedule Delivery?<br\/>Please send an email to nemo@seatopia.fish ASAP if you would like to reschedule delivery for a subsequent week. <\/p>","metafields":""}},"collapsible_tab-3":{"type":"collapsible_tab","disabled":true,"settings":{"icon":"none","icon_width":24,"heading":"Collapsible row 3","content":"<p>Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store.<\/p>","metafields":""}},"collapsible_tab-4":{"type":"collapsible_tab","disabled":true,"settings":{"icon":"none","icon_width":24,"heading":"Collapsible row 4","content":"<p>Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store.<\/p>","metafields":""}},"specification_adgPVP":{"type":"specification","settings":{"icon":"shopify:\/\/shop_images\/Frame_1.svg","heading":"Support"}},"specification_8XCn6j":{"type":"specification","settings":{"icon":"shopify:\/\/shop_images\/Vector_2.svg","heading":"Shipping"}},"specification_xBYaXB":{"type":"specification","settings":{"icon":"shopify:\/\/shop_images\/SVG_1.svg","heading":"Packaging"}},"specification_wMfUHN":{"type":"specification","settings":{"icon":"shopify:\/\/shop_images\/SVG.svg","heading":"Rewards"}},"specification_YtNRBN":{"type":"specification","settings":{"icon":"shopify:\/\/shop_images\/product-weight.svg_fill_1.svg","heading":"Weight"}}},"block_order":["collapsible_tab-1","collapsible_tab-2","collapsible_tab-3","collapsible_tab-4","specification_adgPVP","specification_8XCn6j","specification_xBYaXB","specification_wMfUHN","specification_YtNRBN"],"disabled":true,"settings":{"style":"with-border","open_first_row":true,"specifications_heading":"Facilities","heading":"Product details","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"#000000","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":120,"padding_bottom":28,"divider":false,"full_width":false,"rounded":false}},"faq":{"type":"faq","blocks":{"question-1":{"type":"question","settings":{"title":"<strong>Can I customize my box?<\/strong>","text":"<p>We are essentially a farmers market for artisanal aquaculture. In that sense, our Seatopia curated boxes are like a CSA box. We offer our curated boxes as a way to highlight what is seasonally available and introduce our members to new seafood and farm partners they might be interested in. So, they cannot be customized. <\/p><p>But we do offer custom boxes! Members can order a custom box through the <a href=\"https:\/\/seatopia.fish\/collections\/add-ons\" title=\"https:\/\/seatopia.fish\/collections\/add-ons\">a la cart section of our website. <\/a>Subscription members can mix and match items in their portal and take advantage of member-only items and offers. <\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question-2":{"type":"question","settings":{"title":"<strong>Do I have to subscribe to place an order?<\/strong>","text":"<p>No! But becoming a subscriber is the best way to support aquaculture farmers raising fish the right way. <\/p><p>Your subscription helps us with planning harvest timelines and scheduling ocean freight, helping us move the industry away from unsustainable practices of flying fresh fish around the world. Subscribers also have early access to preferred pricing, exclusive add-ons and limited time offers. <\/p><p>You will never be locked in to a subscription - you may change the order, the frequency or cancel anytime. <\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question-3":{"type":"question","settings":{"title":"<strong>Do you offer discounts?<\/strong>","text":"<p>As a general rule, we do not offer discounts, aside from a small thank you for first time customers. We offer the same incentive if you find us through one of our affiliate friends or supporters. Both are only available to first time customers. <\/p><p>Rather than ask our members to search the internet for discounts and coupons, we always offer the lowest prices we can. <\/p><p>The best way to save is by becoming a monthly subscriber. Our subscription members receive a small price incentive for helping us to reliably and predictably support artisan, regenerative aquaculture.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question-4":{"type":"question","settings":{"title":"<strong>What about antibiotics?<\/strong>","text":"<p>At Seatopia, we have a strict zero-tolerance policy for the use of preventative antibiotics in our feed, and our partner farms do not use preventative antibiotics. <\/p><p>In extreme cases where a veterinarian prescribes antibiotics for an individual animal's treatment, that animal is quarantined for a sufficient period, typically at least 30 days, to ensure no detectable levels of antibiotics remain before it can be reintegrated or harvested. <\/p><p>However, these instances where antibiotics are prescribed are rare, and typically only realistically possible in open-ocean aquaculture. <\/p><p>Many of our land-based (RAS) farms use zero antibiotics under any circumstances. More information about these and our other farms can be found on individual farm pages. <\/p><p>We are always able to answer any additional questions via email at nemo@seatopia.fish<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question-5":{"type":"question","settings":{"title":"<strong>What is a portion?<\/strong>","text":"<p>Many in our community are cooking for households or meal planning around specific protein requirements. For that reason, we sell our curated boxes in portions, not pieces. <\/p><p>A portion is typically 5.5-8oz for filets. For other items, like scallops or smoked trout, a portion can be considered 3-4oz, which is the recommended portion size per the professional chefs and nutritionists that we work with. <\/p><p>So, a 12 serving box will contain 4.5-5.5lbs of raw seafood.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"contact":{"type":"contact","settings":{"heading":"Didn’t find your answer?","text":"<p>Don't hestitate to contact us<\/p>","show_phone":false,"avatar":"shopify:\/\/shop_images\/Ellipse_67.png","avatar_height":60,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["question-1","question-2","question-3","question-4","question-5","contact"],"settings":{"style":"with-background","heading":"FAQs","heading_size":"title-lg tracking-heading","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"<p>Please read our <a href=\"https:\/\/seatopia.gorgias.help\/\" title=\"https:\/\/seatopia.gorgias.help\/\">FAQs<\/a> page to find out more.<\/p>","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_background":"#335566","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"#171717","color_button_background":"#ffffff","color_button_gradient":"","color_overlay":"#ffffff","overlay_opacity":4,"padding_top":84,"padding_bottom":4,"divider":false,"narrow":false,"rounded":false}},"product-recommendations":{"type":"product-recommendations","settings":{"product_limit":6,"columns":4,"carousel_on_desktop":true,"columns_mobile":"1","swipe_on_mobile":true,"heading":"If you like Steelhead you will love","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"","highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"#fafafa","color_button_background":"#1c2427","color_button_gradient":"","padding_top":68,"padding_bottom":64,"divider":false,"full_width":false,"rounded":true}},"recently-viewed":{"type":"recently-viewed","disabled":true,"settings":{"product_limit":6,"columns":4,"carousel_on_desktop":true,"columns_mobile":"1","swipe_on_mobile":true,"heading":"Recently Viewed","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"","highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":72,"padding_bottom":72,"divider":false,"full_width":false,"rounded":false}}},"order":["main-product","image_with_text_overlay_atWXNF","help-drawer","video_with_text_overlay_jH8bXm","video-hero","collage_PtgD3p","image_with_text_XUDGWK","image_with_text_yeFNJz","175815325305d321d0","product-details","faq","product-recommendations","recently-viewed"]}