    "faq": {
      "type": "faq",
      "blocks": {
        "q_thaw": {
          "type": "question",
          "settings": {
            "title": "How do I defrost the scallops?",
            "text": "<p>Rinse them under cold running water straight from the freezer to remove the ice glaze, slide them off the shells with a spoon, pat them dry and refrigerate them uncovered on paper towels for 1 to 2 hours. Blot away any moisture before they go into the pan.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_done": {
          "type": "question",
          "settings": {
            "title": "How do I know they&rsquo;re done?",
            "text": "<p>Watch for golden-brown rings around the bottom edge, about 60 to 90 seconds, then flip for 30 to 60 seconds more, until just opaque in the center. They release from the pan when they&rsquo;re ready. Small scallops cook faster than large ones, so watch the rings rather than the clock. The FDA conservatively suggests cooking to an internal temperature of 145&deg;F.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_tear": {
          "type": "question",
          "settings": {
            "title": "Why didn&rsquo;t my scallops brown?",
            "text": "<p>Usually moisture, a pan that isn&rsquo;t hot enough, or a nonstick pan. Pat them dry once more right before you salt them, heat the oil until it shimmers, use stainless steel or cast iron, and give them space in two batches of 6.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_ahead": {
          "type": "question",
          "settings": {
            "title": "Can I make the sauce ahead?",
            "text": "<p>Yes, the same day for the brightest green. It keeps 1 to 2 days in the fridge; the color dulls a little, but it still tastes great spooned over eggs, rice, or any seafood.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_hold": {
          "type": "question",
          "settings": {
            "title": "What is calamansi?",
            "text": "<p>A small, fragrant citrus used across Filipino cooking, somewhere between a lime and a mandarin. Bottled calamansi juice works, and lime juice is Geronimo&rsquo;s swap.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_sauce": {
          "type": "question",
          "settings": {
            "title": "How do I make it dinner?",
            "text": "<p>Serve the scallops over steamed rice with avocado and greens, with extra sauce spooned over, or pile them onto a handful of greens.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
      "block_order": [
        "q_thaw",
        "q_done",
        "q_tear",
        "q_ahead",
        "q_hold",
        "q_sauce"
      ],
