    "rich_text_intro": {
      "type": "rich-text",
      "blocks": {
        "text_intro": {
          "type": "text",
          "settings": {
            "text": "<p>Golden seared scallops on the half shell over a punchy, bright green chili sauce. Light, fast, and made for a weeknight. The scallops need an hour or two in the fridge to defrost and dry, and the sauce blends in five minutes while you wait. The sear itself is about two minutes a batch.</p><p><em>Serve them right away, before the acid starts to change the texture of the scallop.</em> &mdash; Geronimo</p>",
            "text_size": "subtext-md",
            "text_max_size": 32,
            "text_font": "body",
            "secondary_color": false,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
      "block_order": [
        "text_intro"
      ],
