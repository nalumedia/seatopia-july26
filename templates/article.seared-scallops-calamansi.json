      "type": "multicolumn-with-icons",
      "blocks": {
        "g_time": {
          "type": "column",
          "settings": {
            "icon": "time",
            "custom_icon": "",
            "heading": "15 minutes active",
            "text": "<p>Plus 1 to 2 hours in the fridge while the scallops defrost and dry. The sauce blends in the meantime.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "g_serves": {
          "type": "column",
          "settings": {
            "icon": "users",
            "custom_icon": "",
            "heading": "Serves 2",
            "text": "<p>Six scallops each, from one package of our Half-Shell Scallops. Feeding 4? Grab 2 packages.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "g_rice": {
          "type": "column",
          "settings": {
            "icon": "heart",
            "custom_icon": "",
            "heading": "Stainless or cast iron",
            "text": "<p>Never nonstick. A heavy pan, hot enough that the oil shimmers, is what makes the golden crust.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "g_cold": {
          "type": "column",
          "settings": {
            "icon": "check_mark",
            "custom_icon": "",
            "heading": "Dry is the key",
            "text": "<p>Rinse off the ice glaze, pat every scallop dry and let them defrost uncovered on paper towels. A dry surface is what sears.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
