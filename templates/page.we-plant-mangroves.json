    "custom_liquid_mgfARe": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "liquid": "{% comment %}\n  Seatopia Earth Month Progress Widget — April 2026\n\n  INSTALLATION:\n  1. In Shopify Admin, go to Online Store > Themes > Edit Code\n  2. Create a new section called \"earth-month-widget\"\n  3. Paste this code into the new section\n  4. API_URL is pre-configured to https://getdeep.blue\n  5. Add the section to your page via the Theme Editor\n\n  This widget shows a live progress bar toward the April 2026\n  mangrove planting goal (1 tree per order).\n{% endcomment %}\n\n<style>\n  .seatopia-earth-month {\n    font-family: 'Georgia', 'Times New Roman', serif;\n    max-width: 700px;\n    margin: 40px auto;\n    padding: 0 20px;\n  }\n\n  .earth-month-card {\n    background: #f5f0e8;\n    border-radius: 16px;\n    padding: 48px 40px 36px;\n    text-align: center;\n  }\n\n  .earth-month-title {\n    font-size: 28px;\n    font-weight: 400;\n    color: #4a6c7a;\n    margin: 0 0 28px 0;\n    letter-spacing: 0.5px;\n  }\n\n  .earth-month-bar-bg {\n    width: 100% !important;\n    height: 16px !important;\n    background: #c8d3de !important;\n    border-radius: 8px !important;\n    overflow: hidden !important;\n    margin-bottom: 12px !important;\n    position: relative !important;\n    display: block !important;\n  }\n\n  .earth-month-bar-fill {\n    height: 100% !important;\n    background: linear-gradient(90deg, #1a7a5a, #2d8a6e) !important;\n    border-radius: 8px !important;\n    transition: width 1s ease-in-out !important;\n    box-shadow: 0 0 8px rgba(45, 138, 110, 0.6) !important;\n    display: block !important;\n    min-height: 16px !important;\n  }\n\n  .earth-month-stats {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    font-size: 14px;\n    color: #6a7c8a;\n  }\n\n  .earth-month-stats .goal {\n    font-weight: 600;\n  }\n\n  .earth-month-loading {\n    text-align: center;\n    padding: 40px;\n    color: #6a7c8a;\n  }\n\n  .earth-month-loading .spinner {\n    width: 28px;\n    height: 28px;\n    border: 3px solid #d6dfe8;\n    border-top-color: #6a9ab5;\n    border-radius: 50%;\n    animation: em-spin 1s linear infinite;\n    margin: 0 auto 12px;\n  }\n\n  @keyframes em-spin {\n    to { transform: rotate(360deg); }\n  }\n</style>\n\n<div class=\"seatopia-earth-month\" id=\"seatopia-earth-month\">\n  <div class=\"earth-month-loading\">\n    <div class=\"spinner\"></div>\n    <p>Loading progress...</p>\n  </div>\n</div>\n\n<script>\n(function() {\n  // UPDATE THIS URL to your DeepBlue dashboard URL\n  // Add ?target=2500 to change the goal (default: 2500)\n  const API_URL = 'https://getdeep.blue/api/public/earth-month-widget';\n\n  const container = document.getElementById('seatopia-earth-month');\n\n  function renderWidget(data) {\n    const rawPct = (data.treesPlanted / data.target) * 100;\n    const pct = Math.min(rawPct, 100);\n    const displayPct = data.treesPlanted > 0 ? Math.max(pct, 3) : 0;\n    const pctLabel = pct < 1 ? pct.toFixed(1) : Math.round(pct);\n    container.innerHTML = `\n      <div class=\"earth-month-card\">\n        <h2 class=\"earth-month-title\">Our Pledge This Earth Month</h2>\n        <div class=\"earth-month-bar-bg\">\n          <div class=\"earth-month-bar-fill\" style=\"width: ${displayPct}%\"></div>\n        </div>\n        <div class=\"earth-month-stats\">\n          <span>${data.treesPlanted.toLocaleString()} trees planted so far (${pctLabel}%)</span>\n          <span class=\"goal\">Goal: ${data.target.toLocaleString()}</span>\n        </div>\n      </div>\n    `;\n  }\n\n  function renderError() {\n    container.innerHTML = '<div class=\"earth-month-loading\"><p>Unable to load progress. Please try again later.</p></div>';\n  }\n\n  fetch(API_URL)\n    .then(r => { if (!r.ok) throw new Error('Failed'); return r.json(); })\n    .then(data => renderWidget(data))\n    .catch(() => renderError());\n})();\n</script>",
        "color_text": "",
        "color_background": "",
