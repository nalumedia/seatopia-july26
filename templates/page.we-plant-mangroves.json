          },
          "disabled": true
        },
        "review_beCApy": {
          "type": "review",
          "disabled": true,
          "settings": {
            "image": "shopify://shop_images/dr_brook.png",
            "image_url": "shopify://blogs/regenerative-aquaculture/are-we-still-mermaids-embracing-our-aquatic-roots-for-modern-health",
            "title": "Dr. Kristyn Silver-Brook",
            "job": "Prenatal and postpartum chiropractor, mama, and a Seatopia customer",
            "Start_number": "5",
            "text": "<p>Thanks to SEATOPIA, throughout my pregnancy & while breastfeeding I've confidently enjoyed sushi-grade, low mercury, omega-rich seafood from the comfort of home!</p>",
            "block_background": "",
            "block_text_color": ""
          }
        },
        "review_t6Kfty": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/Ben_greenfield_89fa6ea5-3395-4d81-975e-1f952ba5b657.png",
            "image_url": "shopify://blogs/regenerative-aquaculture",
            "title": "Ben Greenfield",
            "job": "Health & Fitness Coach",
            "Start_number": "5",
            "text": "<p>\"If you want healthy, gourmet-style seafood, in the comfort of your own home, seafood that goes above and beyond any you've tasted before, you need Seatopia in your life!\"</p>",
            "block_background": "",
