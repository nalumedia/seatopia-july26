            "custom_icon": "",
            "heading": "Serves 4",
            "text": "<p>One skin-on branzino fillet per person, over butternut puree with a celery salad.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "g_rice": {
          "type": "column",
          "settings": {
            "icon": "heart",
            "custom_icon": "",
            "heading": "One skillet for the fish",
            "text": "<p>An oven-safe skillet takes the fish from the stove to the oven. A small pan makes the sage brown butter.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "g_cold": {
