    "faq": {
      "type": "faq",
      "blocks": {
        "q_thaw": {
          "type": "question",
          "settings": {
            "title": "How do I thaw the branzino?",
            "text": "<p>Move it to the fridge the night before. For a quick thaw, seal it in a bag and submerge it in cold water for 20&ndash;30 minutes. Pat it very dry before it goes into the pan.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_done": {
          "type": "question",
          "settings": {
            "title": "How do I know the fish is done?",
            "text": "<p>After about 5 minutes in the oven, the flesh turns opaque and flakes easily. The FDA suggests cooking fish to an internal temperature of 145&deg;F.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_tear": {
          "type": "question",
          "settings": {
            "title": "Why isn’t my skin crisp?",
            "text": "<p>Usually moisture or a crowded pan. Pat the fillets very dry, heat the ghee until it shimmers, and sear in two batches if they don’t fit with space between them. Leave them alone until the skin releases easily.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_ahead": {
          "type": "question",
          "settings": {
            "title": "What can I make ahead?",
            "text": "<p>The puree and dressing, up to 1 day ahead. Rewarm the puree with a splash of olive oil. Slice the celery up to 2 hours ahead and keep it in ice water.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_hold": {
          "type": "question",
          "settings": {
            "title": "Why small squash?",
            "text": "<p>Smaller butternut squash are sweeter and more flavorful. Larger ones work too; give them 5&ndash;10 minutes more in the oven.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_sauce": {
          "type": "question",
          "settings": {
            "title": "How do I toast pine nuts?",
            "text": "<p>In a dry pan over medium-low heat for 3&ndash;4 minutes, shaking often. They burn quickly, so stay close.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
      "block_order": [
        "q_thaw",
        "q_done",
        "q_tear",
        "q_ahead",
        "q_hold",
        "q_sauce"
      ],
