            "icon": "check_mark",
            "custom_icon": "",
            "heading": "Dry skin, hot pan",
            "text": "<p>Pat the fillets very dry and press each one for 10 seconds, so the skin stays flat and turns crisp.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
