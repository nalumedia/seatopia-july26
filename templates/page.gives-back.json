      "blocks": {
        "p1": {
          "type": "paragraph",
          "settings": {
            "text": "<p>Our Black Tiger Shrimp are raised in low-density ponds woven through living mangrove forest in Tarakan. For every Seatopia box ordered, we plant one mangrove tree in the same coastal community.</p>"
          }
        },
        "p2": {
          "type": "paragraph",
          "settings": {
            "text": "<p>Mangrove roots stabilize shorelines, filter water and store carbon in coastal sediment. The count above is live.</p>"
          }
        }
      },
