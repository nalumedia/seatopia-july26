    "stack_video": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_id": "the-stack",
        "liquid": "\n<style>\n  .sea-stack {\n    --ink:#171717; --muted:#5c5c5c; --line:#e5e2dc; --wash:#faf8f4; --gold:#bb8f50;\n    color: var(--ink); background: var(--wash);\n    border: 1px solid var(--line); border-radius: 20px; padding: 30px;\n  }\n  .sea-stack__grid {\n    display: grid; grid-template-columns: minmax(0, 250px) minmax(0, 1fr);\n    gap: 34px; align-items: center;\n  }\n  .sea-stack__player {\n    position: relative; margin: 0; aspect-ratio: 9 / 16;\n    border-radius: 16px; overflow: hidden;\n    background: #111 center / cover no-repeat;\n    box-shadow: 0 14px 34px -22px rgba(0,0,0,.5);\n  }\n  .sea-stack__player video {\n    width: 100%; height: 100%; object-fit: cover; display: block;\n    opacity: 0; transition: opacity .3s ease;\n  }\n  .sea-stack__player.is-playing video { opacity: 1; }\n  .sea-stack__play {\n    position: absolute; inset: 0; width: 100%; height: 100%;\n    display: flex; align-items: center; justify-content: center;\n    border: 0; padding: 0; cursor: pointer;\n    background: linear-gradient(180deg, rgba(0,0,0,.04), rgba(0,0,0,.34));\n    transition: opacity .25s ease;\n  }\n  .sea-stack__player.is-playing .sea-stack__play { opacity: 0; pointer-events: none; }\n  .sea-stack__play span {\n    width: 58px; height: 58px; border-radius: 50%;\n    background: rgba(255,255,255,.94);\n    display: flex; align-items: center; justify-content: center;\n    box-shadow: 0 6px 18px -6px rgba(0,0,0,.5);\n    transition: transform .18s ease;\n  }\n  .sea-stack__play:hover span { transform: scale(1.07); }\n  .sea-stack__play svg { width: 19px; height: 19px; margin-left: 3px; fill: var(--ink); }\n  .sea-stack__badge {\n    position: absolute; top: 12px; left: 12px; z-index: 2;\n    font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;\n    color: #fff; background: rgba(23,23,23,.62); padding: 5px 10px; border-radius: 999px;\n  }\n  .sea-stack__player.is-playing .sea-stack__badge { opacity: 0; transition: opacity .25s ease; }\n  .sea-stack__eyebrow {\n    font-size: 11px; letter-spacing: .14em; text-transform: uppercase;\n    color: var(--gold); font-weight: 600; margin: 0 0 8px;\n  }\n  .sea-stack__heading { font-size: clamp(23px, 2.8vw, 30px); line-height: 1.15; font-weight: 600; margin: 0 0 18px; }\n  .sea-stack__list { margin: 0; padding: 0; list-style: none; position: relative; }\n  .sea-stack__list:before {\n    content: \"\"; position: absolute; left: 7px; top: 10px; bottom: 10px;\n    width: 2px; background: linear-gradient(180deg, var(--gold), #e5d3b4);\n  }\n  .sea-stack__list li {\n    position: relative; padding: 0 0 13px 30px;\n    font-size: 15px; line-height: 1.5; color: var(--muted);\n  }\n  .sea-stack__list li:last-child { padding-bottom: 0; }\n  .sea-stack__list li:before {\n    content: \"\"; position: absolute; left: 2px; top: 7px;\n    width: 12px; height: 12px; border-radius: 50%;\n    background: #fff; border: 2px solid var(--gold);\n  }\n  .sea-stack__list b { color: var(--ink); }\n  .sea-stack__cap {\n    margin: 18px 0 0; padding-top: 14px; border-top: 1px solid var(--line);\n    font-size: 13px; line-height: 1.55; color: var(--muted);\n  }\n  @media (max-width: 989px) {\n    .sea-stack { padding: 22px; }\n    .sea-stack__grid { grid-template-columns: 1fr; gap: 24px; justify-items: center; }\n    .sea-stack__player { width: min(74vw, 250px); }\n    .sea-stack__body { width: 100%; }\n  }\n</style>\n\n<div class=\"sea-stack\">\n  <div class=\"sea-stack__grid\">\n\n    <figure class=\"sea-stack__player\" data-sea-stack\n            style=\"background-image:url('{{ 'smoked-trout-sandwich-video-poster.jpg' | file_url }}');\">\n      <span class=\"sea-stack__badge\">0:52</span>\n      <video preload=\"none\" playsinline\n             poster=\"{{ 'smoked-trout-sandwich-video-poster.jpg' | file_url }}\"\n             data-src-hd=\"https://cdn.shopify.com/videos/c/vp/feef742c40bd4828820a9793b2f4ddc3/feef742c40bd4828820a9793b2f4ddc3.HD-720p-4.5Mbps-93920679.mp4\"\n             data-src-sd=\"https://cdn.shopify.com/videos/c/vp/feef742c40bd4828820a9793b2f4ddc3/feef742c40bd4828820a9793b2f4ddc3.SD-480p-1.5Mbps-93920679.mp4\"\n             aria-label=\"Jason Pabst building the smoked trout sandwich on the rocks in coastal Maine\"></video>\n      <button class=\"sea-stack__play\" type=\"button\" aria-label=\"Play the 52 second build video\">\n        <span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M8 5v14l11-7z\"></path></svg></span>\n      </button>\n    </figure>\n\n    <div class=\"sea-stack__body\">\n      <p class=\"sea-stack__eyebrow\">The stack, bottom to top</p>\n      <h2 class=\"sea-stack__heading\">Order matters more than technique.</h2>\n      <ol class=\"sea-stack__list\">\n        <li><b>Hollowed sourdough base</b> &mdash; scoop out the crumb so the fillings sit down inside the loaf instead of sliding off it</li>\n        <li><b>Garlic scape and soft cheese</b> &mdash; on <em>both</em> cut faces; this is the waterproofing that stops the bread going soggy</li>\n        <li><b>Smoked trout, edge to edge</b> &mdash; laid flat in one even layer so every bite gets some</li>\n        <li><b>Fresh dill</b> &mdash; straight onto the fish, where the oil in the trout carries it</li>\n        <li><b>Tomato, cucumber, red onion</b> &mdash; sliced thin, seasoned on the sandwich rather than in a bowl</li>\n        <li><b>Greens and more dill</b> &mdash; the cushion between the wet layer and the lid</li>\n        <li><b>Basil oil on the top half</b> &mdash; mashed in a mortar, spread on the underside of the lid</li>\n      </ol>\n      <p class=\"sea-stack__cap\">\n        Cheese against bread on both halves, wet things in the middle, greens between the wet things and the lid.\n        Get that sequence right and it survives a walk to the water.\n      </p>\n    </div>\n\n  </div>\n</div>\n\n<script>\n  (function () {\n    document.querySelectorAll('[data-sea-stack]').forEach(function (frame) {\n      var video = frame.querySelector('video');\n      var button = frame.querySelector('.sea-stack__play');\n      if (!video || !button) return;\n\n      button.addEventListener('click', function () {\n        if (!video.currentSrc && !video.src) {\n          var wide = window.matchMedia('(min-width: 600px)').matches;\n          video.src = wide ? video.dataset.srcHd : video.dataset.srcSd;\n        }\n        frame.classList.add('is-playing');\n        video.controls = true;\n        var played = video.play();\n        if (played && played.catch) {\n          played.catch(function () { video.muted = true; video.play(); });\n        }\n      });\n\n      video.addEventListener('pause', function () {\n        if (video.currentTime === 0 || video.ended) {\n          frame.classList.remove('is-playing');\n          video.controls = false;\n        }\n      });\n    });\n  })();\n</script>\n",
