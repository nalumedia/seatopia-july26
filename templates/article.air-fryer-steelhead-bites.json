    "rich_text_intro": {
      "type": "rich-text",
      "blocks": {
        "text_intro": {
          "type": "text",
          "settings": {
            "text": "<p>Steelhead cut into cubes, tossed with oregano, smoked paprika and garlic powder, and air-fried until the edges go golden &mdash; then piled onto warm jasmine rice with arugula, feta, kalamata olives and a green goddess tzatziki that gets its colour and body from a whole avocado blended into the yogurt.</p><p>Two things carry it. Pat the fish properly dry before it is seasoned; that is the whole trick to the crust. And the sauce goes on at the table, not in the basket, so the bites stay crisp.</p>",
            "text_size": "subtext-md",
            "text_max_size": 32,
            "text_font": "body",
            "secondary_color": false,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
