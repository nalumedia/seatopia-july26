ity":40}}},"block_order":["image-1","image-2","image-3","image-4"],"settings":{"heading":"The world's best and most sustainable seafood","heading_size":"title-sm","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h3","subheading":"","description":"<p>We believe that seafood is a super food and work with innovative aquaculture farms worldwide who source the cleanest seafood which we deliver direct to your door.<\/p>","button_label":"","button_link":"shopify:\/\/collections\/add-ons-1","button_external":false,"button_icon":true,"highlighted_text":"scribble","highlighted_scribble":"basic-underline","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"#1c2427","color_button_gradient":"","padding_top":72,"padding_bottom":0,"divider":true,"full_width":false,"rounded":true,"enable_parallax":true}},"product-details":{"type":"product-details","blocks":{"collapsible_tab-1":{"type":"collapsible_tab","disabled":true,"settings":{"icon":"none","icon_width":24,"heading":"Certificate of Analysis","content":"<p>We lab test a sample from all our seafood products to verify that they are mercury safe (contain less than .01ppm of mercury) and have zero detectable microplastics.<br\/><br\/><br\/>Here are the latest lab tests for Esteros Lubimar Bream:<\/p><p><a href=\"https:\/\/drive.google.com\/file\/d\/1FpEzXFvvHrzYF4qarvlsaoTFqZbwydxz\/view?usp=sharing\" target=\"_blank\">Bream Lot BR-0001<\/a><\/p><p><br\/>You can <a href=\"https:\/\/seatopia.fish\/pages\/seatopia-testing-commitment\">learn more about Seatopia's Testing Commitment here (https:\/\/seatopia.fish\/pages\/seatopia-testing-commitment)<\/a>.<\/p>","metafields":""}},"collapsible_tab-2":{"type":"collapsible_tab","disabled":true,"settings":{"icon":"none","icon_width":24,"heading":"Shipping Policy","content":"<p>Order cutoff for each week is Sunday night. We pack and ship outstanding orders Monday through Wednesday, with delivery generally to be expected on Wednesday through Friday. When your order is ready to ship, UPS tracking information will be sent via email (and or SMS) with a tentative delivery ETA.<\/p><p>*UPS will provide live tracking information with an approximate delivery window but there is no exact time slot. <\/p><p>Need to Reschedule Delivery?<br\/>Please send an email to nemo@seatopia.fish ASAP if you would like to reschedule delivery for a subsequent week. <\/p>","metafields":""}},"collapsible_tab-3":{"type":"collapsible_tab","disabled":true,"settings":{"icon":"none","icon_width":24,"heading":"Collapsible row 3","content":"<p>Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store.<\/p>","metafields":""}},"collapsible_tab-4":{"type":"collapsible_tab","disabled":true,"settings":{"icon":"none","icon_width":24,"heading":"Collapsible row 4","content":"<p>Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store.<\/p>","metafields":""}},"specification_adgPVP":{"type":"specification","settings":{"icon":"shopify:\/\/shop_images\/Frame_1.svg","heading":"Support"}},"specification_8XCn6j":{"type":"specification","settings":{"icon":"shopify:\/\/shop_images\/Vector_2.svg","heading":"Shipping"}},"specification_xBYaXB":{"type":"specification","settings":{"icon":"shopify:\/\/shop_images\/SVG_1.svg","heading":"Packaging"}},"specification_wMfUHN":{"type":"specification","settings":{"icon":"shopify:\/\/shop_images\/SVG.svg","heading":"Rewards"}},"specification_YtNRBN":{"type":"specification","settings":{"icon":"shopify:\/\/shop_images\/product-weight.svg_fill_1.svg","heading":"Weight"}}},"block_order":["collapsible_tab-1","collapsible_tab-2","collapsible_tab-3","collapsible_tab-4","specification_adgPVP","specification_8XCn6j","specification_xBYaXB","specification_wMfUHN","specification_YtNRBN"],"disabled":true,"settings":{"style":"with-border","open_first_row":true,"specifications_heading":"Facilities","heading":"Product details","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"#000000","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":120,"padding_bottom":28,"divider":false,"full_width":false,"rounded":false}},"custom_liquid_CcknDe":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"section_id":"","liquid":"<div class=\"seatopia-edacious-results-block\">\n  <div\n    data-edacious-results='{\"brand\":\"seatopia\",\"product\":\"half-shell-scallops\",\"config\":\"2gl7st\"}'\n  ><\/div>\n\n  <button\n    type=\"button\"\n    class=\"seatopia-coa-link\"\n    aria-label=\"View the Certificate of Analysis for Half-Shell Scallops\"\n    onclick=\"window.open('https:\/\/cdn.shopify.com\/s\/files\/1\/0222\/9882\/0682\/files\/MP-Seacorp-Peruvian_Scallops-Lot_935.pdf?v=1783786078','_blank','noopener,noreferrer');\"\n  >\n    <span class=\"seatopia-coa-claim\">✓ Zero Detectable Microplastics<\/span>\n    <span class=\"seatopia-coa-action\">View Certificate of Analysis →<\/span>\n  <\/button>\n<\/div>\n\n<style>\n  .seatopia-edacious-results-block {\n    width: 100%;\n  }\n\n  .seatopia-coa-link {\n    appearance: none !important;\n    -webkit-appearance: none !important;\n    background: transparent !important;\n    border: none !important;\n    box-shadow: none !important;\n    padding: 0 !important;\n    margin: 18px 0 0 !important;\n\n    display: flex !important;\n    flex-direction: column !important;\n    align-items: flex-start !important;\n    gap: 4px !important;\n\n    color: #27485b !important;\n    text-align: left !important;\n    cursor: pointer !important;\n    font-family: inherit !important;\n\n    text-decoration: none !important;\n    background-image: none !important;\n  }\n\n  .seatopia-coa-link *,\n  .seatopia-coa-link::before,\n  .seatopia-coa-link::after,\n  .seatopia-coa-link *::before,\n  .seatopia-coa-link *::after {\n    text-decoration: none !important;\n    background-image: none !important;\n    border: none !important;\n    box-shadow: none !important;\n  }\n\n  .seatopia-coa-claim {\n    font-size: 20px;\n    font-weight: 600;\n    line-height: 1.25;\n    color: #27485b;\n  }\n\n  .seatopia-coa-action {\n    font-size: 16px;\n    font-weight: 400;\n    line-height: 1.3;\n    color: #27485b;\n  }\n\n  .seatopia-coa-link:hover {\n    opacity: 0.8;\n  }\n\n  .seatopia-coa-link:focus-visible {\n    outline: 2px solid #27485b;\n    outline-offset: 4px;\n  }\n<\/style>","color_text":"","color_background":"","gradient_background":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":40,"padding_bottom":40,"divider":false,"narrow":false,"rounded":false}},"faq":{"type":"faq","blocks":{"question-1":{"type":"question","settings":{"title":"<strong>Can I customize my box?<\/strong>","text":"<p>We are essentially a farmers market for artisanal aquaculture. In that sense, our Seatopia curated boxes are like a CSA box. We offer our curated boxes as a way to highlight what is seasonally available and introduce our members to new seafood and farm partners they might be interested in. So, they cannot be customized. <\/p><p>But we do offer custom boxes! Members can order a custom box through the <a href=\"https:\/\/seatopia.fish\/collections\/add-ons\" title=\"https:\/\/seatopia.fish\/collections\/add-ons\">a la cart section of our website. <\/a>Subscription members can mix and match items in their portal and take advantage of member-only items and offers. <\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question-2":{"type":"question","settings":{"title":"<strong>Do I have to subscribe to place an order?<\/strong>","text":"<p>No! But becoming a subscriber is the best way to support aquaculture farmers raising fish the right way. <\/p><p>Your subscription helps us with planning harvest timelines and scheduling ocean freight, helping us move the industry away from unsustainable practices of flying fresh fish around the world. Subscribers also have early access to preferred pricing, exclusive add-ons and limited time offers. <\/p><p>You will never be locked in to a subscription - you may change the order, the frequency or cancel anytime. <\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question-3":{"type":"question","settings":{"title":"<strong>Do you offer discounts?<\/strong>","text":"<p>As a general rule, we do not offer discounts, aside from a small thank you for first time customers. We offer the same incentive if you find us through one of our affiliate friends or supporters. Both are only available to first time customers. <\/p><p>Rather than ask our members to search the internet for discounts and coupons, we always offer the lowest prices we can. <\/p><p>The best way to save is by becoming a monthly subscriber. Our subscription members receive a small price incentive for helping us to reliably and predictably support artisan, regenerative aquaculture.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question-4":{"type":"question","settings":{"title":"<strong>What about antibiotics?<\/strong>","text":"<p>At Seatopia, we have a strict zero-tolerance policy for the use of preventative antibiotics in our feed, and our partner farms do not use preventative antibiotics. <\/p><p>In extreme cases where a veterinarian prescribes antibiotics for an individual animal's treatment, that animal is quarantined for a sufficient period, typically at least 30 days, to ensure no detectable levels of antibiotics remain before it can be reintegrated or harvested. <\/p><p>However, these instances where antibiotics are prescribed are rare, and typically only realistically possible in open-ocean aquaculture. <\/p><p>Many of our land-based (RAS) farms use zero antibiotics under any circumstances. More information about these and our other farms can be found on individual farm pages. <\/p><p>We are always able to answer any additional questions via email at nemo@seatopia.fish<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question-5":{"type":"question","settings":{"title":"<strong>What is a portion?<\/strong>","text":"<p>Many in our community are cooking for households or meal planning around specific protein requirements. For that reason, we sell our curated boxes in portions, not pieces. <\/p><p>A portion is typically 5.5-8oz for filets. For other items, like scallops or smoked trout, a portion can be considered 3-4oz, which is the recommended portion size per the professional chefs and nutritionists that we work with. <\/p><p>So, a 12 serving box will contain 4.5-5.5lbs of raw seafood.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"contact":{"type":"contact","settings":{"heading":"Didn’t find your answer?","text":"<p>Don't hestitate to contact us<\/p>","show_phone":false,"avatar":"shopify:\/\/shop_images\/Ellipse_67.png","avatar_height":60,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["question-1","question-2","question-3","question-4","question-5","contact"],"settings":{"style":"with-background","heading":"FAQs","heading_size":"title-lg tracking-heading","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"<p>Please read our <a href=\"https:\/\/seatopia.gorgias.help\/\" title=\"https:\/\/seatopia.gorgias.help\/\">FAQs<\/a> page to find out more.<\/p>","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_background":"#335566","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"#171717","color_button_background":"#ffffff","color_button_gradient":"","color_overlay":"#ffffff","overlay_opacity":4,"padding_top":84,"padding_bottom":4,"divider":false,"narrow":false,"rounded":false}},"portfolio_WnMHLe":{"type":"portfolio","blocks":{"profile_Affpif":{"type":"profile","settings":{"image":"shopify:\/\/shop_images\/Screenshot_2025-06-04_at_11.53.51_AM.png","heading":"Scallop Crudo with Watermelon","text":"<p>Meticulously cut yellowtail and watermelon with thinly sliced Peruvian scallops for a touch of luxury. The dish is finished with a spritz of citrus ponzu and a sprinkle of homemade seasoning, making it a true masterpiece on the plate.<\/p><p>👉🏽 <a href=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/kingfish-and-scallop-crudo-with-watermelon\" target=\"_blank\">Get the Recipe<\/a><\/p>","color_text":"#ffffff","color_background":"#171717"}},"profile_BnhYzV":{"type":"profile","settings":{"image":"shopify:\/\/shop_images\/seacorp-peruvian-scallop-meat-20-oz-175608.png","heading":"Scallops with Romesco","text":"<p>A super easy light starter to counter the heavy mains of a big dinner. It’s a cold starter (apart from the cooking of the scallops) so the preparation of this dish can be done in advance. There’s a lot of late season tomatoes knocking around in grocery stores. Heritage tomatoes have more bite and texture which works perfect for this dish. <\/p><p>👉🏽 <a href=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/scallops-with-romesco-and-marinated-tomatoes\" target=\"_blank\" title=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/scallops-with-romesco-and-marinated-tomatoes\">Get the recipe<\/a><\/p>","color_text":"#ffffff","color_background":"#171717"}},"profile_bx4ntY":{"type":"profile","settings":{"image":"shopify:\/\/shop_images\/Screenshot_2025-06-04_at_11.56.56_AM.png","heading":"Scallop Crudo with Citrus Soy","text":"<p>Rich in omega-3 fatty acids crucial for optimal brain function and carefully lab-tested to ensure they're mercury-safe and free from detectable microplastics, these scallops offer gourmet indulgence paired with peace of mind.<\/p><p>👉🏽 <a href=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/asian-scallop-crudo-with-citrus-soy-marinade\" target=\"_blank\" title=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/asian-scallop-crudo-with-citrus-soy-marinade\">Get the recipe<\/a><\/p>","color_text":"#ffffff","color_background":"#171717"}}},"block_order":["profile_Affpif","profile_BnhYzV","profile_bx4ntY"],"settings":{"columns":4,"carousel_on_desktop":false,"layout":"default","image_ratio":"portrait","image_ratio_mobile":"portrait","columns_mobile":"1","swipe_on_mobile":true,"heading":"Seacorp Peruvian Scallop Recipes","heading_size":"title-md","heading_alignment":"text-center justify-center","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":60,"padding_bottom":60,"divider":false,"full_width":false,"rounded":false}},"product-recommendations":{"type":"product-recommendations","settings":{"product_limit":6,"columns":4,"carousel_on_desktop":true,"columns_mobile":"1","swipe_on_mobile":true,"heading":"More seafood favorites","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"","highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"#fafafa","c