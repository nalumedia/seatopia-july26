age":""}},"read_more_UPLh7F":{"type":"read_more","settings":{}},"spinning_text_UM9kie":{"type":"spinning_text","settings":{"text":"Featured product"}}},"block_order":["title_qatmGe","description_3t6j8r","variant_picker_rX9AaG","buy_buttons_9QQWDb","pickup_availability_g6aNwr","share_YPkYtn","read_more_UPLh7F","spinning_text_UM9kie"],"disabled":true,"settings":{"product":"seatopia-regenerative-seafood-bundle","enable_sticky_info":true,"show_chef_notes":true,"media_size":66,"gallery_layout":"thumbnail","thumbnail_position":"beside","image_ratio":"adapt_first","image_zoom":"lightbox","hide_variants":false,"enable_video_autoplay":false,"enable_video_looping":false,"mobile_layout":"partial","image_ratio_mobile":"adapt_first","mobile_thumbnail":false,"padding_top":72,"padding_bottom":72,"divider":false,"full_width":false,"rounded":false}},"custom_image_with_txt_founder_Mx3h6w":{"type":"custom-image-with-txt-founder","blocks":{"heading_ayfbh3":{"type":"heading","settings":{"heading":"Poke bowls with tamari, ginger and garlic","heading_size":"title-md","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_MLM83N":{"type":"text","settings":{"text":"<p>Learn the art of building a clean, vibrant poke bowl that honors the purity of your Seatopia seafood. In this interactive 1:1 session, you’ll cook alongside a member of the Seatopia Culinary Team while refining knife skills, seasoning technique, and bowl composition.<\/p><p>This is a <strong>hands-on, cook-along experience<\/strong> designed to help you feel confident preparing raw, sushi-grade seafood at home.<\/p><p><strong>What you’ll learn during the session<\/strong><\/p><ul><li><strong>Cube & Season Seafood<\/strong> — cut sushi-grade fish into clean, even bites<\/li><li><strong>Build Flavor Layers<\/strong> — balance tamari, ginger, and garlic without overpowering the fish<\/li><li><strong>Assemble the Bowl<\/strong> — pair seafood with rice, greens, and toppings for a nutrient-dense, restaurant-quality result<\/li><\/ul><p>To make the most of our time together, please review the materials in the booking link below <strong>before your call<\/strong>. This allows us to spend the session cooking, tasting, and refining — not just explaining basics.<\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"spacing_JUpGyi":{"type":"spacing","settings":{"height":40,"height_mobile":28}},"button_Am6YGt":{"type":"button","settings":{"button_label":"Make some great Poke","button_link":"https:\/\/calendly.com\/101-seafood\/poke?back=1&month=2025-12","button_style":"primary","button_size":"md","button_external":true,"button_icon":true}}},"block_order":["heading_ayfbh3","text_MLM83N","spacing_JUpGyi","button_Am6YGt"],"settings":{"custom_class":"","image":"shopify:\/\/shop_images\/mercury-tested-poke.jpg","image_height":"100vh","image_width":"medium","layout":"image_first","text_alignment":"left","content_position":"align-self-center","image_height_mobile":"auto","text_alignment_mobile":"left","color_text":"","color_background":"","container_color_bg":"","gradient_background":"","color_background_2":"","gradient_background_2":"","color_highlight":"","gradient_highlight":"","color_button_text":"#ffffff","color_button_background":"#ff7755","color_button_gradient":"","padding_top":100,"padding_bottom":100,"divider":false,"full_width":false,"rounded":false,"enable_parallax":true,"parallax_direction":"vertical"}},"custom_image_with_txt_founder_B7LPCx":{"type":"custom-image-with-txt-founder","blocks":{"heading_pwa7YW":{"type":"heading","settings":{"heading":"The ancient art of ceviche","heading_size":"title-md","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_mge6Bd":{"type":"text","settings":{"text":"<p>Experience the bright, refreshing flavors of coastal ceviche — the ultimate clean, no-heat seafood preparation. This hands-on class will guide you through balancing acidity, texture, and herbs to create your own masterpiece.<\/p><p>You’ll learn how to:<\/p><ul><li><strong>Dice & Cure Seafood<\/strong> — using citrus acids for a safe, flavorful “cold cook.”<\/li><li><strong>Balance Brightness & Salt<\/strong> — to highlight the fish’s natural sweetness.<\/li><li><strong>Build a Ceviche Bowl<\/strong> — with avocado, herbs, onions, and a touch of heat.<\/li><\/ul><p>To make the most of our time together, please review the materials in the booking link below <strong>before your call<\/strong>. This allows us to spend the session cooking, tasting, and refining — not just explaining basics.<\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"spacing_eeDPNp":{"type":"spacing","settings":{"height":40,"height_mobile":28}},"button_LTnWAD":{"type":"button","settings":{"button_label":"Learn everything about Ceviche","button_link":"https:\/\/calendly.com\/101-seafood\/ceviche-class?back=1&month=2025-12","button_style":"primary","button_size":"md","button_external":true,"button_icon":true}}},"block_order":["heading_pwa7YW","text_mge6Bd","spacing_eeDPNp","button_LTnWAD"],"settings":{"custom_class":"","image":"shopify:\/\/shop_images\/Seatopia.E-Book-8.jpg","image_height":"100vh","image_width":"small","layout":"text_first","text_alignment":"left","content_position":"align-self-center","image_mobile":"shopify:\/\/shop_images\/Seatopia.E-Book-8.jpg","image_height_mobile":"auto","text_alignment_mobile":"left","color_text":"","color_background":"","container_color_bg":"","gradient_background":"","color_background_2":"","gradient_background_2":"","color_highlight":"","gradient_highlight":"","color_button_text":"#ffffff","color_button_background":"#ff7755","color_button_gradient":"","padding_top":100,"padding_bottom":100,"divider":false,"full_width":false,"rounded":false,"enable_parallax":true,"parallax_direction":"vertical"}},"custom_image_with_txt_founder_KtCnzT":{"type":"custom-image-with-txt-founder","blocks":{"heading_dYr9iH":{"type":"heading","settings":{"heading":"Become a sushi chef","heading_size":"title-md","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_MPPkTr":{"type":"text","settings":{"text":"<p>Bring the sushi bar home with <strong>Seatopia 201: Hand Rolls at Home<\/strong> — a fun, interactive class that teaches you how to assemble stunning temaki hand rolls using sushi-grade seafood, fresh ingredients, and clean techniques.<\/p><p>You’ll learn how to:<\/p><ul><li><strong>Slice Sushi-Grade Fish<\/strong> — thinly and evenly for easy rolling.<\/li><li><strong>Build the Perfect Roll<\/strong> — using nori, seasoned rice, and vibrant toppings.<\/li><li><strong>Balance Texture & Temperature<\/strong> — so every bite feels fresh, clean, and oceanic.<\/li><\/ul><p><strong>Prep Reminder:<\/strong><\/p><p>Before your session, thaw one Seatopia fillet (Salmon, Yellowtail, or Steelhead). Have ready: sushi rice (warm or room temperature), nori sheets, soy or tamari, sesame oil, avocado, cucumber, scallions, and a small bowl of water for sealing your rolls.<\/p><p>Perfect for date nights, family dinners, or simply mastering the art of sushi simplicity.<\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"spacing_HYrjWT":{"type":"spacing","settings":{"height":40,"height_mobile":28}},"button_frQEMw":{"type":"button","settings":{"button_label":"Book your free Sushi class","button_link":"https:\/\/calendly.com\/101-seafood\/hand-roll-class?back=1&month=2025-12","button_style":"primary","button_size":"md","button_external":true,"button_icon":true}}},"block_order":["heading_dYr9iH","text_MPPkTr","spacing_HYrjWT","button_frQEMw"],"settings":{"custom_class":"","image":"shopify:\/\/shop_images\/seatopia-sushi-date-night-box-8.jpg","image_height":"100vh","image_width":"medium","layout":"image_first","text_alignment":"left","content_position":"align-self-center","image_mobile":"shopify:\/\/shop_images\/seatopia-sushi-date-night-box-8.jpg","image_height_mobile":"auto","text_alignment_mobile":"left","color_text":"","color_background":"","container_color_bg":"","gradient_background":"","color_background_2":"","gradient_background_2":"","color_highlight":"","gradient_highlight":"","color_button_text":"#ffffff","color_button_background":"#ff7755","color_button_gradient":"","padding_top":100,"padding_bottom":100,"divider":false,"full_width":false,"rounded":false,"enable_parallax":true,"parallax_direction":"vertical"}},"multicolumn_with_icons_dTYEAk":{"type":"multicolumn-with-icons","blocks":{"column_GinHbn":{"type":"column","settings":{"icon":"truck","custom_icon":"","heading":"What to do when you receive your box","text":"<p>How to properly defrost and store sashimi-grade seafood to maximize taste, texture, and mouth feel.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"column_GcDWEt":{"type":"column","settings":{"icon":"clipboard","custom_icon":"","heading":"How to prepare your kitchen for greatness","text":"<p>Get your kitchen ready and stock up on the tools and ingredients you need to create incredible meals at home.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"column_xMHHGX":{"type":"column","settings":{"icon":"check_mark","custom_icon":"","heading":"Easy recipes to get you started","text":"<p>Learn the basics of sashimi, crudo, pan frying, baking, and some incredible recipes to get you started.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["column_GinHbn","column_GcDWEt","column_xMHHGX"],"settings":{"custom_class":"","style":"with-background","columns":3,"text_alignment":"center","dt_txt_alignment":"center","heading":"We teach you","heading_size":"title-md","heading_alignment":"text-center md:items-center","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":72,"padding_bottom":72,"divider":false,"full_width":false,"rounded":false}},"multicolum_with_icon_image_cXbRHT":{"type":"Multicolum-with-icon-image","blocks":{"column_dqVXYH":{"type":"column","settings":{"icon":"truck","custom_icon":"","cstm-sub-heading":"","heading":"What to do when you receive your box","text":"<p>How to properly defrost and store sashimi-grade seafood to maximize taste, texture, and mouth feel.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"column_7aADNd":{"type":"column","settings":{"icon":"clipboard","custom_icon":"","cstm-sub-heading":"","heading":"How to prepare your kitchen for greatness","text":"<p>Get your kitchen ready and stock up on the tools and ingredients you need to create incredible meals at home.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"column_9NiFDg":{"type":"column","settings":{"icon":"check_mark","custom_icon":"","cstm-sub-heading":"","heading":"Easy recipes to get you started","text":"<p>Learn the basics of sashimi, crudo, pan frying, baking, and some incredible recipes to get you started.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["column_dqVXYH","column_7aADNd","column_9NiFDg"],"disabled":true,"settings":{"custom_class":"","style":"with-border","columns":3,"text_alignment":"left","heading":"We teach you","heading_size":"title-md","heading_alignment":"text-center md:items-center","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":72,"divider":false,"full_width":false,"rounded":false}},"portfolio_UDhAKq":{"type":"portfolio","blocks":{"profile_p3Jdxr":{"type":"profile","settings":{"image":"shopify:\/\/shop_images\/ChefJamesReNourish.png","heading":"Chef James","text":"<p>A passionate Chef, underwater photographer & an accomplished surfer & bluewater sailor having lived aboard a sailboat for 10 years, completing the US Coast Guard Captain training & sailed the Eastern Pacific coastline from San Francisco, California to Ecuador & the Galapagos Islands. <\/p>","color_text":"#ffffff","color_background":"#171717"}},"profile_GkeiMW":{"type":"profile","settings":{"image":"shopify:\/\/shop_images\/MT_AG1_Dinner.jpg","heading":"Chef Miriam","text":"<p>Miriam is a certified Functional Nutrition Coach and Private Chef whose healing journey deepened her belief in food as medicine and shaped her focus on autoimmune conditions. Now rooted in Ojai’s agricultural valley, she works with organizations in the regenerative movement, weaving storytelling, experiential learning, and education to inspire systems-level awareness. She believes some of the most profound learning happens over a meal—at home, with food grown nearby, and a community that honors your seat at the table.<\/p>","color_text":"#ffffff","color_background":"#171717"}},"profile_6VdAqa":{"type":"profile","settings":{"image":"shopify:\/\/shop_images\/Screenshot_2025-05-24_at_9.23.35_AM.png","heading":"Chef Clark","text":"<p>Clark worked at Chef Dan Barber’s two Michelin star restaurant, Blue Hill at Stone Barn, in New York as a line cook for two years. He’s worked fall harvest at Morning Glory Farm in Edgartown, Massachusetts, and as a Venture Fellow at Food Future Co. in New York. He holds a BA in philosophy and economics from Claremont McKenna College.<br\/><\/p>","color_text":"#ffffff","color_background":"#171717"}},"profile_KdtE34":{"type":"profile","settings":{"image":"shopify:\/\/shop_images\/Screenshot_2025-07-03_at_8.20.57_AM.png","heading":"Chef Nico","text":"<p>Nicolas Torrent, founder of Circadian Research, brings over a decade of experience as a private chef for high-performance individuals and wellness-focused families. His approach to food is rooted in functional medicine, circadian rhythm alignment, and ancestral wisdom. Chef Nico is currently available for hire in Southern California and Kaua’i for private dinners, retreats, and nutritional consultations.<br\/>📍 Instagram: @circadianresearch<\/p>","color_text":"#ffffff","color_background":"#171717"}}},"block_order":["profile_p3Jdxr","profile_GkeiMW","profile_6VdAqa","profile_KdtE34"],"custom_css":[".portfolio.card-grid {display: flex; flex-wrap: wrap; justify-content: center; \/* Center horizontally *\/ gap: 2rem; \/* Optional: space between cards *\/ padding: 1rem; max-width: 100%; \/* Avoid overflow *\/ margin: 0 auto; \/* Center in parent container *\/}",".portfolio.card-grid .card {max-width: 320px; \/* You can adjust this based on your design *\/ flex: 1 1 300px; \/* Flexible size within constraints *\/}","@media (max-width: 768px) {.portfolio.card-grid .card {max-width: 100%; flex: 1 1 100%; }}"],"settings":{"columns":4,"carousel_on_desktop":false,"layout":"default","image_ratio":"portrait","image_ratio_mobile":"portrait","columns_mobile":"1","swipe_on_mobile":true,"heading":"Your Seatopia Culinary Team","heading_size":"title-md","heading_alignment":"text-center justify-center","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","paddi