240px;}"," \/* Optional: center content inside each product card *\/"],"name":"t:sections.featured-collection.presets.name","settings":{"collection":"","products":["bream-6oz-filets","branzino-bundle-2x-6oz-portions"],"product_limit":6,"columns":4,"carousel_on_desktop":true,"show_view_all":false,"columns_mobile":"1","swipe_on_mobile":true,"heading":"Branzino and Sea Bream","heading_size":"title-md","heading_alignment":"text-center md:items-center","heading_tag":"h2","subheading":"from Esteros Lubimar","description":"","highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":60,"padding_bottom":32,"divider":false,"full_width":false,"rounded":false}},"rich_text_tYfEAp":{"type":"rich-text","blocks":{"heading_zMMcwg":{"type":"heading","settings":{"heading":"Lab tested to ensure it meets the Seatopia Standard","heading_size":"title-lg tracking-heading","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_Lbgpq6":{"type":"text","settings":{"text":"","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"button_JKJaFE":{"type":"button","disabled":true,"settings":{"button_label":"Button label","button_link":"","button_style":"primary","button_size":"md","button_external":false,"button_icon":true}}},"block_order":["heading_zMMcwg","text_Lbgpq6","button_JKJaFE"],"name":"t:sections.rich-text.presets.name","settings":{"custom-class":"","section_id":"","text_alignment":"center","text_alignment_mobile":"left","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":32,"divider":false,"narrow":true,"rounded":false}},"rich_text_fDqEkm":{"type":"rich-text","blocks":{"text_e9xqD8":{"type":"text","settings":{"text":"<p>Esteros Lubimar raises branzino (aka European\/Mediterranean sea bass), and sea bream (aka dorade, or gilt-head bream), which are uniquely suited to the estuary's waters and feed on the microorganisms that live there. These Mediterranean natives are similar in taste, and both thrive in the calm, brackish waters of the Guadalquivir, where they graze naturally on plankton, algae, and small invertebrates, developing rich, a flavors and firm, flaky textures. The result is an incredible sweetness and versatility, and a golden layer of fat, reflective of their diet. Both fish are celebrated for crisp skin when cooked whole. We think they perfectly embody the farm’s philosophy: that the best-tasting fish come from environments where nature leads and humans listen.<\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["text_e9xqD8"],"name":"t:sections.rich-text.presets.name","settings":{"custom-class":"","section_id":"","text_alignment":"left","text_alignment_mobile":"center","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":0,"divider":false,"narrow":true,"rounded":false}},"custom_liquid_DQPWbU":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"section_id":"","liquid":"<div class=\"seatopia-edacious-results-block\">\n  <div\n    data-edacious-results='{\"brand\":\"seatopia\",\"product\":\"esteros-lubimar-sea-bream-fillet\",\"config\":\"xsd8ik\"}'\n  ><\/div>\n\n  <button\n    type=\"button\"\n    class=\"seatopia-coa-link\"\n    aria-label=\"View the Certificate of Analysis for Esteros Lubimar Sea Bream\"\n    onclick=\"window.open('https:\/\/cdn.shopify.com\/s\/files\/1\/0222\/9882\/0682\/files\/MP-Esteros_Lubimar-Sea_Bream-Lot_BR0001.pdf?v=1783785488','_blank','noopener,noreferrer');\"\n  >\n    <span class=\"seatopia-coa-claim\">✓ Zero Detectable Microplastics<\/span>\n    <span class=\"seatopia-coa-action\">View Certificate of Analysis →<\/span>\n  <\/button>\n<\/div>\n\n<style>\n  .seatopia-edacious-results-block {\n    width: 100%;\n  }\n\n  .seatopia-coa-link {\n    appearance: none !important;\n    -webkit-appearance: none !important;\n    background: transparent !important;\n    border: none !important;\n    box-shadow: none !important;\n    padding: 0 !important;\n    margin: 18px 0 0 !important;\n\n    display: flex !important;\n    flex-direction: column !important;\n    align-items: flex-start !important;\n    gap: 4px !important;\n\n    color: #27485b !important;\n    text-align: left !important;\n    cursor: pointer !important;\n    font-family: inherit !important;\n\n    text-decoration: none !important;\n    background-image: none !important;\n  }\n\n  .seatopia-coa-link *,\n  .seatopia-coa-link:before,\n  .seatopia-coa-link:after,\n  .seatopia-coa-link *:before,\n  .seatopia-coa-link *:after {\n    text-decoration: none !important;\n    background-image: none !important;\n    border: none !important;\n    box-shadow: none !important;\n  }\n\n  .seatopia-coa-claim {\n    font-size: 20px;\n    font-weight: 600;\n    line-height: 1.25;\n    color: #27485b;\n  }\n\n  .seatopia-coa-action {\n    font-size: 16px;\n    font-weight: 400;\n    line-height: 1.3;\n    color: #27485b;\n  }\n\n  .seatopia-coa-link:hover {\n    opacity: 0.8;\n  }\n\n  .seatopia-coa-link:focus-visible {\n    outline: 2px solid #27485b;\n    outline-offset: 4px;\n  }\n<\/style>","color_text":"","color_background":"","gradient_background":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":72,"padding_bottom":72,"divider":false,"narrow":false,"rounded":false}},"portfolio_khhjiy":{"type":"portfolio","blocks":{"profile_FtXEVP":{"type":"profile","settings":{"image":"shopify:\/\/shop_images\/Screenshot_2025-05-21_at_10.35.34_AM.png","heading":"Sea Bream Sashimi","text":"<p>Sea Bream Sashimi + Yuzu, Spirulina & Shiso<br\/>A simple, elegant dish packed with Omega-3s, detoxifying spirulina, and the health-boosting properties of Yuzu, rich in vitamin C and antioxidants. Shiso adds digestive support and anti-inflammatory benefits, rounding out the superfood ingredients. Featuring Seatopia’s Sea Bream—tested with some of the highest Omega-3 levels of any fish—this recipe is both a feast for the senses and a boost for your wellness journey. <a href=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/blue-spirulina-sea-bream-sashimi-shiso-yuzu\" target=\"_blank\" title=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/blue-spirulina-sea-bream-sashimi-shiso-yuzu\">Get the Recipe<\/a><\/p>","color_text":"#ffffff","color_background":"#171717"}},"profile_9abkc4":{"type":"profile","settings":{"image":"shopify:\/\/shop_images\/Screenshot_2025-05-21_at_11.52.31_AM.png","heading":"Crispy Skin Branzino","text":"<p>Discover the elegance of Seatopia’s sushi-grade branzino in this recipe featuring a vibrant parsley-spinach pesto. This dish highlights the freshness of toasted pine nuts, lemon, and extra virgin olive oil, paired perfectly with seared branzino.<\/p><p>👉🏽 <a href=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/branzino-with-parsley-spinach-pesto-a-nutritious-gourmet-delight\" target=\"_blank\" title=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/branzino-with-parsley-spinach-pesto-a-nutritious-gourmet-delight\">Get the recipe<\/a><\/p>","color_text":"#ffffff","color_background":"#171717"}},"profile_tPnk6G":{"type":"profile","settings":{"image":"shopify:\/\/shop_images\/Screenshot_2025-05-21_at_11.55.15_AM.png","heading":"Branzino Salad","text":"<p>Panzanella or panmolle is a Tuscan and Umbrian chopped salad of soaked stale bread, onions and tomatoes that is popular in the summer. It often includes cucumbers, sometimes basil and is dressed with olive oil and vinegar. It is also popular in other parts of central Italy. Paired with clean Mediterranean Seabass its a classic staple of the Mediterranean diet.<\/p><p>👉🏽 <a href=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/branzino-panzanella-salad\" target=\"_blank\" title=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/branzino-panzanella-salad\">Get the recipe<\/a><\/p>","color_text":"#ffffff","color_background":"#171717"}}},"block_order":["profile_FtXEVP","profile_9abkc4","profile_tPnk6G"],"custom_css":["\/* Center the tiles inside the grid *\/.portfolio.card-grid {display: flex; flex-wrap: wrap; justify-content: center; gap: 2rem; padding: 1rem; text-align: center;}"," \/* Optional: center the parent container if needed *\/.card-grid--4 {justify-content: center;}",".grid {justify-content: center;}",".profile.card {max-width: clamp(250px, 25vw, 300px); width: 100%;}"],"name":"t:sections.portfolio.presets.name","settings":{"columns":4,"carousel_on_desktop":false,"layout":"default","image_ratio":"portrait","image_ratio_mobile":"portrait","columns_mobile":"1","swipe_on_mobile":true,"heading":"Branzino and Sea Bream Recipes","heading_size":"title-md","heading_alignment":"text-center justify-center","heading_tag":"h2","subheading":"","description":"