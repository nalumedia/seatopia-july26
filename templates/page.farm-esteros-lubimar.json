{"sections":{"main-page":{"type":"main-page","disabled":true,"settings":{"heading_size":"title-xl tracking-heading","heading_alignment":"text-left","heading_tag":"h1","text_size":"text-base","padding_top":72,"padding_bottom":120,"divider":false,"narrow":true,"rounded":false}},"image_with_text_overlay_kLza9i":{"type":"image-with-text-overlay","blocks":{"breadcrumb_BJUb9g":{"type":"breadcrumb","disabled":true,"settings":{}},"subheading_qdxMYq":{"type":"subheading","settings":{"subheading":"Esteros Lubimar | Andalusia, Spain","subheading_size":"subtitle-md","secondary_color":false}},"heading_AjG4JM":{"type":"heading","settings":{"heading":"From the Estuaries of Cádiz","heading_size":"title-lg tracking-heading","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_KL3hEA":{"type":"text","settings":{"text":"","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["breadcrumb_BJUb9g","subheading_qdxMYq","heading_AjG4JM","text_KL3hEA"],"name":"t:sections.image-with-text-overlay.presets.name","settings":{"section_id":"","transparent_header":true,"image":"shopify:\/\/shop_images\/flamingos-esteros-lubimar.jpg","image_height":"650px","content_width":"small","content_position":"md:items-end md:justify-start","text_alignment":"left","image_height_mobile":"auto","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","color_text":"#ffffff","color_highlight":"#e0a580","gradient_highlight":"","color_button_text":"#171717","color_button_background":"#ffffff","color_button_gradient":"","color_overlay":"#171717","overlay_opacity":24,"padding_top":0,"padding_bottom":0,"divider":false,"full_width":true,"rounded":false,"enable_parallax":false,"narrow":false,"parallax_direction":"vertical"}},"highlight_text_AJeTin":{"type":"highlight-text","blocks":{"heading_PMBeRc":{"type":"heading","settings":{"heading":"Where farming fish means restoring nature","heading_size":"title-md","heading_tag":"h1","highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["heading_PMBeRc"],"custom_css":[],"name":"t:sections.highlight-text.presets.name","settings":{"text_alignment":"left","text_alignment_mobile":"center","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":60,"padding_bottom":32,"divider":false,"narrow":false,"rounded":false}},"rich_text_ENwwLT":{"type":"rich-text","blocks":{"text_aXfMMX":{"type":"text","settings":{"text":"<p>Esteros Lubimar is the evolution of a vision—where farming fish means restoring nature, not depleting it. Nestled in the estuaries of Cádiz, Spain, this pioneering aquaculture farm revives the art of extensive, regenerative seafood production once championed by Veta La Palma—the very farm celebrated by Chef Dan Barber in The Third Plate and his iconic TED Talk.<\/p><p>Here, fish are raised in harmony with the tides, in vast semi-natural lagoons, feeding on the estuary’s rich plankton and algae, free from artificial inputs. The result is seafood of exceptional flavor and nutritional value, prized by world-class chefs and grown without compromising the environment. Esteros Lubimar is not just a farm—it’s a thriving ecosystem that feeds both people and the planet, offering a bold new blueprint for the future of aquaculture.<\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["text_aXfMMX"],"name":"t:sections.rich-text.presets.name","settings":{"custom-class":"","section_id":"","text_alignment":"left","text_alignment_mobile":"center","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":60,"divider":false,"narrow":false,"rounded":false}},"collage_DpiTir":{"type":"collage","blocks":{"image_fbk9FG":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/microalge-estuary_9d37746e-774b-4a63-ad9c-830265fdbac0.jpg","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}},"image_tEppWi":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/2.15-1024x675.jpg","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}},"image_YdEwXg":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/organic-sea-bream_1512x_4fbe91c6-b27d-46b9-80b3-7c82ad954141.webp","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}},"image_6EVEmG":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/1.-QUIENES-SOMOS-1-1024x683.jpg","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}}},"block_order":["image_fbk9FG","image_tEppWi","image_YdEwXg","image_6EVEmG"],"name":"t:sections.collage.presets.name","settings":{"heading":"A confluence of land and sea","heading_size":"title-md","heading_alignment":"text-center md:items-center","heading_tag":"h2","subheading":"","description":"<p>These nutrient-dense estuaries of the Guadalquivir River serve as vital nurseries for marine species, migratory stopovers for birds, and natural aquatic vegetation that filters and oxygenates the water. Shaped by centuries of tidal rhythms and traditional salt farming, the estuaries provide a pristine environment for raising fish. Their dynamic ecosystems support a delicate balance of plankton, algae, and low-trophic organisms, creating an ideal, self-sustaining food web. <\/p>","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":0,"divider":false,"full_width":false,"rounded":false,"enable_parallax":true}},"video_with_text_jg6Mgi":{"type":"video-with-text","blocks":{"heading_Lt3JWg":{"type":"heading","settings":{"heading":"A new wave of aquaculture","heading_size":"title-md","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_YaVhXe":{"type":"text","settings":{"text":"<p>At Esteros Lubimar, bream and branzino feed the way nature intended, grazing freely on the diverse array of nutrients found in the estuarine ecosystem. <\/p><p>Their diet consists of naturally occurring plankton, algae, and low-trophic organisms like small crustaceans and mollusks that flourish in the nutrient-rich waters of the Cádiz estuaries. <\/p><p>To account for any seasonal or tidal variations, and to ensure fish get enough calories, their diets are supplemented by a natural, non-GMO feed supplement of plant proteins and algae. This natural food web not only supports the health and vitality of the fish but also enhances their flavor, resulting in clean, oceanic notes and a superior texture and removes the need for any antibiotics or special treatment. <\/p><p>By eliminating the need fish 100% raised on conventional feed, Esteros Lubimar reduces environmental impact and feed-related emissions, creating a closed-loop system where the ecosystem sustains itself. It’s a result that is enabled by it's philosophy, and one that we seek to replicate. <\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"button_7U3fqD":{"type":"button","disabled":true,"settings":{"button_label":"Button label","button_link":"","button_style":"primary","button_size":"md","button_external":false,"button_icon":true}}},"block_order":["heading_Lt3JWg","text_YaVhXe","button_7U3fqD"],"name":"t:sections.video-with-text.presets.name","settings":{"video":"shopify:\/\/files\/videos\/Lubimar Interview v2.mp4","video_url":"","description":"","enable_video_autoplay":false,"enable_video_looping":false,"image_height":"700px","video_width":"small","layout":"video_first","text_alignment":"left","content_position":"align-self-center","video_url_mobile":"","image_height_mobile":"600px","text_alignment_mobile":"left","color_text":"","color_background":"","gradient_background":"","color_background_2":"","gradient_background_2":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":72,"padding_bottom":72,"divider":false,"full_width":false,"rounded":false,"enable_parallax":false,"parallax_direction":"vertical"}},"video_with_text_FUAJfD":{"type":"video-with-text","blocks":{"heading_3hdhjW":{"type":"heading","settings":{"heading":"Esteros Lubimar - in harmony with nature","heading_size":"title-md","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_KKca6r":{"type":"text","settings":{"text":"<p>The estuary harbours a fascinating combination of wildlife, and Esteros Lubimar consider themselves stewards and wardens of this very special place. Watch their video to dive into the estuary.<\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"button_Kx44Ar":{"type":"button","disabled":true,"settings":{"button_label":"Button label","button_link":"","button_style":"primary","button_size":"md","button_external":false,"button_icon":true}}},"block_order":["heading_3hdhjW","text_KKca6r","button_Kx44Ar"],"name":"t:sections.video-with-text.presets.name","settings":{"video_url":"https:\/\/www.youtube.com\/watch?v=npDRMsosDCI&t=1s","cover_image":"shopify:\/\/shop_images\/Screenshot_20