    "at_a_glance": {
      "type": "multicolumn-with-icons",
      "blocks": {
        "glance_time": {
          "type": "column",
          "settings": {
            "icon": "time",
            "custom_icon": "",
            "heading": "50 minutes, mostly hands-off",
            "text": "<p>20 minutes prep, 30 minutes cooking. The sweet potatoes air fry for 20 while you blend the sauce and shave the salad.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "glance_serves": {
          "type": "column",
          "settings": {
            "icon": "users",
            "custom_icon": "",
            "heading": "Serves 2",
            "text": "<p>Two King Salmon portions, two Japanese sweet potatoes, one bunch each of parsley and cilantro. Scales cleanly to four.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "glance_method": {
          "type": "column",
          "settings": {
            "icon": "lightning",
            "custom_icon": "",
            "heading": "Air fryer, 400&deg;F",
            "text": "<p>Sweet potatoes 20 minutes, salmon 8&ndash;10. No pan to watch, no oven to heat, nothing to flip.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "glance_omega": {
          "type": "column",
          "settings": {
            "icon": "award",
            "custom_icon": "",
            "heading": "3,430 mg EPA+DHA",
            "text": "<p>Per 8.5&nbsp;oz Ōra King portion &mdash; 1,140&nbsp;mg EPA and 2,290&nbsp;mg DHA, plus 64&nbsp;mcg selenium.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
      "block_order": [
        "glance_time",
        "glance_serves",
        "glance_method",
        "glance_omega"
      ],
