    "collab_card": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_id": "recipe-collab",
        "liquid": "\n<style>\n  .sea-collab {\n    --ink: #171717;\n    --muted: #5c5c5c;\n    --line: #e5e2dc;\n    --wash: #faf8f4;\n    --gold: #bb8f50;\n    border: 1px solid var(--line);\n    border-radius: 18px;\n    background: var(--wash);\n    padding: 24px 28px;\n    display: flex;\n    align-items: center;\n    gap: 20px;\n    flex-wrap: wrap;\n    color: var(--ink);\n  }\n  .sea-collab__avatar {\n    flex: 0 0 auto;\n    width: 68px;\n    height: 68px;\n    border-radius: 50%;\n    overflow: hidden;\n    border: 2px solid #fff;\n    box-shadow: 0 0 0 2px var(--gold);\n    background: #eee;\n  }\n  .sea-collab__avatar img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n  .sea-collab__body { flex: 1 1 260px; min-width: 0; }\n  .sea-collab__eyebrow {\n    font-size: 11px;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n    color: var(--gold);\n    font-weight: 600;\n    margin: 0 0 5px;\n  }\n  .sea-collab__name {\n    font-size: 21px;\n    font-weight: 600;\n    line-height: 1.2;\n    margin: 0 0 4px;\n  }\n  .sea-collab__name a { color: inherit; text-decoration: none; }\n  .sea-collab__name a:hover { text-decoration: underline; }\n  .sea-collab__role {\n    font-size: 15px;\n    color: var(--muted);\n    line-height: 1.45;\n    margin: 0;\n  }\n  .sea-collab__cred {\n    font-size: 13px;\n    color: var(--muted);\n    line-height: 1.5;\n    margin: 10px 0 0;\n    padding-top: 10px;\n    border-top: 1px solid var(--line);\n  }\n  .sea-collab__follow {\n    flex: 0 0 auto;\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 11px 20px;\n    border: 1px solid var(--ink);\n    border-radius: 999px;\n    font-size: 15px;\n    font-weight: 600;\n    text-decoration: none;\n    color: var(--ink);\n    background: #fff;\n    transition: background .18s ease, color .18s ease;\n  }\n  .sea-collab__follow:hover { background: var(--ink); color: #fff; }\n  .sea-collab__follow svg { width: 18px; height: 18px; }\n  @media (max-width: 749px) {\n    .sea-collab { padding: 20px; gap: 16px; }\n    .sea-collab__follow { width: 100%; justify-content: center; }\n    .sea-collab__name { font-size: 19px; }\n  }\n</style>\n\n<div class=\"sea-collab\">\n  <div class=\"sea-collab__avatar\">\n    <img\n      src=\"{{ 'alex-silver-fagan.jpg' | file_url }}\"\n      alt=\"Alex Silver-Fagan, founder of Flow Into Strong\"\n      width=\"600\"\n      height=\"600\"\n      loading=\"lazy\"\n      decoding=\"async\">\n  </div>\n\n  <div class=\"sea-collab__body\">\n    <p class=\"sea-collab__eyebrow\">Flow Into Strong &times; Seatopia</p>\n    <p class=\"sea-collab__name\">\n      Recipe by <a href=\"https://www.alexsilverfagan.com/\" target=\"_blank\" rel=\"noopener noreferrer\">Alex Silver-Fagan</a>\n    </p>\n    <p class=\"sea-collab__role\">Fitness professional, mental health advocate and founder of <em>Flow Into Strong</em> &mdash; a method blending strength, mindfulness and self-discovery.</p>\n    <p class=\"sea-collab__cred\">Youngest Nike Master Trainer at 23 &middot; 350-hour yoga teacher &middot; SFG &amp; RKC kettlebell specialist</p>\n  </div>\n\n  <a class=\"sea-collab__follow\"\n     href=\"https://www.instagram.com/alexsilverfagan/\"\n     target=\"_blank\"\n     rel=\"noopener noreferrer\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n      <rect x=\"2\" y=\"2\" width=\"20\" height=\"20\" rx=\"5\"></rect>\n      <circle cx=\"12\" cy=\"12\" r=\"4\"></circle>\n      <circle cx=\"17.5\" cy=\"6.5\" r=\"1.2\" fill=\"currentColor\" stroke=\"none\"></circle>\n    </svg>\n    <span>Follow</span>\n  </a>\n</div>\n",
        "color_text": "",
        "color_background": "",
        "gradient_background": "",
        "color_button_text": "",
        "color_button_background": "",
        "color_button_gradient": "",
        "padding_top": 28,
        "padding_bottom": 8,
        "divider": false,
        "narrow": true,
        "rounded": false
      }
    },
    "rich_text_intro": {
      "type": "rich-text",
      "blocks": {
        "text_intro": {
          "type": "text",
          "settings": {
            "text": "<p>A bowl built backwards from what your body needs after training: <strong>3,430&nbsp;mg of EPA+DHA</strong> from a single Ōra King portion, slow carbohydrate from air-fried Japanese sweet potato, and a raw herb sauce doing the work that a bottled dressing usually doesn&rsquo;t. Fifty minutes start to finish, and the air fryer does most of it.</p>",
            "text_size": "subtext-md",
            "text_max_size": 32,
            "text_font": "body",
            "secondary_color": false,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "text2_intro": {
          "type": "text",
          "settings": {
            "text": "<p>This one is a collaboration with <a href=\"https://www.instagram.com/alexsilverfagan/\" target=\"_blank\" rel=\"noopener\">Alex Silver-Fagan</a> &mdash; fitness professional, mental health advocate and founder of <em>Flow Into Strong</em>. Her framing for the bowl was simple: every ingredient in it is chosen for recovery, hormones, hair and skin. Nothing is here for decoration.</p>",
            "text_size": "subtext-md",
            "text_max_size": 32,
            "text_font": "body",
            "secondary_color": false,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "text3_intro": {
          "type": "text",
          "settings": {
            "text": "<p>The salmon is Seatopia <a href=\"/products/king-salmon\">King Salmon</a> from <a href=\"/pages/ora-king-salmon-new-zealand\">Ōra King</a> in New Zealand &mdash; 8.5&nbsp;oz skin-on, sushi-grade, third-party lab tested to the <a href=\"/pages/why-clean-seafood-matters\">Seatopia Standard&trade;</a> at mercury &le;&nbsp;0.1&nbsp;ppm with zero detectable microplastics in the samples analyzed.</p>",
            "text_size": "subtext-md",
            "text_max_size": 32,
            "text_font": "body",
            "secondary_color": false,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
      "block_order": [
        "text_intro",
        "text2_intro",
        "text3_intro"
      ],
