    "why_it_works": {
      "type": "multicolumn-with-icons",
      "blocks": {
        "why_recovery": {
          "type": "column",
          "settings": {
            "icon": "shield",
            "custom_icon": "",
            "heading": "Recovery",
            "text": "<p>3,430&nbsp;mg of marine omega-3s per portion. EPA and DHA are the forms your body actually uses &mdash; no conversion step, unlike the ALA in flax or chia.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "why_hormones": {
          "type": "column",
          "settings": {
            "icon": "heart",
            "custom_icon": "",
            "heading": "Hormones",
            "text": "<p>64&nbsp;mcg of selenium per portion, plus fat-soluble vitamins carried by the olive oil in the sauce. Salmon is one of the few foods dense in both.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "why_skinhair": {
          "type": "column",
          "settings": {
            "icon": "star",
            "custom_icon": "",
            "heading": "Skin &amp; hair",
            "text": "<p>Protein and DHA together, with vitamin C from lemon and raw herbs in the sauce &mdash; which is why the sauce is blended raw rather than cooked.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
      "block_order": [
        "why_recovery",
        "why_hormones",
        "why_skinhair"
      ],
