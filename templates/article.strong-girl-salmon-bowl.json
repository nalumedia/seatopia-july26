    "build_the_bowl": {
      "type": "multicolumn-with-icons",
      "blocks": {
        "part_base": {
          "type": "column",
          "settings": {
            "icon": "box",
            "custom_icon": "",
            "heading": "1. Air-fried Japanese sweet potato",
            "text": "<p>Peeled, diced, olive oil and salt, 20 minutes at 400&deg;F. Sweeter and drier than orange sweet potato &mdash; it crisps instead of steaming.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "part_protein": {
          "type": "column",
          "settings": {
            "icon": "lightning",
            "custom_icon": "",
            "heading": "2. King Salmon",
            "text": "<p>Patted dry, salted, 8&ndash;10 minutes at 400&deg;F. Drying the surface is the whole trick: wet fish steams, dry fish browns.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "part_sauce": {
          "type": "column",
          "settings": {
            "icon": "organic",
            "custom_icon": "",
            "heading": "3. Herby green sauce",
            "text": "<p>Parsley, cilantro, tarragon, garlic, lemon and olive oil, blended raw. This is the acid and the freshness &mdash; make it while the potatoes cook.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "part_crunch": {
          "type": "column",
          "settings": {
            "icon": "star",
            "custom_icon": "",
            "heading": "4. Shaved carrot &amp; radish",
            "text": "<p>Shaved thin, tossed with lemon, olive oil, manuka honey and salt, then left 20 minutes to soften slightly. Arugula underneath for pepper.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
      "block_order": [
        "part_base",
        "part_protein",
        "part_sauce",
        "part_crunch"
      ],
