    "rich_text_intro": {
      "type": "rich-text",
      "blocks": {
        "text_intro": {
          "type": "text",
          "settings": {
            "text": "<p>This dish is delightful served warm, but it is also built for the days ahead &mdash; it gets better overnight and is just as good at room temperature. Chewy farro meets earthy maitake, toasted hazelnut and crisp pear, against flaky branzino and its crackling skin.</p><p>Two things decide whether it works. The skin needs thirty seconds under a spatula or it curls off the pan and never crisps. And the dressing goes on off the heat, so the miso keeps its flavour rather than cooking out.</p>",
            "text_size": "subtext-md",
            "text_max_size": 32,
            "text_font": "body",
            "secondary_color": false,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
