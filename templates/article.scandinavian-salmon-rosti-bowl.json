    "rich_text_intro": {
      "type": "rich-text",
      "blocks": {
        "text_intro": {
          "type": "text",
          "settings": {
            "text": "<p>Salmon coated in a lingonberry-Dijon-yogurt sauce that caramelises lightly as it cooks, flaked over loose, craggy potato r&ouml;sti and finished with quick-pickled cucumber, radish and more of the same sauce spooned over cold.</p><p>Squeeze the grated potato properly dry &mdash; that one step is the difference between crisp strands and a soft pancake. Works in an air fryer or a conventional oven.</p>",
            "text_size": "subtext-md",
            "text_max_size": 32,
            "text_font": "body",
            "secondary_color": false,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
