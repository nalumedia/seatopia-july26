g_bottom":32,"divider":false,"full_width":false,"rounded":false}},"rich_text_tYfEAp":{"type":"rich-text","blocks":{"heading_zMMcwg":{"type":"heading","settings":{"heading":"Lab Tested to Ensure It Meets the Seatopia Standard","heading_size":"title-lg tracking-heading","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_Lbgpq6":{"type":"text","settings":{"text":"","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"button_JKJaFE":{"type":"button","disabled":true,"settings":{"button_label":"Button label","button_link":"","button_style":"primary","button_size":"md","button_external":false,"button_icon":true}}},"block_order":["heading_zMMcwg","text_Lbgpq6","button_JKJaFE"],"settings":{"custom-class":"","text_alignment":"center","text_alignment_mobile":"left","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":32,"divider":false,"narrow":true,"rounded":false}},"rich_text_fDqEkm":{"type":"rich-text","blocks":{"text_e9xqD8":{"type":"text","settings":{"text":"<p>The salmon at Mt. Cook are nourished with a premium, hand-fed diet tailored to support both fish health and clean flavor. Their feed is free from GMOs, hormones, and antibiotics, and is composed of sustainably sourced marine proteins, poultry oil, essential plant-based nutrients like fava beans, and naturally derived astaxanthin: the antioxidant that gives king salmon their deep coral hue. This balanced diet supports robust health, a high omega-3 profile, and excellent taste while being species appropriate and environmentally conscious. With full traceability and thoughtful formulation, Mt. Cook’s feed philosophy is an extension of their commitment to purity, sustainability, and responsible farming.<\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["text_e9xqD8"],"settings":{"custom-class":"","text_alignment":"left","text_alignment_mobile":"center","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":0,"divider":false,"narrow":true,"rounded":false}},"custom_liquid_rgQ9BW":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"liquid":"<div data-edacious-results='{\"brand\": \"seatopia\", \"product\": \"mt-cook-king-salmon\", \"config\": \"5wfy5l\"}'><\/div>","color_text":"","color_background":"","gradient_background":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":40,"padding_bottom":40,"divider":false,"narrow":false,"rounded":false}},"portfolio_khhjiy":{"type":"portfolio","blocks":{"profile_FtXEVP":{"type":"profile","settings":{"image":"shopify:\/\/shop_images\/Screenshot_2025-06-25_at_8.44.12_AM.png","heading":"Broiled Miso  Salmon Bowl","text":"<p>This ritualistic recipe celebrates the art of a 48-hour marinade, blending saké, miso, and coconut sugar to create a deeply flavorful glaze. We'll guide you through every step—from preparing the marinade to broiling the salmon to perfection and plating it with sushi rice, purple broccolini, pickled onions, and creamy avocado.<\/p><p>👉🏽 <a href=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/broiled-miso-salmon-bowl-sushi-rice-avocado\" target=\"_blank\" title=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/broiled-miso-salmon-bowl-sushi-rice-avocado\">Get the Recipe<\/a><\/p>","color_text":"#ffffff","color_background":"#171717"}},"profile_9abkc4":{"type":"profile","settings":{"image":"shopify:\/\/shop_images\/Screenshot_2025-06-25_at_8.45.54_AM.png","heading":"Spirulina-Infused Crudo","text":"<p><em>Prepare Steelhead Crudo with green spirulina emulsion. Seatopia’s sushi-grade seafood delivers abundant Omega-3s to support heart and brain health.<\/em><\/p><p>👉🏽 <a href=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/spirulina-infused-crudo-with-seatopia-steelhead\" target=\"_blank\" title=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/spirulina-infused-crudo-with-seatopia-steelhead\">Get the recipe<\/a><\/p>","color_text":"#ffffff","color_background":"#171717"}},"profile_tPnk6G":{"type":"profile","settings":{"image":"shopify:\/\/shop_images\/Screenshot_2025-06-25_at_8.47.03_AM.png","heading":"Salmon Poke Bowl","text":"<p>Join us in this new recipe where we dive into the traditional flavors of Hawaii with a classic Salmon Poke, made with New Zealand King Salmon from Seatopia. This step-by-step guide walks you through preparing a flavorful poke, marrying the rich taste of sushi-grade salmon, loaded with omega-3s, with the freshness of pickled ginger and garlic, known for their digestive and immune-supporting properties. Perfectly paired with organic sushi rice and creamy avocado, this dish is a true celebration of Hawaiian cuisine and wholesome nourishment.<\/p><p>👉🏽 <a href=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/salmon-poke-101-tamari-ginger-garlic\" target=\"_blank\" title=\"https:\/\/seatopia.fish\/blogs\/seafood-re