title-md","heading_tag":"h1","highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["heading_PMBeRc"],"custom_css":[],"settings":{"text_alignment":"left","text_alignment_mobile":"center","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":60,"padding_bottom":32,"divider":false,"narrow":false,"rounded":false}},"rich_text_ENwwLT":{"type":"rich-text","blocks":{"text_aXfMMX":{"type":"text","settings":{"text":"<p>Hudson Valley Fisheries raises sushi-grade steelhead trout in a land-based recirculating aquaculture system (RAS) in the heart of New York’s Hudson Valley. With zero risk of escape into wild ecosystems or use of antibiotics, this is aquaculture done with precision and purpose. The result is steelhead with a buttery, mild flavor, firm texture, and beautiful color. Rich in omega-3s and favored by New York chefs for its versatility. Raised with care from egg to harvest in an indoor facility powered by smart water recycling and clean feed, this steelhead trout offers the integrity of local, traceable production with the culinary quality of the finest seafood in the world.<\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["text_aXfMMX"],"settings":{"custom-class":"","section_id":"","text_alignment":"left","text_alignment_mobile":"center","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":60,"divider":false,"narrow":false,"rounded":false}},"collage_DpiTir":{"type":"collage","blocks":{"image_j3jWR4":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/Screen_Shot_2025-07-01_at_4.56.15_PM.png","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}},"image_7fiqzh":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/Screen_Shot_2025-07-01_at_4.59.53_PM.png","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}},"image_KxrKPV":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/Screen_Shot_2025-07-01_at_4.58.34_PM.png","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}},"image_b7LfNg":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/Screen_Shot_2025-07-01_at_5.16.56_PM.png","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}}},"block_order":["image_j3jWR4","image_7fiqzh","image_KxrKPV","image_b7LfNg"],"settings":{"heading":"A Model for Farming Near Densely Populated Markets in New York","heading_size":"title-md","heading_alignment":"text-center md:items-center","heading_tag":"h2","subheading":"","description":"<p>The facility sits in Columbia County, just a few hours from New York City, where it draws city water into a fully closed-loop RAS system. This biosecure environment keeps fish safe from outside pathogens and predators while eliminating environmental discharge and escapes. It’s a climate-controlled ecosystem that recycles over 99% of its water, filters solids into organic potting soil, and even shares nutrient-rich wastewater with a neighboring cannabis farm. Locating the farm near major food markets not only ensures unbeatable freshness but significantly reduces the carbon footprint compared to remote sea farms or long-haul imports. <\/p>","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":0,"divider":false,"full_width":false,"rounded":false,"enable_parallax":true}},"video_with_text_FUAJfD":{"type":"video-with-text","blocks":{"heading_3hdhjW":{"type":"heading","settings":{"heading":"Seafood Watch's \"Best Choice\" Steelhead Trout","heading_size":"title-md","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_KKca6r":{"type":"text","settings":{"text":"<p>Hudson Valley Fisheries is the creation of  a team of aquaculture engineers, environmental scientists, and food system realists led by Ed Tribe committed to doing things differently, and doing them right. Ed spent years refining the operation, combining art and science to raise fish in a tightly controlled, land-based system that sets a new standard for domestic aquaculture. With over 100 employees and a 24\/7 operation, the farm is built on deep curiosity and high standards. Regularly audited, 4-Star BAP, continually optimized, and driven by a belief that food should nourish both people and planet. Their work supports rural jobs, local food systems, and the next generation of responsible aquaculture.<\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"button_Kx44Ar":{"type":"button","disabled":true,"settings":{"button_label":"Button label","button_link":"","button_style":"primary","button_size":"md","button_external":false,"button_icon":true}}},"block_order":["heading_3hdhjW","text_KKca6r","button_Kx44Ar"],"settings":{"video_url":"https:\/\/www.youtube.com\/watch?v=j5jedw-cdZM&t=1s","cover_image":"shopify:\/\/shop_images\/Screen_Shot_2025-07-01_at_5.20.36_PM.png","description":"","enable_video_autoplay":false,"enable_video_looping":false,"image_height":"adapt","video_width":"medium","layout":"video_first","text_alignment":"left","content_position":"align-self-center","video_url_mobile":"","i