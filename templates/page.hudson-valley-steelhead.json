e-md","heading_alignment":"text-center md:items-center","heading_tag":"h2","subheading":"Hudson Valley Fisheries","description":"<p>Hudson Valley raises <em>Oncorhynchus mykiss<\/em>, also known as steelhead trout, a species that bridges the gap between trout and salmon in both biology and flavor. While steelhead are trout by classification, they share the anadromous life cycle of salmon, traditionally migrating between fresh and salt water. The result is a fish with the color, texture, and taste of salmon, but with a more delicate flavor and slightly leaner profile. Rich in omega-3s and high in protein, steelhead is versatile in the kitchen: perfect for sashimi, searing, baking, or smoking.<\/p>","highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":60,"padding_bottom":32,"divider":false,"full_width":false,"rounded":false}},"rich_text_tYfEAp":{"type":"rich-text","blocks":{"heading_zMMcwg":{"type":"heading","settings":{"heading":"Clean feed, 0.0 antibiotics, dyes or hormones. Third-party lab tested for mercury and microplastics","heading_size":"title-lg tracking-heading","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_Lbgpq6":{"type":"text","settings":{"text":"","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"button_JKJaFE":{"type":"button","disabled":true,"settings":{"button_label":"Button label","button_link":"","button_style":"primary","button_size":"md","button_external":false,"button_icon":true}}},"block_order":["heading_zMMcwg","text_Lbgpq6","button_JKJaFE"],"settings":{"custom-class":"","section_id":"","text_alignment":"center","text_alignment_mobile":"left","heading":"","heading_size":"title-md","heading_alignment":"text-l