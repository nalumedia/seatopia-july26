    "heat_note": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_id": "build-in-layers",
        "liquid": "<style>\n  .sea-pepper {\n    --ink: #171717;\n    --muted: #5c5c5c;\n    --line: #e5e2dc;\n    --wash: #faf8f4;\n    --gold: #bb8f50;\n    color: var(--ink);\n    background: var(--wash);\n    border: 1px solid var(--line);\n    border-radius: 20px;\n    padding: 30px;\n  }\n  .sea-pepper__grid {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) minmax(0, 300px);\n    gap: 34px;\n    align-items: center;\n  }\n  .sea-pepper__eyebrow {\n    font-size: 11px;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n    color: var(--gold);\n    font-weight: 600;\n    margin: 0 0 8px;\n  }\n  .sea-pepper__heading {\n    font-size: clamp(23px, 2.8vw, 30px);\n    line-height: 1.15;\n    font-weight: 600;\n    margin: 0 0 10px;\n  }\n  .sea-pepper__lede {\n    font-size: 15px;\n    line-height: 1.55;\n    color: var(--muted);\n    margin: 0 0 22px;\n  }\n  .sea-pepper__rows {\n    display: grid;\n    gap: 14px;\n  }\n  .sea-pepper__row {\n    background: #fff;\n    border: 1px solid var(--line);\n    border-radius: 14px;\n    padding: 15px 17px;\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) auto;\n    gap: 10px 16px;\n    align-items: center;\n  }\n  .sea-pepper__row--pick {\n    border-color: var(--gold);\n    box-shadow: 0 0 0 1px var(--gold);\n  }\n  .sea-pepper__name {\n    grid-column: 1;\n    margin: 0;\n    font-size: 15px;\n    font-weight: 600;\n    line-height: 1.3;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    flex-wrap: wrap;\n  }\n  .sea-pepper__tag {\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n    color: #fff;\n    background: var(--gold);\n    padding: 3px 8px;\n    border-radius: 999px;\n  }\n  .sea-pepper__meter {\n    grid-column: 2;\n    grid-row: 1;\n    display: flex;\n    gap: 4px;\n    align-items: center;\n  }\n  .sea-pepper__pip {\n    width: 9px;\n    height: 9px;\n    border-radius: 50%;\n    background: #fff;\n    border: 1.5px solid #d8cfc0;\n  }\n  .sea-pepper__pip.is-on {\n    background: #b8462f;\n    border-color: #b8462f;\n  }\n  .sea-pepper__note {\n    grid-column: 1 / -1;\n    margin: 0;\n    font-size: 13.5px;\n    line-height: 1.5;\n    color: var(--muted);\n  }\n  .sea-pepper__legend {\n    margin: 16px 0 0;\n    padding-top: 14px;\n    border-top: 1px solid var(--line);\n    font-size: 13px;\n    line-height: 1.55;\n    color: var(--muted);\n  }\n  .sea-pepper__figure {\n    margin: 0;\n  }\n  .sea-pepper__figure img {\n    width: 100%;\n    height: auto;\n    display: block;\n    border-radius: 16px;\n    box-shadow: 0 14px 34px -22px rgba(0,0,0,.5);\n  }\n  .sea-pepper__cap {\n    margin: 10px 0 0;\n    font-size: 12.5px;\n    line-height: 1.5;\n    color: var(--muted);\n  }\n  @media (max-width: 989px) {\n    .sea-pepper {\n      padding: 22px;\n    }\n    .sea-pepper__grid {\n      grid-template-columns: 1fr;\n      gap: 24px;\n    }\n    .sea-pepper__figure {\n      order: -1;\n    }\n  }\n  .sea-pepper__step {\n    grid-column: 2;\n    grid-row: 1;\n    font-size: 11px;\n    font-weight: 600;\n    letter-spacing: .1em;\n    text-transform: uppercase;\n    color: var(--gold);\n  }\n</style>\n\n<div class=\"sea-pepper\">\n  <div class=\"sea-pepper__grid\">\n\n    <div class=\"sea-pepper__body\">\n      <p class=\"sea-pepper__eyebrow\">Build it in layers</p>\n      <h2 class=\"sea-pepper__heading\">Five layers, in this order.</h2>\n      <p class=\"sea-pepper__lede\">\n        The order is the recipe. Crema first so the trout has something to hold onto, the wet salsa on top\n        of the fish rather than under it, and the drizzle last.\n      </p>\n\n      <div class=\"sea-pepper__rows\">\n      <div class=\"sea-pepper__row sea-pepper__row--pick\">\n        <p class=\"sea-pepper__name\">\n          <span>Avocado lime crema</span>\n          <span class=\"sea-pepper__tag\">The base</span>\n        </p>\n        <span class=\"sea-pepper__step\">Layer 1</span>\n        <p class=\"sea-pepper__note\">Spread it thick, right to the edge. It is the glue that holds everything else on the tostada.</p>\n      </div>\n      <div class=\"sea-pepper__row\">\n        <p class=\"sea-pepper__name\">\n          <span>Smoked trout</span>\n          <span class=\"sea-pepper__tag\">Big flakes</span>\n        </p>\n        <span class=\"sea-pepper__step\">Layer 2</span>\n        <p class=\"sea-pepper__note\">Break it by hand into big pieces and pile them on. Big flakes keep the trout the star of every bite.</p>\n      </div>\n      <div class=\"sea-pepper__row\">\n        <p class=\"sea-pepper__name\">\n          <span>Cucumber salsa</span>\n          <span class=\"sea-pepper__tag\">The fresh part</span>\n        </p>\n        <span class=\"sea-pepper__step\">Layer 3</span>\n        <p class=\"sea-pepper__note\">Persian cucumber, cilantro, lime and salt, tossed right before you build so it stays crisp.</p>\n      </div>\n      <div class=\"sea-pepper__row\">\n        <p class=\"sea-pepper__name\">\n          <span>Pickled onion &amp; pomegranate</span>\n          <span class=\"sea-pepper__tag\">The pop</span>\n        </p>\n        <span class=\"sea-pepper__step\">Layer 4</span>\n        <p class=\"sea-pepper__note\">Sharp and sweet-tart against the smoke. Add cilantro leaves here too, if you are using them.</p>\n      </div>\n      <div class=\"sea-pepper__row\">\n        <p class=\"sea-pepper__name\">\n          <span>Salsa macha, lime, flaky salt</span>\n          <span class=\"sea-pepper__tag\">The finish</span>\n        </p>\n        <span class=\"sea-pepper__step\">Layer 5</span>\n        <p class=\"sea-pepper__note\">A drizzle of salsa macha for smoky heat and crunch, a squeeze of lime, a pinch of flaky salt. Serve right away.</p>\n      </div>\n      </div>\n\n      <p class=\"sea-pepper__legend\">\n        Build each tostada just before it is eaten. Once the crema and salsa go on, the shell starts to soften.\n      </p>\n    </div>\n\n    <figure class=\"sea-pepper__figure\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0222/9882/0682/files/seatopia-toastada-recipe-geronimo-ramos-19.jpg?width=700\" alt=\"Two finished smoked trout tostadas topped with cucumber salsa, pickled red onion, pomegranate and salsa macha, with lime wedges\" width=\"3648\" height=\"5472\" loading=\"lazy\" decoding=\"async\">\n      <figcaption class=\"sea-pepper__cap\">\n        Every layer showing: crema at the edge, trout, salsa, onion, pomegranate and macha.\n      </figcaption>\n    </figure>\n\n  </div>\n</div>",
