    "faq": {
      "type": "faq",
      "blocks": {
        "q_cook": {
          "type": "question",
          "settings": {
            "title": "Do I need to cook the trout?",
            "text": "<p>No. Our Smoked Trout is hot-smoked and ready to eat, so it only needs thawing. Serve it straight from the fridge, or let it sit out for a few minutes first if you like it less cold.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_thaw": {
          "type": "question",
          "settings": {
            "title": "How do I thaw it?",
            "text": "<p>In the refrigerator, in its sealed pack, overnight. Never on the counter or in warm water. Keep it in the fridge until you build the tostadas.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_crunch": {
          "type": "question",
          "settings": {
            "title": "How do I keep the tostadas crunchy?",
            "text": "<p>Build them right before you eat. Make the crema and slice the toppings ahead, toss the cucumber salsa at the last minute so it does not go watery, and only then layer everything on the shell.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_ahead": {
          "type": "question",
          "settings": {
            "title": "Can I make anything ahead?",
            "text": "<p>The crema keeps for a day in the fridge with plastic wrap pressed onto the surface. The pickled onion keeps for days. The cucumber salsa is best made right before you build.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_macha": {
          "type": "question",
          "settings": {
            "title": "What is salsa macha, and where do I find it?",
            "text": "<p>A Mexican chile oil made with dried chiles, garlic and toasted nuts or seeds, so it is crunchy as well as smoky and hot. Look for it in jars near the hot sauces or in Latin grocery stores. Most contain peanuts or sesame, so check the label if you are cooking for allergies. Chili crisp is the closest swap.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_more": {
          "type": "question",
          "settings": {
            "title": "How do I make it for four?",
            "text": "<p>Use two packages of Smoked Trout and double everything else. You will have plenty of crema, since one batch already makes a little extra.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
      "block_order": [
        "q_cook",
        "q_thaw",
        "q_crunch",
        "q_ahead",
        "q_macha",
        "q_more"
      ],
