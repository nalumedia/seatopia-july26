        "m_head": {
          "type": "heading",
          "settings": {
            "heading": "Keep the trout in big flakes",
            "heading_size": "title-md",
            "heading_tag": "h2",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "m_text": {
          "type": "text",
          "settings": {
            "text": "<p>Move the pack from the freezer to the fridge the day before. In the morning it is ready: our Smoked Trout is hot-smoked and ready to eat, so it goes straight from the fridge to the tostada. Slide the fillet off its board, lift it away from the skin, and break it by hand into big pieces along its natural lines. Big flakes keep the smoky trout the star of every bite.</p>",
            "text_size": "subtext-md",
            "text_max_size": 32,
            "text_font": "body",
            "secondary_color": false,
            "highlighted_text": "none",
