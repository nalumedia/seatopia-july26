        "profile_9abkc4": {
          "type": "profile",
          "settings": {
            "image": "shopify://shop_images/Screenshot_2025-06-25_at_8.45.54_AM.png",
            "heading": "Spirulina-Infused Crudo",
            "text": "<p>Prepare Steelhead Crudo with a green spirulina emulsion, made with Seatopia’s sushi-grade steelhead. 👉🏽 <a href=\"/blogs/seafood-recipes/spirulina-infused-crudo-with-seatopia-steelhead\">Get the recipe</a></p>",
            "color_text": "#ffffff",
