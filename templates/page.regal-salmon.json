","heading_size":"title-md","heading_tag":"h1","highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["heading_PMBeRc"],"custom_css":[],"settings":{"text_alignment":"left","text_alignment_mobile":"center","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":60,"padding_bottom":32,"divider":false,"narrow":false,"rounded":false}},"rich_text_ENwwLT":{"type":"rich-text","blocks":{"text_aXfMMX":{"type":"text","settings":{"text":"<p>At Smoke in Chimenys, rainbow trout are raised in spring-fed waters flowing through a restored 1800s hatchery and raceway system in the heart of Appalachian South. There are no electric pumps, no chemicals, no shortcuts. Just gravity-fed water, traditional methods, and a commitment to fish health and environmental harmony. <br\/><br\/>They raise trout by hand - hand feeding, hand harvesting, and hand processing. The result? Trout with clean, sweet flavor, delicate flaky texture, and crispable skin that chefs and home cooks love. Loved by Michelin starred chefs and home cooks alike, Ty’s farm is an example of restorative aquaculture rooted in Appalachian legacy, proving that low-density, low-intervention farming can yield food that’s both delicious and environmentally sound. <\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["text_aXfMMX"],"settings":{"custom-class":"","text_alignment":"left","text_alignment_mobile":"center","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":60,"divider":false,"narrow":false,"rounded":false}},"collage_DpiTir":{"type":"collage","blocks":{"image_fbk9FG":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/Screenshot_2024-08-12_at_2.02.46_PM_1923c7c1-cba1-4f9e-867a-4b267c08a5bb.png","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}},"image_tEppWi":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/Screenshot_2025-05-22_at_10.05.03_AM.png","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}},"image_YdEwXg":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/fry_ba9d2e8b-2382-444b-833d-9e2cba488374.jpg","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}},"image_6EVEmG":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/2_415319bf-615e-4ba5-b27a-0abed736b87e.jpg","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}}},"block_order":["image_fbk9FG","image_tEppWi","image_YdEwXg","image_6EVEmG"],"settings":{"heading":"Cold, clear water from the Blue Ridge Mountains","heading_size":"title-md","heading_alignment":"text-center md:items-center","heading_tag":"h2","subheading":"","description":"<p>Smoke in Chimneys operates in foothills of the Blue Ridge Mountains, on land that in many ways helped shape the history of mainland American aquaculture. Here, cold, clear spring water from limestone aquifers travels downhill through a gravity-powered raceway system first built in the late 1800s. This natural water flow oxygenates the trout and keeps their environment clean without the need for external energy inputs. <\/p>","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":0,"divider":false,"full_width":false,"rounded":false,"enable_parallax":true}},"video_with_text_FUAJfD":{"type":"video-with-text","blocks":{"heading_3hdhjW":{"type":"heading","settings":{"heading":"A new wave of trout farming","heading_size":"title-md","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_KKca6r":{"type":"text","settings":{"text":"<p>Smoke in Chimneys is the life’s work of Ty Walker, a Virginia native who grew up farming and fly fishing in the Shenandoah Valley. After years of living in the city, Ty and his wife Shannon felt called back to the land and discovered their purpose in an unexpected place: a defunct 1930s trout hatchery near New Castle. Overgrown and silent, the property had sat dormant for years, until a former hatchery worker turned an old cast-iron valve and the water flowed once more. That moment sparked Ty’s vision. Armed with a century-old book on trout farming and a shared determination, the Walkers restored the historic site by hand, learning as they went. In 2022, they launched Smoke in Chimneys to raise trout the old way. Every fish reflects their labor, their reverence for nature, and their belief that the best food is born from care, history, and clean water.<\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"button_Kx44Ar":{"type":"button","disabled":true,"settings":{"button_label":"Button label","button_link":"","button_style":"primary","button_size":"md","button_external":false,"button_icon":true}}},"block_order":["heading_3hdhjW","text_KKca6r","button_Kx44Ar"],"settings":{"video_url":"https:\/\/www.youtube.com\/watch?v=E2bS76A7DUs","cover_image":"shopify:\/\/shop_images\/Screenshot_2025-05-22_at_10.06.58_AM.png","description":"","enable_video_autoplay":false,"enable_video_looping":false,"image_height":"adapt","video_width":"medium","layout":"video_first","text_alignment":"left","content_position":"align-self-center","video_url_mobile":"","image_height_mobile":"auto","text_alignment_mobile":"left","color_text":"","color_background":"","gradient_background":"","color_background_2":"","gradient_background_2":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":72,"padding_bottom":72,"divider":false,"full_width":false,"rounded":false,"enable_parallax":false,"parallax_direction":"vertical"}},"image_with_text_overlay_tC8T8E":{"type":"image-with-text-overlay","settings":{"transparent_header":false,"image":"shopify:\/\/shop_images\/blue_ridge.jpg","image_height":"850px","content_width":"small","content_position":"md:items-center md:justify-center","text_alignment":"left","image_height_mobile":"auto","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","color_text":"#ffffff","color_highlight":"#e0a580","gradient_highlight":"","color_button_text":"#171717","color_button_background":"#ffffff","color_button_gradient":"","color_overlay":"#171717","overlay_opacity":70,"padding_top":0,"padding_bottom":0,"divider":false,"full_width":true,"rounded":false,"enable_parallax":true,"narrow":false,"parallax_direction":"vertical"}},"featured_collection_PeAA7p":{"type":"featured-collection","custom_css":["\/* Center and limit the size of product tiles *\/.card-grid {display: flex; flex-wrap: wrap; justify-content: center; gap: 2rem; \/* Adjust spacing between tiles *\/ margin: 0 auto; padding: 1rem;}"," \/* Restrict individual product card width *\/.card-grid .product-card {max-width: 280px; \/* Or 240px for tighter grid *\/ flex: 1 1 240px;}"," \/* Optional: center content inside each product card *\/"],"settings":{"collection":"","products":["smoke-in-chimneys-whole-trout-12-16oz","smoke-in-chimneys-smoked-trout-filets"],"product_limit":6,"columns":4,"carousel_on_desktop":true,"show_view_all":false,"columns_mobile":"1","swipe_on_mobile":true,"heading":"Rainbow Trout","heading_size":"title-md","heading_alignment":"text-center md:items-center","heading_tag":"h2","subheading":"from Smoke in Chimneys","description":"<p>Smoke in Chimneys raises rainbow trout (<em>Oncorhynchus mykiss<\/em>), a freshwater species native to cold, fast-moving streams and perfectly suited to the spring-fed raceways of western North Carolina. <br\/><br\/>We like them grilled whole, smoked, or baked in the oven <em>en papillote - <\/em>wrapped in butcher paper and aromatics like lemon, rosemary and sea salt. <\/p>","highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":60,"padding_bottom":32,"divider":false,"full_width":false,"rounded":false}},"rich_text_tYfEAp":{"type":"rich-text","blocks":{"heading_zMMcwg":{"type":"heading","settings":{"heading":"Lab tested to ensure it meet's the Seatopia Standard","heading_size":"title-lg tracking-heading","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_Lbgpq6":{"type":"text","settings":{"text":"","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"button_JKJaFE":{"type":"button","disabled":true,"settings":{"button_label":"Button label","button_link":"","button_style":"primary","button_size":"md","button_external":false,"button_icon":true}}},"block_order":["heading_zMMcwg","text_Lbgpq6","button_JKJaFE"],"settings":{"custom-class":"","text_alignment":"center","text_alignment_mobile":"left","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":32,"divider":false,"narrow":true,"rounded":false}},"rich_text_fDqEkm":{"type":"rich-text","blocks":{"text_e9xqD8":{"type":"text","settings":{"text":"<p>Smoke in Chimney’s trout feed on insects and microorganisms thriving in their spring-fed habitat. To support healthy growth and maintain nutritional quality, their diet is supplemented with a premium, low-fiber feed made of 65% ocean-sourced fish protein and fat, 4% grain fiber, and 30% plant ingredients and trace minerals. 100% free of additional inclusions or antibiotics. <\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["text_e9xqD8"],"settings":{"custom-class":"","text_alignment":"left","text_alignment_mobile":"center","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":0,"divider":false,"narrow":true,"rounded":false}},"custom_liquid_rgQ9BW":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"liquid":"<div id=\"lightlabs-widget-container\" style=\"display: flex; justify-content: center; text-align: center; margin: 2rem auto;\">\n  <lightlabs-widget company-id=\"83\"><\/lightlabs-widget>\n  <noscript>\n    <p>Please enable JavaScript to view our verified mercury testing results from LightLabs.<\/p>\n  <\/noscript>\n<\/div>","color_text":"","color_background":"","gradient_background":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":0,"divider":false,"narrow":false,"rounded":false}},"portfolio_khhjiy":{"type":"portfolio","blocks":{"profile_FtXEVP":{"type":"profile","settings":{"image":"shopify:\/\/shop_images\/Screenshot_2025-05-22_at_12.53.51_PM.png","heading":"Grilled Whole Trout","text":"<p>Trout is delicate with a mild clean flavor and nutty, buttery notes which makes it the perfect canvas. Smoke in Chimneys spring-raised trout is on the menu at some of the East Coast's most distinguished restaurants - including multiple Michelin Star locations.<\/p><p>👉🏽 <a href=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/grilled-whole-rainbow-trout\" target=\"_blank\" title=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/grilled-whole-rainbow-trout\">Get the Recipe<\/a><\/p>","color_text":"#ffffff","color_background":"#171717"}},"profile_9abkc4":{"type":"profile","settings":{"image":"shopify:\/\/shop_images\/Screenshot_2025-05-22_at_12.56.48_PM.png","heading":"Pescatarian Stuffing","text":"<p>Instead of using sticks of butter to resuscitate a boxed Thanksgiving stuffing recipe, let's make it something extra special this year, so delicious and, dare I say, good for you!<br\/><br\/>\"As the fish is sushi-grade, please don't over cook it!\"<br\/>- Chef Mike Tully<\/p><p>👉🏽 <a href=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/hudson-valley-steelhead-trout-thanksgiving-stuffing-recipe\" target=\"_blank\" title=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/hudson-valley-steelhead-trout-thanksgiving-stuffing-recipe\">Get the recipe<\/a><\/p>","color_text":"#ffffff","color_background":"#171717"}},"profile_tPnk6G":{"type":"profile","settings":{"image":"shopify:\/\/shop_images\/Screenshot_2025-05-22_at_12.59.47_PM.png","heading":"Butterflied Broiled Trout","text":"<p>Join us in preparing a perfectly broiled Butterflied Rainbow Trout, a flavorful recipe.  Watch the full video below to learn how to debone the fish using the Butterfly technique and then broil the fish to create the perfect crispy skin.  We serve it over a vibrant sauce made from roasted poblano peppers, cilantro, lemon juice, olive oil, anchovies, and nori. This dish brings out the best in sustainable seafood, highlighting the natural flavors of the ocean with a zesty twist.<\/p><p>👉🏽 <a href=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/broiled-butterfly-rainbow-trout\" target=\"_blank\" title=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/broiled-butterfly-rainbow-trout\">Get the recipe<\/a><\/p>","color_text":"#ffffff","color_background":"#171717"}}},"block_order":["profile_FtXEVP","profile_9abkc4","profile_tPnk6G"],"custom_css":["\/* Center the tiles inside the grid *\/.portfolio.card-grid {display: flex; flex-wrap: wrap; justify-content: center; gap: 2rem; padding: 1rem; text-align: center;}"," \/* Optional: center the parent container if needed *\/.card-grid--4 {justify-content: center;}",".grid {justify-content: center;}",".profile.card {max-width: clamp(250px, 25vw, 300px); width: 100%;}"],"settings":{"columns":4,"carousel_on_desktop":false,"layout":"default","image_ratio":"portrait","image_ratio_mobile":"portrait","columns_mobile":"1","swipe_on_mobile":true,"heading":"Rainbow Trout Recipes","heading_size":"title-md","heading_alignment":"text-center justify-center","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":60,"padding_bottom":60,"divider":false,"full_width":false,"rounded":false}},"map_LW4PtC":{"type":"map","set