    "faq_blast": {
      "type": "faq",
      "blocks": {
        "q_fresh": {
          "type": "question",
          "settings": {
            "title": "Is frozen really better than fresh?",
            "text": "<p>&ldquo;Fresh&rdquo; only tells you the fish was never frozen &mdash; not that it was recently harvested. Seafood frozen close to harvest can reach you in better condition than fish that spent days in transit.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_time": {
          "type": "question",
          "settings": {
            "title": "How long does it keep in the freezer?",
            "text": "<p>Fatty fish such as salmon and steelhead are best within 2&ndash;3 months. Lean white fish such as barramundi, branzino and bream within 6&ndash;8 months. Shellfish within 3&ndash;6 months. Keep your freezer at 0&deg;F or below and avoid repeated thawing and refreezing.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_rush": {
          "type": "question",
          "settings": {
            "title": "Can I speed up thawing?",
            "text": "<p>Yes &mdash; use an ice bath with the fish still sealed in its vacuum bag, for at least 15 minutes. Avoid warm water, the microwave, and thawing on the counter.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_refreeze": {
          "type": "question",
          "settings": {
            "title": "Can I refreeze what I have thawed?",
            "text": "<p>We do not recommend it. Each freeze-thaw cycle costs texture and moisture, which is exactly what careful freezing set out to protect.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
