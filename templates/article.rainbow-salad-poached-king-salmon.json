          }
        },
        "g_rice": {
          "type": "column",
          "settings": {
            "icon": "heart",
            "custom_icon": "",
            "heading": "One pan",
            "text": "<p>A wide pan for the salmon. The salad and dressing need only a bowl and a whisk.</p>",
            "highlighted_text": "none",
