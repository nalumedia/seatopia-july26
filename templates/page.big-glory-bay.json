ghted_text":"none","highlighted_scribble":"circle"}}},"block_order":["heading_PMBeRc"],"custom_css":[],"settings":{"text_alignment":"left","text_alignment_mobile":"center","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":60,"padding_bottom":32,"divider":false,"narrow":false,"rounded":false}},"rich_text_ENwwLT":{"type":"rich-text","blocks":{"text_aXfMMX":{"type":"text","settings":{"text":"<p>King salmon were originally introduced to New Zealand for sport fishing, with broodstock from the Sacramento River in California dating back to the early 1900s. Today, that legacy lives on with the same reverance for this prized species. King salmon are raised slowly and carefully, surrounded by the wild beauty of New Zealand’s southernmost coastlines. Here, powerful tides and frigid currents from the Southern Ocean create a pristine, oxygen-rich environment where fish grow strong and healthy. With low-density pens and minimal handling, each King salmon develops rich marbling, clean flavor, and firm texture. Farmed by Sanford with a deep respect for Te Waipounamu (South Island) and its marine ecosystems, this is salmon of extraordinary quality. Sushi-grade, sashimi-soft, and rich in omega-3s. It’s a standout choice for chefs and home cooks seeking both taste and traceability. <\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["text_aXfMMX"],"settings":{"custom-class":"","text_alignment":"left","text_alignment_mobile":"center","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":60,"divider":false,"narrow":false,"rounded":false}},"collage_DpiTir":{"type":"collage","blocks":{"image_j3jWR4":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/Screen_Shot_2025-07-01_at_7.36.07_PM.png","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}},"image_7fiqzh":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/Screen_Shot_2025-07-01_at_7.38.19_PM.png","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}},"image_KxrKPV":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/Screen_Shot_2025-07-01_at_7.37.05_PM.png","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}},"image_b7LfNg":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/Screen_Shot_2025-07-01_at_7.39.20_PM.png","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}}},"block_order":["image_j3jWR4","image_7fiqzh","image_KxrKPV","image_b7LfNg"],"settings":{"heading":"Raised in remote waters with zero antibiotics, and rated Seafood Watch \"Best Choice\"","heading_size":"title-md","heading_alignment":"text-center md:items-center","heading_tag":"h2","subheading":"","description":"<p>Big Glory Bay is located on Stewart Island\/Rakiura, off the southern tip of New Zealand, where the Pacific meets the Antarctic. Isolated from other aquaculture operations, this cold, remote bay is refreshed daily by some of the clearest ocean water in the world. The bay’s deep channels and strong, natural tidal flows help maintain excellent water quality and provide the salmon with a consistent, clean current that mimics the wild. Big Glory Bay is the only salmon farm in New Zealand's deep south, and its location provides a rare combination of environmental purity, and optimal growing conditions.<\/p>","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":0,"divider":false,"full_width":false,"rounded":false,"enable_parallax":true}},"video_with_text_FUAJfD":{"type":"video-with-text","blocks":{"heading_3hdhjW":{"type":"heading","settings":{"heading":"Stewart Island is Home to Just 440 People, 85% Protected Park Land","heading_size":"title-md","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_KKca6r":{"type":"text","settings":{"text":"<p>Big Glory Bay is not accessible by road, so its farmers practice total dedication. The team includes marine biologists, Māori kaitiaki (guardians), and longtime aquaculture professionals who live and work along Aotearoa’s coasts. Their shared commitment to sustainability is grounded in stewardship, community, and science-backed care. Every fish is raised with patience and intention, guided by the belief that high-quality seafood should honor both the environment it comes from and the people who tend it. <\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"button_Kx44Ar":{"type":"button","disabled":true,"settings":{"button_label":"Button label","button_link":"","button_style":"primary","button_size":"md","button_external":false,"button_icon":true}}},"block_order":["heading_3hdhjW","text_KKca6r","button_Kx44Ar"],"settings":{"video_url":"https:\/\/www.youtube.com\/watch?v=u8GIzdpPZP8","cover_image":"shopify:\/\/shop_images\/Screen_Shot_2025-07-01_at_7.40.34_PM.png","description":"","enable_video_autoplay":false,"enable_video_looping":false,"image_height":"adapt","video_width":"medium","layout":"video_first","text_alignment":"left","content_position":"align-self-center","video_url_mobile":"","image_height_mobile":"auto","text_alignment_mobile":"left","color_text":"","color_background":"","gradient_background":"","color_background_2":"","gradient_background_2":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":72,"padding_bottom":72,"divider":false,"full_width":false,"rounded":false,"enable_parallax":false,"parallax_direction":"vertical"}},"image_with_text_overlay_tC8T8E":{"type":"image-with-text-overlay","settings":{"transparent_header":false,"image":"shopify:\/\/shop_images\/Screen_Shot_2025-07-01_at_7.45.30_PM.png","image_height":"850px","content_width":"small","content_position":"md:items-center md:justify-center","text_alignment":"left","image_height_mobile":"auto","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","color_text":"#ffffff","color_highlight":"#e0a580","gradient_highlight":"","color_button_text":"#171717","color_button_background":"#ffffff","color_button_gradient":"","color_overlay":"#171717","overlay_opacity":70,"padding_top":0,"padding_bottom":0,"divider":false,"full_width":true,"rounded":false,"enable_parallax":true,"narrow":false,"parallax_direction":"vertical"}},"featured_collection_PeAA7p":{"type":"featured-collection","custom_css":["\/* Center and limit the size of product tiles *\/.card-grid {display: flex; flex-wrap: wrap; justify-content: center; gap: 2rem; \/* Adjust spacing between tiles *\/ margin: 0 auto; padding: 1rem;}"," \/* Restrict individual product card width *\/.card-grid .product-card {max-width: 280px; \/* Or 240px for tighter grid *\/ flex: 1 1 240px;}"," \/* Optional: center content inside each product card *\/"],"settings":{"collection":"","products":["big-glory-bay-new-zealand-king-salmon"],"product_limit":6,"columns":4,"carousel_on_desktop":true,"show_view_all":false,"columns_mobile":"1","swipe_on_mobile":true,"heading":"King Salmon","heading_size":"title-md","heading_alignment":"text-center md:items-center","heading_tag":"h2","subheading":"from Big Glory Bay","description":"<p>Big Glory Bay raises <em>Oncorhynchus tshawytscha<\/em>, also known as King or Chinook salmon, the largest and most prized of all salmon species. Native to the North Pacific, King salmon are known for their buttery richness, high fat content, and luxurious mouthfeel. They’re also slower-growing than other salmon, which allows them to develop thicker fillets and intricate marbling. In aquaculture, they require cold, clean water and ample space; conditions found in abundance in Big Glory Bay. Ideal for sashimi, grilling, or smoking, this species is favored by chefs for its flavor, texture, and depth.<\/p>","highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":60,"padding_bottom":32,"divider":false,"full_width":false,"rounded":false}},"rich_text_tYfEAp":{"type":"rich-text","blocks":{"heading_zMMcwg":{"type":"heading","settings":{"heading":"Sustainably Fed, Ethically Farmed, Lab-Tested to Meet the Seatopia Standard","heading_size":"title-lg tracking-heading","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_Lbgpq6":{"type":"text","settings":{"text":"","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"button_JKJaFE":{"type":"button","disabled":true,"settings":{"button_label":"Button label","button_link":"","button_style":"primary","button_size":"md","button_external":false,"button_icon":true}}},"block_order":["heading_zMMcwg","text_Lbgpq6","button_JKJaFE"],"settings":{"custom-class":"","text_alignment":"center","text_alignment_mobile":"left","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":32,"divider":false,"narrow":true,"rounded":false}},"rich_text_fDqEkm":{"type":"rich-text","blocks":{"text_e9xqD8":{"type":"text","settings":{"text":"<p>King salmon from Big Glory Bay (Sanford) are raised on a diet crafted to mirror their natural nutrition profile: rich in marine proteins, vegetable proteins, and Omega-3s, with no antibiotics or artificial growth hormones. Sanford sources high-quality, responsibly managed feed ingredients, and their vertical integration allows traceability and control from feed to finished product. The salmon are raised in low-density pens to reduce stress and allow for healthy swimming behavior, and strong bay currents keep the water clean and the fish active. Every element of the farming practice is designed to enhance fish health, environmental performance, and nutrient density. <\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["text_e9xqD8"],"settings":{"custom-class":"","text_alignment":"left","text_alignment_mobile":"center","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":0,"divider":false,"narrow":true,"rounded":false}},"custom_liquid_rgQ9BW":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"liquid":"<div id=\"lightlabs-widget-container\" style=\"display: flex; justify-content: center; text-align: center; margin: 2rem auto;\">\n  <lightlabs-widget company-id=\"83\"><\/lightlabs-widget>\n  <noscript>\n    <p>Please enable JavaScript to view our verified mercury testing results from LightLabs.<\/p>\n  <\/noscript>\n<\/div>","color_text":"","color_background":"","gradient_background":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":0,"divider":false,"narrow":false,"rounded":false}},"portfolio_khhjiy":{"type":"portfolio","blocks":{"profile_FtXEVP":{"type":"profile","settings":{"image":"shopify:\/\/shop_images\/Screenshot_2025-06-25_at_8.44.12_AM.png","heading":"Broiled Miso  Salmon Bowl","text":"<p>This ritualistic recipe celebrates the art of a 48-hour marinade, blending saké, miso, and coconut sugar to create a deeply flavorful glaze. We'll guide you through every step—from preparing the marinade to broiling the salmon to perfection and plating it with sushi rice, purple broccolini, pickled onions, and creamy avocado.<\/p><p>👉🏽 <a href=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/broiled-miso-salmon-bowl-sushi-rice-avocado\" target=\"_blank\" title=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/broiled-miso-salmon-bowl-sushi-rice-avocado\">Get the Recipe<\/a><\/p>","color_text":"#ffffff","color_background":"#171717"}},"profile_9abkc4":{"type":"profile","settings":{"image":"shopify:\/\/shop_images\/Screenshot_2025-06-25_at_8.45.54_AM.png","heading":"Spirulina-Infused Crudo","text":"<p><em>Prepare Steelhead Crudo with green spirulina emulsion. Seatopia’s sushi-grade seafood delivers abundant Omega-3s to support heart and brain health.<\/em><\/p><p>👉🏽 <a href=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/spirulina-infused-crudo-with-seatopia-steelhead\" target=\"_blank\" title=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/spirulina-infused-crudo-with-seatopia-steelhead\">Get the recipe<\/a><\/p>","color_text":"#ffffff","color_background":"#171717"}},"profile_tPnk6G":{"type":"profile","settings":{"image":"shopify:\/\/shop_images\/Screenshot_2025-06-25_at_8.47.03_AM.png","heading":"Salmon Poke Bowl","text":"<p>Join us in this new recipe where we dive into the traditional flavors of Hawaii with a classic Salmon Poke, made with New Zealand King Salmon from Seatopia. This step-by-step guide walks you through preparing a flavorful poke, marrying the rich taste of sushi-grade salmon, loaded with omega-3s, with the freshness of pickled ginger and garlic, known for their digestive and immune-supporting properties. Perfectly paired with organic sushi rice and creamy avocado, this dish is a true celebration of Hawaiian cuisine and wholesome nourishment.<\/p><p>👉🏽 <a href=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/salmon-poke-101-tamari-ginger-garlic\" target=\"_blank\" title=\"https:\/\/seatopia.fish\/blogs\/seafood-recipes\/salmon-poke-101-tamari-ginger-garlic\">Get the recipe<\/a><\/p>","color_text":"#ffffff","color_background":"#171717"}}},"block_order":["profile_FtXEVP","profile_9abkc4","profile_tPnk6G"],"custom_css":["\/* Center the tiles inside the grid *\/.portfolio.card-grid {display: flex; flex-wrap: wrap; justify-content: center; gap: 2rem; padding: 1rem; text-align: center;}"," \/* Optional: center the parent container if needed *\/.card-grid--4 {justify-content: center;}",".grid {justify-content: center;}",".profile.card {max-width: clamp(250px, 25vw, 300px); width: 100%;}"],"settings":{"columns":4,"carousel_on_desktop":false,"layout":"default","image_ratio":"portrait","image_ratio_mobile":"portrait","columns_mobile":"1","swipe_on_mobile":true,"heading":"King Salmon Recipes","heading_size":"title-md","heading_alignment":"text-center justify-center","heading_tag":"h2",