    "meal_prep": {
      "type": "image-with-text",
      "blocks": {
        "m_sub": {
          "type": "subheading",
          "settings": {
            "subheading": "Cube it cold",
            "subheading_size": "subtitle-md",
            "secondary_color": true
          }
        },
        "m_head": {
          "type": "heading",
          "settings": {
            "heading": "Pat it dry, then bite-sized cubes",
            "heading_size": "title-md",
            "heading_tag": "h2",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "m_text": {
          "type": "text",
          "settings": {
            "text": "<p>Move the King Salmon from the freezer to the fridge the night before, in its sealed pack. When the bowls are almost ready, take it out, pat it dry and cut it into bite-sized cubes with your sharpest knife. No marinade needed. Keep it in the fridge until the last step, and serve the bowls right away.</p>",
            "text_size": "subtext-md",
            "text_max_size": 32,
            "text_font": "body",
            "secondary_color": false,
            "highlighted_text": "none",
