    "faq": {
      "type": "faq",
      "blocks": {
        "q_raw": {
          "type": "question",
          "settings": {
            "title": "Can I eat the King Salmon raw?",
            "text": "<p>Nicole serves it raw here. Read what sashimi-grade means to us above. Eating raw or undercooked meat, poultry, seafood, shellfish or eggs may increase your risk of foodborne illness, especially with certain medical conditions. Consult your doctor if you think you may be sensitive.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_thaw": {
          "type": "question",
          "settings": {
            "title": "How do I thaw fish I am going to eat raw?",
            "text": "<p>In the refrigerator, in its sealed pack, overnight. Never on the counter or in warm water. Keep it cold until you cube it, and eat it the day you thaw it.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_cooked": {
          "type": "question",
          "settings": {
            "title": "Can I use cooked salmon instead?",
            "text": "<p>Yes. Sear or roast the salmon, let it cool a little, then flake it over the bowls. The FDA conservatively suggests cooking seafood to an internal temperature of 145&nbsp;&deg;F.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_ahead": {
          "type": "question",
          "settings": {
            "title": "Can I prep it ahead?",
            "text": "<p>Prepare the rice, edamame and vegetables ahead and refrigerate them separately. Cool cooked rice promptly, refrigerate it within an hour, and use it within 24 hours. Keep the salmon chilled and cube it just before serving.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_gf": {
          "type": "question",
          "settings": {
            "title": "Can I make it gluten-free?",
            "text": "<p>Use gluten-free tamari or coconut aminos, and check the labels on the furikake, chili crisp and other seasonings.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_amount": {
          "type": "question",
          "settings": {
            "title": "How much salmon do I need?",
            "text": "<p>Nicole thaws four portions of King Salmon for her family of four, one per bowl. Our King Salmon portions are 8.5&nbsp;oz each, so use less per bowl if your crew eats lighter.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
      "block_order": [
        "q_raw",
        "q_thaw",
        "q_cooked",
        "q_ahead",
        "q_gf",
        "q_amount"
      ],
