eading_size":"title-md","heading_tag":"h1","highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["heading_PMBeRc"],"custom_css":[],"settings":{"text_alignment":"left","text_alignment_mobile":"center","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":60,"padding_bottom":32,"divider":false,"narrow":false,"rounded":false}},"rich_text_ENwwLT":{"type":"rich-text","blocks":{"text_aXfMMX":{"type":"text","settings":{"text":"<p>At Australis Aquaculture, barramundi are raised in the tropical waters of Vân Phong Bay, Vietnam, using a revolutionary model of climate-smart ocean farming. By cultivating one of the world’s most sustainable fish species in low-density, open-ocean pens, Australis produces seafood that’s delicious, nutrient-rich, and low impact. Barramundi offers a mild, buttery flavor, high omega-3s, and zero traceable mercury, earning it a Monterey Bay Aquarium “Best Choice” sustainability rating, and 4 Star BAP. This is responsible seafood for a changing planet. Loved by chefs, trusted by Seatopia, and designed to make a difference.<\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["text_aXfMMX"],"settings":{"custom-class":"","section_id":"","text_alignment":"left","text_alignment_mobile":"center","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":60,"divider":false,"narrow":false,"rounded":false}},"collage_DpiTir":{"type":"collage","blocks":{"image_j3jWR4":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/Screen_Shot_2025-07-01_at_4.25.51_PM.png","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}},"image_7fiqzh":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/2019-AustralisVN_DJI_0051-1536x864.jpg","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}},"image_KxrKPV":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/australis-barramundi-6oz-142562.png","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}},"image_b7LfNg":{"type":"image","settings":{"subheading":"","heading":"","link":"","invert_subheading_heading":false,"image":"shopify:\/\/shop_images\/Screen_Shot_2025-07-01_at_4.27.16_PM.png","image_ratio":"portrait","content_position":"md:items-end md:justify-start","text_alignment":"left","image_ratio_mobile":"portrait","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_highlight":"","gradient_highlight":"","color_overlay":"#171717","overlay_opacity":10}}},"block_order":["image_j3jWR4","image_7fiqzh","image_KxrKPV","image_b7LfNg"],"settings":{"heading":"Tropical waters and quick currents","heading_size":"title-md","heading_alignment":"text-center md:items-center","heading_tag":"h2","subheading":"","description":"<p>Australis operates in a marine enclave in Vietnam’s Khánh Hòa province. Sheltered by mountainous peninsulas and coral reefs, the bay provides an ideal environment for ocean aquaculture: warm tropical waters, steady currents, and excellent biosecurity. The location’s natural depth and current flow were selected to improve cleanliness and protect local ecosystems. Here, the tropical ocean itself becomes a living, breathing part of the farming system, enabling low-input, high-integrity seafood production in harmony with nature, not as a tax on it. <\/p>","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":0,"divider":false,"full_width":false,"rounded":false,"enable_parallax":true}},"video_with_text_FUAJfD":{"type":"video-with-text","blocks":{"heading_3hdhjW":{"type":"heading","settings":{"heading":"A 30 year journey from dorm room aquaponics to sustainable ocean farming","heading_size":"title-md","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_KKca6r":{"type":"text","settings":{"text":"<p>Australis is the long-term vision of Josh Goldman, a pioneer in sustainable aquaculture whose journey began with a solar-powered aquaponics experiment in his college dorm. That curiosity led to a global quest, testing over 30 species across continents, before discovering barramundi. Goldman founded Australis to bring sustainable seafood to scale and spent decades building operations from scratch, culminating in the launch of their Vân Phong Bay site. Today, a committed team of Vietnamese aquaculture experts and environmental engineers carry forward the mission, combining traditional know-how with cutting-edge techniques to farm with purpose and precision. For Seatopia, we love the innovation, but also the species: less common in the US, barramundi can be raised with relatively low inputs, which makes it a great candidate for sustainable farming. <\/p>","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"button_Kx44Ar":{"type":"button","disabled":true,"settings":{"button_label":"Button label","button_link":"","button_style":"primary","button_size":"md","button_external":false,"button_icon":true}}},"block_order":["heading_3hdhjW","text_KKca6r","button_Kx44Ar"],"settings":{"video_url":"https:\/\/www.youtube.com\/watch?v=g7Msr96douA","cover_image":"shopify:\/\/shop_images\/Screen_Shot_2025-07-01_at_4.28.37_PM.png","description":"","enable_video_autoplay":false,"enable_video_looping":false,"image_height":"adapt","video_width":"medium","layout":"video_first","text_alignment":"left","content_position":"align-self-center","video_url_mobile":"","image_height_mobile":"auto","text_alignment_mobile":"left","color_text":"","color_background":"","gradient_background":"","color_background_2":"","gradient_background_2":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":72,"padding_bottom":72,"divider":false,"full_width":false,"rounded":false,"enable_parallax":false,"parallax_direction":"vertical"}},"image_with_text_overlay_tC8T8E":{"type":"image-with-text-overlay","settings":{"section_id":"","transparent_header":false,"image":"shopify:\/\/shop_images\/Screen_Shot_2025-07-01_at_4.29.39_PM.png","image_height":"850px","content_width":"small","content_position":"md:items-center md:justify-center","text_alignment":"left","image_height_mobile":"auto","content_position_mobile":"items-end justify-start","text_alignment_mobile":"left","color_text":"#ffffff","color_highlight":"#e0a580","gradient_highlight":"","color_button_text":"#171717","color_button_background":"#ffffff","color_button_gradient":"","color_overlay":"#171717","overlay_opacity":70,"padding_top":0,"padding_bottom":0,"divider":false,"full_width":true,"rounded":false,"enable_parallax":true,"narrow":false,"parallax_direction":"vertical"}},"featured_collection_PeAA7p":{"type":"featured-collection","custom_css":["\/* Center and limit the size of product tiles *\/.card-grid {display: flex; flex-wrap: wrap; justify-content: center; gap: 2rem; \/* Adjust spacing between tiles *\/ margin: 0 auto; padding: 1rem;}"," \/* Restrict individual product card width *\/.card-grid .product-card {max-width: 280px; \/* Or 240px for tighter grid *\/ flex: 1 1 240px;}"," \/* Optional: center content inside each product card *\/"],"settings":{"collection":"","products":["barramundi-2-pack"],"product_limit":6,"columns":4,"carousel_on_desktop":true,"show_view_all":false,"columns_mobile":"1","swipe_on_mobile":true,"heading":"Barramundi","heading_size":"title-md","heading_alignment":"text-center md:items-center","heading_tag":"h2","subheading":"from Australis","description":"<p>Barramundi (<em>Lates calcarifer<\/em>) is a tropical finfish native to the Indo-Pacific and one of the most sustainable seafood choices on the planet. Naturally hardy, fast-growing, and incredibly feed-efficient, barramundi thrives in a variety of salinities and requires fewer resources to raise than salmon or shrimp. Its naturally high omega-3 content, low mercury levels, and mild, buttery taste make it a favorite among nutritionists and chefs alike. It's a fish that checks every box: easy to cook, delicious to eat, and gentle on the environment. Whether grilled, pan-seared, or baked, barramundi delivers clean flavor and clean conscience.<\/p>","highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":60,"padding_bottom":32,"divider":false,"full_width":false,"rounded":false}},"rich_text_tYfEAp":{"type":"rich-text","blocks":{"heading_zMMcwg":{"type":"heading","settings":{"heading":"Sustainably Fed, Ethically Farmed, Lab-Tested to Meet the Seatopia Standard","heading_size":"title-lg tracking-heading","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_Lbgpq6":{"type":"text","settings":{"text":"","text_size":"subtext-md","text_max_size":32,"text_font":"body","secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"button_JKJaFE":{"type":"button","disabled":true,"settings":{"button_label":"Button label","button_link":"","button_style":"primary","button_size":"md","button_external":false,"button_icon":true}}},"block_order":["heading_zMMcwg","text_Lbgpq6","button_JKJaFE"],"settings":{"custom-class":"","section_id":"","text_alignment":"center","text_alignment_mobile":"left","heading":"","heading_size":"title-md","heading_alignm