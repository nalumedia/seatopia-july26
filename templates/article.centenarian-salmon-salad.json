"6.5\" r=\"1.2\" fill=\"currentColor\" stroke=\"none\"></circle>\n      </svg>\n      <span>@alexcbolivar</span>\n    </a>\n    <a class=\"sea-collab__follow\" href=\"https://www.instagram.com/jasonpabst_\" target=\"_blank\" rel=\"noopener noreferrer\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n        <rect x=\"2\" y=\"2\" width=\"20\" height=\"20\" rx=\"5\"></rect>\n        <circle cx=\"12\" cy=\"12\" r=\"4\"></circle>\n        <circle cx=\"17.5\" cy=\"6.5\" r=\"1.2\" fill=\"currentColor\" stroke=\"none\"></circle>\n      </svg>\n      <span>@jasonpabst_</span>\n    </a>\n  </div>\n</div>\n",
