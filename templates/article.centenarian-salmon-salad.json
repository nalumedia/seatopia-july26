        "divider": false,
        "full_width": false,
        "rounded": true,
        "heading_size": "title-md",
        "heading_alignment": "text-left md:items-end md:flex-row",
        "heading_tag": "h2",
        "subheading": "",
        "description": "<p>Work in this order and the oven never sits empty. Everything cold gets made in the thirty minutes the sweet potatoes are roasting.</p>",
        "heading": "The one-hour game plan",
