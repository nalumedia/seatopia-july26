    "five_parts": {
      "type": "multicolumn-with-icons",
      "blocks": {
        "p_salmon": {
          "type": "column",
          "settings": {
            "icon": "lightning",
            "custom_icon": "",
            "heading": "1. Baked salmon",
            "text": "<p>Olive oil, salt and thin lemon rounds, baked at 350&deg;F for 15 minutes. No glaze, no marinade &mdash; the whole point is to taste the fish.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "p_roast": {
          "type": "column",
          "settings": {
            "icon": "organic",
            "custom_icon": "",
            "heading": "2. The sheet pan",
            "text": "<p>Okinawan sweet potato in &frac12;-inch cubes and a jar of drained chickpeas, roasted hot until the chickpeas crisp and the potato edges brown. Same pan the salmon uses next.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "p_tzatziki": {
          "type": "column",
          "settings": {
            "icon": "box",
            "custom_icon": "",
            "heading": "3. Honeyed dill tzatziki",
            "text": "<p>Greek yogurt, a whole bunch of minced dill, garlic, lemon, olive oil and a tablespoon of raw honey. Thick enough to ribbon off a spoon.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "p_cold": {
          "type": "column",
          "settings": {
            "icon": "star",
            "custom_icon": "",
            "heading": "4. Raw, cold and jammy",
            "text": "<p>Cucumber-tomato salad, avocado, kalamata olives, wild blueberries, purple sauerkraut, broccoli sprouts &mdash; plus the seven-minute eggs, soft centres up.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
      "block_order": [
        "p_salmon",
        "p_roast",
        "p_tzatziki",
        "p_cold"
      ],
