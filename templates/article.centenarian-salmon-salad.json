    "blue_zone_video": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_id": "blue-zone-video",
        "liquid": "\n<style>\n  .sea-story {\n    --ink:#171717; --muted:#5c5c5c; --line:#e5e2dc; --wash:#faf8f4; --gold:#bb8f50;\n    color: var(--ink); background: var(--wash);\n    border: 1px solid var(--line); border-radius: 20px; padding: 30px;\n  }\n  .sea-story__grid {\n    display: grid; grid-template-columns: minmax(0, 260px) minmax(0, 1fr);\n    gap: 32px; align-items: center;\n  }\n  .sea-story__player {\n    position: relative; margin: 0; aspect-ratio: 9 / 16;\n    border-radius: 16px; overflow: hidden;\n    background: #111 center / cover no-repeat;\n    box-shadow: 0 14px 34px -22px rgba(0,0,0,.5);\n  }\n  .sea-story__player video {\n    width: 100%; height: 100%; object-fit: cover; display: block;\n    opacity: 0; transition: opacity .3s ease;\n  }\n  .sea-story__player.is-playing video { opacity: 1; }\n  .sea-story__play {\n    position: absolute; inset: 0; width: 100%; height: 100%;\n    display: flex; align-items: center; justify-content: center;\n    border: 0; padding: 0; cursor: pointer;\n    background: linear-gradient(180deg, rgba(0,0,0,.04), rgba(0,0,0,.34));\n    transition: opacity .25s ease;\n  }\n  .sea-story__player.is-playing .sea-story__play { opacity: 0; pointer-events: none; }\n  .sea-story__play span {\n    width: 60px; height: 60px; border-radius: 50%;\n    background: rgba(255,255,255,.94);\n    display: flex; align-items: center; justify-content: center;\n    box-shadow: 0 6px 18px -6px rgba(0,0,0,.5);\n    transition: transform .18s ease;\n  }\n  .sea-story__play:hover span { transform: scale(1.07); }\n  .sea-story__play svg { width: 20px; height: 20px; margin-left: 3px; fill: var(--ink); }\n  .sea-story__badge {\n    position: absolute; top: 12px; left: 12px; z-index: 2;\n    font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;\n    color: #fff; background: rgba(23,23,23,.62); padding: 5px 10px; border-radius: 999px;\n  }\n  .sea-story__player.is-playing .sea-story__badge { opacity: 0; transition: opacity .25s ease; }\n  .sea-story__eyebrow {\n    font-size: 11px; letter-spacing: .14em; text-transform: uppercase;\n    color: var(--gold); font-weight: 600; margin: 0 0 10px;\n  }\n  .sea-story__heading { font-size: clamp(24px, 3vw, 31px); line-height: 1.15; font-weight: 600; margin: 0 0 14px; }\n  .sea-story__body { font-size: 16px; line-height: 1.6; color: var(--muted); margin: 0 0 14px; }\n  .sea-story__body strong { color: var(--ink); }\n  .sea-story__zones {\n    margin: 0; padding: 0; list-style: none;\n    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 18px;\n  }\n  .sea-story__zones li {\n    font-size: 14px; line-height: 1.5; color: var(--muted);\n    padding-left: 14px; position: relative;\n  }\n  .sea-story__zones li:before {\n    content: \"\"; position: absolute; left: 0; top: 8px;\n    width: 5px; height: 5px; border-radius: 50%; background: var(--gold);\n  }\n  .sea-story__zones b { color: var(--ink); }\n  @media (max-width: 989px) {\n    .sea-story { padding: 22px; }\n    .sea-story__grid { grid-template-columns: 1fr; gap: 24px; justify-items: center; }\n    .sea-story__player { width: min(74vw, 260px); }\n    .sea-story__zones { grid-template-columns: 1fr; }\n  }\n</style>\n\n<div class=\"sea-story\">\n  <div class=\"sea-story__grid\">\n\n    <figure class=\"sea-story__player\" data-sea-story\n            style=\"background-image:url('{{ 'centenarian-salmon-salad-video-poster.jpg' | file_url }}');\">\n      <span class=\"sea-story__badge\">0:55</span>\n      <video preload=\"none\" playsinline\n             poster=\"{{ 'centenarian-salmon-salad-video-poster.jpg' | file_url }}\"\n             data-src-hd=\"https://cdn.shopify.com/videos/c/vp/4603ec21a267466a9c46d05a2056582f/4603ec21a267466a9c46d05a2056582f.HD-720p-4.5Mbps-93851834.mp4\"\n             data-src-sd=\"https://cdn.shopify.com/videos/c/vp/4603ec21a267466a9c46d05a2056582f/4603ec21a267466a9c46d05a2056582f.SD-480p-1.5Mbps-93851834.mp4\"\n             aria-label=\"Alex Bolivar and Jason Pabst building the Centenarian Salmon Salad\"></video>\n      <button class=\"sea-story__play\" type=\"button\" aria-label=\"Play the 55 second recipe video\">\n        <span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M8 5v14l11-7z\"></path></svg></span>\n      </button>\n    </figure>\n\n    <div>\n      <p class=\"sea-story__eyebrow\">Fifty-five seconds, start to platter</p>\n      <h2 class=\"sea-story__heading\">Every ingredient is borrowed from a blue zone.</h2>\n      <p class=\"sea-story__body\">\n        Blue zones are the handful of places where living past 100 is unremarkable. This platter is assembled almost\n        entirely from what people actually eat there &mdash; and each part is pulling a specific nutritional thread.\n      </p>\n      <ul class=\"sea-story__zones\">\n        <li><b>Anthocyanins</b> &mdash; purple sweet potato, sauerkraut, wild blueberries, red onion</li>\n        <li><b>Legumes</b> &mdash; the one food common to every blue zone</li>\n        <li><b>Polyphenols and monounsaturated fat</b> &mdash; a generous pour of extra-virgin olive oil</li>\n        <li><b>Live ferments</b> &mdash; raw purple sauerkraut</li>\n        <li><b>Sulforaphane</b> &mdash; raw broccoli sprouts</li>\n        <li><b>Choline</b> &mdash; pasture-raised eggs, boiled jammy so the yolks stay soft</li>\n      </ul>\n    </div>\n\n  </div>\n</div>\n\n<script>\n  (function () {\n    document.querySelectorAll('[data-sea-story]').forEach(function (frame) {\n      var video = frame.querySelector('video');\n      var button = frame.querySelector('.sea-story__play');\n      if (!video || !button) return;\n\n      button.addEventListener('click', function () {\n        if (!video.currentSrc && !video.src) {\n          var wide = window.matchMedia('(min-width: 600px)').matches;\n          video.src = wide ? video.dataset.srcHd : video.dataset.srcSd;\n        }\n        frame.classList.add('is-playing');\n        video.controls = true;\n        var played = video.play();\n        if (played && played.catch) {\n          played.catch(function () { video.muted = true; video.play(); });\n        }\n      });\n\n      video.addEventListener('pause', function () {\n        if (video.currentTime === 0 || video.ended) {\n          frame.classList.remove('is-playing');\n          video.controls = false;\n        }\n      });\n    });\n  })();\n</script>\n",
