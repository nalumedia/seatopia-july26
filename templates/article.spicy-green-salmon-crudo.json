        "m_text": {
          "type": "text",
          "settings": {
            "text": "<p>Take the skin off first, then slice straight from the fridge with your sharpest knife. Cut across the white lines in the flesh, in one long stroke per slice rather than sawing, and keep every slice about the same thickness so they eat the same. Lay them on a plate and put them back in the fridge while you make the dressing and slice the toppings.</p>",
            "text_size": "subtext-md",
            "text_max_size": 32,
            "text_font": "body",
