    "heat_note": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_id": "dial-the-heat",
        "liquid": "<style>\n  .sea-pepper {\n    --ink: #171717;\n    --muted: #5c5c5c;\n    --line: #e5e2dc;\n    --wash: #faf8f4;\n    --gold: #bb8f50;\n    color: var(--ink);\n    background: var(--wash);\n    border: 1px solid var(--line);\n    border-radius: 20px;\n    padding: 30px;\n  }\n  .sea-pepper__grid {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) minmax(0, 300px);\n    gap: 34px;\n    align-items: center;\n  }\n  .sea-pepper__eyebrow {\n    font-size: 11px;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n    color: var(--gold);\n    font-weight: 600;\n    margin: 0 0 8px;\n  }\n  .sea-pepper__heading {\n    font-size: clamp(23px, 2.8vw, 30px);\n    line-height: 1.15;\n    font-weight: 600;\n    margin: 0 0 10px;\n  }\n  .sea-pepper__lede {\n    font-size: 15px;\n    line-height: 1.55;\n    color: var(--muted);\n    margin: 0 0 22px;\n  }\n  .sea-pepper__rows {\n    display: grid;\n    gap: 14px;\n  }\n  .sea-pepper__row {\n    background: #fff;\n    border: 1px solid var(--line);\n    border-radius: 14px;\n    padding: 15px 17px;\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) auto;\n    gap: 10px 16px;\n    align-items: center;\n  }\n  .sea-pepper__row--pick {\n    border-color: var(--gold);\n    box-shadow: 0 0 0 1px var(--gold);\n  }\n  .sea-pepper__name {\n    grid-column: 1;\n    margin: 0;\n    font-size: 15px;\n    font-weight: 600;\n    line-height: 1.3;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    flex-wrap: wrap;\n  }\n  .sea-pepper__tag {\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n    color: #fff;\n    background: var(--gold);\n    padding: 3px 8px;\n    border-radius: 999px;\n  }\n  .sea-pepper__meter {\n    grid-column: 2;\n    grid-row: 1;\n    display: flex;\n    gap: 4px;\n    align-items: center;\n  }\n  .sea-pepper__pip {\n    width: 9px;\n    height: 9px;\n    border-radius: 50%;\n    background: #fff;\n    border: 1.5px solid #d8cfc0;\n  }\n  .sea-pepper__pip.is-on {\n    background: #b8462f;\n    border-color: #b8462f;\n  }\n  .sea-pepper__note {\n    grid-column: 1 / -1;\n    margin: 0;\n    font-size: 13.5px;\n    line-height: 1.5;\n    color: var(--muted);\n  }\n  .sea-pepper__legend {\n    margin: 16px 0 0;\n    padding-top: 14px;\n    border-top: 1px solid var(--line);\n    font-size: 13px;\n    line-height: 1.55;\n    color: var(--muted);\n  }\n  .sea-pepper__figure {\n    margin: 0;\n  }\n  .sea-pepper__figure img {\n    width: 100%;\n    height: auto;\n    display: block;\n    border-radius: 16px;\n    box-shadow: 0 14px 34px -22px rgba(0,0,0,.5);\n  }\n  .sea-pepper__cap {\n    margin: 10px 0 0;\n    font-size: 12.5px;\n    line-height: 1.5;\n    color: var(--muted);\n  }\n  @media (max-width: 989px) {\n    .sea-pepper {\n      padding: 22px;\n    }\n    .sea-pepper__grid {\n      grid-template-columns: 1fr;\n      gap: 24px;\n    }\n    .sea-pepper__figure {\n      order: -1;\n    }\n  }\n</style>\n\n<div class=\"sea-pepper\">\n  <div class=\"sea-pepper__grid\">\n\n    <div class=\"sea-pepper__body\">\n      <p class=\"sea-pepper__eyebrow\">Dial the heat</p>\n      <h2 class=\"sea-pepper__heading\">Four sources of heat, each one adjustable.</h2>\n      <p class=\"sea-pepper__lede\">\n        The &ldquo;spicy&rdquo; in this crudo comes from four places, and you control every one of them.\n        Make it as Val does the first time, then turn each one up or down to suit your table.\n      </p>\n\n      <div class=\"sea-pepper__rows\">\n      <div class=\"sea-pepper__row sea-pepper__row--pick\">\n        <p class=\"sea-pepper__name\">\n          <span>Salsa macha</span>\n          <span class=\"sea-pepper__tag\">The drizzle</span>\n        </p>\n        <div class=\"sea-pepper__meter\" role=\"img\" aria-label=\"Heat: 4 out of 5\">\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        </div>\n        <p class=\"sea-pepper__note\">Chile oil with toasted nuts, seeds and garlic. The boldest heat on the plate, and the crunch. Start with 2 tablespoons and pass the jar.</p>\n      </div>\n      <div class=\"sea-pepper__row\">\n        <p class=\"sea-pepper__name\">\n          <span>Fresno chile</span>\n          <span class=\"sea-pepper__tag\">On top</span>\n        </p>\n        <div class=\"sea-pepper__meter\" role=\"img\" aria-label=\"Heat: 3 out of 5\">\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        </div>\n        <p class=\"sea-pepper__note\">Thin rounds scattered over the salmon. For less heat, scrape out the seeds before slicing, or use half.</p>\n      </div>\n      <div class=\"sea-pepper__row\">\n        <p class=\"sea-pepper__name\">\n          <span>Jalape&ntilde;o</span>\n          <span class=\"sea-pepper__tag\">In the dressing</span>\n        </p>\n        <div class=\"sea-pepper__meter\" role=\"img\" aria-label=\"Heat: 2 out of 5\">\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        </div>\n        <p class=\"sea-pepper__note\">Blended with the stem, seeds and membranes removed it is mild and green. Leave some seeds in, or add a second pepper, for more.</p>\n      </div>\n      <div class=\"sea-pepper__row\">\n        <p class=\"sea-pepper__name\">\n          <span>Chile vinegar</span>\n          <span class=\"sea-pepper__tag\">In the dressing</span>\n        </p>\n        <div class=\"sea-pepper__meter\" role=\"img\" aria-label=\"Heat: 1 out of 5\">\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        </div>\n        <p class=\"sea-pepper__note\">A tablespoon brightens the dressing more than it heats it. Add a splash more at the end if it needs lift.</p>\n      </div>\n      </div>\n\n      <p class=\"sea-pepper__legend\">\n        The dots show how much heat each one brings, hottest first. Taste the dressing before it goes on the\n        plate &mdash; that is the easiest point to adjust.\n      </p>\n    </div>\n\n    <figure class=\"sea-pepper__figure\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0222/9882/0682/files/IMG_8659.jpg?width=700\" alt=\"Sliced Fresno chile rounds and thinly sliced green onion in two small blue bowls\" width=\"2573\" height=\"3216\" loading=\"lazy\" decoding=\"async\">\n      <figcaption class=\"sea-pepper__cap\">\n        Fresno chile and green onion, sliced thin and ready to scatter.\n      </figcaption>\n    </figure>\n\n  </div>\n</div>",
        "padding_top": 40,
