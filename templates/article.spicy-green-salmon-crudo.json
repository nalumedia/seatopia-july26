    "faq": {
      "type": "faq",
      "blocks": {
        "q_raw": {
          "type": "question",
          "settings": {
            "title": "Can I eat the King Salmon raw?",
            "text": "<p>Val serves it raw here. Read what sashimi-grade means to us above. Eating raw or undercooked meat, poultry, seafood, shellfish or eggs may increase your risk of foodborne illness, especially with certain medical conditions. Consult your doctor if you think you may be sensitive.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_thaw": {
          "type": "question",
          "settings": {
            "title": "How do I thaw fish I am going to eat raw?",
            "text": "<p>In the refrigerator, in its sealed pack, overnight. Never on the counter or in warm water. Keep it cold until you slice it, and slice it while it is still very cold &mdash; it holds its shape and cuts cleanly. Eat it the day you thaw it.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_skin": {
          "type": "question",
          "settings": {
            "title": "How do I take the skin off?",
            "text": "<p>Lay the fillet skin-side down with the narrow end toward you. Cut down to the skin at that end, then grip the skin with a paper towel and run your knife flat along it, angled slightly down, pulling the skin gently the other way. It is easiest while the fish is still very cold.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_macha": {
          "type": "question",
          "settings": {
            "title": "What is salsa macha, and where do I find it?",
            "text": "<p>A Mexican chile oil made with dried chiles, garlic and toasted nuts or seeds, so it is crunchy as well as hot. Look for it in jars near the hot sauces or in Latin grocery stores. Most contain peanuts or sesame, so check the label if you are cooking for allergies. Chili crisp is the closest swap.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_ahead": {
          "type": "question",
          "settings": {
            "title": "Can I make it ahead?",
            "text": "<p>Make the dressing up to a few hours ahead and keep it in the fridge with plastic wrap pressed onto the surface so it stays green. Slice the toppings ahead too. Slice the salmon and plate everything right before you serve.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_serve": {
          "type": "question",
          "settings": {
            "title": "What do I serve it with?",
            "text": "<p>Val serves it as a light appetizer with tortilla chips or crunchy crackers for scooping up the dressing. For dinner, double it and add a simple rice or a green salad.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
      "block_order": [
        "q_raw",
        "q_thaw",
        "q_skin",
