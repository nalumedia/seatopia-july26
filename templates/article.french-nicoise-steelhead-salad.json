        "g_serves": {
          "type": "column",
          "settings": {
            "icon": "users",
            "custom_icon": "",
            "heading": "Serves 3",
            "text": "<p>One 12 oz Steelhead Sashimi Loin, about 4 oz of fish per plate. Laid whole over a big platter and served family style.</p>",
            "highlighted_text": "none",
