    "shrimp_note": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_id": "one-pot-three-timers",
        "liquid": "<style>\n  .sea-pepper {\n    --ink: #171717;\n    --muted: #5c5c5c;\n    --line: #e5e2dc;\n    --wash: #faf8f4;\n    --gold: #bb8f50;\n    color: var(--ink);\n    background: var(--wash);\n    border: 1px solid var(--line);\n    border-radius: 20px;\n    padding: 30px;\n  }\n  .sea-pepper__grid {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) minmax(0, 300px);\n    gap: 34px;\n    align-items: center;\n  }\n  .sea-pepper__eyebrow {\n    font-size: 11px;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n    color: var(--gold);\n    font-weight: 600;\n    margin: 0 0 8px;\n  }\n  .sea-pepper__heading {\n    font-size: clamp(23px, 2.8vw, 30px);\n    line-height: 1.15;\n    font-weight: 600;\n    margin: 0 0 10px;\n  }\n  .sea-pepper__lede {\n    font-size: 15px;\n    line-height: 1.55;\n    color: var(--muted);\n    margin: 0 0 22px;\n  }\n  .sea-pepper__rows {\n    display: grid;\n    gap: 14px;\n  }\n  .sea-pepper__row {\n    background: #fff;\n    border: 1px solid var(--line);\n    border-radius: 14px;\n    padding: 15px 17px;\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) auto;\n    gap: 10px 16px;\n    align-items: center;\n  }\n  .sea-pepper__row--pick {\n    border-color: var(--gold);\n    box-shadow: 0 0 0 1px var(--gold);\n  }\n  .sea-pepper__name {\n    grid-column: 1;\n    margin: 0;\n    font-size: 15px;\n    font-weight: 600;\n    line-height: 1.3;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    flex-wrap: wrap;\n  }\n  .sea-pepper__tag {\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n    color: #fff;\n    background: var(--gold);\n    padding: 3px 8px;\n    border-radius: 999px;\n  }\n  .sea-pepper__meter {\n    grid-column: 2;\n    grid-row: 1;\n    display: flex;\n    gap: 4px;\n    align-items: center;\n  }\n  .sea-pepper__pip {\n    width: 9px;\n    height: 9px;\n    border-radius: 50%;\n    background: #fff;\n    border: 1.5px solid #d8cfc0;\n  }\n  .sea-pepper__pip.is-on {\n    background: #b8462f;\n    border-color: #b8462f;\n  }\n  .sea-pepper__note {\n    grid-column: 1 / -1;\n    margin: 0;\n    font-size: 13.5px;\n    line-height: 1.5;\n    color: var(--muted);\n  }\n  .sea-pepper__legend {\n    margin: 16px 0 0;\n    padding-top: 14px;\n    border-top: 1px solid var(--line);\n    font-size: 13px;\n    line-height: 1.55;\n    color: var(--muted);\n  }\n  .sea-pepper__figure {\n    margin: 0;\n  }\n  .sea-pepper__figure img {\n    width: 100%;\n    height: auto;\n    display: block;\n    border-radius: 16px;\n    box-shadow: 0 14px 34px -22px rgba(0,0,0,.5);\n  }\n  .sea-pepper__cap {\n    margin: 10px 0 0;\n    font-size: 12.5px;\n    line-height: 1.5;\n    color: var(--muted);\n  }\n  @media (max-width: 989px) {\n    .sea-pepper {\n      padding: 22px;\n    }\n    .sea-pepper__grid {\n      grid-template-columns: 1fr;\n      gap: 24px;\n    }\n    .sea-pepper__figure {\n      order: -1;\n    }\n  }\n</style>\n\n<div class=\"sea-pepper\">\n  <div class=\"sea-pepper__grid\">\n\n    <div class=\"sea-pepper__body\">\n      <p class=\"sea-pepper__eyebrow\">One pot, three timers</p>\n      <h2 class=\"sea-pepper__heading\">Everything boils together. It just comes out at different times.</h2>\n      <p class=\"sea-pepper__lede\">\n        Bring a medium pot of water to the boil, then add the potatoes, string beans and eggs all at once\n        and start a single timer. Lift each one out with a slotted spoon as its time comes up. One pot to\n        wash, and the three finish within ten minutes of each other.\n      </p>\n\n      <div class=\"sea-pepper__rows\">\n      <div class=\"sea-pepper__row\">\n        <p class=\"sea-pepper__name\">\n          <span>String beans</span>\n          <span class=\"sea-pepper__tag\">Out at 5 min</span>\n        </p>\n        <div class=\"sea-pepper__meter\" role=\"img\" aria-label=\"Time in the pot: Out at 5 min\">\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        </div>\n        <p class=\"sea-pepper__note\">Bright green and just tender, with a little snap left. They keep cooking from their own heat, so pull them on time.</p>\n      </div>\n      <div class=\"sea-pepper__row sea-pepper__row--pick\">\n        <p class=\"sea-pepper__name\">\n          <span>Eggs</span>\n          <span class=\"sea-pepper__tag\">Out at 8 min</span>\n        </p>\n        <div class=\"sea-pepper__meter\" role=\"img\" aria-label=\"Time in the pot: Out at 8 min\">\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        <span class=\"sea-pepper__pip\"></span>\n        </div>\n        <p class=\"sea-pepper__note\">Set whites and a soft, jammy centre &mdash; the yolk you see across the platter in the photos. Halve them once they are cool enough to handle.</p>\n      </div>\n      <div class=\"sea-pepper__row\">\n        <p class=\"sea-pepper__name\">\n          <span>Baby potatoes</span>\n          <span class=\"sea-pepper__tag\">Out at 15 min</span>\n        </p>\n        <div class=\"sea-pepper__meter\" role=\"img\" aria-label=\"Time in the pot: Out at 15 min\">\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip is-on\"></span>\n        <span class=\"sea-pepper__pip is-on\"></span>\n        </div>\n        <p class=\"sea-pepper__note\">A knife slides into the centre with no resistance. Halve them while they are still warm so they take on some of the vinaigrette.</p>\n      </div>\n      </div>\n\n      <p class=\"sea-pepper__legend\">\n        The dots show how far into the 15 minutes each one comes out. Let everything cool slightly before you\n        halve it &mdash; warm, not hot.\n      </p>\n    </div>\n\n    <figure class=\"sea-pepper__figure\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0222/9882/0682/files/step-1-option-2.jpg?width=700\" alt=\"Baby potatoes, yellow string beans and eggs boiling together in one pot over an open fire\" width=\"1800\" height=\"2400\" loading=\"lazy\" decoding=\"async\">\n      <figcaption class=\"sea-pepper__cap\">\n        Jason cooks the whole pot over the fire. A stovetop burner works exactly the same way.\n      </figcaption>\n    </figure>\n\n  </div>\n</div>",
