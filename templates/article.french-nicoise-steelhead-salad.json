    "faq_shrimp": {
      "type": "faq",
      "blocks": {
        "q_salmon": {
          "type": "question",
          "settings": {
            "title": "Can I use salmon instead of steelhead?",
            "text": "<p>Yes &mdash; any salmon from Seatopia works in this recipe. Portions are thinner than a whole loin, so check them at the low end of the cooking time: the fish is ready when it flakes easily with a fork.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_heat": {
          "type": "question",
          "settings": {
            "title": "Grill or oven?",
            "text": "<p>Either. The sealed packet does the work, so the heat source matters less than usual: about 10 minutes on the grill or 15 in a 350&deg;F oven. You can cook it on the stovetop too.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_done": {
          "type": "question",
          "settings": {
            "title": "How do I know the steelhead is done?",
            "text": "<p>Open the packet carefully and press the thickest part with a fork. It is ready when the flesh is opaque and separates into flakes without effort. If the centre still looks translucent, re-seal the packet and give it a few more minutes.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_temp": {
          "type": "question",
          "settings": {
            "title": "Is it served warm or cold?",
            "text": "<p>Either, and room temperature is the classic. Let the fish, potatoes and eggs cool slightly before they go on the greens so the lettuce does not wilt, and dress the platter just before serving.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_eggs": {
          "type": "question",
          "settings": {
            "title": "How runny are the eggs at 8 minutes?",
            "text": "<p>Set whites and a soft, jammy centre, like the ones in the photos. For a firmer yolk leave them in for 10 minutes instead.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "q_thaw": {
          "type": "question",
          "settings": {
            "title": "How do I thaw the steelhead?",
            "text": "<p>Overnight in the refrigerator in the sealed pack, about 12 hours, then pat it dry before it goes into the packet. In a hurry, submerge the sealed pack in cold water and change the water every 20 minutes. Never thaw fish on the counter or out of its pack.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
      "block_order": [
        "q_salmon",
        "q_heat",
        "q_done",
        "q_temp",
        "q_eggs",
        "q_thaw"
      ],
