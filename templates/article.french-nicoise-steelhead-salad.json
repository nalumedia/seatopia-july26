            "icon": "check_mark",
            "custom_icon": "",
            "heading": "One pot, three timers",
            "text": "<p>Everything goes into the boiling water together. Beans come out at 5 minutes, eggs at 8 and potatoes at 15 &mdash; one timer, three pulls.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
