    "meal_prep": {
      "type": "image-with-text",
      "blocks": {
        "m_sub": {
          "type": "subheading",
          "settings": {
            "subheading": "Honey cinnamon salmon",
            "subheading_size": "subtitle-md",
            "secondary_color": true
          }
        },
        "m_head": {
          "type": "heading",
          "settings": {
            "heading": "Small pieces, roasted at 400&deg;F",
            "heading_size": "title-md",
            "heading_tag": "h2",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "m_text": {
          "type": "text",
          "settings": {
            "text": "<p>Thaw the salmon in the fridge overnight in its sealed pack, then pat it dry. Cut each portion into 4&ndash;5 small pieces, toss them with about a tablespoon of honey until evenly coated, and season with a sprinkle of sea salt and a teaspoon of cinnamon. Spread them on a parchment-lined baking sheet and roast at 400&deg;F for about 15&ndash;20 minutes, until done to your liking. The FDA conservatively suggests cooking seafood to an internal temperature of 145&nbsp;&deg;F.</p>",
            "text_size": "subtext-md",
            "text_max_size": 32,
            "text_font": "body",
            "secondary_color": false,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "m_btn": {
          "type": "button",
          "settings": {
            "button_label": "Shop Atlantic Salmon",
            "button_link": "/products/atlantic-salmon-2x-6oz-portions",
            "button_style": "primary",
            "button_size": "md",
            "button_external": false,
            "button_icon": true
          }
        }
      },
      "block_order": [
        "m_sub",
        "m_head",
