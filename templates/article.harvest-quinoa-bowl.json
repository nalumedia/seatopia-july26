          }
        },
        "f_text": {
          "type": "text",
          "settings": {
            "text": "<p>Each pack holds skin-off 6 oz portions of Atlantic Salmon, blast-frozen and vacuum sealed.</p><p>Our Atlantic Salmon tested at 709 mg EPA and 1,254 mg DHA per 6 oz portion. Values vary by sample and season. Low mercury, tested to a tenth of the FDA action level. No microplastics detected in third-party testing.</p><p>Every supplier is third-party tested for nutrition, mercury and microplastics, then randomly audited to ensure consistent compliance with the Seatopia Standard. Farms named, panels published.</p>",
            "text_size": "subtext-md",
            "text_max_size": 32,
            "text_font": "body",
            "secondary_color": false,
            "highlighted_text": "none",
