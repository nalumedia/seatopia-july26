    "heat_note": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_id": "build-your-bowl",
        "liquid": "<style>\n  .sea-pepper {\n    --ink: #171717;\n    --muted: #5c5c5c;\n    --line: #e5e2dc;\n    --wash: #faf8f4;\n    --gold: #bb8f50;\n    color: var(--ink);\n    background: var(--wash);\n    border: 1px solid var(--line);\n    border-radius: 20px;\n    padding: 30px;\n  }\n  .sea-pepper__grid {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) minmax(0, 300px);\n    gap: 34px;\n    align-items: center;\n  }\n  .sea-pepper__eyebrow {\n    font-size: 11px;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n    color: var(--gold);\n    font-weight: 600;\n    margin: 0 0 8px;\n  }\n  .sea-pepper__heading {\n    font-size: clamp(23px, 2.8vw, 30px);\n    line-height: 1.15;\n    font-weight: 600;\n    margin: 0 0 10px;\n  }\n  .sea-pepper__lede {\n    font-size: 15px;\n    line-height: 1.55;\n    color: var(--muted);\n    margin: 0 0 22px;\n  }\n  .sea-pepper__rows {\n    display: grid;\n    gap: 14px;\n  }\n  .sea-pepper__row {\n    background: #fff;\n    border: 1px solid var(--line);\n    border-radius: 14px;\n    padding: 15px 17px;\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) auto;\n    gap: 10px 16px;\n    align-items: center;\n  }\n  .sea-pepper__row--pick {\n    border-color: var(--gold);\n    box-shadow: 0 0 0 1px var(--gold);\n  }\n  .sea-pepper__name {\n    grid-column: 1;\n    margin: 0;\n    font-size: 15px;\n    font-weight: 600;\n    line-height: 1.3;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    flex-wrap: wrap;\n  }\n  .sea-pepper__tag {\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n    color: #fff;\n    background: var(--gold);\n    padding: 3px 8px;\n    border-radius: 999px;\n  }\n  .sea-pepper__meter {\n    grid-column: 2;\n    grid-row: 1;\n    display: flex;\n    gap: 4px;\n    align-items: center;\n  }\n  .sea-pepper__pip {\n    width: 9px;\n    height: 9px;\n    border-radius: 50%;\n    background: #fff;\n    border: 1.5px solid #d8cfc0;\n  }\n  .sea-pepper__pip.is-on {\n    background: #b8462f;\n    border-color: #b8462f;\n  }\n  .sea-pepper__note {\n    grid-column: 1 / -1;\n    margin: 0;\n    font-size: 13.5px;\n    line-height: 1.5;\n    color: var(--muted);\n  }\n  .sea-pepper__legend {\n    margin: 16px 0 0;\n    padding-top: 14px;\n    border-top: 1px solid var(--line);\n    font-size: 13px;\n    line-height: 1.55;\n    color: var(--muted);\n  }\n  .sea-pepper__figure {\n    margin: 0;\n  }\n  .sea-pepper__figure img {\n    width: 100%;\n    height: auto;\n    display: block;\n    border-radius: 16px;\n    box-shadow: 0 14px 34px -22px rgba(0,0,0,.5);\n  }\n  .sea-pepper__cap {\n    margin: 10px 0 0;\n    font-size: 12.5px;\n    line-height: 1.5;\n    color: var(--muted);\n  }\n  @media (max-width: 989px) {\n    .sea-pepper {\n      padding: 22px;\n    }\n    .sea-pepper__grid {\n      grid-template-columns: 1fr;\n      gap: 24px;\n    }\n    .sea-pepper__figure {\n      order: -1;\n    }\n  }\n  .sea-pepper__step {\n    grid-column: 2;\n    grid-row: 1;\n    font-size: 11px;\n    font-weight: 600;\n    letter-spacing: .1em;\n    text-transform: uppercase;\n    color: var(--gold);\n  }\n  .sea-pepper__figure video {\n    width: 100%;\n    height: auto;\n    aspect-ratio: 9 / 16;\n    object-fit: cover;\n    display: block;\n    border-radius: 16px;\n    background: #e9e4dc;\n    box-shadow: 0 14px 34px -22px rgba(0,0,0,.5);\n  }\n</style>\n\n<div class=\"sea-pepper\">\n  <div class=\"sea-pepper__grid\">\n\n    <div class=\"sea-pepper__body\">\n      <p class=\"sea-pepper__eyebrow\">Build your bowl</p>\n      <h2 class=\"sea-pepper__heading\">How Erica builds hers.</h2>\n      <p class=\"sea-pepper__lede\">\n        Everything is cooked separately and comes together in the bowl. Get the squash and the salmon into the\n        oven first, and the rest is done by the time they come out.\n      </p>\n\n      <div class=\"sea-pepper__rows\">\n      <div class=\"sea-pepper__row\">\n        <p class=\"sea-pepper__name\">\n          <span>Quinoa &amp; lentils</span>\n          <span class=\"sea-pepper__tag\">The base</span>\n        </p>\n        <span class=\"sea-pepper__step\">Step 1</span>\n        <p class=\"sea-pepper__note\">Cook them separately and set them aside. Half a cup of each per bowl.</p>\n      </div>\n      <div class=\"sea-pepper__row\">\n        <p class=\"sea-pepper__name\">\n          <span>Roasted delicata</span>\n          <span class=\"sea-pepper__tag\">The sweet part</span>\n        </p>\n        <span class=\"sea-pepper__step\">Step 2</span>\n        <p class=\"sea-pepper__note\">Thin slices, olive oil, sea salt and garlic powder, roasted at 400&deg;F for 15&ndash;20 minutes until soft.</p>\n      </div>\n      <div class=\"sea-pepper__row\">\n        <p class=\"sea-pepper__name\">\n          <span>Carrots &amp; kale</span>\n          <span class=\"sea-pepper__tag\">The fresh part</span>\n        </p>\n        <span class=\"sea-pepper__step\">Step 3</span>\n        <p class=\"sea-pepper__note\">Grated or pre-cut carrots, and Tuscan kale washed and sliced into thin ribbons.</p>\n      </div>\n      <div class=\"sea-pepper__row sea-pepper__row--pick\">\n        <p class=\"sea-pepper__name\">\n          <span>Honey cinnamon salmon</span>\n          <span class=\"sea-pepper__tag\">The center</span>\n        </p>\n        <span class=\"sea-pepper__step\">Step 4</span>\n        <p class=\"sea-pepper__note\">Bite-sized pieces of Atlantic Salmon, coated in honey, cinnamon and sea salt and roasted at 400&deg;F.</p>\n      </div>\n      <div class=\"sea-pepper__row\">\n        <p class=\"sea-pepper__name\">\n          <span>Cashews &amp; tahini</span>\n          <span class=\"sea-pepper__tag\">The finish</span>\n        </p>\n        <span class=\"sea-pepper__step\">Step 5</span>\n        <p class=\"sea-pepper__note\">Dry-roasted cashews on top, then the turmeric tahini drizzled evenly over everything.</p>\n      </div>\n      </div>\n\n      <p class=\"sea-pepper__legend\">\n        Arrange each part in its own section of the bowl, then drizzle the tahini over all of it.\n      </p>\n    </div>\n\n    {%- comment -%}\n      Silent loop of Erica's video. The upload has no audio track: her voiceover carries claims the\n      claims guide rules red, so only the picture is used. Do not swap in the original upload.\n    {%- endcomment -%}\n    <figure class=\"sea-pepper__figure\">\n      <video class=\"sea-pepper__loop\" muted loop playsinline preload=\"none\" disablepictureinpicture disableremoteplayback\n        poster=\"https://cdn.shopify.com/s/files/1/0222/9882/0682/files/05_carrots.jpg?width=700\" width=\"720\" height=\"1280\"\n        data-src=\"https://cdn.shopify.com/videos/c/vp/8426519d7a2a4a459c505ca9b2d2a824/8426519d7a2a4a459c505ca9b2d2a824.HD-720p-3.0Mbps-99352198.mp4\"\n        aria-label=\"Erica building a harvest bowl: quinoa, lentils, squash, kale, carrots, honey cinnamon salmon and turmeric tahini\"></video>\n      <figcaption class=\"sea-pepper__cap\">\n        Erica builds hers, start to finish.\n      </figcaption>\n    </figure>\n\n  </div>\n</div>\n\n<script>\n  (function () {\n    var v = document.querySelector('.sea-pepper__loop');\n    if (!v) return;\n    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;\n    var start = function () {\n      if (!v.src) v.src = v.getAttribute('data-src');\n      var p = v.play();\n      if (p && p.catch) p.catch(function () {});\n    };\n    if (!('IntersectionObserver' in window)) { start(); return; }\n    new IntersectionObserver(function (entries) {\n      entries.forEach(function (e) { if (e.isIntersecting) { start(); } else if (v.src) { v.pause(); } });\n    }, { rootMargin: '200px' }).observe(v);\n  })();\n</script>",
