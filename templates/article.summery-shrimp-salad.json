    "label_story": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_id": "label-story",
        "liquid": "\n<style>\n  .sea-story {\n    --ink:#171717; --muted:#5c5c5c; --line:#e5e2dc; --wash:#faf8f4; --gold:#bb8f50;\n    color: var(--ink);\n    background: var(--wash);\n    border: 1px solid var(--line);\n    border-radius: 20px;\n    padding: 30px;\n  }\n  .sea-story__grid {\n    display: grid;\n    grid-template-columns: minmax(0, 260px) minmax(0, 1fr);\n    gap: 32px;\n    align-items: center;\n  }\n  .sea-story__player {\n    position: relative;\n    margin: 0;\n    aspect-ratio: 9 / 16;\n    border-radius: 16px;\n    overflow: hidden;\n    background: #111 center / cover no-repeat;\n    box-shadow: 0 14px 34px -22px rgba(0,0,0,.5);\n  }\n  .sea-story__player video {\n    width: 100%; height: 100%; object-fit: cover; display: block;\n    opacity: 0; transition: opacity .3s ease;\n  }\n  .sea-story__player.is-playing video { opacity: 1; }\n  .sea-story__play {\n    position: absolute; inset: 0; width: 100%; height: 100%;\n    display: flex; align-items: center; justify-content: center;\n    border: 0; padding: 0; cursor: pointer;\n    background: linear-gradient(180deg, rgba(0,0,0,.04), rgba(0,0,0,.34));\n    transition: opacity .25s ease;\n  }\n  .sea-story__player.is-playing .sea-story__play { opacity: 0; pointer-events: none; }\n  .sea-story__play span {\n    width: 60px; height: 60px; border-radius: 50%;\n    background: rgba(255,255,255,.94);\n    display: flex; align-items: center; justify-content: center;\n    box-shadow: 0 6px 18px -6px rgba(0,0,0,.5);\n    transition: transform .18s ease;\n  }\n  .sea-story__play:hover span { transform: scale(1.07); }\n  .sea-story__play svg { width: 20px; height: 20px; margin-left: 3px; fill: var(--ink); }\n  .sea-story__badge {\n    position: absolute; top: 12px; left: 12px; z-index: 2;\n    font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;\n    color: #fff; background: rgba(23,23,23,.62); padding: 5px 10px; border-radius: 999px;\n  }\n  .sea-story__player.is-playing .sea-story__badge { opacity: 0; transition: opacity .25s ease; }\n  .sea-story__eyebrow {\n    font-size: 11px; letter-spacing: .14em; text-transform: uppercase;\n    color: var(--gold); font-weight: 600; margin: 0 0 10px;\n  }\n  .sea-story__heading {\n    font-size: clamp(24px, 3vw, 31px); line-height: 1.15; font-weight: 600; margin: 0 0 14px;\n  }\n  .sea-story__body { font-size: 16px; line-height: 1.6; color: var(--muted); margin: 0 0 14px; }\n  .sea-story__body strong { color: var(--ink); }\n  .sea-story__body:last-child { margin-bottom: 0; }\n  @media (max-width: 989px) {\n    .sea-story { padding: 22px; }\n    .sea-story__grid { grid-template-columns: 1fr; gap: 24px; justify-items: center; }\n    .sea-story__player { width: min(74vw, 260px); }\n  }\n</style>\n\n<div class=\"sea-story\">\n  <div class=\"sea-story__grid\">\n\n    <figure class=\"sea-story__player\" data-sea-story\n            style=\"background-image:url('{{ 'sunny-fine-foods-label-story-video-poster.jpg' | file_url }}');\">\n      <span class=\"sea-story__badge\">1:31</span>\n      <video preload=\"none\" playsinline\n             poster=\"{{ 'sunny-fine-foods-label-story-video-poster.jpg' | file_url }}\"\n             data-src-hd=\"https://cdn.shopify.com/videos/c/vp/1848d66f03d84b1fb9137637951fbedb/1848d66f03d84b1fb9137637951fbedb.HD-720p-1.6Mbps-93422812.mp4\"\n             data-src-sd=\"https://cdn.shopify.com/videos/c/vp/1848d66f03d84b1fb9137637951fbedb/1848d66f03d84b1fb9137637951fbedb.SD-480p-0.9Mbps-93422812.mp4\"\n             aria-label=\"Nora Kramer of Sunny Fine Foods on seafood mislabeling and why she cooks with Seatopia\"></video>\n      <button class=\"sea-story__play\" type=\"button\" aria-label=\"Play the video from Sunny Fine Foods\">\n        <span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M8 5v14l11-7z\"></path></svg></span>\n      </button>\n    </figure>\n\n    <div>\n      <p class=\"sea-story__eyebrow\">Why we picked this partner</p>\n      <h2 class=\"sea-story__heading\">&ldquo;Two out of every five fish sold in the US isn&rsquo;t the fish on the label.&rdquo;</h2>\n      <p class=\"sea-story__body\">\n        That is the line Nora opens with, and it is the reason this collaboration exists. Sunny Fine Foods reads labels\n        for a living &mdash; their dressings skip the gums, fillers and blanket &ldquo;natural flavors&rdquo; that hide\n        in most bottles. We do the same thing with fish.\n      </p>\n      <p class=\"sea-story__body\">\n        Every Seatopia species is <strong>third-party lab tested</strong> and traceable to a single named farm. The\n        shrimp in this salad comes from <strong>Tarakan</strong>, raised in Indonesian mangroves on a natural diet of\n        neoplankton and phytoplankton &mdash; not a generic &ldquo;product of&rdquo; country label.\n      </p>\n    </div>\n\n  </div>\n</div>\n\n<script>\n  (function () {\n    document.querySelectorAll('[data-sea-story]').forEach(function (frame) {\n      var video = frame.querySelector('video');\n      var button = frame.querySelector('.sea-story__play');\n      if (!video || !button) return;\n\n      button.addEventListener('click', function () {\n        if (!video.currentSrc && !video.src) {\n          var wide = window.matchMedia('(min-width: 600px)').matches;\n          video.src = wide ? video.dataset.srcHd : video.dataset.srcSd;\n        }\n        frame.classList.add('is-playing');\n        video.controls = true;\n        var played = video.play();\n        if (played && played.catch) {\n          played.catch(function () { video.muted = true; video.play(); });\n        }\n      });\n\n      video.addEventListener('pause', function () {\n        if (video.currentTime === 0 || video.ended) {\n          frame.classList.remove('is-playing');\n          video.controls = false;\n        }\n      });\n    });\n  })();\n</script>\n",
        "padding_top": 8,
        "padding_bottom": 48,
        "divider": false,
        "narrow": false,
        "rounded": false,
        "color_text": "",
        "color_background": "",
        "gradient_background": "",
        "color_button_text": "",
        "color_button_background": "",
        "color_button_gradient": ""
      }
    },
    "rich_text_standard": {
      "type": "rich-text",
      "blocks": {
        "heading_standard": {
          "type": "heading",
          "settings": {
            "heading": "Shrimp raised in a mangrove, not a cleared one",
            "heading_size": "title-sm",
            "heading_tag": "h2",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "text_standard": {
          "type": "text",
          "settings": {
            "text": "<p>Most farmed shrimp comes from ponds cut out of mangrove forest. Ours is the opposite trade: Tarakan raises Black Tiger Shrimp <em>inside</em> standing Indonesian mangroves, where the shrimp feed on a natural diet of neoplankton and phytoplankton rather than on formulated pellets.</p><p>Third-party testing puts the mercury at <strong>0.017 ppm</strong>, comfortably inside the 0.1 ppm ceiling of the Seatopia Standard. Each 4 oz portion carries roughly <strong>18 mcg of selenium</strong> and about <strong>40 mg of marine omega-3s</strong>, and the bag ships with no added sulfites &mdash; the preservative that gives most supermarket shrimp its faintly chemical edge. You can read how we test on our <a href=\"/pages/seatopia-testing-commitment\" title=\"Seatopia's Testing Commitment\">testing commitment page</a>.</p>",
            "text_size": "subtext-md",
            "text_max_size": 32,
            "text_font": "body",
            "secondary_color": false,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
      "block_order": [
        "heading_standard",
        "text_standard"
      ],
