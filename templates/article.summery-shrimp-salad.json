 clip_base }}71ce79be93a14cc893e9eaf3a9eb375d/71ce79be93a14cc893e9eaf3a9eb375d.HD-720p-4.5Mbps-93420371.mp4\"\n               data-src-sd=\"{{ clip_base }}71ce79be93a14cc893e9eaf3a9eb375d/71ce79be93a14cc893e9eaf3a9eb375d.SD-480p-1.5Mbps-93420371.mp4\"\n               aria-label=\"Everything laid out: Seatopia Black Tiger Shrimp, cucumbers, peaches, avocado, cilantro, sesame, lime and Sunny Ginger Ponzu\"></video>\n      </div>\n      <figcaption class=\"sea-clips__cap\"><b>Everything on one tray</b>Eight ingredients. Nothing to marinate, nothing to reduce.</figcaption>\n    </figure>\n\n    <figure class=\"sea-clips__item\">\n      <div class=\"sea-clips__frame\" data-sea-clip\n           style=\"background-image:url('{{ 'sunny-fine-foods-ginger-ponzu-drizzle.jpg' | file_url }}');\">\n        <span class=\"sea-clips__step\">Step 2</span>\n        <video muted loop playsinline preload=\"none\" disablepictureinpicture\n               poster=\"{{ 'sunny-fine-foods-ginger-ponzu-drizzle.jpg' | file_url }}\"\n               data-src-hd=\"{{ clip_base }}56be5b5369ae4a9f83412c5bfe90c7e1/56be5b5369ae4a9f83412c5bfe90c7e1.HD-720p-4.5Mbps-93420370.mp4\"\n               data-src-sd=\"{{ clip_base }}56be5b5369ae4a9f83412c5bfe90c7e1/56be5b5369ae4a9f83412c5bfe90c7e1.SD-480p-1.5Mbps-93420370.mp4\"\n               aria-label=\"Sunny Ginger Ponzu being drizzled over the seared shrimp, cucumber, peach and avocado\"></video>\n      </div>\n      <figcaption class=\"sea-clips__cap\"><b>One big drizzle</b>Ginger ponzu goes on at the end, straight from the bottle.</figcaption>\n    </figure>\n\n    <figure class=\"sea-clips__item\">\n      <div class=\"sea-clips__frame\" data-sea-clip\n           style=\"background-image:url('{{ 'sunny-fine-foods-shrimp-peach-salad-plated.jpg' | file_url }}');\">\n        <span class=\"sea-clips__step\">Step 3</span>\n        <video muted loop playsinline preload=\"none\" disablepictureinpicture\n               poster=\"{{ 'sunny-fine-foods-shrimp-peach-salad-plated.jpg' | file_url }}\"\n               data-src-hd=\"{{ clip_base }}f51c0c2a8e8e40c6ac5f9e17beb4e805/f51c0c2a8e8e40c6ac5f9e17beb4e805.HD-720p-4.5Mbps-93420372.mp4\"\n               data-src-sd=\"{{ clip_base }}f51c0c2a8e8e40c6ac5f9e17beb4e805/f51c0c2a8e8e40c6ac5f9e17beb4e805.SD-480p-1.5Mbps-93420372.mp4\"\n               aria-label=\"The finished shrimp salad plated, with a lime wedge squeezed over the top\"></video>\n      </div>\n      <figcaption class=\"sea-clips__cap\"><b>Lime, sesame, flaky salt</b>The three finishes that make it taste like a restaurant salad.</figcaption>\n    </figure>\n\n  </div>\n</div>\n\n<script>\n  (function () {\n    var frames = document.querySelectorAll('[data-sea-clip]');\n    if (!frames.length) return;\n\n    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    if (reduce) return;\n\n    if (!('IntersectionObserver' in window)) return;\n\n    var io = new IntersectionObserver(function (entries) {\n      entries.forEach(function (entry) {\n        var video = entry.target.querySelector('video');\n        if (!video) return;\n\n        if (entry.isIntersecting) {\n          if (!video.src) {\n            var wide = window.matchMedia('(min-width: 750px)').matches;\n            video.src = wide ? video.dataset.srcHd : video.dataset.srcSd;\n          }\n          var played = video.play();\n          if (played && played.catch) played.catch(function () {});\n        } else if (!video.paused) {\n          video.pause();\n        }\n      });\n    }, { rootMargin: '120px 0px', threshold: 0.25 });\n\n    frames.forEach(function (frame) { io.observe(frame); });\n  })();\n</script>\n",
