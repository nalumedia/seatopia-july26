   .sea-collab__name { font-size: 19px; }\n  }\n</style>\n\n{%- assign collab_avatar = 'sunny-fine-foods-logo.jpg' | file_url -%}\n\n<div class=\"sea-collab\">\n  {%- if collab_avatar != blank -%}\n    <div class=\"sea-collab__avatar\">\n      <img src=\"{{ collab_avatar }}\" alt=\"Sunny Fine Foods\" width=\"150\" height=\"150\" loading=\"lazy\" decoding=\"async\">\n    </div>\n  {%- endif -%}\n\n  <div class=\"sea-collab__body\">\n    <p class=\"sea-collab__eyebrow\">Sunny Fine Foods &times; Seatopia</p>\n    <p class=\"sea-collab__name\">Recipe by Sunny Fine Foods</p>\n    <p class=\"sea-collab__role\">Fresh dressings and sauces made from real ingredients &mdash; founded in Los Angeles by Matt and Nora Kramer</p>\n    <p class=\"sea-collab__cred\">Made with Sunny Ginger Ponzu &middot; never heat pasteurized, no added sugar &middot; <a href=\"https://www.sunnyfoods.us\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:inherit;\">sunnyfoods.us</a></p>\n  </div>\n\n  <a class=\"sea-collab__follow\" href=\"https://www.instagram.com/eat___sunny/\" target=\"_blank\" rel=\"noopener noreferrer\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n      <rect x=\"2\" y=\"2\" width=\"20\" height=\"20\" rx=\"5\"></rect>\n      <circle cx=\"12\" cy=\"12\" r=\"4\"></circle>\n      <circle cx=\"17.5\" cy=\"6.5\" r=\"1.2\" fill=\"currentColor\" stroke=\"none\"></circle>\n    </svg>\n    <span>Follow</span>\n  </a>\n</div>\n",
