    "rich_text_intro": {
      "type": "rich-text",
      "blocks": {
        "text_intro": {
          "type": "text",
          "settings": {
            "text": "<p>Sweet Fuyu persimmons, tart passion fruit and delicate Peruvian scallops come together in this bright, seasonal ceviche. A little Fresno pepper brings the heat, while lime and yuzu balance the sweetness.</p><p>Everything is finely diced to the size of the passion fruit seeds, so every spoonful has a little of everything, and it goes back to the table in the scallops’ own shells.</p>",
            "text_size": "subtext-md",
            "text_max_size": 32,
            "text_font": "body",
            "secondary_color": false,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
      "block_order": [
        "text_intro"
      ],
