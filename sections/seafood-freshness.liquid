{%- comment -%}
  Editorial page: Freshness is something you preserve. Rendered by templates/page.seafood-freshness.json.

  Built from the theme's own pieces so it reads like the rest of the store:
  - type: heading / title-* / subtext-* / text-* / text-opacity / rte classes
  - layout: page-width, page-width--narrow, --sp-* spacing, --rounded-block, rgb(var(--color-border))
  - colour: the accent bands set --color-background / --color-foreground from this section's
    settings (Theme editor > Seafood freshness), exactly like the Membership page
  - motion: animate-picture (zoom-out), media-element (scroll parallax), highlighted-text
    (scribble), and theme.Animation fade-ups via data-sf-animate. All of it respects
    prefers-reduced-motion through theme.config.motionReduced.

  Copy follows brand/claims-guide.md v0.32. The standard list uses the guide's green wording
  verbatim; do not reword it. The supplement survey band was cut on 2026-10-29 pending Clark.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign eyebrow_class = 'heading normal-case font-medium subtext-lg leading-none tracking-none'
  assign kicker_class = 'text-sm font-medium text-opacity leading-tight'
  assign cite_class = 'sf-cite text-xs text-opacity'

  assign hero_img = images['salmon_on_board.jpg']
  assign farm_img = images['ora-king-salmon-farm.jpg']
  assign close_img = images['salmon-lovers-box-9444410.jpg']
  assign pack_src = 'https://cdn.shopify.com/s/files/1/0222/9882/0682/products/bakkafrost-faroe-islands-salmon-8-oz-skin-off-portions-454957.jpg?v=1748038707'
-%}

<style>
  #shopify-section-{{ section.id }} {
    --sf-band-space: {{ s.band_padding }}px;
    --sf-band-space-mobile: {{ s.band_padding_mobile }}px;
  }
  {%- assign tones = 'sage,dark' | split: ',' -%}
  {%- for tone in tones -%}
    {%- case tone -%}
      {%- when 'sage' -%}{%- assign bg = s.sage_background -%}{%- assign fg = s.sage_text -%}
      {%- when 'dark' -%}{%- assign bg = s.dark_background -%}{%- assign fg = s.dark_text -%}
    {%- endcase -%}
    {%- assign border = fg | color_mix: bg, 18 -%}
    #shopify-section-{{ section.id }} .sf-tone--{{ tone }} {
      --color-background: {{ bg.red }} {{ bg.green }} {{ bg.blue }};
      --color-foreground: {{ fg.red }} {{ fg.green }} {{ fg.blue }};
      --color-border: {{ border | color_extract: 'red' }} {{ border | color_extract: 'green' }} {{ border | color_extract: 'blue' }};
      background: rgb(var(--color-background));
      color: rgb(var(--color-foreground));
    }
  {%- endfor -%}

  .sf :where(h1, h2, h3, p, figure, dl, dd, ol, ul) { margin: 0; }
  .sf :where(h1, h2, h3) { color: inherit; }

  .sf-band { padding-block: var(--sf-band-space); }
  @media (max-width: 767px) { .sf-band { padding-block: var(--sf-band-space-mobile); } }
  .sf-reading { max-width: 46rem; margin-inline: auto; }
  .sf-stack { display: flex; flex-direction: column; gap: var(--sp-5); }
  .sf-head { display: flex; flex-direction: column; gap: var(--sp-4); margin-block-end: var(--sp-2); }

  .sf-cite { text-decoration: none; white-space: nowrap; }
  .sf-cite:hover { text-decoration: underline; }

  /* Media: theme placeholder colour and block radius */
  .sf-media { position: relative; overflow: hidden; border-radius: var(--rounded-block); background: rgb(var(--color-placeholder)); }
  .sf-media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .sf-media--hero { aspect-ratio: 21 / 9; }
  .sf-media--wide { aspect-ratio: 16 / 7; }
  .sf-media--tall { aspect-ratio: 4 / 5; }
  @media (max-width: 767px) {
    .sf-media--hero { aspect-ratio: 4 / 5; }
    .sf-media--wide { aspect-ratio: 3 / 2; }
  }
  .sf-caption { margin-block-start: var(--sp-3); }

  /* Intro */
  .sf-intro { text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--sp-6); max-width: 60rem; margin-inline: auto; }
  .sf-intro .sf-deck { max-width: 40rem; }

  /* Contents nav */
  .sf-contents { display: flex; flex-wrap: wrap; gap: var(--sp-2) var(--sp-6); padding-block: var(--sp-5); border-block: 1px solid rgb(var(--color-border)); }
  .sf-contents p { width: 100%; }

  /* Chemistry: TMAO -> TMA */
  .sf-chem { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--sp-6); padding: var(--sp-8) var(--sp-6); border-radius: var(--rounded-block); text-align: center; }
  .sf-chem__item { display: flex; flex-direction: column; gap: var(--sp-2); }
  .sf-chem__arrow { display: block; width: 3rem; height: 1px; background: currentColor; position: relative; }
  .sf-chem__arrow::after { content: ""; position: absolute; inset-inline-end: 0; top: -4px; width: 9px; height: 9px; border-block-start: 1px solid currentColor; border-inline-end: 1px solid currentColor; transform: rotate(45deg); }

  /* Two pathways, oxidation measures, standard list: bordered rows */
  .sf-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-6); }
  .sf-card { display: flex; flex-direction: column; gap: var(--sp-2); padding: var(--sp-6); border: 1px solid rgb(var(--color-border)); border-radius: var(--rounded-block); background: rgb(var(--color-foreground) / 0.03); }
  .sf-rows > * { display: grid; grid-template-columns: 11rem 1fr; gap: var(--sp-6); padding-block: var(--sp-5); border-block-start: 1px solid rgb(var(--color-border)); }
  .sf-rows > *:last-child { border-block-end: 1px solid rgb(var(--color-border)); }
  .sf-rows dt { display: flex; flex-direction: column; gap: var(--sp-1d5); }
  .sf-list { list-style: none; padding: 0; }
  .sf-list li { display: flex; flex-direction: column; gap: var(--sp-1d5); padding-block: var(--sp-5); border-block-start: 1px solid rgb(var(--color-border)); }
  .sf-list li:last-child { border-block-end: 1px solid rgb(var(--color-border)); }
  @media (max-width: 767px) {
    .sf-pair { grid-template-columns: 1fr; }
    .sf-rows > * { grid-template-columns: 6.5rem 1fr; gap: var(--sp-4); }
    .sf-chem { gap: var(--sp-3); padding: var(--sp-6) var(--sp-4); }
    .sf-chem__arrow { width: 1.5rem; }
  }

  /* Pull quote */
  .sf-quote { text-align: center; max-width: 56rem; margin-inline: auto; }

  /* Packaging split */
  .sf-split { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(var(--sp-8), 5vw, calc(var(--sp-8) * 2)); align-items: center; }
  .sf-note { padding-block-start: var(--sp-5); border-block-start: 1px solid rgb(var(--color-border)); }
  @media (max-width: 1023px) { .sf-split { grid-template-columns: 1fr; } }

  /* Closing */
  .sf-closing { text-align: center; align-items: center; }

  /* References */
  .sf-refs ol { padding-inline-start: var(--sp-5); display: flex; flex-direction: column; gap: var(--sp-3); }
  .sf-refs li { scroll-margin-block-start: var(--sp-8); }
  .sf-refs a { overflow-wrap: anywhere; }

  .sf [id^="sf-"] { scroll-margin-block-start: calc(var(--header-height, 80px) + var(--sp-6)); }
</style>

<article class="sf" id="seatopia-freshness" aria-labelledby="sf-title">

  {%- comment -%} ============================ INTRO + HERO ============================ {%- endcomment -%}
  <section class="sf-band">
    <div class="page-width">
      <header class="sf-intro">
        <p class="{{ eyebrow_class }}">The Seatopia Journal · Food science</p>
        <h1 id="sf-title" class="heading title-xl tracking-heading leading-tight">
          {%- render 'highlighted-text', content: 'Freshness is something you <em>preserve.</em>', style: 'scribble', scribble: 'basic-underline' -%}
        </h1>
        <p class="sf-deck subtext-lg leading-normal text-opacity">What fishy odors, delicate omega-3s, and the journey from farm to fork reveal about truly exceptional seafood.</p>
        <p class="{{ kicker_class }}">By Seatopia · Science, sourcing &amp; a better dinner</p>
      </header>

      <figure style="margin-block-start: calc(var(--sp-8) * 1.5);">
        <media-element class="sf-media sf-media--hero block" data-parallax="0.15" data-parallax-dir="vertical">
          <picture class="block w-full h-full" is="animate-picture" data-animate="zoom-out">
            {%- if hero_img != blank -%}
              {{ hero_img | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '600,900,1200,1600,2000,2400', alt: 'A person slicing a salmon fillet on a wooden board in warm natural light.' }}
            {%- else -%}
              <img src="https://cdn.shopify.com/s/files/1/0222/9882/0682/files/salmon_on_board.jpg?width=2400" alt="A person slicing a salmon fillet on a wooden board in warm natural light." loading="eager" width="2400" height="1600">
            {%- endif -%}
          </picture>
        </media-element>
        <figcaption class="sf-caption {{ kicker_class }}">Good seafood starts with care, long before it reaches your kitchen.</figcaption>
      </figure>
    </div>
  </section>

  {%- comment -%} ============================ OPENING ============================ {%- endcomment -%}
  <section class="sf-band" style="padding-block-start: 0;">
    <div class="page-width">
      <div class="sf-reading sf-stack rte">
        <p class="heading title-sm leading-tight" data-sf-animate>We’ve learned to look for “fresh” seafood. Somewhere along the way, we also learned to expect it to smell fishy.</p>
        <p class="text-lg leading-normal">Those two expectations deserve a closer look.</p>
        <p class="text-lg leading-normal">A beautiful fillet on crushed ice can look like the very definition of freshness. But a display tells you surprisingly little about the time, temperatures, and handling that brought it there.</p>
        <p class="text-lg leading-normal">The more useful question is: <strong>how well has this fish been cared for?</strong></p>
        <p class="text-lg leading-normal">At Seatopia, that question connects everything: the farms we choose, the way seafood is handled, the freezing and packaging that protect it, and the independent testing that helps us understand what’s inside. The chemistry explains why.</p>

        <nav class="sf-contents" aria-label="In this article">
          <p class="{{ kicker_class }}">In this article</p>
          <a class="link font-medium" href="#sf-smell">The smell</a>
          <a class="link font-medium" href="#sf-omega">The omega-3s</a>
          <a class="link font-medium" href="#sf-preserve">The preservation</a>
          <a class="link font-medium" href="#sf-standard">The standard</a>
        </nav>
      </div>
    </div>
  </section>

  {%- comment -%} ============================ 01 THE SMELL ============================ {%- endcomment -%}
  <section class="sf-band" id="sf-smell" style="padding-block-start: 0;">
    <div class="page-width">
      <div class="sf-reading sf-stack">
        <div class="sf-head" data-sf-animate>
          <p class="{{ kicker_class }}">01 / Follow the chemistry</p>
          <h2 class="heading title-lg">That fishy smell has a story.</h2>
        </div>
        <p class="text-lg leading-normal">Many marine fish naturally contain trimethylamine N-oxide, usually shortened to TMAO. After the fish dies, certain spoilage bacteria can convert it into trimethylamine, or TMA: a compound associated with that familiar fishy odor. Species, temperature, and handling all influence how spoilage develops. <a class="{{ cite_class }}" href="#sf-ref-1">(FAO, n.d.)</a></p>

        <div class="sf-chem sf-tone--sage" role="group" aria-label="Simplified bacterial odor pathway">
          <div class="sf-chem__item" data-sf-animate>
            <strong class="heading title-md leading-none">TMAO</strong>
            <span class="text-sm leading-normal">Naturally present in many marine fish</span>
          </div>
          <span class="sf-chem__arrow" aria-hidden="true" data-sf-animate data-sf-delay="150"></span>
          <div class="sf-chem__item" data-sf-animate data-sf-delay="300">
            <strong class="heading title-md leading-none">TMA</strong>
            <span class="text-sm leading-normal">Produced by certain spoilage bacteria; fishy odor</span>
          </div>
        </div>

        <p class="text-lg leading-normal">That helps explain a useful piece of shopping advice: the FDA says fish should have a mild, fresh smell. Strong fishy, sour, rancid, or ammonia-like odors are reasons to pass it by. <a class="{{ cite_class }}" href="#sf-ref-2">(FDA, n.d.)</a></p>
        <p class="text-lg leading-normal">Different species have different natural aromas. The point is that a powerful off-odor is something to take seriously, rather than something to disguise with lemon.</p>
        <p class="text-sm leading-normal text-opacity">A mild smell is a quality clue, not proof of safety. Safe handling and temperature control still matter.</p>
      </div>
    </div>
  </section>

  {%- comment -%} ============================ 02 THE OMEGA-3S ============================ {%- endcomment -%}
  <section class="sf-band" id="sf-omega" style="padding-block-start: 0;">
    <div class="page-width">
      <div class="sf-reading sf-stack">
        <div class="sf-head" data-sf-animate>
          <p class="{{ kicker_class }}">02 / Protect what makes fish valuable</p>
          <h2 class="heading title-lg">Omega-3s deserve careful treatment.</h2>
        </div>
        <p class="text-lg leading-normal">Odor tells another story, too. Fish fats can react with oxygen in a process called lipid oxidation. In oily fish, that process contributes to rancid aromas and flavors, and it can continue during frozen storage. <a class="{{ cite_class }}" href="#sf-ref-1">(FAO, n.d.)</a></p>
        <p class="text-lg leading-normal">EPA and DHA, the long-chain omega-3 fatty acids found in seafood and marine oils, are particularly susceptible to oxidation. Their chemistry makes protection from oxygen, light, and heat an important part of maintaining oil quality. As oxidation progresses, it creates primary products such as lipid peroxides and a changing mixture of secondary breakdown products. <a class="{{ cite_class }}" href="#sf-ref-3">(Albert et al., 2013)</a></p>

        <div class="sf-pair">
          <div class="sf-card" data-sf-animate>
            <p class="{{ kicker_class }}">Bacterial spoilage</p>
            <h3 class="heading title-sm">The TMA pathway</h3>
            <p class="leading-normal text-opacity">Certain bacteria transform TMAO into a compound associated with fishy odor.</p>
          </div>
          <div class="sf-card" data-sf-animate data-sf-delay="150">
            <p class="{{ kicker_class }}">Lipid oxidation</p>
            <h3 class="heading title-sm">The rancidity pathway</h3>
            <p class="leading-normal text-opacity">Fats react with oxygen, producing compounds that can affect aroma and flavor.</p>
          </div>
        </div>

        <p class="text-lg leading-normal">These are different processes. Smelling a fillet cannot tell you its EPA and DHA content or give you a complete measurement of its oxidative condition. <a class="{{ cite_class }}" href="#sf-ref-1">(FAO, n.d.)</a></p>
      </div>
    </div>
  </section>

  {%- comment -%} ============================ OXIDATION EXPLAINER ============================ {%- endcomment -%}
  <section class="sf-band" style="padding-block-start: 0;">
    <div class="page-width">
      <div class="sf-reading sf-stack">
        <h2 class="heading title-md" data-sf-animate>How researchers measure oxidation.</h2>
        <p class="text-lg leading-normal">Oil testing commonly looks at more than one stage of the process:</p>
        <dl class="sf-rows">
          <div data-sf-animate>
            <dt><span class="heading title-sm leading-none">PV</span><span class="{{ kicker_class }}">Peroxide value</span></dt>
            <dd class="leading-normal">Measures primary oxidation products. A 2015 survey of fish oils used a voluntary limit of 5 mEq/kg.</dd>
          </div>
          <div data-sf-animate data-sf-delay="100">
            <dt><span class="heading title-sm leading-none">AV</span><span class="{{ kicker_class }}">Anisidine value</span></dt>
            <dd class="leading-normal">Assesses certain secondary oxidation products. The same survey used a limit of 20.</dd>
          </div>
          <div data-sf-animate data-sf-delay="200">
            <dt><span class="heading title-sm leading-none">TOTOX</span><span class="{{ kicker_class }}">Total oxidation value</span></dt>
            <dd class="leading-normal">Combines the two: TOTOX = 2 × PV + AV. The same survey used a limit of 26.</dd>
          </div>
        </dl>
        <p class="text-lg leading-normal">Peroxides can break down as oxidation advances, so a low PV alone can be misleading. These voluntary benchmarks assess oil quality; they are not established thresholds for harm in people. <a class="{{ cite_class }}" href="#sf-ref-4">(Jackowski et al., 2015)</a> <a class="{{ cite_class }}" href="#sf-ref-3">(Albert et al., 2013)</a></p>
        <p class="text-lg leading-normal">A review of oxidized marine oils highlighted gaps in the human evidence. Laboratory and animal findings do not, by themselves, demonstrate that oxidation levels measured in retail supplements cause human illness. <a class="{{ cite_class }}" href="#sf-ref-3">(Albert et al., 2013)</a></p>
        <p class="text-lg leading-normal">We can make the case for thoughtful preservation without overstating the health evidence. Flavor, quality, and transparency are already worth protecting.</p>
      </div>
    </div>
  </section>

  {%- comment -%} ============================ PULL QUOTE ============================ {%- endcomment -%}
  <section class="sf-band sf-tone--dark">
    <div class="page-width">
      <p class="sf-quote heading title-lg leading-tight" data-sf-animate>
        {%- render 'highlighted-text', content: 'What happened to the fish matters more than <em>a word on the label.</em>', style: 'scribble', scribble: 'squiggle-underline' -%}
      </p>
    </div>
  </section>

  {%- comment -%} ============================ 03 THE PRESERVATION ============================ {%- endcomment -%}
  <section class="sf-band" id="sf-preserve">
    <div class="page-width">
      <div class="sf-reading sf-stack">
        <div class="sf-head" data-sf-animate>
          <p class="{{ kicker_class }}">03 / Preserve the quality you start with</p>
          <h2 class="heading title-lg">Rethinking the freezer.</h2>
        </div>
        <p class="text-lg leading-normal">“Never frozen” tells you one thing about a fish’s history. It doesn’t tell you how quickly it was chilled, how long it traveled, or how consistently it stayed cold.</p>
        <p class="text-lg leading-normal">NOAA notes that frozen seafood can be an excellent choice because a catch may be processed and frozen promptly. A well-managed frozen supply chain offers a way to preserve quality early, rather than relying on a short refrigerated selling window. <a class="{{ cite_class }}" href="#sf-ref-6">(NOAA Fisheries, 2023)</a></p>
        <p class="text-lg leading-normal">Freezing technique matters. Ice formation affects muscle structure, which is one reason researchers study how freezing and thawing methods influence fish texture. Methods that produce finer, more uniform crystals can reduce structural damage. <a class="{{ cite_class }}" href="#sf-ref-7">(Alizadeh, 2012)</a></p>
        <p class="text-lg leading-normal">But freezing cannot restore quality already lost. It also doesn’t stop every change: fats can still oxidize during frozen storage. Temperature, time, and packaging remain part of the story. <a class="{{ cite_class }}" href="#sf-ref-1">(FAO, n.d.)</a></p>
        <p class="text-lg leading-normal">That’s why our seafood is blast-frozen to -10°F at harvest and vacuum sealed: the aim is to protect the quality the farm starts with.</p>
      </div>
    </div>
  </section>

  {%- comment -%} ============================ PACKAGING SPLIT ============================ {%- endcomment -%}
  <section class="sf-band" style="padding-block-start: 0;">
    <div class="page-width">
      <div class="sf-split">
        <figure>
          <div class="sf-media sf-media--tall">
            <picture class="block w-full h-full" is="animate-picture" data-animate="zoom-out">
              <img
                src="{{ pack_src }}&width=1000"
                srcset="{{ pack_src }}&width=600 600w, {{ pack_src }}&width=1000 1000w, {{ pack_src }}&width=1400 1400w"
                sizes="(min-width: 1024px) 45vw, 100vw"
                alt="A vacuum-sealed Seatopia Atlantic Salmon portion with its label and QR code."
                loading="lazy" decoding="async" width="1000" height="1250">
            </picture>
          </div>
          <figcaption class="sf-caption {{ kicker_class }}">Vacuum-sealed portions help limit oxygen exposure during frozen storage.</figcaption>
        </figure>
        <div class="sf-stack">
          <div class="sf-head" data-sf-animate>
            <p class="{{ eyebrow_class }}">A smaller detail with a big role</p>
            <h2 class="heading title-lg">Less air. More care.</h2>
          </div>
          <p class="leading-normal text-opacity">Freezing and packaging work together. Vacuum sealing removes much of the air around a portion, while suitable packaging helps limit oxygen exposure and moisture loss.</p>
          <p class="leading-normal text-opacity">NC State Extension recommends airtight protection to help prevent freezer burn and preserve seafood quality. <a class="{{ cite_class }}" href="#sf-ref-8">(NC State Extension, n.d.)</a></p>
          <p class="leading-normal text-opacity">At Seatopia, vacuum-sealed portions and frozen distribution are part of how we care for the fish all the way to your freezer.</p>
          <aside class="sf-note sf-stack" style="gap: var(--sp-2);" data-sf-animate>
            <p class="font-medium">Keep the care going at home.</p>
            <p class="text-sm leading-normal text-opacity">Keep seafood frozen until needed. Remove vacuum-packed fish from its reduced-oxygen packaging before refrigerator thawing, and follow the product’s handling instructions. Never thaw it on the counter. <a class="{{ cite_class }}" href="#sf-ref-8">(NC State Extension, n.d.)</a></p>
          </aside>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ============================ FARM PHOTO ============================ {%- endcomment -%}
  <section style="padding-block-end: var(--sf-band-space);">
    <div class="page-width">
      <figure>
        <media-element class="sf-media sf-media--wide block" data-parallax="0.2" data-parallax-dir="vertical">
          <picture class="block w-full h-full">
            {%- if farm_img != blank -%}
              {{ farm_img | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: '100vw', widths: '600,900,1200,1600,2000', alt: 'Salmon farm pens in a sheltered bay surrounded by green hills.' }}
            {%- else -%}
              <img src="https://cdn.shopify.com/s/files/1/0222/9882/0682/files/ora-king-salmon-farm.jpg?width=2000" alt="Salmon farm pens in a sheltered bay surrounded by green hills." loading="lazy" width="2000" height="1200">
            {%- endif -%}
          </picture>
        </media-element>
        <figcaption class="sf-caption {{ kicker_class }}">An Ōra King salmon farm in New Zealand.</figcaption>
      </figure>
    </div>
  </section>

  {%- comment -%} ============================ 04 SOURCING ============================ {%- endcomment -%}
  <section class="sf-band" style="padding-block-start: 0;">
    <div class="page-width">
      <div class="sf-reading sf-stack">
        <div class="sf-head" data-sf-animate>
          <p class="{{ kicker_class }}">04 / Start long before the freezer</p>
          <h2 class="heading title-lg">Better seafood begins with better care.</h2>
        </div>
        <p class="text-lg leading-normal">Preservation is one chapter in a much longer story.</p>
        <p class="text-lg leading-normal">Harvest and handling affect the quality a producer has available to preserve. Prompt dispatch, careful handling, and rapid chilling are practical measures that help protect fish quality. Rough treatment can bruise flesh; delays in chilling create opportunities for deterioration. <a class="{{ cite_class }}" href="#sf-ref-8">(NC State Extension, n.d.)</a></p>
        <p class="text-lg leading-normal">At Seatopia, we look at the whole journey: how seafood is raised, what it is fed, how it is harvested, and how it is handled afterward.</p>
        <p class="text-lg leading-normal">Well-run aquaculture offers an opportunity to plan that journey. Producers can coordinate harvests, processing, and preservation, and document the steps along the way. That’s an opportunity we value, and a reason to ask detailed questions of every farm.</p>
        <p class="text-lg leading-normal">Excellent handling also exists in wild fisheries, and farming alone guarantees nothing. The practices are what count.</p>
      </div>
    </div>
  </section>

  {%- comment -%} ============================ THE SEATOPIA STANDARD ============================ {%- endcomment -%}
  <section class="sf-band sf-tone--sage" id="sf-standard">
    <div class="page-width">
      <div class="sf-reading sf-stack">
        <div class="sf-head" data-sf-animate>
          <p class="{{ eyebrow_class }}">The Seatopia Standard</p>
          <h2 class="heading title-lg">Some things deserve a lab report.</h2>
        </div>
        <p class="text-lg leading-normal">You can appreciate a fillet’s texture and aroma. You can’t determine its mercury concentration or count its milligrams of EPA and DHA by looking at it.</p>
        <p class="text-lg leading-normal">That’s why independent testing is part of our approach to transparency. Our published program includes:</p>
        <ul class="sf-list">
          <li data-sf-animate><strong class="heading title-sm">Mercury.</strong><span class="text-lg leading-normal">Our limit is 0.1 ppm methylmercury – a tenth of the FDA action level.</span></li>
          <li data-sf-animate data-sf-delay="100"><strong class="heading title-sm">Microplastics.</strong><span class="text-lg leading-normal">Tested for microplastics down to 1 micron. No microplastics detected in third-party testing.</span></li>
          <li data-sf-animate data-sf-delay="200"><strong class="heading title-sm">Nutrition.</strong><span class="text-lg leading-normal">We test and publish omega-3, protein, selenium, vitamin D and B12.</span></li>
        </ul>
        <p class="text-lg leading-normal">Every supplier is third-party tested for nutrition, mercury and microplastics, then randomly audited to ensure consistent compliance with the Seatopia Standard.</p>
        <p class="leading-normal text-opacity">“Not detected” means below the detection capability of the method used. It doesn’t prove the absolute absence of every particle in every portion. Nutrient results also describe tested samples and can vary by lot. <a class="{{ cite_class }}" href="#sf-ref-9">(Seatopia, n.d.)</a></p>
        <p class="leading-normal text-opacity">A nutrient panel and an oxidation test answer different questions. Reporting EPA and DHA content alone does not establish a fillet’s oxidative condition.</p>
        <div>
          <a class="button button--secondary button--md" href="/pages/why-clean-seafood-matters" is="hover-link">
            <span class="btn-fill" data-fill></span>
            <span class="btn-text">Explore our testing program</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ============================ WHOLE FOOD ============================ {%- endcomment -%}
  <section class="sf-band">
    <div class="page-width">
      <div class="sf-reading sf-stack">
        <h2 class="heading title-lg" data-sf-animate>A whole-food way to enjoy omega-3s.</h2>
        <p class="text-lg leading-normal">For people who enjoy fish, whole seafood brings something a capsule cannot: a meal.</p>
        <p class="text-lg leading-normal">Alongside marine omega-3s, you’re enjoying protein, flavor, and naturally occurring nutrients whose amounts vary by species and sample. You’re also building a habit around food you look forward to eating.</p>
        <p class="text-lg leading-normal">Supplements can have a useful place, including for people who don’t eat seafood or have specific nutritional needs. Oil quality is a reason to choose carefully, not a reason to dismiss an entire category.</p>
        <p class="text-lg leading-normal">Our focus is the seafood on your plate: thoughtfully raised, carefully handled, and preserved with attention to temperature, oxygen, and time.</p>
      </div>
    </div>
  </section>

  {%- comment -%} ============================ CLOSING PHOTO ============================ {%- endcomment -%}
  <section style="padding-block-end: var(--sf-band-space);">
    <div class="page-width">
      <figure>
        <media-element class="sf-media sf-media--wide block" data-parallax="0.2" data-parallax-dir="vertical">
          <picture class="block w-full h-full">
            {%- if close_img != blank -%}
              {{ close_img | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: '100vw', widths: '600,900,1200,1600,2000', alt: 'Salmon portions cooking on a grill alongside halved stone fruit.' }}
            {%- else -%}
              <img src="https://cdn.shopify.com/s/files/1/0222/9882/0682/files/salmon-lovers-box-9444410.jpg?width=2000" alt="Salmon portions cooking on a grill alongside halved stone fruit." loading="lazy" width="2000" height="1333">
            {%- endif -%}
          </picture>
        </media-element>
        <figcaption class="sf-caption {{ kicker_class }}">The reward for thoughtful preservation: a meal worth slowing down for.</figcaption>
      </figure>
    </div>
  </section>

  {%- comment -%} ============================ CLOSING ============================ {%- endcomment -%}
  <section class="sf-band" style="padding-block-start: 0;">
    <div class="page-width">
      <div class="sf-reading sf-stack sf-closing">
        <div class="sf-head" style="align-items: center;" data-sf-animate>
          <p class="{{ eyebrow_class }}">From the science to your supper</p>
          <h2 class="heading title-lg">Expect more from your seafood.</h2>
        </div>
        <p class="text-lg leading-normal">A mild aroma. Beautiful texture. A clear story about where your fish came from and how it was cared for.</p>
        <p class="text-lg leading-normal">Those are better expectations than accepting a questionable smell as simply “how fish is.”</p>
        <p class="text-lg leading-normal">Thoughtful sourcing gives us quality worth protecting. Careful preservation helps us bring it home to you.</p>
        <p class="heading title-sm leading-tight" data-sf-animate>A little sea salt. A hot pan. An appetite.<br>Freshness worth sitting down for.</p>
        <div>
          <a class="button button--primary button--md" href="/collections/seatopia" is="hover-link">
            <span class="btn-fill" data-fill></span>
            <span class="btn-text">Explore Seatopia seafood</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ============================ REFERENCES ============================ {%- endcomment -%}
  <section class="sf-band" style="padding-block-start: 0;" aria-labelledby="sf-references-title">
    <div class="page-width">
      <div class="sf-reading sf-stack sf-refs" style="padding-block-start: var(--sp-8); border-block-start: 1px solid rgb(var(--color-border));">
        <h2 id="sf-references-title" class="heading title-sm">References &amp; further reading</h2>
        <p class="text-sm leading-normal text-opacity">Peer-reviewed research informs the chemistry and oil-quality discussion. Seatopia’s own testing program is linked separately. Supplement surveys do not establish that Seatopia seafood is less oxidized than other seafood or supplements.</p>
        <ol class="text-sm leading-normal text-opacity">
          <li id="sf-ref-1">Food and Agriculture Organization of the United Nations. (n.d.). <a class="link" href="https://www.fao.org/4/x5990e/X5990e01.htm"><em>Non-sensory assessment of fish quality.</em></a></li>
          <li id="sf-ref-2">U.S. Food and Drug Administration. (n.d.). <a class="link" href="https://www.fda.gov/food/buy-store-serve-safe-food/selecting-and-serving-fresh-and-frozen-seafood-safely"><em>Selecting and serving fresh and frozen seafood safely.</em></a></li>
          <li id="sf-ref-3">Albert, B. B., Cameron-Smith, D., Hofman, P. L., &amp; Cutfield, W. S. (2013). Oxidation of marine omega-3 supplements and human health. <em>BioMed Research International, 2013</em>, 464921. <a class="link" href="https://doi.org/10.1155/2013/464921">https://doi.org/10.1155/2013/464921</a></li>
          <li id="sf-ref-4">Jackowski, S. A., Alvi, A. Z., Mirajkar, A., Imani, Z., Gamalevych, Y., Shaikh, N. A., &amp; Jackowski, G. (2015). Oxidation levels of North American over-the-counter n-3 (omega-3) supplements and the influence of supplement formulation and delivery form on evaluating oxidative safety. <em>Journal of Nutritional Science, 4</em>, e30. <a class="link" href="https://doi.org/10.1017/jns.2015.21">https://doi.org/10.1017/jns.2015.21</a></li>
          <li id="sf-ref-6">NOAA Fisheries. (2023). <a class="link" href="https://www.fisheries.noaa.gov/national/sustainable-seafood/how-buy-seafood"><em>Tips for buying quality seafood.</em></a></li>
          <li id="sf-ref-7">Alizadeh, E. (2012). Freezing / thawing and cooking of fish. <a class="link" href="https://doi.org/10.5772/33396">https://doi.org/10.5772/33396</a></li>
          <li id="sf-ref-8">NC State Extension. (n.d.). <a class="link" href="https://content.ces.ncsu.edu/preserving-your-catch-purchase-a-guide-to-freezing-and-thawing-seafood-at-home"><em>Preserving your catch &amp; purchase: A guide to freezing and thawing seafood at home.</em></a></li>
          <li id="sf-ref-9">Seatopia. (n.d.). <a class="link" href="/pages/why-clean-seafood-matters"><em>Our testing program.</em></a></li>
        </ol>
      </div>
    </div>
  </section>
</article>

<script>
  /* Fade-ups through the theme's own Animation class, so timing and easing match the rest of the store.
     theme.js and vendor.js load with defer, so both exist by DOMContentLoaded. */
  (function () {
    var run = function () {
      if (!window.theme || !theme.Animation || !window.Motion || theme.config.motionReduced) return;
      document.querySelectorAll('#seatopia-freshness [data-sf-animate]').forEach(function (el) {
        el.setAttribute('data-animate', 'fade-up');
        if (el.hasAttribute('data-sf-delay')) el.setAttribute('data-animate-delay', el.getAttribute('data-sf-delay'));
        var a = new theme.Animation(el);
        a.type = 'fade-up';
        a.beforeLoad();
        Motion.inView(el, function () { a.load(); }, { margin: '0px 0px -10% 0px' });
      });
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
    else run();
  })();
</script>

