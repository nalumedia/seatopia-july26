{% comment %}
  {% assign target_blog = blogs['regenerative-aquaculture'] %}
  {% if target_blog %}
    <p>Blog found: {{ target_blog.title }} | Total articles: {{ target_blog.articles_count }}</p>

    {% paginate target_blog.articles by 11 %}
      {% for article in target_blog.articles %}
        <div class="article">
          <h2>
            <a href="{{ article.url }}">{{ article.title }}</a>
          </h2>
          <p>{{ article.excerpt }}</p>
          <a href="{{ article.url }}">Read more</a>
        </div>
      {% endfor %}

      <!-- Pagination Controls -->
      {% if paginate.pages > 1 %}
        <div class="pagination">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}">Previous</a>
          {% endif %}

          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {% else %}
              <span>{{ part.title }}</span>
            {% endif %}
          {% endfor %}

          {% if paginate.next %}
            <a href="{{ paginate.next.url }}">Next</a>
          {% endif %}
        </div>
      {% endif %}
    {% endpaginate %}
  {% else %}
    <p>Blog not found.</p>
  {% endif %}
{% endcomment %}

