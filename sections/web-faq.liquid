{%- comment -%}
  Web kit — FAQ with a contact card. Figma 4594:608: heading and intro on the left with
  a "Didn't find your answer?" form on sand, the accordion on the right, plus/minus icons.
  The form is Shopify's contact form, so messages reach the store's contact email.

  Answers come from the claims guide §9 approved answers where one exists, used whole.
{%- endcomment -%}
{%- render 'uikit-fonts' -%}
{{ 'web-kit.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<div class="wk wk-section wk-section--{{ s.tone }}"{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %}>
  <div class="wk-container wk-faq">
    <div class="wk-faq__intro">
      {%- if s.heading != blank -%}<h2 class="wk-h2">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="wk-body-m wk-muted wk-prose">{{ s.text }}</div>{%- endif -%}
      {%- if s.show_contact -%}
        <div class="wk-faq__contact">
          {%- if s.contact_heading != blank -%}<h3 class="wk-faq__contact-heading">{{ s.contact_heading }}</h3>{%- endif -%}
          {%- if s.contact_text != blank -%}<p class="wk-body-s wk-muted">{{ s.contact_text }}</p>{%- endif -%}
          {%- assign form_id = 'WkFaqContact-' | append: section.id -%}
          {%- form 'contact', id: form_id, class: 'wk-faq__form' -%}
            {%- if form.posted_successfully? -%}
              <p class="wk-body-s wk-faq__ok" role="status">{{ s.success | default: 'Thank you. We read every message and will reply soon.' }}</p>
            {%- else -%}
              {%- if form.errors -%}<p class="wk-body-s wk-faq__err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
              <input type="hidden" name="contact[page]" value="{{ page.title | default: request.path | escape }}">
              <label class="wk-faq__field"><span class="visually-hidden">Name</span><input type="text" name="contact[name]" placeholder="Name" autocomplete="name" required></label>
              <label class="wk-faq__field"><span class="visually-hidden">Email</span><input type="email" name="contact[email]" placeholder="Email" autocomplete="email" required></label>
              <label class="wk-faq__field"><span class="visually-hidden">Message</span><textarea name="contact[body]" placeholder="Message" rows="4" required></textarea></label>
              <button type="submit" class="wk-btn wk-btn--ink wk-btn--block">{{ s.button | default: 'Send message' }}{% render 'web-kit-icon', name: 'arrow-right' %}</button>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>

    <div class="wk-faq__list">
      {%- for block in section.blocks -%}
        <details class="wk-faq__item" {{ block.shopify_attributes }}{% if forloop.first and s.open_first %} open{% endif %}>
          <summary class="wk-faq__q">
            <span class="wk-faq__question">{{ block.settings.question }}</span>
            <span class="wk-faq__icon" aria-hidden="true">
              <span class="wk-faq__icon-plus">{% render 'web-kit-icon', name: 'plus' %}</span>
              <span class="wk-faq__icon-minus">{% render 'web-kit-icon', name: 'minus' %}</span>
            </span>
          </summary>
          <div class="wk-faq__a wk-prose">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if s.faq_schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          { "@type": "Question", "name": {{ block.settings.question | strip_html | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | strip | json }} } }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

<style>
  .wk-faq { display: grid; grid-template-columns: 420px minmax(0, 1fr); gap: 80px; align-items: start; }
  .wk-faq__intro { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .wk-faq__contact { display: flex; flex-direction: column; gap: 14px; width: 100%; margin-top: 40px; padding: 32px; background: var(--wk-sand); }
  .wk .wk-faq__contact-heading { font-size: 30px; line-height: 1.1; letter-spacing: 0; }
  .wk-faq__form { display: flex; flex-direction: column; gap: 14px; }
  .wk-faq__field { display: block; }
  .wk-faq__field input, .wk-faq__field textarea { width: 100%; padding: 14px 16px; border: 1px solid rgba(46, 75, 89, 0.25); border-radius: 0; background: var(--wk-white); color: var(--wk-ink); font: inherit; font-size: 15px; }
  .wk-faq__field input::placeholder, .wk-faq__field textarea::placeholder { color: rgba(46, 75, 89, 0.5); }
  .wk-faq__field input:focus, .wk-faq__field textarea:focus { outline: none; border-color: var(--wk-ink); }
  .wk-faq__field textarea { min-height: 112px; resize: vertical; }
  .wk-faq__ok { color: var(--wk-ink); padding: 16px; border: 1px solid var(--wk-gold); }
  .wk-faq__err { color: #a23b2a; }
  .wk-faq__list { display: flex; flex-direction: column; }
  .wk-faq__item { border-bottom: 1px solid var(--wk-rule); }
  .wk-faq__q { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 24px 0; cursor: pointer; list-style: none; }
  .wk-faq__q::-webkit-details-marker { display: none; }
  .wk-faq__question { font-family: var(--wk-font-heading); font-weight: 300; font-size: 26px; line-height: 1.2; color: var(--wk-ink); }
  .wk-faq__icon { position: relative; flex: none; width: 20px; height: 20px; color: var(--wk-ink); }
  .wk-faq__icon span { position: absolute; inset: 0; display: block; }
  .wk-faq__icon-minus { display: none; }
  .wk-faq__item[open] .wk-faq__icon-plus { display: none; }
  .wk-faq__item[open] .wk-faq__icon-minus { display: block; }
  .wk-faq__a { font-size: 16px; line-height: 1.6; color: rgba(46, 75, 89, 0.85); padding: 0 44px 24px 0; }
  .wk-faq__a ul, .wk-faq__a ol { margin: 1em 0 0; padding-left: 1.2em; }
  .wk .visually-hidden { position: absolute !important; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  @media (max-width: 989px) {
    .wk-faq { grid-template-columns: 1fr; gap: 40px; }
    .wk-faq__contact { margin-top: 12px; padding: 24px; }
    .wk-faq__question { font-size: 22px; }
    .wk-faq__a { padding-right: 0; }
  }
</style>

{% schema %}
{
  "name": "Web kit — FAQ + contact",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Use the claims guide §9 approved answers, whole." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQs" },
    { "type": "richtext", "id": "text", "label": "Intro" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": true },
    { "type": "checkbox", "id": "faq_schema", "label": "Add FAQ structured data for Google", "default": false },
    { "type": "text", "id": "anchor", "label": "Anchor ID" },
    { "type": "select", "id": "tone", "label": "Background", "default": "white", "options": [ { "value": "white", "label": "White" }, { "value": "paper", "label": "Paper" }, { "value": "sand", "label": "Sand" } ] },
    { "type": "header", "content": "Contact card" },
    { "type": "checkbox", "id": "show_contact", "label": "Show the contact form", "default": true },
    { "type": "text", "id": "contact_heading", "label": "Heading", "default": "Didn’t find your answer?" },
    { "type": "text", "id": "contact_text", "label": "Text", "default": "Don't hesitate to contact us" },
    { "type": "text", "id": "button", "label": "Button", "default": "Send message" },
    { "type": "text", "id": "success", "label": "Success message", "default": "Thank you. We read every message and will reply soon." }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer" }
    ]}
  ],
  "presets": [{ "name": "Web kit — FAQ + contact" }]
}
{% endschema %}
