{%- comment -%}
  UI kit — trust band: doctor cards, a stats strip, then customer reviews, in the
  testimonial-card look (photo left, quote right). Replaces the tall one-at-a-time slider
  on campaign pages.

  Claims guide §4.H / 16 CFR Part 465 and 255: only real, attributable quotes and reviews.
  A paid partner's card must carry the disclosure in the same card ("Paid partner").
  Doctors speak about the food or the programme, never about a health outcome (§4.G, §8.7).
  Stats must be on file: "Thousands of subscribers" is green; the orders figure is the
  guide's substantiation line (54K+ lifetime orders).
{%- endcomment -%}

<div class="uikit uikit-section">
  <div class="uikit-container">
    <div class="uikit-trust__head">
      {%- if section.settings.eyebrow != blank -%}<p class="uikit-overline">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="uikit-h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="uikit-body-m uikit-trust__intro">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    {%- assign docs = section.blocks | where: 'type', 'doctor' -%}
    {%- if docs.size > 0 -%}
      <ul class="uikit-trust__docs uikit-trust__docs--{{ docs.size }}" role="list">
        {%- for block in docs -%}
          {%- assign b = block.settings -%}
          <li class="uikit-trust__doc" {{ block.shopify_attributes }}>
            <span class="uikit-trust__doc-media">
              {%- if b.image != blank -%}{{ b.image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250,400,500', sizes: '(min-width: 990px) 180px, 40vw', alt: b.name }}{%- endif -%}
            </span>
            <span class="uikit-trust__doc-body">
              {%- if b.disclosure != blank -%}<span class="uikit-label-s uikit-trust__tag">{{ b.disclosure }}</span>{%- endif -%}
              <blockquote class="uikit-trust__quote">{{ b.quote }}</blockquote>
              <span class="uikit-label-m uikit-trust__name">{{ b.name }}</span>
              {%- if b.role != blank -%}<span class="uikit-body-s uikit-muted">{{ b.role }}</span>{%- endif -%}
              {%- if b.link != blank -%}<a class="uikit-body-s uikit-trust__more" href="{{ b.link }}">{{ b.link_label | default: 'Read more' }} &rarr;</a>{%- endif -%}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- capture stats -%}{{ section.settings.stat_1 }}|{{ section.settings.stat_2 }}|{{ section.settings.stat_3 }}{%- endcapture -%}
    {%- assign stat_list = stats | split: '|' -%}
    {%- capture stat_html -%}
      {%- for st in stat_list -%}
        {%- assign pair = st | split: '::' -%}
        {%- if pair.size == 2 -%}<div class="uikit-trust__stat"><span class="uikit-trust__stat-num">{{ pair[0] | strip }}</span><span class="uikit-body-s">{{ pair[1] | strip }}</span></div>{%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if stat_html != blank -%}<div class="uikit-trust__stats">{{ stat_html }}</div>{%- endif -%}

    {%- assign revs = section.blocks | where: 'type', 'review' -%}
    {%- if revs.size > 0 -%}
      <ul class="uikit-trust__revs" role="list">
        {%- for block in revs -%}
          {%- assign b = block.settings -%}
          <li class="uikit-trust__rev" {{ block.shopify_attributes }}>
            <span class="uikit-trust__stars" aria-label="{{ b.rating }} out of 5">{%- for i in (1..5) -%}<span aria-hidden="true">{% if i <= b.rating %}★{% else %}☆{% endif %}</span>{%- endfor -%}</span>
            <blockquote class="uikit-body-s uikit-trust__rev-text">{{ b.quote }}</blockquote>
            <span class="uikit-label-s uikit-trust__name">{{ b.name }}</span>
            {%- if b.disclosure != blank -%}<span class="uikit-body-s uikit-muted">{{ b.disclosure }}</span>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

<style>
  .uikit-trust__head { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 14px; max-width: 760px; margin: 0 auto 44px; }
  .uikit .uikit-trust__intro { color: var(--uk-heading); max-width: 600px; }
  .uikit-trust__docs { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 20px; list-style: none; margin: 0; padding: 0; }
  .uikit-trust__docs--2 { grid-template-columns: repeat(2, minmax(0,1fr)); }
  .uikit-trust__doc { display: grid; grid-template-columns: 44% 1fr; min-height: 280px; overflow: hidden; border-radius: var(--uk-radius-card); background: var(--uk-white); border: 1px solid var(--uk-rule); }
  .uikit-trust__doc-media { position: relative; background: var(--uk-gray-4, #eee); }
  .uikit-trust__doc-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .uikit-trust__doc-body { display: flex; flex-direction: column; gap: 8px; padding: 22px 20px; color: var(--uk-heading); }
  .uikit .uikit-trust__tag { align-self: flex-start; padding: 4px 10px; border-radius: var(--uk-radius-pill); background: rgba(187,143,80,.14); color: #8a6430; }
  .uikit-trust__quote { margin: 0 0 6px; font-family: var(--uk-font-heading, inherit); font-size: 17px; line-height: 1.3; color: var(--uk-heading); }
  .uikit-trust__name { color: var(--uk-heading); margin-top: auto; }
  .uikit-trust__more { color: var(--uk-heading); text-decoration: underline; text-underline-offset: .2em; }
  .uikit-trust__stats { display: flex; justify-content: center; gap: clamp(32px, 6vw, 96px); margin: 44px 0; padding: 28px 0; border-block: 1px solid var(--uk-rule); text-align: center; }
  .uikit-trust__stat { display: flex; flex-direction: column; gap: 6px; color: var(--uk-heading); }
  .uikit .uikit-trust__stat-num { font-family: var(--uk-font-heading, inherit); font-size: clamp(36px, 4vw, 52px); line-height: 1; letter-spacing: -.02em; color: var(--uk-heading); }
  .uikit-trust__revs { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 20px; list-style: none; margin: 0; padding: 0; }
  .uikit-trust__rev { display: flex; flex-direction: column; gap: 10px; padding: 24px; border-radius: var(--uk-radius-card); background: var(--uk-white); border: 1px solid var(--uk-rule); }
  .uikit-trust__stars { color: var(--uk-gold); letter-spacing: 2px; }
  .uikit-trust__rev-text { margin: 0; font-family: var(--uk-font-body); color: var(--uk-heading); }
  @media (max-width: 989px) {
    .uikit-trust__docs, .uikit-trust__docs--2 { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 86%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: 4px; }
    .uikit-trust__docs::-webkit-scrollbar { display: none; }
    .uikit-trust__doc { scroll-snap-align: start; min-height: 240px; }
    .uikit-trust__revs { grid-template-columns: 1fr; }
    .uikit-trust__stats { flex-wrap: wrap; gap: 24px 40px; }
  }
</style>

{% schema %}
{
  "name": "UI kit — trust band",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "§4.H: real, attributable quotes only. Disclose paid partners in the card. Stats must be on file." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trusted by doctors and thousands of subscribers" },
    { "type": "text", "id": "text", "label": "Intro" },
    { "type": "text", "id": "stat_1", "label": "Stat 1", "info": "Number::label, e.g. 54,000+::orders delivered" },
    { "type": "text", "id": "stat_2", "label": "Stat 2" },
    { "type": "text", "id": "stat_3", "label": "Stat 3" }
  ],
  "blocks": [
    { "type": "doctor", "name": "Doctor", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "text", "id": "name", "label": "Name" },
      { "type": "text", "id": "role", "label": "Title" },
      { "type": "text", "id": "disclosure", "label": "Disclosure", "info": "e.g. Paid partner" },
      { "type": "textarea", "id": "quote", "label": "Quote" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "text", "id": "link_label", "label": "Link label" }
    ]},
    { "type": "review", "name": "Customer review", "settings": [
      { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "textarea", "id": "quote", "label": "Quote (must be a real review)" },
      { "type": "text", "id": "name", "label": "Name" },
      { "type": "text", "id": "disclosure", "label": "Under the name", "default": "Verified buyer" }
    ]}
  ],
  "presets": [{ "name": "UI kit — trust band" }]
}
{% endschema %}
