{%- comment -%}
  UI kit — FAQ. Native <details> rows on the kit's 1px rule (Figma Gray/4).

  Answers on a Seatopia page come from claims guide §9 ("Approved answers") and
  are used whole: the concession and the number travel together. Do not trim a
  block to make it shorter.
{%- endcomment -%}

<div class="uikit uikit-section">
  <div class="uikit-container uikit-faq">
    {%- if section.settings.heading != blank -%}
      <h2 class="uikit-h2 uikit-faq__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="uikit-faq__list">
      {%- for block in section.blocks -%}
        <details class="uikit-faq__item" {{ block.shopify_attributes }}>
          <summary class="uikit-faq__q">
            <span class="uikit-label-l">{{ block.settings.question }}</span>
            <span class="uikit-faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="uikit-body-m uikit-prose uikit-faq__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
    {%- if section.settings.footnote != blank -%}
      <div class="uikit-body-s uikit-muted uikit-prose uikit-faq__foot">{{ section.settings.footnote }}</div>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.faq_schema and section.blocks.size > 0 -%}
  {%- comment -%} FAQPage structured data for search results; text matches what is on the page. {%- endcomment -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | strip | json }} }
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

<style>
  .uikit-faq { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 20px 60px; align-items: start; }
  .uikit-faq__list { border-bottom: 1px solid var(--uk-rule); }
  .uikit-faq__item { border-top: 1px solid var(--uk-rule); }
  .uikit-faq__q { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 24px 0; cursor: pointer; list-style: none; color: var(--uk-heading); }
  .uikit-faq__q::-webkit-details-marker { display: none; }
  .uikit-faq__icon { position: relative; flex: none; width: 16px; height: 16px; }
  .uikit-faq__icon::before, .uikit-faq__icon::after { content: ""; position: absolute; left: 0; top: 7.5px; width: 16px; height: 1px; background: var(--uk-gold); transition: transform .2s ease; }
  .uikit-faq__icon::after { transform: rotate(90deg); }
  .uikit-faq__item[open] .uikit-faq__icon::after { transform: rotate(0deg); }
  .uikit-faq__a { color: var(--uk-heading); padding: 0 40px 28px 0; }
  .uikit-faq__a ul { margin: 1em 0 0; padding-left: 1.2em; }
  .uikit-faq__a a { color: inherit; }
  .uikit-faq__foot { grid-column: 2; }
  .uikit-faq__foot a { color: inherit; text-decoration: underline; }
  @media (max-width: 989px) {
    .uikit-faq { grid-template-columns: 1fr; }
    .uikit-faq__foot { grid-column: auto; }
    .uikit-faq__q .uikit-label-l { font-size: 20px; }
    .uikit-faq__a { padding-right: 0; }
  }
</style>

{% schema %}
{
  "name": "UI kit — FAQ",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Use the claims guide §9 approved answers, whole." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered" },
    { "type": "richtext", "id": "footnote", "label": "Footnote" },
    { "type": "checkbox", "id": "faq_schema", "label": "Add FAQ structured data for Google", "default": false }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer" }
    ]}
  ],
  "presets": [{ "name": "UI kit — FAQ" }]
}
{% endschema %}
