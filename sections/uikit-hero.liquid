{%- comment -%} UI kit — hero. Figma node 47:413 {%- endcomment -%}

<div class="uikit uikit-section">
  <div class="uikit-container uikit-stack uikit-hero">
    <div class="uikit-stack uikit-stack--center uikit-hero__head">
      {%- if section.settings.partner != 'none' -%}
        <p class="uikit-hero__lockup">
          <span class="uikit-hero__lockup-seatopia">SEATOPIA</span>
          <span class="uikit-hero__lockup-x" aria-hidden="true">×</span>
          <span class="uikit-hero__lockup-partner">{% render 'partner-logo', name: section.settings.partner, style: 'wordmark' %}</span>
        </p>
      {%- endif -%}
      <h1 class="uikit-h1">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="uikit-body-m uikit-hero__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.chip != blank -%}
        <p class="uikit-label-s uikit-hero__chip">{{ section.settings.chip }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a class="uikit-btn uikit-btn--primary" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
      {%- if section.settings.note != blank -%}
        <p class="uikit-body-s uikit-hero__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.image != blank -%}
      <div class="uikit-hero__stage">
        <div class="uikit-media uikit-hero__media">
          {{ section.settings.image | image_url: width: 2400 | image_tag:
               loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 1280px) 1200px, 100vw',
               widths: '600,900,1200,1600,2000,2400', alt: section.settings.image.alt | default: '' }}
        </div>
        {%- if section.blocks.size > 0 -%}
          <ul class="uikit-hero__badges" role="list" data-uikit-reveal>
            {%- for block in section.blocks limit: 4 -%}
              <li class="uikit-hero__badge uikit-hero__badge--{{ forloop.index }}" style="--uk-delay: {{ forloop.index0 | times: 140 }}ms;" {{ block.shopify_attributes }}>
                {%- if block.settings.icon_name != 'none' -%}
                  <span class="uikit-hero__badge-icon">{% render 'uikit-icon', name: block.settings.icon_name %}</span>
                {%- endif -%}
                <span class="uikit-body-s uikit-hero__badge-text">{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="uikit-media uikit-hero__media uikit-hero__media--empty"></div>
    {%- endif -%}
  </div>
</div>

<style>
  .uikit-hero { gap: 100px; }
  .uikit-hero__head { gap: 23px; }
  .uikit-hero__head .uikit-h1 { max-width: 836px; }
  .uikit-hero__sub { color: var(--uk-heading); max-width: 720px; }
  .uikit-hero__chip { display: inline-flex; align-items: center; min-height: 34px; padding: 8px 14px; border: 1px solid var(--uk-gold); border-radius: var(--uk-radius-pill); color: var(--uk-heading); }
  .uikit-hero__note { color: var(--uk-heading); }
  .uikit-hero__lockup { display: inline-flex; align-items: center; gap: 18px; margin-bottom: 6px; color: var(--uk-heading); }
  .uikit-hero__lockup-seatopia { font-family: var(--uk-font-heading, inherit); font-size: 22px; letter-spacing: .14em; line-height: 1; }
  .uikit-hero__lockup-x { font-size: 18px; color: var(--uk-gold); }
  .uikit-hero__lockup-partner { display: inline-flex; height: 22px; }
  .uikit-hero__lockup-partner svg { height: 100%; width: auto; }
  @media (max-width: 749px) { .uikit-hero__lockup { gap: 12px; } .uikit-hero__lockup-seatopia { font-size: 17px; } .uikit-hero__lockup-partner { height: 17px; } }
  .uikit-hero__stage { position: relative; }
  .uikit-hero__media { height: 622px; }
  .uikit-hero__badges { list-style: none; margin: 0; padding: 0; }
  .uikit-hero__badge { display: flex; align-items: center; gap: 12px; max-width: 290px; padding: 10px 18px 10px 10px; background: rgba(255,255,255,.92); border-radius: var(--uk-radius-pill); box-shadow: 0 8px 24px rgba(46,75,89,.14); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  .uikit-hero__badge-icon { flex: none; width: 36px; height: 36px; }
  .uikit-hero__badge-icon svg { width: 100%; height: 100%; }
  .uikit .uikit-hero__badge-text { color: var(--uk-heading); line-height: 1.3; }
  @media (min-width: 990px) {
    .uikit-hero__badge { position: absolute; }
    .uikit-hero__badge--1 { left: 40px; top: 56px; }
    .uikit-hero__badge--2 { left: 72px; bottom: 64px; }
    .uikit-hero__badge--3 { right: 40px; top: 96px; }
    .uikit-hero__badge--4 { right: 64px; bottom: 112px; }
  }
  /* Fly in from the nearer edge once the image scrolls into view. */
  .uikit-hero__badges[data-uikit-reveal] .uikit-hero__badge { opacity: 0; transform: translate3d(var(--uk-from, -48px), 12px, 0); transition: opacity .6s ease var(--uk-delay), transform .8s cubic-bezier(.2,.8,.2,1) var(--uk-delay); }
  .uikit-hero__badge--3, .uikit-hero__badge--4 { --uk-from: 48px; }
  .uikit-hero__badges.is-revealed .uikit-hero__badge { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .uikit-hero__badges[data-uikit-reveal] .uikit-hero__badge { opacity: 1; transform: none; transition: none; }
  }
  @media (max-width: 989px) {
    .uikit-hero__badges { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 10px; margin-top: -36px; padding-inline: 12px; position: relative; }
    .uikit-hero__badge { max-width: none; border-radius: var(--uk-radius-card); padding: 10px 12px 10px 10px; }
    .uikit-hero__badge:nth-child(even) { --uk-from: 48px; }
    .uikit-hero__badge:nth-child(odd) { --uk-from: -48px; }
  }
  @media (max-width: 599px) {
    .uikit-hero__badges { grid-template-columns: 1fr; margin-top: -28px; }
    .uikit-hero__badge-icon { width: 32px; height: 32px; }
  }
  .uikit-hero__media--empty { background: var(--uk-gray-4); }
  @media (max-width: 989px) { .uikit-hero { gap: 48px; } .uikit-hero__media { height: 380px; } }
  @media (max-width: 749px) { .uikit-hero__media { height: 280px; } }
</style>

{%- if section.blocks.size > 0 -%}
  <script>
    (function () {
      var el = document.querySelector('#shopify-section-{{ section.id }} [data-uikit-reveal]');
      if (!el) return;
      if (!('IntersectionObserver' in window)) { el.classList.add('is-revealed'); return; }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { el.classList.add('is-revealed'); io.disconnect(); }
        });
      }, { threshold: 0.35 });
      io.observe(el.closest('.uikit-hero__stage') || el);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "UI kit — hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Lab-tested, nutrient-dense seafood delivered." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Third-party lab tested, omega-rich, low mercury, with zero microplastics detected." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Order Now" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "chip", "label": "Offer chip", "info": "Claims guide rule 11: only an offer that is live in Shopify." },
    { "type": "text", "id": "note", "label": "Note below button", "info": "Use for a paid-partner disclosure. It must stay this size and in this position." },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    {
      "type": "select", "id": "partner", "label": "Partner logo", "default": "none",
      "options": [ { "value": "none", "label": "None" }, { "value": "eudemonia", "label": "Eudēmonia" } ]
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "badge",
      "name": "Image badge",
      "settings": [
        { "type": "paragraph", "content": "Badges fly in over the image on scroll. Use a claims guide line whole: no \"up to\", \"verified\" or \"zero detectable\"." },
        {
          "type": "select", "id": "icon_name", "label": "Icon", "default": "fish",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "fish", "label": "Fish" },
            { "value": "mercury", "label": "Mercury (Hg)" },
            { "value": "microplastics", "label": "Microplastics" },
            { "value": "waves", "label": "Waves" }
          ]
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Tested and published" }
      ]
    }
  ],
  "presets": [{ "name": "UI kit — hero" }]
}
{% endschema %}
