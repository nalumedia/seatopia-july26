<style>
    #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
  }
</style>
<div class="cstm-judgeme-review section--padding" style="background-color:{{ section.settings.section_background }};"
  {% if section.settings.section_id != blank %}
    id="{{ section.settings.section_id }}"
  {% endif %}
>
  {% render 'index-judgeme-review' %}
</div>
{% schema %}
  {
    "name": "Judge Me Review",
    "settings": [
      {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info":"Please enter a unique value in each section"
    },
      {
        "type": "color",
        "id": "section_background",
        "label": "Section Background"
      },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_top.label",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_bottom.label",
      "default": 100
    },
    ],
    "presets": [
      {
        "name": "Judge Me Review"
      }
    ]
  }
{% endschema %}