{%- comment -%}
  Seatopia guide: a long-form, block-built guide page in the Omegamaxxing style (sections/omega-guide.liquid),
  so new guides can be written in the editor instead of in code.

  Blocks, in page order:
  - hero      full-bleed photo, eyebrow, deck, chips that jump to chapters, big wordmark title
  - intro     heading and lede beside an automatic contents list built from the chapter and recipe blocks
  - chapter   label, heading, rich text, optional photo (split either side or wide), optional numbered
              points ("Title|Text" per line), optional takeaway; light, sage or dark band
  - recipes   recipe cards from up to eight blog articles
  - gate      email form that unlocks the guide PDF: subscribes the address to a Klaviyo list, records a
              "Guide Downloaded" event, then reveals the download. The PDF link is not in the page until
              the form succeeds.
  - sources   numbered references

  Copy is the claims guide's job, not this section's: write it against brand/claims-guide.md and use its
  §9 approved answers whole.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign eyebrow_class = 'heading normal-case font-medium subtext-lg leading-none tracking-none'
  assign kicker_class = 'text-sm font-medium text-opacity leading-tight'
-%}
{%- capture sg_check -%}<svg class="sg-chip__check" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="12" fill="currentColor" opacity=".16"/><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}

<style>
  #shopify-section-{{ section.id }} {
    --sg-band-space: {{ s.band_padding }}px;
    --sg-band-space-mobile: {{ s.band_padding_mobile }}px;
  }
  {%- assign tones = 'sage,dark' | split: ',' -%}
  {%- for tone in tones -%}
    {%- case tone -%}
      {%- when 'sage' -%}{%- assign bg = s.sage_background -%}{%- assign fg = s.sage_text -%}
      {%- when 'dark' -%}{%- assign bg = s.dark_background -%}{%- assign fg = s.dark_text -%}
    {%- endcase -%}
    {%- assign border = fg | color_mix: bg, 18 -%}
    #shopify-section-{{ section.id }} .sg-tone--{{ tone }} {
      --color-background: {{ bg.red }} {{ bg.green }} {{ bg.blue }};
      --color-foreground: {{ fg.red }} {{ fg.green }} {{ fg.blue }};
      --color-border: {{ border | color_extract: 'red' }} {{ border | color_extract: 'green' }} {{ border | color_extract: 'blue' }};
      background: rgb(var(--color-background));
      color: rgb(var(--color-foreground));
    }
  {%- endfor -%}
  .sg :where(h1, h2, h3, p, figure, dl, dd, ol, ul) { margin: 0; }
  .sg :where(h1, h2, h3) { color: inherit; }
  .sg-band { padding-block: var(--sg-band-space); }
  @media (max-width: 767px) { .sg-band { padding-block: var(--sg-band-space-mobile); } }
  .sg-stack { display: flex; flex-direction: column; gap: var(--sp-5); }
  .sg-head { display: flex; flex-direction: column; gap: var(--sp-4); }
  .sg-label { letter-spacing: .12em; text-transform: uppercase; }
  .sg-reading { max-width: 46rem; }
  .sg [id] { scroll-margin-block-start: calc(var(--header-height, 80px) + var(--sp-6)); }
  .sg-prose { display: flex; flex-direction: column; gap: var(--sp-4); }
  .sg-prose :where(p, li) { font-size: 1.125rem; line-height: 1.6; }
  .sg-prose ul, .sg-prose ol { padding-inline-start: 1.25em; display: flex; flex-direction: column; gap: var(--sp-2); }
  .sg-prose a { color: inherit; text-decoration: underline; text-underline-offset: .2em; }
  .sg-prose blockquote { margin: 0; padding: var(--sp-5) var(--sp-6); border: 1px solid rgb(var(--color-border)); border-radius: var(--rounded-block); background: rgb(var(--color-foreground) / .03); display: flex; flex-direction: column; gap: var(--sp-3); }

  .sg-media { position: relative; overflow: hidden; border-radius: var(--rounded-block); background: rgb(var(--color-placeholder)); }
  .sg-media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .sg-media--tall { aspect-ratio: 4 / 5; }
  .sg-media--wide { aspect-ratio: 16 / 7; }
  .sg-media--land { aspect-ratio: 3 / 2; }
  @media (max-width: 767px) { .sg-media--wide { aspect-ratio: 4 / 3; } }

  .sg-chips { display: flex; flex-wrap: wrap; gap: var(--sp-3); list-style: none; padding: 0; }
  .sg-chip { display: inline-flex; align-items: center; gap: var(--sp-2d5); padding: var(--sp-2) var(--sp-5) var(--sp-2) var(--sp-2); border-radius: 999px; border: 1px solid rgb(255 255 255 / .28); background: rgb(70 60 55 / .42); color: #fff; -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); text-decoration: none; font-weight: 500; line-height: 1.1; }
  .sg-chip__check { flex: none; width: 1.75rem; height: 1.75rem; color: #7bd389; }
  a.sg-chip:hover { border-color: rgb(255 255 255 / .6); }
  [data-sg-fly] .sg-chip { opacity: 0; transform: translate3d(-32px, 10px, 0); transition: opacity .6s ease var(--sg-delay, 0ms), transform .8s cubic-bezier(.2,.8,.2,1) var(--sg-delay, 0ms); }
  [data-sg-fly].is-in .sg-chip { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { [data-sg-fly] .sg-chip { opacity: 1; transform: none; transition: none; } }

  .sg-hero { position: relative; min-height: min(92vh, 880px); display: flex; align-items: flex-end; overflow: hidden; color: #fff; background: #1f211f; }
  .sg-hero__bg { position: absolute; inset: 0; }
  .sg-hero__bg img { width: 100%; height: 100%; object-fit: cover; }
  .sg-hero__bg::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(20 20 18 / .55) 0%, rgb(20 20 18 / .15) 45%, rgb(20 20 18 / .65) 100%); }
  .sg-hero__inner { position: relative; width: 100%; padding-block: calc(var(--sp-8) * 2) var(--sp-8); display: flex; flex-direction: column; gap: var(--sp-6); }
  .sg-hero__deck { max-width: 32rem; font-family: var(--font-heading-family); }
  .sg-wordmark { font-family: var(--font-body-family); font-weight: 600; font-size: clamp(2.75rem, 9.5vw, 11rem); line-height: .88; letter-spacing: -.045em; margin-block-start: var(--sp-6); }
  .sg-hero__inner, .sg-hero__inner :where(p, h1) { color: #fff; }

  .sg-intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(var(--sp-8), 6vw, calc(var(--sp-8) * 2.5)); align-items: start; }
  .sg-contents { list-style: none; padding: 0; }
  .sg-contents li { border-block-start: 1px solid rgb(var(--color-border)); }
  .sg-contents li:last-child { border-block-end: 1px solid rgb(var(--color-border)); }
  .sg-contents a { display: grid; grid-template-columns: 2.5rem 1fr; gap: var(--sp-3); padding-block: var(--sp-4); text-decoration: none; color: inherit; }
  .sg-contents a:hover .sg-contents__title { text-decoration: underline; text-underline-offset: .2em; }
  .sg-contents__n { font-variant-numeric: tabular-nums; padding-block-start: .3em; }
  .sg-contents__sub { font-family: var(--font-heading-family); font-style: italic; }
  @media (max-width: 989px) { .sg-intro { grid-template-columns: 1fr; } }

  .sg-split { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(var(--sp-8), 5vw, calc(var(--sp-8) * 2)); align-items: start; }
  .sg-split--flip > :first-child { order: 2; }
  .sg-split__media { position: sticky; top: calc(var(--header-height, 80px) + var(--sp-6)); }
  @media (max-width: 989px) {
    .sg-split { grid-template-columns: 1fr; }
    .sg-split--flip > :first-child { order: 0; }
    .sg-split__media { position: static; }
  }

  .sg-grid { display: grid; gap: var(--sp-6); }
  .sg-grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .sg-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .sg-grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .sg-num { display: flex; flex-direction: column; gap: var(--sp-2); padding-block-start: var(--sp-4); border-block-start: 1px solid rgb(var(--color-border)); }
  .sg-num p { font-size: 1rem; line-height: 1.55; }
  @media (max-width: 989px) { .sg-grid--3, .sg-grid--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 599px) { .sg-grid--2, .sg-grid--3, .sg-grid--4 { grid-template-columns: 1fr; } }

  .sg-takeaway { display: flex; flex-direction: column; gap: var(--sp-2); padding-block-start: var(--sp-5); border-block-start: 1px solid rgb(var(--color-border)); }
  .sg-takeaway p { font-family: var(--font-heading-family); font-style: italic; font-size: 1.25rem; line-height: 1.45; }

  .sg-recipes { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--sp-5); }
  .sg-recipe { display: flex; flex-direction: column; gap: var(--sp-3); color: inherit; text-decoration: none; }
  .sg-recipe .sg-media { aspect-ratio: 4 / 5; }
  .sg-recipe .sg-media img { transition: transform .6s cubic-bezier(.2,.8,.2,1); }
  .sg-recipe:hover .sg-media img { transform: scale(1.04); }
  .sg-recipe:hover .sg-recipe__title { text-decoration: underline; text-underline-offset: .2em; }
  .sg-recipe__by { font-family: var(--font-heading-family); font-style: italic; }
  @media (max-width: 989px) {
    .sg-recipes { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: minmax(15rem, 70%); overflow-x: auto; scroll-snap-type: x mandatory; padding-block-end: var(--sp-3); }
    .sg-recipe { scroll-snap-align: start; }
  }

  .sg-gate { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(var(--sp-8), 5vw, calc(var(--sp-8) * 2)); align-items: center; }
  .sg-gate__cover { max-width: 22rem; justify-self: center; width: 100%; }
  .sg-gate__cover .sg-media { aspect-ratio: 3 / 4; box-shadow: 0 30px 60px -30px rgb(0 0 0 / .55); transform: rotate(-2deg); }
  .sg-gate__cover-title { position: absolute; inset: auto 0 0 0; padding: var(--sp-6); color: #fff; background: linear-gradient(180deg, transparent, rgb(20 20 18 / .75)); font-family: var(--font-heading-family); font-size: 1.5rem; line-height: 1.15; }
  .sg-gate__form { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
  .sg-gate__form input[type="email"] { flex: 1 1 16rem; min-height: 3.25rem; padding: 0 var(--sp-5); border-radius: 999px; border: 1px solid rgb(var(--color-border)); background: rgb(var(--color-background)); color: rgb(var(--color-foreground)); font: inherit; }
  .sg-gate__form button, .sg-gate__download { min-height: 3.25rem; padding: 0 var(--sp-6); border-radius: 999px; border: 0; background: rgb(var(--color-foreground)); color: rgb(var(--color-background)); font: inherit; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: var(--sp-2); text-decoration: none; }
  .sg-gate__form button[disabled] { opacity: .6; cursor: progress; }
  .sg-gate__fine { font-size: .875rem; line-height: 1.5; opacity: .75; }
  .sg-gate__error { font-size: .9375rem; color: #b8462f; }
  .sg-gate__done[hidden], .sg-gate__error[hidden], .sg-gate__form[hidden] { display: none; }
  .sg-gate__done { display: flex; flex-direction: column; align-items: flex-start; gap: var(--sp-3); }
  @media (max-width: 989px) { .sg-gate { grid-template-columns: 1fr; } .sg-gate__cover { max-width: 16rem; } }

  .sg-refs ol { padding-inline-start: 1.25em; display: flex; flex-direction: column; gap: var(--sp-2); }
  .sg-refs a { color: inherit; }
</style>

<article class="sg" id="{{ s.anchor | default: 'guide' | handleize }}">
  {%- assign toc_n = 0 -%}
  {%- for block in section.blocks -%}
    {%- assign b = block.settings -%}
    {%- case block.type -%}

      {%- when 'hero' -%}
        <section class="sg-hero" {{ block.shopify_attributes }}>
          <div class="sg-hero__bg">
            <picture is="animate-picture" data-animate="zoom-out" class="block w-full h-full">
              {%- if b.image_mobile != blank -%}
                <source media="(max-width: 749px)" srcset="{{ b.image_mobile | image_url: width: 750 }} 750w, {{ b.image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
              {%- endif -%}
              {%- if b.image != blank -%}
                {{ b.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '900,1200,1600,2000,2400', alt: b.image.alt }}
              {%- endif -%}
            </picture>
          </div>
          <div class="page-width sg-hero__inner">
            {%- if b.eyebrow != blank -%}<p class="{{ eyebrow_class }}">{{ b.eyebrow }}</p>{%- endif -%}
            {%- if b.deck != blank -%}<p class="sg-hero__deck title-sm leading-tight">{{ b.deck }}</p>{%- endif -%}
            {%- if b.chips != blank -%}
              <ul class="sg-chips" role="list" data-sg-fly>
                {%- assign chip_lines = b.chips | newline_to_br | split: '<br />' -%}
                {%- for line in chip_lines -%}
                  {%- assign c = line | strip | split: '|' -%}
                  {%- if c.size < 2 -%}{%- continue -%}{%- endif -%}
                  <li style="--sg-delay: {{ forloop.index0 | times: 140 }}ms;"><a class="sg-chip" href="#{{ c[0] | strip }}">{{ sg_check }}{{ c[1] | strip }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
            <h1 class="sg-wordmark">{{ b.title }}</h1>
          </div>
        </section>

      {%- when 'intro' -%}
        <section class="sg-band" {{ block.shopify_attributes }}>
          <div class="page-width sg-intro">
            <div class="sg-stack">
              {%- if b.eyebrow != blank -%}<p class="{{ eyebrow_class }}">{{ b.eyebrow }}</p>{%- endif -%}
              {%- if b.heading != blank -%}<h2 class="heading title-lg tracking-heading leading-tight" data-sg-animate>{{ b.heading }}</h2>{%- endif -%}
              {%- if b.text != blank -%}<div class="sg-prose">{{ b.text }}</div>{%- endif -%}
            </div>
            <nav aria-label="Contents">
              <p class="{{ kicker_class }} sg-label" style="margin-block-end: var(--sp-3);">Contents</p>
              <ol class="sg-contents" role="list">
                {%- assign n = 0 -%}
                {%- for cb in section.blocks -%}
                  {%- unless cb.type == 'chapter' or cb.type == 'recipes' or cb.type == 'gate' -%}{%- continue -%}{%- endunless -%}
                  {%- if cb.settings.anchor == blank or cb.settings.heading == blank -%}{%- continue -%}{%- endif -%}
                  {%- assign n = n | plus: 1 -%}
                  <li><a href="#{{ cb.settings.anchor | handleize }}">
                    <span class="sg-contents__n text-sm text-opacity">{{ n | prepend: '0' | slice: -2, 2 }}</span>
                    <span class="flex flex-col gap-1">
                      <span class="sg-contents__title heading title-sm leading-tight">{{ cb.settings.toc_title | default: cb.settings.heading }}</span>
                      {%- if cb.settings.toc_sub != blank -%}<span class="sg-contents__sub text-base text-opacity">{{ cb.settings.toc_sub }}</span>{%- endif -%}
                    </span>
                  </a></li>
                {%- endfor -%}
              </ol>
            </nav>
          </div>
        </section>

      {%- when 'chapter' -%}
        {%- liquid
          assign tone_class = ''
          if b.tone != 'light'
            assign tone_class = ' sg-tone--' | append: b.tone
          endif
          assign has_img = false
          if b.image != blank
            assign has_img = true
          endif
          assign layout = b.layout
          if has_img == false
            assign layout = 'reading'
          endif
        -%}
        <section class="sg-band{{ tone_class }}"{% if b.anchor != blank %} id="{{ b.anchor | handleize }}"{% endif %} {{ block.shopify_attributes }}>
          <div class="page-width sg-stack" style="gap: calc(var(--sp-8) * 1.25);">
            {%- capture chapter_copy -%}
              <div class="sg-stack">
                <div class="sg-head" data-sg-animate>
                  {%- if b.label != blank -%}<p class="{{ kicker_class }} sg-label">{{ b.label }}</p>{%- endif -%}
                  {%- if b.heading != blank -%}<h2 class="heading title-xl tracking-heading leading-none">{{ b.heading }}</h2>{%- endif -%}
                </div>
                {%- if b.text != blank -%}<div class="sg-prose">{{ b.text }}</div>{%- endif -%}
                {%- if b.takeaway != blank -%}
                  <div class="sg-takeaway">
                    <p class="{{ kicker_class }} sg-label" style="font-style: normal; font-size: .875rem;">{{ b.takeaway_label | default: 'The takeaway' }}</p>
                    {{ b.takeaway }}
                  </div>
                {%- endif -%}
              </div>
            {%- endcapture -%}
            {%- capture chapter_media -%}
              <figure class="sg-media sg-media--{% if layout == 'wide' %}wide{% else %}tall{% endif %}">
                {{ b.image | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 45vw, 100vw', widths: '500,800,1200,1600,2000', alt: b.image.alt }}
              </figure>
            {%- endcapture -%}

            {%- case layout -%}
              {%- when 'split' -%}
                <div class="sg-split">{{ chapter_copy }}<div class="sg-split__media">{{ chapter_media }}</div></div>
              {%- when 'flip' -%}
                <div class="sg-split sg-split--flip">{{ chapter_copy }}<div class="sg-split__media">{{ chapter_media }}</div></div>
              {%- when 'wide' -%}
                <div class="sg-reading">{{ chapter_copy }}</div>
                {{ chapter_media }}
              {%- else -%}
                <div class="sg-reading">{{ chapter_copy }}</div>
            {%- endcase -%}

            {%- if b.points != blank -%}
              {%- assign point_lines = b.points | newline_to_br | split: '<br />' -%}
              <div class="sg-grid sg-grid--{{ b.points_columns }}">
                {%- assign pn = 0 -%}
                {%- for line in point_lines -%}
                  {%- assign p = line | strip | split: '|' -%}
                  {%- if p.size < 2 -%}{%- continue -%}{%- endif -%}
                  {%- assign pn = pn | plus: 1 -%}
                  <div class="sg-num" data-sg-animate data-sg-delay="{{ pn | minus: 1 | times: 80 }}">
                    <span class="text-sm text-opacity">{{ pn | prepend: '0' | slice: -2, 2 }}</span>
                    <h3 class="heading title-sm leading-tight">{{ p[0] | strip }}</h3>
                    <p>{{ p[1] | strip }}</p>
                  </div>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        </section>

      {%- when 'recipes' -%}
        <section class="sg-band"{% if b.anchor != blank %} id="{{ b.anchor | handleize }}"{% endif %} {{ block.shopify_attributes }}>
          <div class="page-width sg-stack" style="gap: var(--sp-8);">
            <div class="sg-head sg-reading" data-sg-animate>
              {%- if b.label != blank -%}<p class="{{ kicker_class }} sg-label">{{ b.label }}</p>{%- endif -%}
              {%- if b.heading != blank -%}<h2 class="heading title-xl tracking-heading leading-none">{{ b.heading }}</h2>{%- endif -%}
              {%- if b.text != blank -%}<div class="sg-prose">{{ b.text }}</div>{%- endif -%}
            </div>
            <div class="sg-recipes">
              {%- assign shown = 0 -%}
              {%- for i in (1..8) -%}
                {%- assign key = 'article_' | append: i -%}
                {%- assign art = b[key] -%}
                {%- if art == blank -%}{%- continue -%}{%- endif -%}
                {%- assign shown = shown | plus: 1 -%}
                {%- assign creators = art.metafields.custom.recipe_creators.value -%}
                <a class="sg-recipe" href="{{ art.url }}" data-sg-animate data-sg-delay="{{ shown | minus: 1 | times: 80 }}">
                  <span class="sg-media">
                    {%- if art.image != blank -%}{{ art.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 22vw, 70vw', widths: '400,600,800', alt: art.image.alt | default: art.title }}{%- endif -%}
                  </span>
                  <span class="text-sm text-opacity">Recipe</span>
                  <span class="sg-recipe__title heading title-sm leading-tight">{{ art.title | remove: 'Seafood 101: ' | remove: 'Seafood 201: ' | strip }}</span>
                  {%- if creators != blank -%}
                    <span class="sg-recipe__by text-base text-opacity">from {% for c in creators %}{{ c.name.value }}{% unless forloop.last %} &amp; {% endunless %}{% endfor %}</span>
                  {%- endif -%}
                </a>
              {%- endfor -%}
            </div>
            {%- if b.note != blank -%}<div class="text-sm leading-normal text-opacity sg-reading">{{ b.note }}</div>{%- endif -%}
          </div>
        </section>

      {%- when 'gate' -%}
        {%- liquid
          assign tone_class = ''
          if b.tone != 'light'
            assign tone_class = ' sg-tone--' | append: b.tone
          endif
        -%}
        <section class="sg-band{{ tone_class }}"{% if b.anchor != blank %} id="{{ b.anchor | handleize }}"{% endif %} {{ block.shopify_attributes }}>
          <div class="page-width sg-gate" data-sg-gate data-key="{{ b.klaviyo_key | escape }}" data-list="{{ b.klaviyo_list | escape }}" data-guide="{{ b.guide_name | escape }}" data-file="{{ b.pdf_url | base64_encode }}" data-block="{{ block.id }}">
            <div class="sg-gate__cover">
              <div class="sg-media">
                {%- if b.cover != blank -%}{{ b.cover | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '22rem', alt: '' }}{%- endif -%}
                <span class="sg-gate__cover-title">{{ b.guide_name }}</span>
              </div>
            </div>
            <div class="sg-stack">
              <div class="sg-head">
                {%- if b.label != blank -%}<p class="{{ kicker_class }} sg-label">{{ b.label }}</p>{%- endif -%}
                {%- if b.heading != blank -%}<h2 class="heading title-xl tracking-heading leading-none">{{ b.heading }}</h2>{%- endif -%}
              </div>
              {%- if b.text != blank -%}<div class="sg-prose">{{ b.text }}</div>{%- endif -%}
              <form class="sg-gate__form" novalidate>
                <label class="visually-hidden" for="sg-email-{{ block.id }}">Email</label>
                <input id="sg-email-{{ block.id }}" type="email" name="email" autocomplete="email" placeholder="Your email" required>
                <button type="submit">{{ b.button_label | default: 'Unlock the guide' }}</button>
              </form>
              <p class="sg-gate__error" role="alert" hidden>That didn’t go through. Check the email address and try again.</p>
              <div class="sg-gate__done" role="status" hidden>
                <p class="text-lg leading-normal">{{ b.success | default: 'You’re in. Your guide is ready.' }}</p>
                <a class="sg-gate__download" href="#" target="_blank" rel="noopener" download>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 4v11m0 0 4.5-4.5M12 15l-4.5-4.5M5 19h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {{ b.download_label | default: 'Download the PDF' }}
                </a>
              </div>
              {%- if b.fine_print != blank -%}<div class="sg-gate__fine">{{ b.fine_print }}</div>{%- endif -%}
            </div>
          </div>
        </section>

      {%- when 'sources' -%}
        <section class="sg-band" style="padding-block-start: 0;" {{ block.shopify_attributes }}>
          <div class="page-width">
            <div class="sg-stack sg-refs sg-reading" style="padding-block-start: var(--sp-8); border-block-start: 1px solid rgb(var(--color-border));">
              <h2 class="heading title-sm">{{ b.heading | default: 'Sources' }}</h2>
              <div class="text-sm leading-normal text-opacity">{{ b.text }}</div>
            </div>
          </div>
        </section>
    {%- endcase -%}
  {%- endfor -%}
</article>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;

    var reveal = function (sel) {
      var els = root.querySelectorAll(sel);
      if (!els.length) return;
      if (!('IntersectionObserver' in window)) { els.forEach(function (el) { el.classList.add('is-in'); }); return; }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
      }, { threshold: 0.3 });
      els.forEach(function (el) { io.observe(el); });
    };
    reveal('[data-sg-fly]');

    var run = function () {
      if (!window.theme || !theme.Animation || !window.Motion || theme.config.motionReduced) return;
      root.querySelectorAll('[data-sg-animate]').forEach(function (el) {
        el.setAttribute('data-animate', 'fade-up');
        if (el.hasAttribute('data-sg-delay')) el.setAttribute('data-animate-delay', el.getAttribute('data-sg-delay'));
        var a = new theme.Animation(el);
        a.type = 'fade-up';
        a.beforeLoad();
        Motion.inView(el, function () { a.load(); }, { margin: '0px 0px -10% 0px' });
      });
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
    else run();

    /* Email gate: Klaviyo public client API (same as uikit-contact). Subscribes the address to the
       list, records a "Guide Downloaded" event naming the guide, then reveals the download. A
       returning visitor who already unlocked this guide sees the download straight away. */
    root.querySelectorAll('[data-sg-gate]').forEach(function (gate) {
      var form = gate.querySelector('.sg-gate__form');
      var done = gate.querySelector('.sg-gate__done');
      var err = gate.querySelector('.sg-gate__error');
      var link = gate.querySelector('.sg-gate__download');
      var KEY = gate.dataset.key, LIST = gate.dataset.list, GUIDE = gate.dataset.guide;
      var storeKey = 'sg-guide-' + gate.dataset.block;
      var unlock = function () {
        try { link.href = atob(gate.dataset.file); } catch (e) { return; }
        form.hidden = true; err.hidden = true; done.hidden = false;
      };
      try { if (localStorage.getItem(storeKey)) unlock(); } catch (e) {}
      var post = function (path, body) {
        return fetch('https://a.klaviyo.com/client/' + path + '/?company_id=' + encodeURIComponent(KEY), {
          method: 'POST',
          headers: { 'Content-Type': 'application/vnd.api+json', 'revision': '2024-10-15' },
          body: JSON.stringify(body)
        }).then(function (r) { if (!r.ok) throw new Error(r.status); return r; });
      };
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var email = (form.email.value || '').trim();
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { err.hidden = false; form.email.focus(); return; }
        var btn = form.querySelector('button');
        btn.disabled = true; err.hidden = true;
        var profile = { data: { type: 'profile', attributes: { email: email } } };
        var jobs = [];
        if (LIST) {
          jobs.push(post('subscriptions', { data: { type: 'subscription', attributes: {
            custom_source: 'Guide: ' + GUIDE,
            profile: { data: { type: 'profile', attributes: { email: email } } }
          }, relationships: { list: { data: { type: 'list', id: LIST } } } } }));
        }
        jobs.push(post('events', { data: { type: 'event', attributes: {
          properties: { guide: GUIDE, page: location.pathname },
          metric: { data: { type: 'metric', attributes: { name: 'Guide Downloaded' } } },
          profile: profile
        } } }));
        Promise.all(jobs).then(function () {
          try { localStorage.setItem(storeKey, '1'); } catch (e2) {}
          unlock();
        }).catch(function () { err.hidden = false; btn.disabled = false; });
      });
    });
  })();
</script>

