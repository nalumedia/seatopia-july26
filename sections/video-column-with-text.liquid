      },
    ],
    "blocks": [
      {
        "type": "text_block",
        "name": "Column",
        "limit": 4,
        "settings": [
          {
            "type": "checkbox",
            "id": "enable_image",
            "label": "Show image",
            "default": true
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
