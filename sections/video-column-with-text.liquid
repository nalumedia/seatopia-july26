{% comment %}
  <div class="pdp-image-text index-columns " style="background-color:{{ section.settings.background_color }}; ">
    <div class="wrapper">
      {% if section.settings.title != blank %}
        <h1 class="title--decorated" style="color:{{ section.settings.text_color }}">
          {{ section.settings.title | escape }}
        </h1>
      {% endif %}
      <div
        class=" pdp-image-text-block-outer grid {% unless section.blocks.size == 5 %}grid-uniform{% endunless %}"
        watchcss
      >
        {% for block in section.blocks %}
          <div
            class="pdp-image-text-block  {{ section.settings.align_text }}"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.enable_image %}
              {% if block.settings.image != blank %}
                {% assign img_url = block.settings.image | img_url: 'master' %}
                {% if block.settings.button_link != blank %}
                  <a href="{{ block.settings.button_link }}">
                    <div class="play_btn">
                      <svg width="20" height="26" viewBox="0 0 20 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M19.3028 12.2553L1.37446 0.562891C0.783199 0.177286 0 0.601542 0 1.30743V24.6922C0 25.3981 0.783197 25.8224 1.37446 25.4368L19.3028 13.7444C19.8406 13.3937 19.8406 12.606 19.3028 12.2553Z" fill="#1A3059"/>
                      </svg>
                    </div>
                    <p
                      class="lazy-image"
                      style="padding-top:{{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100}}%; background-image:  url('{{ block.settings.image | img_url: '1x1' }}');"
                    >
                      <img
                        alt="{{ block.settings.image.alt }}"
                        data-src="{{ img_url }}"
                      >
                    </p>
                    <noscript>
                      <img
                        src="{{ block.settings.image | img_url: '540x' }}"
                        alt="{{ block.settings.image.alt | default: block.settings.title }}"
                      >
                    </noscript>
                  </a>
                {% else %}
                  <p
                    class="lazy-image"
                    style="padding-top:{{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100}}%; background-image:  url('{{ block.settings.image | img_url: '1x1' }}');"
                  >
                    <img
                      class="lazyload fade-in"
                      alt="{{ block.settings.image.alt }}"
                      data-src="{{ img_url }}"
                      data-aspectratio="{{  block.settings.image.aspect_ratio }}"
                      data-parent-fit="cover"
                      data-sizes="auto"
                    >
                  </p>
                  <noscript>
                    <img
                      src="{{ block.settings.image | img_url: '100x' }}"
                      alt="{{ block.settings.image.alt | default: block.settings.title }}"
                    >
                  </noscript>
                {% endif %}
              {% endif %}
            {% endif %}
            {% if block.settings.title != blank %}
              <div class="block-title" style="color:{{ section.settings.text_color }}; text-align:center;">
                {% if block.settings.check_svg != blank %}
                  <div class="check_svg">
                    {{ block.settings.check_svg }}
                  </div>
                {% elsif block.settings.check_image != blank %}
                  <div class="check_image">
                    {{ block.settings.check_image | img_tag }}
                  </div>
                {% endif %}
                <span>{{ block.settings.title }}</span>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>



