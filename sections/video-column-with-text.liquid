<style>
    #shopify-section-{{ section.id }} {
      --section-padding-top: {{ section.settings.padding_top }}px;
      --section-padding-bottom: {{ section.settings.padding_bottom }}px;
      {%- render 'section-variables', section: section -%}
    }
      .cstm-vid-txt-card {
      display: flex;
      flex-direction: column;
      justify-content: center;
      text-align: center;
  }
      .cstm-block-title{
         display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
      }

    @media screen and (min-width: 1024px) {
      #shopify-section-{{ section.id }} .multicolumn {
        --card-grid-gap: {% if section.settings.gap == 'small' %}var(--sp-4){% elsif section.settings.gap == 'medium' %}var(--sp-6){% else %}clamp(40px, 3.5vw, 60px){% endif %};
      }
    }
</style>

{% comment %}
  <div
    class="section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded relative{% endif %}"
    style="{% if section.settings.banner_img != blank %} background-image: url('{{ section.settings.banner_img | img_url: 'master' }}');{% endif %} "
  >
{% endcomment %}
<div
  class="section--padding {% if section.settings.rounded %} section--rounded relative{% endif %} {{ section.settings.custom_class }}"
  data-section-id="{{ section.id }} "
  style="{% if section.settings.banner_img != blank %} background-image: url('{{ section.settings.banner_img | img_url: 'master' }}');{% else %}background-color:{{ section.settings.color_background }} !important;{% endif %} color:{{ section.settings.color_text }}"
>
  <div
    class="page-width{% if section.settings.narrow %} page-width--narrow{% endif %}{% if section.settings.full_width %} page-width--full{% endif %} relative {{ section.settings.custom_class }}"
  >
    {%- render 'section-heading', section: section -%}

    <slider-element
      id="Slider-{{ section.id }}"
      class="grid slider{% if section.settings.swipe_on_mobile %} slider--tablet{% endif %}"
      selector=".card-grid>.card"
    >
      <div class="cstm-vid-txt-outer multicolumn with-{{ section.blocks.size }} card-grid card-grid--{{ section.settings.columns }} mobile:card-grid--{{ section.settings.columns_mobile }} grid relative z-1">
        {%- for block in section.blocks -%}
          <div
            class="cstm-vid-txt-card multicolumn-card {% comment %}{% if block.settings.show_border %} with-border{% endif %}{% endcomment %} card flex gap-4 w-full flex-col {% comment %}items-start{% endcomment %} xl:flex-row md:text-{{ block.settings.text_alignment }} text-{{ block.settings.text_alignment_mobile }}"
            {{ block.shopify_attributes }}
          >
            <div class="grid gap-4 lg:gap-6 w-full">
              {%- if block.settings.video != blank -%}
                {%- capture sizes -%}(max-width: 639px) 100vw, (max-width: 1023px) calc(100vw / 2 - 40px), (max-width: 1535px) calc(min(100vw, {{ settings.page_width }}px) / 3 - 40px), calc(min(100vw, {{ settings.page_width }}px) / 3 - 80px){%- endcapture -%}
                <a
                  class="cstm-vid-txt-block block media media--{{ block.settings.image_ratio }} media--transparent relative overflow-hidden"
                  {% if block.settings.button_link != blank %}
                    href="{{ block.settings.button_link }}"
                    {%- if block.settings.button_external %} target="_blank" rel="noopener"{% endif -%}
                  {% else %}
                    role="link" aria-disabled="true"
                  {% endif %}
                  aria-label="{{ block.settings.heading | escape }}"
                >
                  {%- liquid
                    assign video_alt = block.settings.video.alt | default: block.settings.image.alt
                    assign alt = 'general.accessibility.load_video' | t: description: video_alt | escape
                    assign preview_image = block.settings.video.preview_image | default: block.settings.image

                    capture poster
                      if preview_image != blank
                        echo preview_image | image_url: width: preview_image.width | image_tag: loading: 'lazy', widths: '180,360,540,720,900,1080,1600', sizes: sizes, is: 'lazy-image', class: 'inline-block', alt: alt
                      else
                        echo 'lifestyle-1' | placeholder_svg_tag: 'placeholder'
                      endif
                    endcapture
                  -%}
                  <video-media
                    class="cstm-vid-txt-block-video block"
                    style="--aspect-ratio: {{ block.settings.video.aspect_ratio }}"
                    autoplay
                  >
                    {{- poster -}}
                    <template>
                      {{-
                        block.settings.video
                        | video_tag:
                          playsinline: true,
                          muted: true,
                          autoplay: true,
                          loop: true,
                          controls: false,
                          preload: 'none',
                          image_size: '400x'
                      -}}
                    </template>
                  </video-media>
                </a>
              {%- elsif block.settings.image != blank -%}
                {%- capture sizes -%}(max-width: 639px) 100vw, (max-width: 1023px) calc(100vw / 2 - 40px), (max-width: 1535px) calc(min(100vw, {{ settings.page_width }}px) / 3 - 40px), calc(min(100vw, {{ settings.page_width }}px) / 3 - 80px){%- endcapture -%}
                <a
                  class="block media media--{{ block.settings.image_ratio }} media--transparent relative overflow-hidden"
                  {% if block.settings.button_link != blank %}
                    href="{{ block.settings.button_link }}"
                    {%- if block.settings.button_external %} target="_blank" rel="noopener"{% endif -%}
                  {% else %}
                    role="link" aria-disabled="true"
                  {% endif %}
                  aria-label="{{ block.settings.heading | escape }}"
                >
                  {{-
                    block.settings.image
                    | image_url: width: block.settings.image.width
                    | image_tag:
                      loading: 'lazy',
                      widths: '180,360,540,720,900,1080,1600',
                      sizes: sizes,
                      is: 'lazy-image',
                      class: 'inline-block'
                  -}}
                </a>
              {%- endif -%}
            </div>
            <div class="cstm-column-content ">
              {% if block.settings.title != blank %}
                <div class="cstm-block-title gap-2">
                  {% if block.settings.check_svg != blank %}
                    <div class="check_svg">
                      {{ block.settings.check_svg }}
                    </div>
                  {% elsif block.settings.check_image != blank %}
                    <div class="check_image">
                      {{ block.settings.check_image | img_tag }}
                    </div>
                  {% endif %}
                  <span>{{ block.settings.title }}</span>
                </div>
              {% endif %}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </slider-element>
  </div>
</div>

