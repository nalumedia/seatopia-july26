{%- comment -%}
  Web kit — slideshow. Full-bleed image slides with copy and one button each; arrows, dots, swipe,
  autoplay that pauses on hover, focus and when the tab is hidden. Scroll-snap does the sliding so it
  works without JS; the script only adds the controls and the timer.
{%- endcomment -%}
{%- render 'uikit-fonts' -%}
{{ 'web-kit.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign count = section.blocks.size
-%}
<div class="wk wk-slideshow" id="{{ s.anchor | default: section.id | handleize }}" data-wk-slideshow data-autoplay="{{ s.autoplay | default: 0 }}" style="--wk-slide-h: {{ s.height | default: 720 }}px; --wk-slide-overlay: {{ s.overlay | default: 50 | divided_by: 100.0 }};">
  <div class="wk-slideshow__track" data-wk-track aria-roledescription="carousel">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <section class="wk-slideshow__slide" data-wk-slide aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ count }}" {{ block.shopify_attributes }}>
        {%- if b.image != blank -%}
          {{ b.image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '600,900,1200,1600,2000,2400', sizes: '100vw', class: 'wk-slideshow__img', alt: b.image.alt | default: b.heading | escape }}
        {%- endif -%}
        <div class="wk-slideshow__scrim"></div>
        <div class="wk-container wk-slideshow__content">
          {%- if b.eyebrow != blank -%}<p class="wk-eyebrow wk-eyebrow--on-ink">{{ b.eyebrow }}</p>{%- endif -%}
          {%- if b.heading != blank -%}<h2 class="wk-display">{{ b.heading }}</h2>{%- endif -%}
          {%- if b.text != blank -%}<div class="wk-body wk-prose wk-slideshow__text">{{ b.text }}</div>{%- endif -%}
          {%- if b.cta_label != blank and b.cta_link != blank -%}
            <a class="wk-btn wk-btn--coral" href="{{ b.cta_link }}">{{ b.cta_label }}{% render 'web-kit-icon', name: 'arrow-right' %}</a>
          {%- endif -%}
        </div>
      </section>
    {%- endfor -%}
  </div>
  {%- if count > 1 -%}
    <div class="wk-slideshow__nav">
      <button type="button" class="wk-slideshow__arrow" data-wk-prev aria-label="Previous slide">{% render 'web-kit-icon', name: 'arrow-right' %}</button>
      <div class="wk-slideshow__dots" role="tablist">
        {%- for block in section.blocks -%}
          <button type="button" class="wk-slideshow__dot{% if forloop.first %} is-active{% endif %}" data-wk-dot="{{ forloop.index0 }}" role="tab" aria-label="Go to slide {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
      <button type="button" class="wk-slideshow__arrow" data-wk-next aria-label="Next slide">{% render 'web-kit-icon', name: 'arrow-right' %}</button>
    </div>
  {%- endif -%}
</div>

<style>
  .wk-slideshow { position: relative; background: var(--wk-ink); }
  .wk-slideshow__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .wk-slideshow__track::-webkit-scrollbar { display: none; }
  .wk-slideshow__slide { position: relative; flex: 0 0 100%; width: 100%; min-height: var(--wk-slide-h); scroll-snap-align: start; display: flex; align-items: center; overflow: hidden; }
  .wk-slideshow__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .wk-slideshow__scrim { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(27,46,55, calc(var(--wk-slide-overlay) + .25)) 0%, rgba(27,46,55, var(--wk-slide-overlay)) 45%, rgba(27,46,55, calc(var(--wk-slide-overlay) * .5)) 100%); }
  .wk-slideshow__content { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 24px; max-width: 640px; margin-inline: var(--wk-gutter) auto; padding-block: 96px; color: var(--wk-paper); }
  .wk-slideshow__content .wk-display { color: var(--wk-paper); text-shadow: 0 2px 24px rgba(0,0,0,.35); }
  .wk-slideshow__text { color: rgba(251,250,247,.9); text-shadow: 0 1px 12px rgba(0,0,0,.35); }
  .wk-slideshow__nav { position: absolute; left: 0; right: 0; bottom: 28px; display: flex; align-items: center; justify-content: center; gap: 20px; }
  .wk-slideshow__arrow { width: 48px; height: 48px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid rgba(251,250,247,.45); border-radius: 0; background: rgba(27,46,55,.35); color: var(--wk-paper); cursor: pointer; transition: background .2s, border-color .2s; }
  .wk-slideshow__arrow:hover, .wk-slideshow__arrow:focus-visible { background: var(--wk-paper); color: var(--wk-ink); border-color: var(--wk-paper); }
  .wk-slideshow__arrow svg { width: 18px; height: 18px; }
  .wk-slideshow__arrow[data-wk-prev] svg { transform: rotate(180deg); }
  .wk-slideshow__dots { display: flex; gap: 10px; }
  .wk-slideshow__dot { width: 10px; height: 10px; padding: 0; border-radius: 50%; border: 1px solid rgba(251,250,247,.7); background: transparent; cursor: pointer; transition: background .2s; }
  .wk-slideshow__dot.is-active { background: var(--wk-paper); }
  @media (max-width: 989px) {
    .wk-slideshow__slide { min-height: min(var(--wk-slide-h), 80vh); align-items: flex-end; }
    .wk-slideshow__content { padding-block: 48px 96px; gap: 16px; margin-inline: var(--wk-gutter); }
    .wk-slideshow__scrim { background: linear-gradient(180deg, rgba(27,46,55, calc(var(--wk-slide-overlay) * .4)) 0%, rgba(27,46,55, calc(var(--wk-slide-overlay) + .3)) 100%); }
    .wk-slideshow__nav { bottom: 20px; }
  }
  @media (prefers-reduced-motion: reduce) { .wk-slideshow__track { scroll-behavior: auto; } }
</style>

<script>
  (function () {
    var root = document.querySelector('#shopify-section-{{ section.id }} [data-wk-slideshow]');
    if (!root) return;
    var track = root.querySelector('[data-wk-track]');
    var slides = [].slice.call(root.querySelectorAll('[data-wk-slide]'));
    var dots = [].slice.call(root.querySelectorAll('[data-wk-dot]'));
    if (slides.length < 2) return;
    var index = 0, timer = null, paused = false;
    var delay = Number(root.getAttribute('data-autoplay')) * 1000;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function go(i, smooth) {
      index = (i + slides.length) % slides.length;
      track.scrollTo({ left: slides[index].offsetLeft, behavior: smooth === false || reduce ? 'auto' : 'smooth' });
    }
    function sync() {
      var i = Math.round(track.scrollLeft / track.clientWidth);
      if (i !== index && i >= 0 && i < slides.length) index = i;
      dots.forEach(function (d, j) { d.classList.toggle('is-active', j === index); d.setAttribute('aria-selected', j === index ? 'true' : 'false'); });
    }
    function start() { if (!delay || reduce) return; stop(); timer = setInterval(function () { if (!paused && !document.hidden) go(index + 1); }, delay); }
    function stop() { if (timer) clearInterval(timer); timer = null; }
    root.querySelector('[data-wk-prev]').addEventListener('click', function () { go(index - 1); start(); });
    root.querySelector('[data-wk-next]').addEventListener('click', function () { go(index + 1); start(); });
    dots.forEach(function (d) { d.addEventListener('click', function () { go(Number(d.getAttribute('data-wk-dot'))); start(); }); });
    var raf; track.addEventListener('scroll', function () { cancelAnimationFrame(raf); raf = requestAnimationFrame(sync); }, { passive: true });
    root.addEventListener('mouseenter', function () { paused = true; });
    root.addEventListener('mouseleave', function () { paused = false; });
    root.addEventListener('focusin', function () { paused = true; });
    root.addEventListener('focusout', function () { paused = false; });
    track.addEventListener('touchstart', function () { stop(); }, { passive: true });
    window.addEventListener('resize', function () { go(index, false); });
    sync(); start();
  })();
</script>

{% schema %}
{
  "name": "Web kit — slideshow",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "height", "label": "Height", "min": 480, "max": 960, "step": 20, "unit": "px", "default": 720 },
    { "type": "range", "id": "overlay", "label": "Overlay", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 45 },
    { "type": "range", "id": "autoplay", "label": "Autoplay (seconds, 0 = off)", "min": 0, "max": 12, "step": 1, "default": 7 },
    { "type": "text", "id": "anchor", "label": "Anchor ID" }
  ],
  "blocks": [
    { "type": "slide", "name": "Slide", "limit": 6, "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "richtext", "id": "text", "label": "Text" },
      { "type": "text", "id": "cta_label", "label": "Button label" },
      { "type": "url", "id": "cta_link", "label": "Button link" }
    ]}
  ],
  "presets": [{ "name": "Web kit — slideshow", "blocks": [ { "type": "slide" }, { "type": "slide" } ] }]
}
{% endschema %}
