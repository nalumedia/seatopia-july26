{%- comment -%}
  UI kit — curated box grid. Figma node 47:473.
  Layout "Scrolling" turns it into a snap carousel with arrows, for campaign pages that
  lead with the best sellers and then the specialty boxes. A card can take everything
  from a product: image, title, link and starting price. "Show savings" works out the
  per-portion saving of the largest size over the smallest from the variant names
  (12 / 18 / 24 Portion), the same arithmetic as the product cards' "Save 4.8%".
{%- endcomment -%}

{%- assign scroll = false -%}
{%- if section.settings.layout == 'scroll' -%}{%- assign scroll = true -%}{%- endif -%}

<div class="uikit uikit-section">
  <div class="uikit-container">
    <div class="uikit-boxgrid__head{% if scroll %} uikit-boxgrid__head--scroll{% endif %}">
      <div class="uikit-boxgrid__headtext">
        {%- if section.settings.heading != blank -%}<h2 class="uikit-h2">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p class="uikit-body-m uikit-muted uikit-boxgrid__intro">{{ section.settings.text }}</p>{%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <a class="uikit-btn uikit-btn--primary uikit-btn--s" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a>
        {%- endif -%}
      </div>
      {%- if scroll -%}
        <div class="uikit-boxgrid__arrows">
          <button type="button" class="uikit-boxgrid__arrow" data-uk-scroll="-1" aria-label="Previous boxes"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          <button type="button" class="uikit-boxgrid__arrow" data-uk-scroll="1" aria-label="More boxes"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        </div>
      {%- endif -%}
    </div>

    {%- liquid
      assign groups = ''
      for block in section.blocks
        if block.settings.group != blank
          assign key = '|' | append: block.settings.group | append: '|'
          unless groups contains key
            assign groups = groups | append: key
          endunless
        endif
      endfor
      assign group_list = groups | remove_first: '|' | split: '||'
    -%}
    {%- if section.settings.show_filters and group_list.size > 1 -%}
      <div class="uikit-boxgrid__filters" role="group" aria-label="Filter boxes">
        <button type="button" class="uikit-boxgrid__filter" data-uk-filter="" aria-pressed="true">All</button>
        {%- for g in group_list -%}
          {%- assign gg = g | remove: '|' -%}
          <button type="button" class="uikit-boxgrid__filter" data-uk-filter="{{ gg | handleize }}" aria-pressed="false">{{ gg }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <ul class="uikit-boxgrid{% if scroll %} uikit-boxgrid--scroll{% endif %}" role="list" data-uk-track>
      {%- for block in section.blocks -%}
        {%- liquid
          assign bp = block.settings.product
          assign b_img = block.settings.image
          if b_img == blank and bp != blank
            assign b_img = bp.featured_image
          endif
          assign b_link = block.settings.link
          if b_link == blank and bp != blank
            assign b_link = bp.url
          endif
          assign b_title = block.settings.title
          if b_title == blank and bp != blank
            assign b_title = bp.title
          endif
          assign b_save = ''
          if block.settings.show_savings and bp != blank and bp.variants.size > 1
            assign v_first = bp.variants.first
            assign v_last = bp.variants.last
            assign n_first = v_first.title | remove: ',' | split: ' ' | first | plus: 0
            assign n_last = v_last.title | remove: ',' | split: ' ' | first | plus: 0
            if n_first > 0 and n_last > n_first
              assign pp_first = v_first.price | times: 1.0 | divided_by: n_first
              assign pp_last = v_last.price | times: 1.0 | divided_by: n_last
              if pp_last < pp_first
                assign pct = pp_last | divided_by: pp_first | times: -100 | plus: 100 | round: 1
                assign b_save = 'Save ' | append: pct | append: '% per portion on ' | append: n_last
              endif
            endif
          endif
        -%}
        <li class="uikit-boxgrid__item" data-uk-group="{{ block.settings.group | handleize }}" {{ block.shopify_attributes }}>
          {%- if block.settings.group != blank -%}<p class="uikit-label-s uikit-boxgrid__group">{{ block.settings.group }}</p>{%- endif -%}
          <a class="uikit-boxgrid__link" href="{{ b_link | default: '#' }}">
            <span class="uikit-media uikit-boxgrid__media" style="--uk-ratio: 4 / 3;">
              {%- if b_img != blank -%}
                {{ b_img | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 373px, 80vw', widths: '400,600,900', alt: b_img.alt | default: b_title }}
              {%- endif -%}
              {%- if block.settings.tag != blank -%}<span class="uikit-label-s uikit-boxgrid__tag{% if block.settings.tag_gold %} uikit-boxgrid__tag--gold{% endif %}">{{ block.settings.tag }}</span>{%- endif -%}
            </span>
            <span class="uikit-boxgrid__row">
              <span class="uikit-label-l uikit-boxgrid__name">{{ b_title }}</span>
              {%- if block.settings.show_price and bp != blank -%}
                <span class="uikit-body-s uikit-boxgrid__price">{% if bp.price_varies %}From {% endif %}{{ bp.price_min | money_without_trailing_zeros }}</span>
              {%- endif -%}
            </span>
            <span class="uikit-body-s uikit-muted">{{ block.settings.text }}</span>
            {%- if block.settings.savings_text != blank -%}
              <span class="uikit-label-s uikit-boxgrid__save">{{ block.settings.savings_text }}</span>
            {%- elsif b_save != '' and block.settings.show_buy == false -%}
              <span class="uikit-label-s uikit-boxgrid__save">{{ b_save }}</span>
            {%- endif -%}
          </a>
          {%- if block.settings.show_buy and bp != blank -%}
            {%- comment -%} The curated-boxes buy bar: size chips with savings, one-tap add. {%- endcomment -%}
            <div class="uikit-boxgrid__buy">
              {%- capture qa_pid -%}{{ block.id }}-{{ bp.id }}{%- endcapture -%}
              {%- render 'product-card-quick-add', product: bp, section_id: section.id, product_id: qa_pid -%}
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

<style>
  .uikit-boxgrid__head { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; margin-bottom: 48px; }
  .uikit-boxgrid__head--scroll { flex-direction: row; justify-content: space-between; align-items: flex-end; gap: 24px; }
  .uikit-boxgrid__headtext { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .uikit-boxgrid__head .uikit-h2 { max-width: 640px; }
  .uikit-boxgrid__intro { max-width: 620px; }
  .uikit-boxgrid__arrows { display: flex; gap: 10px; flex: none; }
  .uikit-boxgrid__arrow { display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border: 1px solid var(--uk-rule); border-radius: 999px; background: var(--uk-white); color: var(--uk-heading); cursor: pointer; }
  .uikit-boxgrid__arrow:hover { border-color: var(--uk-heading); }
  .uikit-boxgrid__arrow[disabled] { opacity: .35; cursor: default; }
  .uikit-boxgrid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 28px; list-style: none; margin: 0; padding: 0; }
  .uikit-boxgrid--scroll { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: calc((100% - 56px) / 3); overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; padding-bottom: 6px; }
  .uikit-boxgrid--scroll::-webkit-scrollbar { display: none; }
  .uikit-boxgrid--scroll .uikit-boxgrid__item { scroll-snap-align: start; }
  .uikit-boxgrid__item { display: flex; flex-direction: column; gap: 12px; }
  .uikit .uikit-boxgrid__group { color: var(--uk-gold); letter-spacing: .12em; text-transform: uppercase; min-height: 1.2em; }
  .uikit-boxgrid__link { display: flex; flex-direction: column; gap: 12px; color: inherit; text-decoration: none; }
  .uikit-boxgrid__media { position: relative; aspect-ratio: 4 / 3; }
  .uikit-boxgrid__name { color: var(--uk-heading); }
  .uikit-boxgrid__tag { position: absolute; left: 16px; top: 16px; padding: 6px 12px; border-radius: var(--uk-radius-pill); background: var(--uk-white); color: var(--uk-heading); }
  .uikit-boxgrid__tag--gold { background: var(--uk-gold); color: var(--uk-white); }
  .uikit-boxgrid__row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .uikit-boxgrid__price { color: var(--uk-heading); white-space: nowrap; }
  .uikit .uikit-boxgrid__save { align-self: flex-start; padding: 5px 10px; border-radius: 6px; background: rgba(187,143,80,.14); color: #8a6430; }
  .uikit-boxgrid__link:hover .uikit-boxgrid__media { opacity: .9; }
  .uikit-boxgrid__buy { margin-top: auto; }
  .uikit-boxgrid__buy .card-qa { padding-top: 0; }
  .uikit-boxgrid__item[hidden] { display: none; }
  .uikit-boxgrid__filters { display: flex; flex-wrap: wrap; gap: 8px; margin: -24px 0 32px; }
  .uikit-boxgrid__filter { padding: 10px 20px; border: 1px solid var(--uk-rule); border-radius: var(--uk-radius-pill); background: var(--uk-white); color: var(--uk-heading); font: inherit; cursor: pointer; }
  .uikit-boxgrid__filter[aria-pressed="true"] { background: var(--uk-heading); border-color: var(--uk-heading); color: var(--uk-white); }
  @media (max-width: 989px) {
    .uikit-boxgrid { grid-template-columns: 1fr; gap: 32px; }
    .uikit-boxgrid--scroll { grid-template-columns: none; grid-auto-columns: 72%; gap: 16px; }
    .uikit-boxgrid__head--scroll { flex-direction: column; align-items: flex-start; }
    .uikit-boxgrid__arrows { display: none; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var fs = root.querySelectorAll('[data-uk-filter]');
    var track = root.querySelector('[data-uk-track]');
    fs.forEach(function (f) {
      f.addEventListener('click', function () {
        var g = f.getAttribute('data-uk-filter');
        fs.forEach(function (x) { x.setAttribute('aria-pressed', x === f ? 'true' : 'false'); });
        root.querySelectorAll('.uikit-boxgrid__item').forEach(function (it) {
          it.hidden = g !== '' && it.getAttribute('data-uk-group') !== g;
        });
        if (track) { track.scrollLeft = 0; track.dispatchEvent(new Event('scroll')); }
      });
    });
  })();
</script>

{%- if scroll -%}
  <script>
    (function () {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root) return;
      var track = root.querySelector('[data-uk-track]');
      var btns = root.querySelectorAll('[data-uk-scroll]');
      if (!track) return;
      var sync = function () {
        var max = track.scrollWidth - track.clientWidth - 2;
        btns.forEach(function (b) {
          var dir = +b.getAttribute('data-uk-scroll');
          b.disabled = dir < 0 ? track.scrollLeft <= 2 : track.scrollLeft >= max;
        });
      };
      btns.forEach(function (b) {
        b.addEventListener('click', function () {
          var item = track.querySelector('.uikit-boxgrid__item');
          var step = item ? item.getBoundingClientRect().width + 28 : track.clientWidth;
          track.scrollBy({ left: step * +b.getAttribute('data-uk-scroll'), behavior: 'smooth' });
        });
      });
      track.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "UI kit — box grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Looking for something else? Choose a box or build your own." },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "Lab-tested seafood delivered to your door, snap frozen. Select 12, 18, or 24 portion curated boxes, or build your own." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Build Your Box" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "checkbox", "id": "show_filters", "label": "Filter buttons by group", "default": false },
    {
      "type": "select", "id": "layout", "label": "Layout", "default": "grid",
      "options": [ { "value": "grid", "label": "Grid" }, { "value": "scroll", "label": "Scrolling" } ]
    }
  ],
  "blocks": [
    { "type": "box", "name": "Box", "settings": [
      { "type": "product", "id": "product", "label": "Product", "info": "Supplies the image, title, link and price when those are empty." },
      { "type": "checkbox", "id": "show_price", "label": "Show starting price", "default": false },
      { "type": "checkbox", "id": "show_buy", "label": "Show size picker and Add button", "default": false },
      { "type": "checkbox", "id": "show_savings", "label": "Show per-portion savings", "info": "Largest size against smallest, from the variant names.", "default": false },
      { "type": "text", "id": "savings_text", "label": "Savings line", "info": "Overrides the calculated saving. Only an offer that is live." },
      { "type": "text", "id": "group", "label": "Group label above card", "info": "e.g. Favorites, Specialty. Also drives the filter buttons." },
      { "type": "text", "id": "tag", "label": "Tag on image" },
      { "type": "checkbox", "id": "tag_gold", "label": "Gold tag", "default": false },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "presets": [{ "name": "UI kit — box grid", "blocks": [
    { "type": "box", "settings": { "title": "Salmon Lovers Box", "text": "Rich flavor carrying oceanic depth and gentle sweetness across the palate. Contains a selection of King, Atlantic, and Steelhead." } },
    { "type": "box", "settings": { "title": "Fish & Shellfish Box", "text": "Contains salmon, whitefish, and Peruvian scallops." } },
    { "type": "box", "settings": { "title": "White Fish Box", "text": "Contains a selection of bream, branzino, yellowtail, and barramundi." } }
  ]}]
}
{% endschema %}
