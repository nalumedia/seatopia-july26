{%- comment -%}
  UI kit — side-by-side comparison. Figma node 47:570

  CLAIMS GUIDE §8.11 — competitor columns are BLOCKED.
  A measurable comparison to competitors needs a documented, dated scan of what
  competitors actually publish. §5 records that dataset as "Does not exist."
  Comparatives also carry Lanham Act exposure: a competitor sues directly, no
  agency involved. The Seatopia column is green published fact and is safe.
  Leave `show_competitors` off until Clark signs off AND the dataset exists.
{%- endcomment -%}

<div class="uikit uikit-section">
  <div class="uikit-container">
    {%- if section.settings.eyebrow != blank -%}<p class="uikit-overline uikit-cmp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="uikit-h2 uikit-cmp__heading">{{ section.settings.heading }}</h2>{%- endif -%}

    <div class="uikit-cmp{% unless section.settings.show_competitors %} uikit-cmp--solo{% endunless %}">
      <div class="uikit-cmp__col uikit-cmp__col--brand">
        <p class="uikit-label-l uikit-cmp__brandname">{{ section.settings.brand_label }}</p>
        <ul class="uikit-cmp__list" role="list">
          {%- for block in section.blocks -%}
            <li class="uikit-cmp__row uikit-body-s">{{ block.settings.seatopia }}</li>
          {%- endfor -%}
        </ul>
      </div>

      {%- if section.settings.show_competitors -%}
        <div class="uikit-cmp__col">
          <p class="uikit-label-m uikit-cmp__colname">{{ section.settings.col2_label }}</p>
          <ul class="uikit-cmp__list" role="list">
            {%- for block in section.blocks -%}
              <li class="uikit-cmp__row uikit-body-s uikit-muted">{{ block.settings.col2 | default: '— pending competitor dataset —' }}</li>
            {%- endfor -%}
          </ul>
        </div>
        <div class="uikit-cmp__col">
          <p class="uikit-label-m uikit-cmp__colname">{{ section.settings.col3_label }}</p>
          <ul class="uikit-cmp__list" role="list">
            {%- for block in section.blocks -%}
              <li class="uikit-cmp__row uikit-body-s uikit-muted">{{ block.settings.col3 | default: '— pending competitor dataset —' }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .uikit-cmp__eyebrow { text-align: center; }
  .uikit-cmp__heading { text-align: center; max-width: 720px; margin: 12px auto 48px; }
  .uikit-cmp { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr) minmax(0,1fr); gap: 24px; align-items: start; }
  .uikit-cmp--solo { grid-template-columns: minmax(0, 620px); justify-content: center; }
  .uikit-cmp__col { border-radius: var(--uk-radius-card); padding: 32px 28px; }
  .uikit-cmp__col--brand { background: var(--uk-deep-deep-blue); color: var(--uk-white); }
  .uikit-cmp__col--brand .uikit-cmp__brandname { color: var(--uk-white); margin-bottom: 20px; }
  .uikit-cmp__colname { color: var(--uk-heading); margin-bottom: 20px; }
  .uikit-cmp__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .uikit-cmp__row { padding: 14px 0; border-top: 1px solid rgba(255,255,255,.16); }
  .uikit-cmp__col:not(.uikit-cmp__col--brand) .uikit-cmp__row { border-top-color: var(--uk-gray-4); }
  .uikit-cmp__row:first-child { border-top: 0; }
  @media (max-width: 989px) { .uikit-cmp { grid-template-columns: 1fr; } .uikit-cmp--solo { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "UI kit — comparison",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Claims guide §8.11: the competitor columns need a documented competitor dataset, which §5 records as not existing. Keep them off until Clark signs off." },
    { "type": "checkbox", "id": "show_competitors", "label": "Show competitor columns (BLOCKED — see above)", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Side by Side Comparison" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Never worry about the quality of your seafood again." },
    { "type": "text", "id": "brand_label", "label": "Brand column label", "default": "SEATOPIA" },
    { "type": "text", "id": "col2_label", "label": "Column 2 label", "default": "Supermarkets" },
    { "type": "text", "id": "col3_label", "label": "Column 3 label", "default": "Other Seafood Direct Companies" }
  ],
  "blocks": [
    { "type": "row", "name": "Row", "settings": [
      { "type": "text", "id": "seatopia", "label": "Seatopia" },
      { "type": "text", "id": "col2", "label": "Column 2 (needs dataset)" },
      { "type": "text", "id": "col3", "label": "Column 3 (needs dataset)" }
    ]}
  ],
  "presets": [{ "name": "UI kit — comparison", "blocks": [
    { "type": "row", "settings": { "seatopia": "Third-party lab tested for nutrition, mercury and microplastics" } },
    { "type": "row", "settings": { "seatopia": "Our limit is 0.1 ppm methylmercury — a tenth of the FDA action level" } },
    { "type": "row", "settings": { "seatopia": "Tested for microplastics down to 1 micron" } },
    { "type": "row", "settings": { "seatopia": "We test and publish omega-3, protein, selenium, vitamin D and B12" } },
    { "type": "row", "settings": { "seatopia": "Farms named, panels published" } },
    { "type": "row", "settings": { "seatopia": "Blast-frozen to -10°F at harvest, vacuum sealed" } }
  ]}]
}
{% endschema %}
