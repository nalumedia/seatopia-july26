{%- comment -%} UI kit — logo cloud / featured in. Figma node 47:419 {%- endcomment -%}

<div class="uikit uikit-section uikit-section--tight">
  <div class="uikit-container uikit-stack uikit-stack--center uikit-logos">
    {%- if section.settings.heading != blank -%}
      <p class="uikit-overline">{{ section.settings.heading }}</p>
    {%- endif -%}
    <ul class="uikit-logos__row" role="list">
      {%- for block in section.blocks -%}
        <li class="uikit-logos__item" {{ block.shopify_attributes }}>
          {%- if block.settings.logo != blank -%}
            {{ block.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.logo.alt | default: '' }}
          {%- else -%}
            <span class="uikit-body-s uikit-muted">{{ block.settings.name }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

<style>
  .uikit-logos { gap: 32px; }
  .uikit-logos__row { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 48px; list-style: none; margin: 0; padding: 0; }
  .uikit-logos__item img { max-height: 28px; width: auto; opacity: .7; }
  @media (max-width: 749px) { .uikit-logos__row { gap: 28px; } .uikit-logos__item img { max-height: 20px; } }
</style>

{% schema %}
{
  "name": "UI kit — logo cloud",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Eyebrow", "default": "Featured In" }
  ],
  "blocks": [
    { "type": "logo", "name": "Logo", "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo" },
      { "type": "text", "id": "name", "label": "Fallback name" }
    ]}
  ],
  "presets": [{ "name": "UI kit — logo cloud", "blocks": [
    { "type": "logo", "settings": { "name": "Goop" } },
    { "type": "logo", "settings": { "name": "Forbes" } },
    { "type": "logo", "settings": { "name": "Well+Good" } },
    { "type": "logo", "settings": { "name": "Food Fix" } }
  ]}]
}
{% endschema %}
