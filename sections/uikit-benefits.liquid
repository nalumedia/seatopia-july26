{%- comment -%} UI kit — benefit badges. Figma node 47:441 / 47:442 {%- endcomment -%}

<div class="uikit uikit-section">
  <div class="uikit-container">
    <ul class="uikit-benefits" role="list">
      {%- for block in section.blocks -%}
        <li class="uikit-benefits__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <span class="uikit-benefits__icon">
              {{ block.settings.icon | image_url: width: 72 | image_tag: loading: 'lazy', alt: '' }}
            </span>
          {%- endif -%}
          <p class="uikit-label-m uikit-benefits__name">{{ block.settings.title }}</p>
          <p class="uikit-body-s uikit-muted">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.heading != blank -%}
      <h2 class="uikit-h2 uikit-benefits__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>
</div>

<style>
  .uikit-benefits { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 40px; list-style: none; margin: 0; padding: 0; }
  .uikit-benefits__item { display: flex; flex-direction: column; gap: 10px; }
  .uikit-benefits__icon { display: block; width: 36px; height: 36px; margin-bottom: 6px; }
  .uikit-benefits__icon img { width: 100%; height: 100%; object-fit: contain; }
  .uikit-benefits__name { color: var(--uk-heading); }
  .uikit-benefits__heading { margin-top: 100px; text-align: center; max-width: 780px; margin-inline: auto; }
  @media (max-width: 989px) { .uikit-benefits { grid-template-columns: repeat(2, minmax(0,1fr)); gap: 32px; } .uikit-benefits__heading { margin-top: 64px; } }
  @media (max-width: 599px) { .uikit-benefits { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "UI kit — benefits",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading below badges", "default": "Know exactly what's in the seafood you serve." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "title", "label": "Title", "default": "Low mercury" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Our limit is 0.1 ppm methylmercury — a tenth of the FDA action level." }
      ]
    }
  ],
  "presets": [
    {
      "name": "UI kit — benefits",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Low mercury", "text": "Our limit is 0.1 ppm methylmercury — a tenth of the FDA action level." } },
        { "type": "benefit", "settings": { "title": "Zero microplastics detected", "text": "Tested for microplastics down to 1 micron. Zero detected in third-party testing." } },
        { "type": "benefit", "settings": { "title": "Nutrient dense", "text": "We test and publish omega-3, protein, selenium, vitamin D and B12." } },
        { "type": "benefit", "settings": { "title": "Farms named", "text": "Farms named, panels published. Scan the QR on the box and the farm page opens." } }
      ]
    }
  ]
}
{% endschema %}
