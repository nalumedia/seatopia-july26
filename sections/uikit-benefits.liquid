{%- comment -%}
  UI kit — benefit badges. Figma node 47:441 / 47:442, and the proof band 47:419
  (heading and intro above, icon lockups below) when "Heading position" is Above.
{%- endcomment -%}

{%- capture uk_benefits_head -%}
  {%- if section.settings.heading != blank or section.settings.text != blank -%}
    <div class="uikit-benefits__head uikit-benefits__head--{{ section.settings.heading_position }}">
      {%- if section.settings.heading != blank -%}
        <h2 class="uikit-h2 uikit-benefits__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="uikit-body-m uikit-benefits__intro">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

<div class="uikit uikit-section">
  <div class="uikit-container">
    {%- if section.settings.heading_position == 'above' -%}{{ uk_benefits_head }}{%- endif -%}

    <ul class="uikit-benefits{% if section.settings.ruled %} uikit-benefits--ruled{% endif %}" role="list">
      {%- for block in section.blocks -%}
        <li class="uikit-benefits__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <span class="uikit-benefits__icon">
              {{ block.settings.icon | image_url: width: 72 | image_tag: loading: 'lazy', alt: '' }}
            </span>
          {%- elsif block.settings.icon_name != 'none' -%}
            <span class="uikit-benefits__icon">{% render 'uikit-icon', name: block.settings.icon_name %}</span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <p class="uikit-label-m uikit-benefits__name">{{ block.settings.title }}</p>
          {%- endif -%}
          <p class="{% if block.settings.title != blank %}uikit-body-s uikit-muted{% else %}uikit-body-m uikit-benefits__text{% endif %}">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.heading_position != 'above' -%}{{ uk_benefits_head }}{%- endif -%}
  </div>
</div>

<style>
  .uikit-benefits { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 40px; list-style: none; margin: 0; padding: 0; }
  .uikit-benefits__item { display: flex; flex-direction: column; gap: 10px; }
  .uikit-benefits__icon { display: block; width: 36px; height: 36px; margin-bottom: 6px; }
  .uikit-benefits__icon img, .uikit-benefits__icon svg { width: 100%; height: 100%; object-fit: contain; }
  .uikit-benefits__name { color: var(--uk-heading); }
  .uikit-benefits__text { color: var(--uk-heading); }
  .uikit-benefits__head { text-align: center; max-width: 780px; margin-inline: auto; }
  .uikit-benefits__head--below { margin-top: 100px; }
  .uikit-benefits__head--above { margin-bottom: 60px; }
  .uikit .uikit-benefits__intro { color: var(--uk-heading); max-width: 576px; margin: 40px auto 0; }
  .uikit-benefits--ruled { gap: 20px; }
  .uikit-benefits--ruled .uikit-benefits__item { border-top: 1px solid var(--uk-rule); padding: 40px 20px 40px 0; gap: 24px; }
  .uikit-benefits--ruled .uikit-benefits__icon { margin-bottom: 0; }
  @media (max-width: 989px) {
    .uikit-benefits { grid-template-columns: repeat(2, minmax(0,1fr)); gap: 32px; }
    .uikit-benefits__head--below { margin-top: 64px; }
    .uikit-benefits__head--above { margin-bottom: 40px; }
    .uikit .uikit-benefits__intro { margin-top: 24px; }
  }
  @media (max-width: 599px) {
    .uikit-benefits { grid-template-columns: 1fr; }
    .uikit-benefits--ruled { gap: 0; }
    .uikit-benefits--ruled .uikit-benefits__item { padding: 28px 0; gap: 16px; }
  }
</style>

{% schema %}
{
  "name": "UI kit — benefits",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Know exactly what's in the seafood you serve." },
    { "type": "textarea", "id": "text", "label": "Intro" },
    {
      "type": "select", "id": "heading_position", "label": "Heading position", "default": "below",
      "options": [ { "value": "above", "label": "Above badges" }, { "value": "below", "label": "Below badges" } ]
    },
    { "type": "checkbox", "id": "ruled", "label": "Rule above each badge", "default": false }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon image" },
        {
          "type": "select", "id": "icon_name", "label": "Built-in icon", "info": "Used when no icon image is set.", "default": "none",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "fish", "label": "Fish" },
            { "value": "mercury", "label": "Mercury (Hg)" },
            { "value": "microplastics", "label": "Microplastics" },
            { "value": "waves", "label": "Waves" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Low mercury" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Our limit is 0.1 ppm methylmercury — a tenth of the FDA action level." }
      ]
    }
  ],
  "presets": [
    {
      "name": "UI kit — benefits",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Low mercury", "text": "Our limit is 0.1 ppm methylmercury — a tenth of the FDA action level." } },
        { "type": "benefit", "settings": { "title": "Zero microplastics detected", "text": "Tested for microplastics down to 1 micron. Zero detected in third-party testing." } },
        { "type": "benefit", "settings": { "title": "Nutrient dense", "text": "We test and publish omega-3, protein, selenium, vitamin D and B12." } },
        { "type": "benefit", "settings": { "title": "Farms named", "text": "Farms named, panels published. Scan the QR on the box and the farm page opens." } }
      ]
    }
  ]
}
{% endschema %}
