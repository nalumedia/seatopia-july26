{%- comment -%}
  Article — Editorial
  ============================================================================
  A simplified, reading-first article layout for long-form editorial posts
  (as opposed to sections/main-article-overlay.liquid, which carries the
  RecipeKit branch and the theme's default `rte` typography).

  The post body still comes from `article.content`, so the copy stays editable
  in Shopify Admin exactly as before — this section only controls the frame and
  the typography around it. Nothing here hardcodes article copy.

  DESIGN NOTES
    - One reading measure (--artx-measure) governs the body. Images, pull
      quotes and the stat strip deliberately break out wider than it.
    - Type scale is fluid via clamp(), so there is no mobile breakpoint for it.
    - Colors are the Seatopia brand set, exposed as settings so the section can
      be reused on other posts without a code change.

  GOTCHA: theme.css carries a sitewide `div:empty { display: none }` reset, so
  every decorative element here is a <span> with content or a ::before on a
  parent that has children. An empty decorative <div> silently never paints and
  looks correct in a standalone render — only the live storefront catches it.
{%- endcomment -%}

{%- liquid
  assign a = article

  # Reading time. 220 wpm is the usual editorial average; +1 so a short post
  # never reads "0 min".
  assign word_count = a.content | strip_html | split: ' ' | size
  assign read_time = word_count | divided_by: 220 | plus: 1

  assign hero_alt = a.image.alt | default: a.title

  assign accent = section.settings.color_accent | default: '#bb8f50'
  assign deep = section.settings.color_deep | default: '#335566'
  assign measure = section.settings.measure | default: 68
-%}

<style>
  #shopify-section-{{ section.id }} {
    --artx-ink: #171717;
    --artx-deep: {{ deep }};
    --artx-gold: {{ accent }};
    --artx-cream: #f7efe6;
    --artx-measure: {{ measure }}ch;
    --artx-muted: #6b6b6b;
  }

  .artx { color: var(--artx-ink); }
  .artx *, .artx *:before, .artx *:after { box-sizing: border-box; }

  /* ------------------------------------------------------------------ hero */
  .artx__hero { position: relative; isolation: isolate; }
  .artx__hero-media { position: relative; overflow: hidden; }
  .artx__hero-media img {
    display: block; width: 100%; height: 100%; object-fit: cover;
  }
  .artx__hero--tall .artx__hero-media { height: clamp(340px, 62vh, 620px); }
  .artx__hero--short .artx__hero-media { height: clamp(260px, 42vh, 420px); }
  .artx__scrim {
    position: absolute; inset: 0; display: block;
    background: linear-gradient(to bottom, rgba(0,0,0,.14) 0%, rgba(0,0,0,.30) 45%, rgba(0,0,0,.72) 100%);
  }
  .artx__hero-inner {
    position: absolute; inset: auto 0 0 0;
    padding: 0 0 clamp(28px, 4vw, 56px);
  }
  .artx__hero-copy { max-width: 22ch; }
  .artx__eyebrow {
    display: inline-flex; align-items: center; gap: 9px;
    margin: 0 0 14px;
    font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase;
    color: var(--artx-gold);
  }
  .artx__eyebrow:before {
    content: ""; flex: 0 0 auto;
    width: 7px; height: 7px; border-radius: 50%; background: var(--artx-gold);
  }
  .artx__title {
    margin: 0; color: #fff;
    font-size: clamp(32px, 5.2vw, 62px); line-height: 1.03;
    font-weight: 600; letter-spacing: -0.02em; text-wrap: balance;
  }
  .artx__meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px;
    margin: 18px 0 0; padding: 0; list-style: none;
    font-size: 13px; color: rgba(255,255,255,.86);
  }
  .artx__meta li { display: inline-flex; align-items: center; gap: 14px; }
  .artx__meta li + li:before {
    content: ""; width: 3px; height: 3px; border-radius: 50%;
    background: rgba(255,255,255,.55);
  }
  .artx__meta strong { font-weight: 600; color: #fff; }

  /* hero fallback when the post has no featured image */
  .artx__hero--plain {
    background: var(--artx-deep);
    padding: clamp(56px, 8vw, 104px) 0 clamp(32px, 4vw, 56px);
  }

  /* ----------------------------------------------------------- stat strip */
  .artx__stats {
    display: grid; gap: 1px;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    margin: 0; padding: 0; list-style: none;
    background: rgba(23,23,23,.10);
    border: 1px solid rgba(23,23,23,.10);
    border-radius: 14px; overflow: hidden;
  }
  .artx__stat { background: var(--artx-cream); padding: 22px 20px; }
  .artx__stat-value {
    display: block; font-size: clamp(26px, 3.2vw, 38px); line-height: 1;
    font-weight: 600; letter-spacing: -0.01em; color: var(--artx-deep);
  }
  .artx__stat-label {
    display: block; margin-top: 8px;
    font-size: 13px; line-height: 1.45; color: var(--artx-muted);
  }

  /* ------------------------------------------------------------------ body */
  .artx__body {
    max-width: var(--artx-measure);
    margin-inline: auto;
    font-size: clamp(17px, 1.25vw, 19px);
    line-height: 1.78;
    color: #2a2a2a;
  }
  .artx__body > :first-child { margin-top: 0; }
  .artx__body > :last-child { margin-bottom: 0; }
  .artx__body p { margin: 0 0 1.35em; }

  /* Shopify article bodies often open with their own <h1>. Here it is a deck
     line with its own copy, NOT a repeat of the title, so it is styled rather
     than hidden — hiding it would silently drop a sentence of the article.
     (It does leave two <h1>s in the DOM; demote it to <h2> in Shopify Admin if
     that matters for a given post.) */
  .artx__body > h1 {
    margin: 0 0 .7em;
    font-size: clamp(22px, 2.4vw, 30px); line-height: 1.2;
    font-weight: 600; letter-spacing: -0.01em; color: var(--artx-deep);
  }

  /* Lede: the opening paragraph, whether or not a deck precedes it. */
  .artx__body > h1 + p,
  .artx__body > p:first-child {
    font-size: 1.12em; line-height: 1.68; color: #1f1f1f;
  }

  .artx__body h2 {
    margin: 2.2em 0 .7em;
    font-size: clamp(23px, 2.5vw, 31px); line-height: 1.18;
    font-weight: 600; letter-spacing: -0.01em; color: var(--artx-deep);
    text-wrap: balance;
  }
  .artx__body h2:before {
    content: ""; display: block;
    width: 34px; height: 2px; margin-bottom: .55em;
    background: var(--artx-gold);
  }
  .artx__body h3, .artx__body h4 {
    margin: 1.8em 0 .5em;
    font-size: clamp(18px, 1.6vw, 21px); line-height: 1.3;
    font-weight: 600; color: var(--artx-deep);
  }

  .artx__body a {
    color: var(--artx-deep);
    text-decoration: underline;
    text-decoration-color: var(--artx-gold);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    transition: color .16s ease;
  }
  .artx__body a:hover { color: var(--artx-gold); }

  .artx__body ul, .artx__body ol { margin: 0 0 1.35em; padding-left: 0; }
  .artx__body ul { list-style: none; }
  .artx__body ul > li { position: relative; padding-left: 1.6em; margin-bottom: .7em; }
  .artx__body ul > li:before {
    content: ""; position: absolute; left: 0; top: .62em;
    width: 7px; height: 7px; border-radius: 50%; background: var(--artx-gold);
  }
  .artx__body ol { padding-left: 1.4em; }
  .artx__body ol > li { margin-bottom: .7em; padding-left: .3em; }
  .artx__body ol > li::marker { color: var(--artx-gold); font-weight: 600; }
  /* The source HTML wraps each <li> in a <p>; collapse that spacing. */
  .artx__body li > p { margin: 0; }
  .artx__body li > p + p { margin-top: .5em; }

  .artx__body blockquote {
    margin: 2em 0; padding: 0 0 0 1.2em;
    border-left: 3px solid var(--artx-gold);
    font-size: 1.1em; line-height: 1.6; font-style: italic; color: var(--artx-deep);
  }

  /* Bare images break out past the reading measure. Images inside a <figure>
     do NOT — a figure is usually a sized diagram with a caption, and the
     negative margin would knock it out of alignment with its own caption. */
  .artx__body img {
    display: block; width: 100%; height: auto;
    margin: 2em 0; border-radius: 14px;
  }
  @media (min-width: 990px) {
    .artx__body > img,
    .artx__body > p > img {
      width: calc(100% + 9rem); max-width: none;
      margin-left: -4.5rem;
    }
  }
  .artx__body figure { margin: 2.2em 0; }
  .artx__body figure img { margin: 0 auto; }
  .artx__body figcaption {
    margin-top: .8em; font-size: .86em; line-height: 1.5;
    color: var(--artx-muted); text-align: center;
  }
  .artx__body hr {
    margin: 2.4em 0; border: 0; height: 1px; background: rgba(23,23,23,.14);
  }

  /* --------------------------------------------------------------- share */
  .artx__share {
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px;
    max-width: var(--artx-measure); margin: 3em auto 0;
    padding-top: 1.6em; border-top: 1px solid rgba(23,23,23,.14);
  }
  .artx__share-label {
    font-size: 12px; font-weight: 700; letter-spacing: .14em;
    text-transform: uppercase; color: var(--artx-muted);
  }
  .artx__share a {
    display: inline-flex; align-items: center;
    padding: 7px 15px; border-radius: 999px;
    border: 1px solid rgba(23,23,23,.18);
    font-size: 13px; font-weight: 600; text-decoration: none; color: var(--artx-ink);
    transition: border-color .16s ease, color .16s ease;
  }
  .artx__share a:hover { border-color: var(--artx-gold); color: var(--artx-gold); }

  /* ----------------------------------------------------------------- cta */
  .artx__cta {
    background: var(--artx-deep); color: #fff;
    border-radius: 18px;
    padding: clamp(32px, 4.5vw, 56px) clamp(24px, 4vw, 56px);
    text-align: center;
  }
  .artx__cta-title {
    margin: 0 0 12px; color: #fff;
    font-size: clamp(24px, 3vw, 36px); line-height: 1.12; font-weight: 600;
    letter-spacing: -0.01em; text-wrap: balance;
  }
  .artx__cta-text {
    margin: 0 auto; max-width: 58ch;
    font-size: clamp(15px, 1.2vw, 17px); line-height: 1.6; color: rgba(255,255,255,.84);
  }
  .artx__cta-btn {
    display: inline-flex; align-items: center; gap: 9px;
    margin-top: 26px; padding: 15px 32px; border-radius: 999px;
    background: #fff; color: var(--artx-ink);
    font-size: 16px; font-weight: 600; text-decoration: none;
    transition: transform .16s ease, box-shadow .16s ease;
  }
  .artx__cta-btn:hover {
    transform: translateY(-1px); color: var(--artx-ink);
    box-shadow: 0 12px 28px -14px rgba(0,0,0,.6);
  }

  .artx__block { margin-top: clamp(38px, 5vw, 64px); }
</style>

<div class="artx" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">

  {%- comment -%} ------------------------------------------------- hero {%- endcomment -%}
  {%- if section.settings.show_hero and a.image != blank -%}
    <header class="artx__hero {% if section.settings.hero_height == 'short' %}artx__hero--short{% else %}artx__hero--tall{% endif %}">
      <div class="artx__hero-media">
        {{ a.image | image_url: width: 2400 | image_tag:
             widths: '600,900,1200,1600,2000,2400',
             sizes: '100vw',
             loading: 'eager',
             fetchpriority: 'high',
             alt: hero_alt }}
        <span class="artx__scrim"></span>
      </div>
      <div class="artx__hero-inner">
        <div class="page-width">
          <div class="artx__hero-copy">
            {%- if section.settings.eyebrow != blank or a.tags.size > 0 -%}
              <p class="artx__eyebrow">{{ section.settings.eyebrow | default: a.tags.first }}</p>
            {%- endif -%}
            <h1 class="artx__title heading">{{ a.title }}</h1>
            <ul class="artx__meta">
              {%- if section.settings.show_author and a.author != blank -%}
                <li>By <strong>{{ a.author }}</strong></li>
              {%- endif -%}
              {%- if section.settings.show_date -%}
                <li><time datetime="{{ a.published_at | date: '%Y-%m-%d' }}">{{ a.published_at | date: format: 'month_day_year' }}</time></li>
              {%- endif -%}
              {%- if section.settings.show_reading_time -%}
                <li>{{ read_time }} min read</li>
              {%- endif -%}
            </ul>
          </div>
        </div>
      </div>
    </header>
  {%- else -%}
    <header class="artx__hero artx__hero--plain">
      <div class="page-width">
        <div class="artx__hero-copy">
          {%- if section.settings.eyebrow != blank or a.tags.size > 0 -%}
            <p class="artx__eyebrow">{{ section.settings.eyebrow | default: a.tags.first }}</p>
          {%- endif -%}
          <h1 class="artx__title heading">{{ a.title }}</h1>
          <ul class="artx__meta">
            {%- if section.settings.show_author and a.author != blank -%}
              <li>By <strong>{{ a.author }}</strong></li>
            {%- endif -%}
            {%- if section.settings.show_date -%}
              <li><time datetime="{{ a.published_at | date: '%Y-%m-%d' }}">{{ a.published_at | date: format: 'month_day_year' }}</time></li>
            {%- endif -%}
            {%- if section.settings.show_reading_time -%}
              <li>{{ read_time }} min read</li>
            {%- endif -%}
          </ul>
        </div>
      </div>
    </header>
  {%- endif -%}

  <article class="page-width" itemscope itemtype="http://schema.org/BlogPosting">
    <meta itemprop="headline" content="{{ a.title | escape }}">
    {%- if a.image != blank -%}<meta itemprop="image" content="{{ a.image | image_url: width: 1200 }}">{%- endif -%}
    <meta itemprop="datePublished" content="{{ a.published_at | date: '%Y-%m-%d' }}">
    {%- if a.author != blank -%}<meta itemprop="author" content="{{ a.author | escape }}">{%- endif -%}

    {%- comment -%} ------------------------------------------- stat strip {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="artx__stats artx__block">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stat' -%}
            <li class="artx__stat" {{ block.shopify_attributes }}>
              <span class="artx__stat-value">{{ block.settings.value }}</span>
              <span class="artx__stat-label">{{ block.settings.label }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="artx__body artx__block" itemprop="articleBody">
      {{- a.content -}}
    </div>

    {%- if section.settings.show_share -%}
      <div class="artx__share">
        <span class="artx__share-label">Share</span>
        <a href="https://www.facebook.com/sharer.php?u={{ shop.url }}{{ a.url }}" target="_blank" rel="noopener">Facebook</a>
        <a href="https://x.com/intent/post?text={{ a.title | url_encode }}&amp;url={{ shop.url }}{{ a.url }}" target="_blank" rel="noopener">X</a>
        <a href="https://pinterest.com/pin/create/button/?url={{ shop.url }}{{ a.url }}{% if a.image %}&amp;media={{ a.image | image_url: width: 1200 }}{% endif %}&amp;description={{ a.title | url_encode }}" target="_blank" rel="noopener">Pinterest</a>
        <a href="mailto:?subject={{ a.title | url_encode }}&amp;body={{ shop.url }}{{ a.url }}">Email</a>
      </div>
    {%- endif -%}

    {%- if section.settings.cta_heading != blank -%}
      <aside class="artx__cta artx__block">
        <p class="artx__cta-title heading">{{ section.settings.cta_heading }}</p>
        {%- if section.settings.cta_text != blank -%}
          <p class="artx__cta-text">{{ section.settings.cta_text }}</p>
        {%- endif -%}
        {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
          <a class="artx__cta-btn" href="{{ section.settings.cta_link }}">
            <span>{{ section.settings.cta_label }}</span>
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>
            </svg>
          </a>
        {%- endif -%}
      </aside>
    {%- endif -%}
  </article>
</div>

{% schema %}
{
  "name": "Article — Editorial",
  "tag": "section",
  "class": "section-article-editorial",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "checkbox", "id": "show_hero", "label": "Show featured image hero", "default": true },
    {
      "type": "select",
      "id": "hero_height",
      "label": "Hero height",
      "options": [
        { "value": "tall", "label": "Tall" },
        { "value": "short", "label": "Short" }
      ],
      "default": "tall"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Defaults to the article's first tag." },
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": true },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "checkbox", "id": "show_reading_time", "label": "Show reading time", "default": true },

    { "type": "header", "content": "Body" },
    {
      "type": "range",
      "id": "measure",
      "label": "Reading width",
      "info": "Characters per line. 60-70 reads most comfortably.",
      "min": 50, "max": 90, "step": 2, "unit": "ch", "default": 68
    },
    { "type": "checkbox", "id": "show_share", "label": "Show share links", "default": true },

    { "type": "header", "content": "Closing call to action" },
    { "type": "text", "id": "cta_heading", "label": "Heading" },
    { "type": "textarea", "id": "cta_text", "label": "Text" },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "url", "id": "cta_link", "label": "Button link" },

    { "type": "header", "content": "Color" },
    { "type": "color", "id": "color_deep", "label": "Deep", "default": "#335566" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#bb8f50" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "43%" },
        { "type": "text", "id": "label", "label": "Label", "default": "Less household food waste when cooking from frozen" }
      ]
    }
  ],
  "presets": [
    { "name": "Article — Editorial" }
  ]
}
{% endschema %}
