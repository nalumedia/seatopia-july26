{%- comment -%}
  ============================================================================
  Curated Boxes Funnel
  ============================================================================
  Three-step wizard (Seafood -> Size -> Checkout) over ONE Shopify product with
  two options: Style x Size = 9 variants. Visual reference:
  https://seatopiastandard.com/curated-boxes (the standalone React build).

  DESIGN: runs on the Seatopia UI kit (assets/uikit.css + snippets/uikit-fonts)
  exactly like the Hyman and Eudēmonia pages: kit buttons (.uikit-btn), kit type
  classes, gold accent, white cards on the kit surface with the kit rule and
  radius. The .cbf-* rules in the stylesheet block at the end are layout only;
  every colour, radius and font comes from a --uk-* token or a value the
  uikit-* sections already use (gold text #8a6430, error #a23b2a). There is no
  accent setting: the kit's gold is the accent.

  DATA THIS SECTION READS (and degrades gracefully without):
    variant.metafields.custom.box_components  JSON: [{sku,name,quantity}, ...]
    shop.metafields.custom.omega_by_sku       JSON: {SKU: {epaDhaMg, servingOz, name}}
  When absent, the "What's inside" and "Omega-3" blocks are omitted entirely -
  never estimated. Omega figures are shown as published test results with the
  variance note the claims guide requires (brand/claims-guide.md §8.8). The
  2,000 mg/day "days of omega-3" figure from the reference is deliberately not
  rendered: it is unsourced and AMBER in the guide (§8.12).
{%- endcomment -%}

{%- liquid
  assign product = all_products[section.settings.product]
  assign style_option = null
  assign size_option = null

  for opt in product.options_with_values
    if opt.name == section.settings.style_option_name
      assign style_option = opt
    endif
    if opt.name == section.settings.size_option_name
      assign size_option = opt
    endif
  endfor

  assign omega_mf = shop.metafields.custom.omega_by_sku
  assign entry = false
  if section.settings.mode == 'entry'
    assign entry = true
  endif
  assign funnel_url = section.settings.funnel_url | default: '/pages/curated-boxes'
-%}

{%- liquid
  assign skip_entry = false
  if entry
    assign here = request.path | split: '?' | first
    if here == funnel_url
      assign skip_entry = true
    endif
    if section.settings.hide_on_articles and request.page_type == 'article'
      assign skip_entry = true
    endif
  endif
-%}
{%- if skip_entry -%}
  {%- comment -%} entry module on the funnel page itself: the full funnel is already here {%- endcomment -%}
{%- elsif product == blank or style_option == blank or size_option == blank -%}
  {%- if request.design_mode -%}
    <div class="section section--padding">
      <div class="page-width">
        <p class="rte">
          <strong>Curated Boxes Funnel:</strong>
          {% if product == blank %}
            select a product in this section's settings.
          {% else %}
            this product needs options named
            &ldquo;{{ section.settings.style_option_name }}&rdquo; and
            &ldquo;{{ section.settings.size_option_name }}&rdquo;. It currently has:
            {% for o in product.options_with_values %}&ldquo;{{ o.name }}&rdquo;{% unless forloop.last %}, {% endunless %}{% endfor %}.
          {% endif %}
        </p>
      </div>
    </div>
  {%- endif -%}
{%- else -%}

  {%- render 'uikit-fonts' -%}
  {{ 'uikit.css' | asset_url | stylesheet_tag }}

  {%- comment -%} ---- variant data for the client, built once ---- {%- endcomment -%}
  {%- capture variant_json -%}
    [
    {%- assign style_idx = style_option.position | minus: 1 -%}
    {%- assign size_idx = size_option.position | minus: 1 -%}
    {%- for v in product.variants -%}
      {%- liquid
        assign v_style = v.options[style_idx]
        assign v_size = v.options[size_idx]
        assign v_img = v.image | default: product.featured_image
        assign v_portions = v_size | split: ' ' | first | plus: 0
        assign v_per = ''
        if v_portions > 0
          assign v_per = v.price | times: 1.0 | divided_by: v_portions | round | money
        endif
      -%}
      {
        "id": {{ v.id }},
        "style": {{ v_style | json }},
        "size": {{ v_size | json }},
        "sku": {{ v.sku | json }},
        "price": {{ v.price }},
        "priceText": {{ v.price | money | json }},
        "priceShort": {{ v.price | money_without_trailing_zeros | json }},
        "portions": {{ v_portions }},
        "perServing": {{ v_per | json }},
        "available": {{ v.available }},
        "image": {{ v_img | image_url: width: 900 | json }},
        "components": {{ v.metafields.custom.box_components.value | json }},
        "plans": [
          {%- for alloc in v.selling_plan_allocations -%}
            {%- liquid
              assign a_per = ''
              if v_portions > 0
                assign a_per = alloc.price | times: 1.0 | divided_by: v_portions | round | money
              endif
            -%}
            {
              "id": {{ alloc.selling_plan.id }},
              "name": {{ alloc.selling_plan.name | json }},
              "price": {{ alloc.price }},
              "priceText": {{ alloc.price | money | json }},
              "perServing": {{ a_per | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
    ]
  {%- endcapture -%}

  {%- capture icon_fish -%}
    <svg class="cbf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6.5 12c2.5-4 6-6 11.5-6 0 0-1 2.5-1 6s1 6 1 6c-5.5 0-9-2-11.5-6Z"/><path d="M6.5 12 2 8.5v7L6.5 12Z"/><path d="M14 10.5h.01"/></svg>
  {%- endcapture -%}
  {%- capture icon_check -%}
    <svg class="cbf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
  {%- endcapture -%}
  {%- capture icon_star -%}
    <svg class="cbf-star" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"/></svg>
  {%- endcapture -%}

  <section class="section uikit uikit-section uikit-section--tight cbf-section" id="CuratedFunnel-{{ section.id }}">
    <div class="uikit-container cbf-container"{% unless entry %} id="curated-funnel"{% endunless %}>
      <curated-funnel
        class="cbf{% if entry %} cbf--entry{% endif %}"
        data-entry="{{ entry }}"
        data-funnel-url="{{ funnel_url | escape }}"
        data-style-name="{{ section.settings.style_option_name | escape }}"
        data-size-name="{{ section.settings.size_option_name | escape }}"
        data-sub-label="{{ section.settings.submit_sub_label | default: 'Subscribe' | escape }}"
        data-once-label="{{ section.settings.submit_once_label | default: 'Checkout' | escape }}"
        data-require-email="{% if section.settings.email_label != blank %}true{% else %}false{% endif %}"
      >
        <script type="application/json" data-cbf-variants>{{ variant_json }}</script>
        {%- if omega_mf != blank -%}
          <script type="application/json" data-cbf-omega>{{ omega_mf.value | json }}</script>
        {%- endif -%}

        {%- comment -%} ---------- phone pill ---------- {%- endcomment -%}
        {%- if section.settings.phone != blank and entry == false -%}
          {%- assign tel = section.settings.phone | remove: '(' | remove: ')' | remove: ' ' | remove: '-' | remove: '.' -%}
          <p class="cbf-phone uikit-body-s uikit-muted">
            {{ section.settings.phone_label | escape }}
            <a class="uikit-link" href="tel:{{ tel }}">{{ section.settings.phone | escape }}</a>
          </p>
        {%- endif -%}

        {%- comment -%} ---------- progress (full mode only) ---------- {%- endcomment -%}
        {%- unless entry -%}
        <ol class="cbf-progress" aria-label="Progress">
          {%- assign step_labels = section.settings.step_labels | default: 'Seafood,Size,Checkout' | split: ',' -%}
          {%- for label in step_labels -%}
            <li class="cbf-progress__item{% if forloop.first %} is-active{% endif %}" data-cbf-progress="{{ forloop.index }}">
              <button
                type="button"
                class="cbf-progress__btn"
                data-cbf-goto="{{ forloop.index }}"
                aria-current="{% if forloop.first %}step{% else %}false{% endif %}"
              >
                <span class="cbf-progress__num">
                  <span class="cbf-progress__digit">{{ forloop.index }}</span>
                  <span class="cbf-progress__check">{{ icon_check }}</span>
                </span>
                <span class="cbf-progress__label uikit-label-s">{{ label | strip | escape }}</span>
              </button>
            </li>
            {%- unless forloop.last -%}
              <li class="cbf-progress__rule" aria-hidden="true"></li>
            {%- endunless -%}
          {%- endfor -%}
        </ol>
        {%- endunless -%}

        <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" data-cbf-form novalidate>
          <input type="hidden" name="id" value="" data-cbf-variant-id>
          <input type="hidden" name="selling_plan" value="" data-cbf-selling-plan>
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="properties[_funnel]" value="curated-boxes">

          {%- comment -%} ================= STEP 1 : STYLE ================= {%- endcomment -%}
          <div class="cbf-step" data-cbf-step="1">
            <div class="cbf-head">
              <h2 class="cbf-h uikit-h2">{{ section.settings.step1_heading | escape }}</h2>
              {%- if section.settings.step1_subheading != blank -%}
                <div class="cbf-sub uikit-body-m uikit-muted">{{ section.settings.step1_subheading }}</div>
              {%- endif -%}
            </div>

            <fieldset class="cbf-fieldset">
              <legend class="visually-hidden">{{ section.settings.step1_heading | escape }}</legend>
              <div class="cbf-grid">
                {%- for value in style_option.values -%}
                  {%- liquid
                    assign vstr = value | downcase
                    assign img = null
                    assign blurb = ''
                    for block in section.blocks
                      if block.type == 'style'
                        assign bname = block.settings.style_value | downcase | strip
                        if bname == vstr
                          assign img = block.settings.image
                          assign blurb = block.settings.description
                        endif
                      endif
                    endfor

                    assign s_idx = style_option.position | minus: 1
                    assign z_idx = size_option.position | minus: 1
                    assign lowest = nil
                    assign lowest_per = nil
                    for v in product.variants
                      if v.options[s_idx] == value
                        if lowest == nil or v.price < lowest
                          assign lowest = v.price
                        endif
                        assign vp = v.options[z_idx] | split: ' ' | first | plus: 0
                        if vp > 0
                          assign per = v.price | times: 1.0 | divided_by: vp | round
                          if lowest_per == nil or per < lowest_per
                            assign lowest_per = per
                          endif
                        endif
                      endif
                    endfor
                  -%}
                  <label class="cbf-opt">
                    <input
                      type="radio"
                      class="visually-hidden"
                      name="cbf-style"
                      value="{{ value | escape }}"
                      data-cbf-style
                    >
                    <span class="cbf-card cbf-card--style">
                      <span class="cbf-card__media">
                        {%- if img != blank -%}
                          {{ img | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 400px, 100vw', widths: '400,600,800,1000', alt: value }}
                        {%- elsif product.featured_image -%}
                          {{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 400px, 100vw', widths: '400,600,800,1000', alt: value }}
                        {%- endif -%}
                      </span>
                      <span class="cbf-card__body">
                        <span class="cbf-card__row">
                          <span class="cbf-card__title uikit-label-l">{{ value | escape }}</span>
                          <span class="cbf-radio" aria-hidden="true">{{ icon_check }}</span>
                        </span>
                        {%- if blurb != blank -%}
                          <span class="cbf-card__text uikit-body-s uikit-muted">{{ blurb }}</span>
                        {%- endif -%}
                        {%- if lowest != nil -%}
                          <span class="cbf-card__price uikit-body-s uikit-muted">From <strong>{{ lowest | money_without_trailing_zeros }}</strong>{% if lowest_per != nil %} <span class="cbf-per">· from {{ lowest_per | money }}/serving</span>{% endif %}</span>
                        {%- endif -%}
                        <span class="cbf-card__omega uikit-body-s" data-cbf-style-omega="{{ value | escape }}" hidden>
                          {{ icon_fish }}<span data-cbf-style-omega-text></span>
                        </span>
                      </span>
                    </span>
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>

            <div class="cbf-actions cbf-actions--end">
              <button type="button" class="uikit-btn uikit-btn--primary" data-cbf-next="2" data-cbf-needs="style" disabled>
                {{ section.settings.continue_label | escape }}
              </button>
            </div>

            {%- if section.settings.omega_footnote != blank -%}
              <div class="cbf-note uikit-body-s uikit-muted" data-cbf-omega-note hidden>{{ section.settings.omega_footnote }}</div>
            {%- endif -%}
          </div>

          {%- unless entry -%}
          {%- comment -%} ================= STEP 2 : SIZE ================= {%- endcomment -%}
          <div class="cbf-step" data-cbf-step="2" hidden>
            <div class="cbf-head">
              <h2 class="cbf-h uikit-h2">{{ section.settings.step2_heading | escape }}</h2>
              {%- if section.settings.step2_subheading != blank -%}
                <div class="cbf-sub uikit-body-m uikit-muted">{{ section.settings.step2_subheading }}</div>
              {%- endif -%}
              <button type="button" class="cbf-chosen" data-cbf-next="1" data-cbf-chosen hidden aria-label="Change your box">
                <span class="cbf-chosen__media"><img src="" alt="" width="32" height="32" loading="lazy" data-cbf-chosen-image></span>
                <span class="uikit-label-s">{{ section.settings.chosen_label | default: 'Your box' | escape }}: <span data-cbf-chosen-title></span></span>
                <span class="cbf-chosen__change uikit-body-s">{{ section.settings.chosen_change_label | default: 'Change' | escape }}</span>
              </button>
            </div>

            <fieldset class="cbf-fieldset">
              <legend class="visually-hidden">{{ section.settings.step2_heading | escape }}</legend>
              <div class="cbf-grid">
                {%- for value in size_option.values -%}
                  {%- liquid
                    assign vstr = value | downcase
                    assign tagline = ''
                    assign detail = ''
                    assign badge = ''
                    for block in section.blocks
                      if block.type == 'size'
                        assign bname = block.settings.size_value | downcase | strip
                        if bname == vstr
                          assign tagline = block.settings.tagline
                          assign detail = block.settings.description
                          assign badge = block.settings.badge
                        endif
                      endif
                    endfor
                    assign portions = value | split: ' ' | first
                  -%}
                  <label class="cbf-opt">
                    <input
                      type="radio"
                      class="visually-hidden"
                      name="cbf-size"
                      value="{{ value | escape }}"
                      data-cbf-size
                    >
                    <span class="cbf-card cbf-card--size">
                      {%- if badge != blank -%}
                        <span class="cbf-badge uikit-label-s">{{ badge | escape }}</span>
                      {%- endif -%}
                      <span class="cbf-card__body cbf-card__body--center">
                        <span class="cbf-size__lead">
                          <span class="cbf-portions">{{ portions }}</span>
                          <span class="cbf-portions__label uikit-body-s uikit-muted">Portions</span>
                        </span>
                        {%- if tagline != blank -%}<span class="cbf-eyebrow uikit-label-s">{{ tagline | escape }}</span>{%- endif -%}
                        {%- if detail != blank -%}<span class="cbf-card__text uikit-body-s uikit-muted">{{ detail }}</span>{%- endif -%}
                        <span class="cbf-card__price uikit-body-m uikit-muted" data-cbf-size-price="{{ value | escape }}"></span>
                        <span class="cbf-card__omega cbf-card__omega--stack" data-cbf-size-omega="{{ value | escape }}" hidden>
                          <span class="cbf-card__omega-big" data-cbf-size-omega-big></span>
                          <span class="uikit-body-s uikit-muted" data-cbf-size-omega-sub></span>
                        </span>
                      </span>
                    </span>
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>

            <div class="cbf-actions">
              <button type="button" class="uikit-btn uikit-btn--secondary" data-cbf-next="1">
                {{ section.settings.back_label | escape }}
              </button>
              <button type="button" class="uikit-btn uikit-btn--primary" data-cbf-next="3" data-cbf-needs="size" disabled>
                {{ section.settings.continue_label | escape }}
              </button>
            </div>

            {%- if section.settings.omega_footnote != blank -%}
              <div class="cbf-note uikit-body-s uikit-muted" data-cbf-omega-note hidden>{{ section.settings.omega_footnote }}</div>
            {%- endif -%}
          </div>

          {%- comment -%} ================= STEP 3 : REVIEW ================= {%- endcomment -%}
          <div class="cbf-step cbf-step--narrow" data-cbf-step="3" hidden>
            <div class="cbf-head">
              <h2 class="cbf-h uikit-h2">{{ section.settings.step3_heading | escape }}</h2>
              {%- if section.settings.step3_subheading != blank -%}
                <div class="cbf-sub uikit-body-m uikit-muted">{{ section.settings.step3_subheading }}</div>
              {%- endif -%}
            </div>

            {%- comment -%} a) summary {%- endcomment -%}
            <div class="cbf-summary">
              {%- assign summary_img = product.selected_or_first_available_variant.image | default: product.featured_image -%}
              <span class="cbf-summary__media">
                {%- if summary_img != blank -%}
                  <img
                    src="{{ summary_img | image_url: width: 600 }}"
                    alt="{{ product.title | escape }}"
                    width="{{ summary_img.width }}"
                    height="{{ summary_img.height }}"
                    loading="lazy"
                    data-cbf-summary-image
                  >
                {%- endif -%}
              </span>
              <div class="cbf-summary__body">
                <div class="cbf-card__row">
                  <span class="cbf-summary__title uikit-label-l" data-cbf-summary-title></span>
                  <span class="cbf-eyebrow uikit-label-s" data-cbf-summary-size></span>
                </div>
                {%- if section.settings.ship_copy != blank -%}
                  <div class="uikit-body-s uikit-muted">{{ section.settings.ship_copy }}</div>
                {%- endif -%}
                <div class="cbf-card__row cbf-summary__foot">
                  <span class="cbf-summary__price">
                    <span data-cbf-summary-price></span>
                    <s class="uikit-body-s uikit-muted" data-cbf-summary-compare hidden></s>
                    <span class="cbf-per uikit-body-s uikit-muted" data-cbf-summary-per></span>
                  </span>
                  {%- assign rating_count = product.metafields.reviews.rating_count.value | default: 0 -%}
                  {%- if rating_count > 0 -%}
                    {%- assign rating_val = product.metafields.reviews.rating.value.rating | default: 5 | round -%}
                    <span class="cbf-rating" aria-label="Rated {{ product.metafields.reviews.rating.value.rating }} out of 5">
                      <span class="cbf-rating__stars" aria-hidden="true">
                        {%- for i in (1..5) -%}
                          <span class="cbf-rating__star{% if i > rating_val %} is-off{% endif %}">{{ icon_star }}</span>
                        {%- endfor -%}
                      </span>
                      <span class="uikit-body-s uikit-muted">{{ rating_count }} reviews</span>
                    </span>
                  {%- endif -%}
                </div>
              </div>
            </div>

            <div class="cbf-panels">
            {%- comment -%} b) contents - only when the metafield exists {%- endcomment -%}
            <div class="cbf-panel" data-cbf-contents hidden>
              <h3 class="cbf-panel__title uikit-label-m">{{ icon_fish }}{{ section.settings.contents_heading | escape }}</h3>
              <ul class="cbf-list" data-cbf-contents-list></ul>
              {%- if section.settings.contents_disclaimer != blank -%}
                <div class="cbf-note cbf-note--tight uikit-body-s uikit-muted">{{ section.settings.contents_disclaimer }}</div>
              {%- endif -%}
            </div>

            {%- comment -%} c) omega - only when lab data exists {%- endcomment -%}
            <div class="cbf-panel" data-cbf-omega-block hidden>
              <h3 class="cbf-panel__title uikit-label-m">{{ icon_fish }}{{ section.settings.omega_heading | escape }}</h3>
              <div class="cbf-stats">
                <div class="cbf-stat">
                  <span class="cbf-stat__num" data-cbf-omega-total></span>
                  <span class="uikit-body-s uikit-muted">EPA+DHA</span>
                </div>
                <div class="cbf-stat">
                  <span class="cbf-stat__num" data-cbf-omega-servings></span>
                  <span class="uikit-body-s uikit-muted">lab-tested servings</span>
                </div>
                <div class="cbf-stat">
                  <span class="cbf-stat__num" data-cbf-omega-portions></span>
                  <span class="uikit-body-s uikit-muted">portions in this box</span>
                </div>
              </div>
              {%- if section.settings.omega_disclaimer != blank -%}
                <div class="cbf-note cbf-note--tight uikit-body-s uikit-muted">{{ section.settings.omega_disclaimer }}</div>
              {%- endif -%}
              <div class="cbf-note cbf-note--tight uikit-body-s uikit-muted" data-cbf-omega-partial hidden>{{ section.settings.omega_partial_note }}</div>
            </div>
            </div>

            {%- comment -%} d) purchase type {%- endcomment -%}
            {%- if product.selling_plan_groups.size > 0 -%}
              <fieldset class="cbf-fieldset cbf-purchase">
                <legend class="visually-hidden">{{ section.settings.purchase_heading | escape }}</legend>

                <label class="cbf-opt cbf-opt--row">
                  <input type="radio" class="visually-hidden" name="cbf-purchase" value="onetime" data-cbf-purchase>
                  <span class="cbf-card cbf-card--row">
                    <span class="cbf-card__row">
                      <span class="cbf-row__lead"><span class="cbf-dot" aria-hidden="true"></span><span class="uikit-label-m">{{ section.settings.onetime_label | escape }}</span></span>
                      <span class="cbf-row__price"><span class="uikit-label-m" data-cbf-once-price></span> <span class="cbf-per uikit-body-s uikit-muted" data-cbf-once-per></span></span>
                    </span>
                  </span>
                </label>

                <label class="cbf-opt cbf-opt--row">
                  <input type="radio" class="visually-hidden" name="cbf-purchase" value="subscription" data-cbf-purchase checked>
                  <span class="cbf-card cbf-card--row">
                    <span class="cbf-card__row">
                      <span class="cbf-row__lead"><span class="cbf-dot" aria-hidden="true"></span><span class="uikit-label-m">{{ section.settings.subscribe_label | escape }}</span></span>
                      <span class="cbf-row__price"><span class="uikit-label-m" data-cbf-sub-price></span> <s class="uikit-body-s uikit-muted" data-cbf-sub-compare></s> <span class="cbf-per uikit-body-s uikit-muted" data-cbf-sub-per></span></span>
                    </span>
                    <span class="cbf-sub-detail" data-cbf-sub-detail>
                      <span class="cbf-select-wrap">
                        <select class="cbf-select uikit-body-s" data-cbf-plan-select aria-label="Delivery frequency"></select>
                      </span>
                      {%- if section.settings.subscribe_benefits != blank -%}
                        <span class="cbf-benefits uikit-body-s">{{ section.settings.subscribe_benefits }}</span>
                      {%- endif -%}
                    </span>
                  </span>
                </label>
              </fieldset>
            {%- endif -%}

            {%- comment -%} e) email + checkout {%- endcomment -%}
            <div class="cbf-checkout">
              {%- if section.settings.email_label != blank -%}
                <label class="cbf-label uikit-label-s" for="CbfEmail-{{ section.id }}">{{ section.settings.email_label | escape }}</label>
                <input
                  id="CbfEmail-{{ section.id }}"
                  class="cbf-input uikit-body-m"
                  type="email"
                  name="properties[Email]"
                  autocomplete="email"
                  placeholder="you@email.com"
                  data-cbf-email
                >
                <p class="cbf-error uikit-body-s" data-cbf-email-error hidden>{{ section.settings.email_error | escape }}</p>
              {%- endif -%}

              <button type="submit" class="uikit-btn uikit-btn--primary cbf-btn--block" data-cbf-submit>
                <span data-cbf-submit-text>{{ section.settings.checkout_label | escape }}</span>
              </button>
              <p class="cbf-error uikit-body-s" data-cbf-submit-error hidden>Something went wrong adding this box. Please try again.</p>

              <button type="button" class="uikit-btn uikit-btn--secondary cbf-btn--center" data-cbf-next="2">
                {{ section.settings.change_size_label | default: 'Change size' | escape }}
              </button>
            </div>
          </div>
          {%- endunless -%}
        </form>
      </curated-funnel>

      {%- comment -%} ---------- social proof: reuse Judge.me ---------- {%- endcomment -%}
      {%- if section.settings.show_reviews and product.metafields.judgeme.widget != blank -%}
        <div class="cbf-reviews">{{ product.metafields.judgeme.widget }}</div>
      {%- endif -%}
    </div>
  </section>

  <script>
    (function () {
      if (customElements.get('curated-funnel')) return;

      customElements.define('curated-funnel', class extends HTMLElement {
        connectedCallback() {
          this.variants = this.readJSON('[data-cbf-variants]') || [];
          this.omega = this.readJSON('[data-cbf-omega]') || null;
          this.form = this.querySelector('[data-cbf-form]');
          this.requireEmail = this.dataset.requireEmail === 'true';
          this.entry = this.dataset.entry === 'true';
          this.funnelUrl = this.dataset.funnelUrl || '/pages/curated-boxes';
          if (this.entry) {
            var first = document.querySelector('curated-funnel');
            if (first && first !== this) {
              var wrap = this.closest('.shopify-section') || this.closest('.cbf-section');
              if (wrap) wrap.hidden = true;
              return;
            }
          }
          this.step = 1;
          this.busy = false;

          this.addEventListener('change', this.onChange.bind(this));
          this.addEventListener('click', this.onClick.bind(this));
          if (this.form) this.form.addEventListener('submit', this.onSubmit.bind(this));

          var email = this.querySelector('[data-cbf-email]');
          if (email) {
            email.addEventListener('blur', this.captureLead.bind(this));
            email.addEventListener('input', this.update.bind(this));
          }

          var note = this.querySelectorAll('[data-cbf-omega-note]');
          note.forEach(function (el) { el.hidden = !this.omega; }, this);

          this.renderStyleOmega();
          this.update();
          this.goto(1, false);
          if (!this.entry) this.applyParams();
        }

        /* Deep link from an entry module elsewhere on the site: ?style=...&size=... preselects
           and opens the funnel on the next step. */
        applyParams() {
          var q;
          try { q = new URLSearchParams(window.location.search); } catch (e) { return; }
          var want = { style: q.get('style'), size: q.get('size') };
          var picked = {};
          ['style', 'size'].forEach(function (k) {
            if (!want[k]) return;
            var el = Array.prototype.filter.call(this.querySelectorAll('[data-cbf-' + k + ']'), function (r) {
              return r.value.toLowerCase() === want[k].toLowerCase();
            })[0];
            if (el) { el.checked = true; picked[k] = true; }
          }, this);
          if (!picked.style) return;
          this.update();
          this.goto(picked.size ? 3 : 2, false);
        }

        readJSON(sel) {
          var el = this.querySelector(sel);
          if (!el) return null;
          try { return JSON.parse(el.textContent); } catch (e) { return null; }
        }

        val(name) {
          var el = this.querySelector('[data-cbf-' + name + ']:checked');
          return el ? el.value : null;
        }

        current() {
          var s = this.val('style'), z = this.val('size');
          if (!s || !z) return null;
          return this.variants.filter(function (v) { return v.style === s && v.size === z; })[0] || null;
        }

        onChange(e) {
          if (e.target.matches('[data-cbf-style],[data-cbf-size],[data-cbf-purchase],[data-cbf-plan-select]')) this.update();
        }

        onClick(e) {
          var next = e.target.closest('[data-cbf-next]');
          if (next && !next.disabled) { e.preventDefault(); this.goto(parseInt(next.dataset.cbfNext, 10)); return; }
          var goto = e.target.closest('[data-cbf-goto]');
          if (goto) {
            var n = parseInt(goto.dataset.cbfGoto, 10);
            if (n < this.step) { e.preventDefault(); this.goto(n); }
          }
        }

        goto(n, scroll) {
          if (n === 2 && !this.val('style')) return;
          if (this.entry && n >= 2) {
            /* entry mode: the rest of the funnel lives on the funnel page */
            var sep = this.funnelUrl.indexOf('?') > -1 ? '&' : '?';
            window.location.href = this.funnelUrl + sep + 'style=' + encodeURIComponent(this.val('style'));
            return;
          }
          if (n === 3 && !this.current()) return;
          this.step = n;
          this.querySelectorAll('[data-cbf-step]').forEach(function (el) {
            el.hidden = parseInt(el.dataset.cbfStep, 10) !== n;
          });
          this.querySelectorAll('[data-cbf-progress]').forEach(function (el) {
            var i = parseInt(el.dataset.cbfProgress, 10);
            el.classList.toggle('is-active', i === n);
            el.classList.toggle('is-done', i < n);
            var b = el.querySelector('[data-cbf-goto]');
            if (b) b.setAttribute('aria-current', i === n ? 'step' : 'false');
          });
          var waves = this.querySelectorAll('.cbf-progress__rule');
          waves.forEach(function (w, i) { w.classList.toggle('is-active', i + 1 < n); });
          if (scroll !== false) {
            /* Keep the page still. Only when the funnel's top has been scrolled past (the user
               pressed Continue at the bottom of a long step) bring the new step's heading into
               view, instantly: an animated scroll reads as the page jumping. The theme's sticky
               header publishes its height as --sticky-header-height. */
            var hh = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--sticky-header-height'), 10) || 0;
            var rect = this.getBoundingClientRect();
            if (rect.top < hh) {
              window.scrollTo({ top: Math.max(0, rect.top + window.pageYOffset - hh - 16), behavior: 'auto' });
            }
          }
        }

        /* ---- omega helpers. No lab data -> no numbers, ever. ---- */
        omegaFor(components) {
          if (!this.omega || !components || !components.length) return null;
          var total = 0, servings = 0, noData = 0;
          components.forEach(function (c) {
            var rec = this.omega[(c.sku || '').trim()];
            var qty = parseInt(c.quantity, 10) || 0;
            if (rec && typeof rec.epaDhaMg === 'number' && rec.epaDhaMg > 0) { total += rec.epaDhaMg * qty; servings += qty; }
            else { noData += qty; }
          }, this);
          if (!servings) return null;
          return { total: total, servings: servings, noData: noData };
        }

        fmtMg(mg) { return Math.round(mg).toLocaleString('en-US') + ' mg'; }
        fmtG(mg) {
          return mg >= 1000
            ? (mg / 1000).toLocaleString('en-US', { maximumFractionDigits: 1 }) + ' g'
            : this.fmtMg(mg);
        }
        shortName(c) {
          var n = c.name || c.sku || '';
          var i = n.indexOf(', ');
          return i > -1 ? n.slice(i + 2) : n;
        }

        renderStyleOmega() {
          if (!this.omega) return;
          var self = this;
          this.querySelectorAll('[data-cbf-style-omega]').forEach(function (el) {
            var style = el.dataset.cbfStyleOmega;
            var sum = 0, n = 0;
            self.variants.filter(function (v) { return v.style === style; }).forEach(function (v) {
              var o = self.omegaFor(v.components);
              if (o) { sum += o.total; n += o.servings; }
            });
            if (!n) return;
            var txt = el.querySelector('[data-cbf-style-omega-text]');
            if (txt) txt.textContent = '≈ ' + self.fmtMg(sum / n) + ' EPA+DHA per serving';
            el.hidden = false;
          });
        }

        update() {
          var self = this;
          var style = this.val('style');
          var v = this.current();

          /* step gates */
          this.querySelectorAll('[data-cbf-needs]').forEach(function (btn) {
            var need = btn.dataset.cbfNeeds;
            btn.disabled = need === 'style' ? !style : !v;
          });

          /* per-size prices + omega on step 2, for the chosen style */
          this.querySelectorAll('[data-cbf-size-price]').forEach(function (el) {
            var match = self.variants.filter(function (x) {
              return x.style === style && x.size === el.dataset.cbfSizePrice;
            })[0];
            el.innerHTML = match
              ? 'Starting at <strong>' + match.priceShort + '</strong>' + (match.perServing ? ' <span class="cbf-per">· ' + match.perServing + '/serving</span>' : '')
              : '';
          });
          this.querySelectorAll('[data-cbf-size-omega]').forEach(function (el) {
            var match = self.variants.filter(function (x) {
              return x.style === style && x.size === el.dataset.cbfSizeOmega;
            })[0];
            var o = match ? self.omegaFor(match.components) : null;
            if (!o) { el.hidden = true; return; }
            var big = el.querySelector('[data-cbf-size-omega-big]');
            var sub = el.querySelector('[data-cbf-size-omega-sub]');
            if (big) big.textContent = self.fmtG(o.total) + ' omega-3' + (o.noData ? '*' : '');
            if (sub) sub.textContent = 'EPA+DHA per box · ' + o.servings + ' lab-tested servings';
            el.hidden = false;
          });

          /* step 2: the box chosen on step 1 */
          var chosen = this.querySelector('[data-cbf-chosen]');
          if (chosen) {
            var sv = style ? this.variants.filter(function (x) { return x.style === style; })[0] : null;
            if (sv) {
              var ci = chosen.querySelector('[data-cbf-chosen-image]');
              if (ci && sv.image && ci.getAttribute('src') !== sv.image) ci.src = sv.image;
              this.setText('[data-cbf-chosen-title]', sv.style);
            }
            chosen.hidden = !sv;
          }

          if (!v) return;

          /* selling plans */
          var select = this.querySelector('[data-cbf-plan-select]');
          var hasPlans = v.plans && v.plans.length > 0;
          if (select && hasPlans && select.dataset.builtFor !== String(v.id)) {
            var keep = select.value;
            select.innerHTML = v.plans.map(function (p) {
              return '<option value="' + p.id + '">' + p.name + '</option>';
            }).join('');
            if (keep && v.plans.some(function (p) { return String(p.id) === keep; })) select.value = keep;
            select.dataset.builtFor = String(v.id);
          }
          var purchase = this.val('purchase') || 'subscription';
          var wantsSub = purchase === 'subscription' && hasPlans;
          var planId = null, plan = null;
          if (wantsSub) {
            planId = select && select.value ? select.value : v.plans[0].id;
            plan = v.plans.filter(function (p) { return String(p.id) === String(planId); })[0] || v.plans[0];
            planId = plan.id;
          }
          var subPlan = hasPlans ? v.plans[0] : null;
          var subDetail = this.querySelector('[data-cbf-sub-detail]');
          if (subDetail) subDetail.hidden = !wantsSub;

          this.setText('[data-cbf-once-price]', v.priceText);
          this.setText('[data-cbf-once-per]', v.perServing ? v.perServing + '/serving' : '');
          this.setText('[data-cbf-sub-price]', subPlan ? subPlan.priceText : '');
          this.setText('[data-cbf-sub-compare]', subPlan && subPlan.price < v.price ? v.priceText : '');
          this.setText('[data-cbf-sub-per]', subPlan && subPlan.perServing ? subPlan.perServing + '/serving' : '');

          var priceText = plan ? plan.priceText : v.priceText;
          this.querySelector('[data-cbf-variant-id]').value = v.id;
          this.querySelector('[data-cbf-selling-plan]').value = planId || '';

          var img = this.querySelector('[data-cbf-summary-image]');
          if (img && v.image) { img.src = v.image; img.srcset = ''; img.alt = v.style; }
          this.setText('[data-cbf-summary-title]', v.style);
          this.setText('[data-cbf-summary-size]', v.size);
          this.setText('[data-cbf-summary-price]', priceText);
          var cmp = this.querySelector('[data-cbf-summary-compare]');
          if (cmp) { cmp.textContent = v.priceText; cmp.hidden = !(plan && plan.price < v.price); }
          var perText = plan ? plan.perServing : v.perServing;
          this.setText('[data-cbf-summary-per]', perText ? perText + '/serving' : '');
          this.setText('[data-cbf-submit-text]',
            (plan ? this.dataset.subLabel : this.dataset.onceLabel) + ' — ' + priceText);

          /* contents */
          var box = this.querySelector('[data-cbf-contents]');
          var list = this.querySelector('[data-cbf-contents-list]');
          if (box && list) {
            if (v.components && v.components.length) {
              list.innerHTML = v.components.map(function (c) {
                return '<li class="cbf-list__row"><span class="cbf-list__name">' +
                  '<svg class="cbf-icon cbf-icon--ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>' +
                  self.esc(self.shortName(c)) + '</span><span class="cbf-list__qty">×' + (parseInt(c.quantity, 10) || 0) + '</span></li>';
              }).join('');
              box.hidden = false;
            } else { box.hidden = true; }
          }

          /* omega */
          var ob = this.querySelector('[data-cbf-omega-block]');
          var o = this.omegaFor(v.components);
          if (ob) {
            if (o) {
              var portions = (v.components || []).reduce(function (a, c) { return a + (parseInt(c.quantity, 10) || 0); }, 0);
              this.setText('[data-cbf-omega-total]', this.fmtG(o.total));
              this.setText('[data-cbf-omega-servings]', String(o.servings));
              this.setText('[data-cbf-omega-portions]', String(portions));
              var partial = this.querySelector('[data-cbf-omega-partial]');
              if (partial) partial.hidden = o.noData === 0;
              ob.hidden = false;
            } else { ob.hidden = true; }
          }

          var submit = this.querySelector('[data-cbf-submit]');
          if (submit) submit.disabled = this.busy || !v.available || (this.requireEmail && !this.emailOk());
        }

        emailOk() {
          var email = this.querySelector('[data-cbf-email]');
          if (!email) return true;
          return /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test((email.value || '').trim());
        }

        esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
        setText(sel, text) { var el = this.querySelector(sel); if (el) el.textContent = text; }

        /* Add to cart via AJAX, then straight to checkout, like the reference. */
        onSubmit(e) {
          e.preventDefault();
          var v = this.current();
          if (!v || this.busy) return;
          if (this.requireEmail && !this.emailOk()) {
            var err = this.querySelector('[data-cbf-email-error]');
            if (err) err.hidden = false;
            return;
          }
          var self = this;
          var submit = this.querySelector('[data-cbf-submit]');
          var label = this.querySelector('[data-cbf-submit-text]');
          var errBox = this.querySelector('[data-cbf-submit-error]');
          var prev = label ? label.textContent : '';
          this.busy = true;
          if (submit) submit.disabled = true;
          if (label) label.textContent = 'Processing…';
          if (errBox) errBox.hidden = true;

          var body = new FormData(this.form);
          if (!body.get('selling_plan')) body.delete('selling_plan');
          var root = window.Shopify && window.Shopify.routes ? window.Shopify.routes.root : '/';
          var emailEl = this.querySelector('[data-cbf-email]');
          var emailVal = emailEl ? (emailEl.value || '').trim() : '';
          if (emailVal && this.emailOk()) this.identifyLead(emailVal);
          /* checkout[email] prefills the email field on Shopify's checkout */
          var checkoutUrl = root + 'checkout' + (emailVal ? '?checkout%5Bemail%5D=' + encodeURIComponent(emailVal) : '');
          fetch(root + 'cart/add.js', {
            method: 'POST',
            headers: { 'Accept': 'application/json' },
            body: body
          }).then(function (r) {
            if (!r.ok) throw new Error('add failed');
            window.location.href = checkoutUrl;
          }).catch(function () {
            self.busy = false;
            if (label) label.textContent = prev;
            if (errBox) errBox.hidden = false;
            self.update();
          });
        }

        /* Klaviyo is already on every page - identify the lead without adding
           a dependency. Runs on blur and again on submit (Enter in the field skips
           blur). Prefers the current klaviyo.identify API, falls back to the legacy
           _learnq queue, and fails silently if Klaviyo has not booted. */
        captureLead(e) {
          var email = (e.target.value || '').trim();
          var ok = this.emailOk();
          var err = this.querySelector('[data-cbf-email-error]');
          if (err) err.hidden = ok || !email;
          if (!ok) return;
          this.identifyLead(email);
        }

        identifyLead(email) {
          if (!email || this.lastIdentified === email) return;
          var props = {
            $email: email,
            CuratedBoxStyle: this.val('style'),
            CuratedBoxSize: this.val('size'),
            LeadSource: 'curated-boxes-funnel'
          };
          try {
            if (window.klaviyo && typeof window.klaviyo.identify === 'function') {
              window.klaviyo.identify(props);
            } else {
              window._learnq = window._learnq || [];
              window._learnq.push(['identify', props]);
            }
            this.lastIdentified = email;
          } catch (_) {}
        }
      });
    })();
  </script>
{%- endif -%}

{% stylesheet %}
/* Curated Boxes Funnel. Layout only: every colour, font and radius is a UI kit
   token or a value the uikit-* sections already use, so this page reads like
   the Hyman and Eudēmonia pages. */
.cbf-section { --cbf-gold-text: #8a6430; --cbf-shadow: 0 10px 30px rgba(46,75,89,.10); }
#curated-funnel { scroll-margin-top: calc(var(--sticky-header-height, 0px) + 24px); }
.uikit .cbf-section { padding-block: 20px 48px; }
@media (max-width: 749px) { .uikit .cbf-section { padding-block: 14px 36px; } }
.cbf-container { position: relative; }
.cbf { display: block; }

/* phone line */
.cbf-phone { display: flex; justify-content: flex-end; gap: 4px; margin: 0 0 10px; }
@media (min-width: 990px) { .cbf-phone { position: absolute; top: 8px; right: var(--uk-gutter); margin: 0; } }
@media (max-width: 749px) { .cbf-phone { justify-content: center; text-align: center; flex-wrap: wrap; } }

/* progress */
.cbf-progress { list-style: none; display: flex; align-items: center; justify-content: center; max-width: 480px; margin: 0 auto 16px; padding: 0; }
.cbf-progress__item { flex: 0 0 auto; }
.cbf-progress__btn { display: flex; flex-direction: row; align-items: center; gap: 8px; background: none; border: 0; padding: 0; cursor: default; color: var(--uk-muted); font: inherit; }
.cbf-progress__item.is-done .cbf-progress__btn { cursor: pointer; }
.cbf-progress__item.is-active .cbf-progress__btn,
.cbf-progress__item.is-done .cbf-progress__btn { color: var(--uk-heading); }
.cbf-progress__num { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border: 1px solid var(--uk-rule); border-radius: var(--uk-radius-pill); background: var(--uk-white); color: var(--uk-muted); font-weight: 600; font-size: 14px; transition: background-color .18s ease, border-color .18s ease, color .18s ease; }
.cbf-progress__item.is-active .cbf-progress__num,
.cbf-progress__item.is-done .cbf-progress__num { background: var(--uk-gold); border-color: var(--uk-gold); color: var(--uk-white); }
.cbf-progress__check { display: none; width: 16px; height: 16px; }
.cbf-progress__check .cbf-icon { width: 16px; height: 16px; }
.cbf-progress__item.is-done .cbf-progress__digit { display: none; }
.cbf-progress__item.is-done .cbf-progress__check { display: inline-flex; }
.cbf-progress__rule { flex: 1 1 40px; height: 1px; margin: 0 10px; background: var(--uk-rule); }
.cbf-progress__rule.is-active { background: var(--uk-gold); }

/* headings, as the kit's offer / box-grid heads */
.cbf-head { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; max-width: 780px; margin: 0 auto 18px; }
.cbf-sub p { margin: 0; }

/* the box chosen on step 1, as the kit's gold-outlined chip (uikit-hero__chip) */
.cbf-chosen { display: inline-flex; align-items: center; gap: 10px; margin: 6px 0 8px; padding: 5px 14px 5px 5px; border: 1px solid var(--uk-gold); border-radius: var(--uk-radius-pill); background: var(--uk-white); color: var(--uk-heading); font: inherit; cursor: pointer; transition: border-color .18s ease; }
.cbf-chosen:hover { border-color: var(--uk-dark-blue); }
.cbf-chosen:focus-visible { outline: 2px solid var(--uk-gold); outline-offset: 2px; }
.cbf-chosen[hidden] { display: none; }
.cbf-chosen__media { display: block; width: 32px; height: 32px; border-radius: 50%; overflow: hidden; background: var(--uk-gray-4); flex: 0 0 auto; }
.cbf-chosen__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
.cbf-chosen__change { color: var(--cbf-gold-text); text-decoration: underline; text-underline-offset: 2px; }

/* grids + cards: white, 1px kit rule, kit card radius; chosen = gold rule + the kit's featured shadow */
.cbf-fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
.cbf-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
@media (max-width: 749px) { .cbf-grid { grid-template-columns: 1fr; gap: 10px; } [data-cbf-step="2"] .cbf-grid { gap: 20px; } }

.cbf-opt { display: block; position: relative; cursor: pointer; height: 100%; }
.cbf-card { position: relative; display: flex; flex-direction: column; height: 100%; border: 1px solid var(--uk-rule); border-radius: var(--uk-radius-card); background: var(--uk-white); overflow: hidden; transition: border-color .18s ease, box-shadow .18s ease; }
.cbf-opt:hover .cbf-card { border-color: var(--uk-gray-2); }
.cbf-opt input:checked + .cbf-card { border-color: var(--uk-gold); box-shadow: var(--cbf-shadow); }
.cbf-opt input:focus-visible + .cbf-card { outline: 2px solid var(--uk-gold); outline-offset: 2px; }
.cbf-card--size { overflow: visible; }

.cbf-card__media { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--uk-gray-4); }
.cbf-card__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
.cbf-card__body { display: flex; flex-direction: column; gap: 8px; padding: 20px; flex: 1 1 auto; }
.cbf-card__body--center { align-items: center; text-align: center; padding: 24px 20px 20px; }
.cbf-card__text { flex: 1 1 auto; }
.cbf-card__row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.cbf-card--style .cbf-card__row { align-items: flex-start; }
.cbf-card--style .cbf-radio { margin-top: 4px; }
.cbf-card__title { color: var(--uk-heading); }
.cbf-card__text p { margin: 0; }
.cbf-card__price strong { color: var(--uk-heading); font-weight: 600; }
.cbf-per { white-space: nowrap; font-weight: 400; }
.cbf-summary__price .cbf-per { font-family: var(--uk-font-body); }
.cbf-row__price .cbf-per { white-space: nowrap; }
.cbf-card__omega { display: inline-flex; align-items: center; gap: 6px; margin-top: 4px; padding-top: 12px; border-top: 1px solid var(--uk-rule); color: var(--cbf-gold-text); font-weight: 600; }
.cbf-card__omega--stack { flex-direction: column; align-self: stretch; gap: 2px; }
.cbf-card__omega-big { font-size: 18px; font-weight: 600; color: var(--cbf-gold-text); }
.cbf-icon { width: 16px; height: 16px; flex: 0 0 auto; }

.cbf-radio { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; flex: 0 0 auto; border: 1px solid var(--uk-gray-2); border-radius: 50%; color: var(--uk-white); background: transparent; transition: background-color .18s ease, border-color .18s ease; }
.cbf-radio .cbf-icon { width: 14px; height: 14px; opacity: 0; }
.cbf-opt input:checked + .cbf-card .cbf-radio { background: var(--uk-gold); border-color: var(--uk-gold); }
.cbf-opt input:checked + .cbf-card .cbf-radio .cbf-icon { opacity: 1; }

/* the kit's gold tag (uikit-boxgrid__tag--gold) and gold eyebrow (uikit-offer__eyebrow) */
.cbf-badge { position: absolute; top: 0; left: 50%; transform: translate(-50%, -50%); padding: 6px 12px; border-radius: var(--uk-radius-pill); background: var(--uk-gold); color: var(--uk-white); white-space: nowrap; z-index: 1; }
.uikit .cbf-eyebrow { color: var(--uk-gold); letter-spacing: .12em; text-transform: uppercase; }
.cbf-size__lead { display: contents; }
.uikit .cbf-portions { font-family: var(--uk-font-heading); font-weight: 300; font-size: 48px; line-height: 1; letter-spacing: -.02em; color: var(--uk-heading); }
.cbf-portions__label { margin-top: -4px; margin-bottom: 4px; }

/* notes + actions */
.cbf-note { text-align: center; max-width: 720px; margin: 16px auto 0; }
.cbf-note--tight { text-align: left; margin: 12px 0 0; }
.cbf-note p { margin: 0; }
.cbf-actions { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 20px; }
.cbf-actions--end { justify-content: flex-end; }
@media (max-width: 749px) { .cbf-actions { margin-top: 14px; } .cbf-actions .uikit-btn { flex: 1 1 0; min-width: 0; } }
.cbf-section .uikit-btn:disabled { background: var(--uk-gray-2); border-color: var(--uk-gray-2); color: var(--uk-white); cursor: not-allowed; }
.cbf-btn--block { width: 100%; }
.cbf-btn--center { margin: 8px auto 0; display: flex; }

/* step 3 */
.cbf-step--narrow { max-width: 760px; margin-inline: auto; }
.cbf-summary { display: grid; grid-template-columns: minmax(0, 30%) minmax(0, 1fr); border: 1px solid var(--uk-gold); border-radius: var(--uk-radius-card); background: var(--uk-white); box-shadow: var(--cbf-shadow); overflow: hidden; }
.cbf-summary__media { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--uk-gray-4); }
.cbf-summary__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
.cbf-summary__body { display: flex; flex-direction: column; justify-content: center; gap: 6px; padding: 20px; min-width: 0; }
.cbf-summary__title { color: var(--uk-heading); }
.cbf-summary__foot { margin-top: 4px; flex-wrap: wrap; }
.cbf-summary__price { display: inline-flex; align-items: baseline; gap: 8px; font-family: var(--uk-font-heading); font-weight: 500; font-size: 34px; line-height: 1; color: var(--uk-heading); }
.cbf-rating { display: inline-flex; align-items: center; gap: 6px; }
.cbf-rating__stars { display: inline-flex; gap: 2px; }
.cbf-star { width: 14px; height: 14px; fill: var(--uk-gold); }
.cbf-rating__star.is-off .cbf-star { fill: var(--uk-gray-3); }
@media (max-width: 749px) {
  .cbf-summary { grid-template-columns: 118px minmax(0, 1fr); }
  .cbf-summary__media { aspect-ratio: auto; }
  .cbf-summary__title { font-size: 20px; }
  .cbf-summary__body > .cbf-card__row:first-child { flex-wrap: wrap; row-gap: 2px; }
  .cbf-summary__body .cbf-eyebrow { white-space: nowrap; }
  .cbf-summary__price { font-size: 28px; }
}

/* panels, as the kit's white cards (uikit-panels__buy) with its stat type (uikit-panels__stat) */
.cbf-panels { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-top: 14px; }
.cbf-panels:empty { display: none; }
.cbf-panel { min-width: 0; padding: 18px 20px; border: 1px solid var(--uk-rule); border-radius: var(--uk-radius-card); background: var(--uk-white); }
.uikit .cbf-panel__title { display: flex; align-items: center; gap: 8px; margin: 0 0 10px; font-family: var(--uk-font-body); font-size: 16px; font-weight: 600; line-height: 1.2; letter-spacing: 0; color: var(--uk-heading); }
.cbf-panel__title .cbf-icon { color: var(--uk-gold); width: 18px; height: 18px; }
.cbf-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
.cbf-list__row { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 16px; }
.cbf-list__name { display: inline-flex; align-items: center; gap: 8px; min-width: 0; color: var(--uk-heading); }
.cbf-icon--ok { color: var(--uk-gold); width: 15px; height: 15px; }
.cbf-list__qty { font-weight: 600; color: var(--cbf-gold-text); }
.cbf-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 8px; border-top: 1px solid var(--uk-rule); }
.cbf-stat { display: flex; flex-direction: column; gap: 4px; padding: 14px 12px 0 0; }
.uikit .cbf-stat__num { font-family: var(--uk-font-heading); font-size: 26px; line-height: 1.1; color: var(--uk-heading); }

/* purchase type */
.cbf-purchase { display: flex; flex-direction: column; gap: 8px; margin-top: 14px; }
.cbf-opt--row { height: auto; }
.cbf-card--row { padding: 14px 18px; gap: 10px; }
.cbf-row__lead { display: inline-flex; align-items: center; gap: 12px; color: var(--uk-heading); }
.cbf-dot { display: inline-flex; width: 18px; height: 18px; border: 1px solid var(--uk-gray-2); border-radius: 50%; position: relative; flex: 0 0 auto; }
.cbf-dot::after { content: ""; position: absolute; inset: 3px; border-radius: 50%; background: var(--uk-gold); opacity: 0; transition: opacity .15s ease; }
.cbf-opt input:checked + .cbf-card .cbf-dot { border-color: var(--uk-gold); }
.cbf-opt input:checked + .cbf-card .cbf-dot::after { opacity: 1; }
.cbf-row__price { white-space: nowrap; color: var(--uk-heading); }
.cbf-sub-detail { display: flex; flex-direction: column; gap: 12px; padding-left: 30px; }
.cbf-sub-detail[hidden] { display: none; }
.cbf-select-wrap { position: relative; display: block; }
.cbf-select { width: 100%; appearance: none; -webkit-appearance: none; padding: 12px 40px 12px 16px; border: 1px solid var(--uk-rule); border-radius: 10px; background: var(--uk-white); color: var(--uk-heading); font: inherit; }
.cbf-select:focus { outline: none; border-color: var(--uk-heading); }
.cbf-select-wrap::after { content: ""; position: absolute; right: 16px; top: 50%; width: 8px; height: 8px; border-right: 1px solid var(--uk-heading); border-bottom: 1px solid var(--uk-heading); transform: translateY(-70%) rotate(45deg); pointer-events: none; }
.cbf-benefits ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
.cbf-benefits li { position: relative; padding-left: 22px; }
.cbf-benefits li::before { content: ""; position: absolute; left: 0; top: 0.35em; width: 6px; height: 10px; border-right: 2px solid var(--uk-gold); border-bottom: 2px solid var(--uk-gold); transform: rotate(45deg); }

/* email + checkout, as the kit's contact fields */
.cbf-checkout { display: flex; flex-direction: column; gap: 8px; margin-top: 14px; }
.cbf-label { color: var(--uk-heading); }
.cbf-input { width: 100%; padding: 14px 16px; border: 1px solid var(--uk-rule); border-radius: 10px; background: var(--uk-white); color: var(--uk-heading); font: inherit; transition: border-color .18s ease; }
.cbf-input:focus { outline: none; border-color: var(--uk-heading); }
.cbf-error { margin: 0; color: #a23b2a; }

/* phones: style cards become a row with a square thumbnail; size cards put the number beside the details */
@media (max-width: 749px) {
  .cbf-card--style { flex-direction: row; align-items: stretch; }
  .cbf-card--style .cbf-card__media { flex: 0 0 118px; aspect-ratio: auto; }
  .cbf-card--style .cbf-card__body { flex: 1 1 auto; min-width: 0; padding: 14px 16px; gap: 4px; }
  .cbf-card--style .cbf-card__omega { padding-top: 6px; }
  .cbf-card--size .cbf-card__body--center { display: grid; grid-template-columns: 92px minmax(0, 1fr); column-gap: 14px; align-items: center; text-align: left; padding: 18px 16px 16px; }
  .cbf-card--size .cbf-size__lead { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0; grid-row: 1 / span 5; }
  .cbf-card--size .cbf-portions__label { margin-bottom: 0; }
  .uikit .cbf-card--size .cbf-portions { font-size: 40px; }
  .cbf-card--size .cbf-card__omega--stack { align-items: flex-start; }
  .cbf-summary__body { padding: 16px; }
  .cbf-panels { grid-template-columns: 1fr; gap: 10px; margin-top: 10px; }
  .cbf-progress__btn { flex-direction: column; gap: 4px; }
  .cbf-progress__rule { margin: 0 8px 22px; }
}

/* reviews block from Judge.me */
.cbf-reviews { margin-top: 56px; }
{% endstylesheet %}


{% schema %}
{
  "name": "Curated Boxes Funnel",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Three-step funnel over one product with a Style option and a Size option. Optional data: variant metafield custom.box_components (JSON list of {sku,name,quantity}) powers 'What's inside'; shop metafield custom.omega_by_sku (JSON map of SKU to {epaDhaMg}) powers the omega figures. Both blocks stay hidden until that data exists — values are never estimated."
    },
    { "type": "product", "id": "product", "label": "Curated box product" },
    { "type": "select", "id": "mode", "label": "Mode", "options": [
      { "value": "full", "label": "Full funnel: three steps in place" },
      { "value": "entry", "label": "Entry: step 1 here, the rest on the funnel page" }
    ], "default": "full", "info": "Entry is for the homepage, landing pages and recipes: pick a box here, continue on the funnel page with that box already chosen." },
    { "type": "url", "id": "funnel_url", "label": "Funnel page (entry mode)", "info": "Defaults to /pages/curated-boxes." },
    { "type": "checkbox", "id": "hide_on_articles", "label": "Hide on blog articles", "default": false, "info": "For the footer copy: recipe templates carry their own module above the newsletter banner." },
    { "type": "text", "id": "style_option_name", "label": "Style option name", "default": "Style" },
    { "type": "text", "id": "size_option_name", "label": "Size option name", "default": "Size" },
    { "type": "text", "id": "step_labels", "label": "Progress labels (comma separated)", "default": "Seafood,Size,Checkout" },
    { "type": "text", "id": "continue_label", "label": "Continue button", "default": "Continue" },
    { "type": "text", "id": "back_label", "label": "Back button", "default": "Back" },
    { "type": "text", "id": "change_size_label", "label": "Change size button (step 3)", "default": "Change size" },
    { "type": "text", "id": "phone_label", "label": "Phone pill text", "default": "Prefer to talk? Call us to order" },
    { "type": "text", "id": "phone", "label": "Phone number", "default": "(818) 646-4251" },

    { "type": "header", "content": "Step 1 — Seafood" },
    { "type": "text", "id": "step1_heading", "label": "Heading", "default": "Choose Your Seafood" },
    { "type": "richtext", "id": "step1_subheading", "label": "Subheading", "default": "<p>Each box is chef-curated with hand-picked selections.</p>" },

    { "type": "header", "content": "Step 2 — Size" },
    { "type": "text", "id": "step2_heading", "label": "Heading", "default": "Choose Your Size" },
    { "type": "text", "id": "chosen_label", "label": "Chosen box label", "default": "Your box" },
    { "type": "text", "id": "chosen_change_label", "label": "Chosen box change link", "default": "Change" },
    { "type": "richtext", "id": "step2_subheading", "label": "Subheading", "default": "<p>Choose the box size that fits your household.</p>" },
    { "type": "richtext", "id": "omega_footnote", "label": "Omega footnote (steps 1 and 2)", "info": "Shown only when lab data exists. Keep the variance note — it is what makes the figure a published test result rather than a guarantee (claims guide §8.8).", "default": "<p>Per-serving EPA+DHA figures are our published third-party test results from Edacious for each portion in the box, averaged across the box. Values vary by sample and season.</p>" },

    { "type": "header", "content": "Step 3 — Review" },
    { "type": "text", "id": "step3_heading", "label": "Heading", "default": "Your Box is Built!" },
    { "type": "richtext", "id": "step3_subheading", "label": "Subheading", "default": "<p>Review your selections and checkout.</p>" },
    { "type": "richtext", "id": "ship_copy", "label": "Shipping copy", "default": "<p>Arrives snap frozen. Orders ship Tuesday &amp; Wednesday.</p>" },
    { "type": "text", "id": "contents_heading", "label": "Contents heading", "default": "What's inside this box" },
    { "type": "richtext", "id": "contents_disclaimer", "label": "Contents disclaimer", "default": "<p>Chef-curated selection — exact varieties may shift slightly with the season and best available harvest.</p>" },
    { "type": "text", "id": "omega_heading", "label": "Omega heading", "default": "Omega-3 in this box" },
    { "type": "richtext", "id": "omega_disclaimer", "label": "Omega disclaimer", "default": "<p>Published Edacious test results for each portion, summed for the box. Values vary by sample and season.</p>" },
    { "type": "richtext", "id": "omega_partial_note", "label": "Partial-data note", "default": "<p>Totals include lab-tested portions only.</p>" },

    { "type": "header", "content": "Purchase" },
    { "type": "text", "id": "purchase_heading", "label": "Heading (screen readers)", "default": "How would you like it?" },
    { "type": "text", "id": "subscribe_label", "label": "Subscribe label", "default": "Subscribe & Save 10%" },
    { "type": "richtext", "id": "subscribe_benefits", "label": "Subscribe benefits", "default": "<ul><li>Free 1:1 chef classes</li><li>Arrives snap-frozen or we replace it</li><li>Pause, skip, or cancel anytime</li></ul>" },
    { "type": "text", "id": "onetime_label", "label": "One-time label", "default": "One-time purchase" },
    { "type": "text", "id": "email_label", "label": "Email label (blank = no email gate)", "default": "Enter your email to continue to checkout" },
    { "type": "text", "id": "email_error", "label": "Email error", "default": "Please enter a valid email address." },
    { "type": "text", "id": "checkout_label", "label": "Checkout button (before a price is known)", "default": "Checkout" },
    { "type": "text", "id": "submit_sub_label", "label": "Checkout button, subscription", "default": "Subscribe" },
    { "type": "text", "id": "submit_once_label", "label": "Checkout button, one-time", "default": "Checkout" },
    { "type": "checkbox", "id": "show_reviews", "label": "Show Judge.me reviews", "default": true }
  ],
  "blocks": [
    {
      "type": "style",
      "name": "Style card",
      "settings": [
        { "type": "text", "id": "style_value", "label": "Matches Style option value" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "richtext", "id": "description", "label": "Description" }
      ]
    },
    {
      "type": "size",
      "name": "Size card",
      "settings": [
        { "type": "text", "id": "size_value", "label": "Matches Size option value" },
        { "type": "text", "id": "tagline", "label": "Tagline" },
        { "type": "richtext", "id": "description", "label": "Detail line" },
        { "type": "text", "id": "badge", "label": "Badge" }
      ]
    }
  ],
  "presets": [{ "name": "Curated Boxes Funnel" }]
}
{% endschema %}
