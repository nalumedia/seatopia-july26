{%- comment -%}
  Web kit — numbered steps. Figma 4592:547 "How Your Box Gives Back", built from the
  "Impact Step" component (4592:512): gold numeral, title, line, on a left rule.
{%- endcomment -%}
{%- render 'uikit-fonts' -%}
{{ 'web-kit.css' | asset_url | stylesheet_tag }}
<div class="wk wk-section wk-section--{{ section.settings.tone }} wk-steps-wrap">
  <div class="wk-container wk-steps">
    {%- if section.settings.heading != blank -%}
      <h2 class="wk-display wk-steps__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <ol class="wk-steps__list" role="list">
      {%- for block in section.blocks -%}
        <li class="wk-steps__item" {{ block.shopify_attributes }}>
          <span class="wk-steps__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <span class="wk-h3 wk-steps__title">{{ block.settings.title }}</span>
          <span class="wk-body-m wk-steps__text">{{ block.settings.text }}</span>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

<style>
  .wk-steps { display: flex; flex-direction: column; align-items: center; gap: 48px; }
  .wk .wk-steps__heading { text-align: center; }
  .wk-steps__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; width: 100%; list-style: none; margin: 0; padding: 0; }
  .wk-steps__item { display: flex; flex-direction: column; gap: 16px; padding: 8px 40px; border-left: 1px solid var(--wk-rule); }
  .wk-steps__num { font-family: var(--wk-font-heading); font-weight: 300; font-size: 72px; line-height: 1; color: var(--wk-gold); }
  .wk .wk-steps__title { color: var(--wk-ink); }
  .wk-steps__text { color: rgba(46, 75, 89, 0.85); }
  @media (max-width: 989px) {
    .wk-steps { gap: 36px; }
    .wk-steps__list { grid-template-columns: 1fr; gap: 28px; }
    .wk-steps__item { padding: 4px 24px; }
    .wk-steps__num { font-size: 56px; }
    .wk .wk-steps__title { font-size: 26px; }
  }
</style>

{% schema %}
{
  "name": "Web kit — numbered steps",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How Your Box Gives Back" },
    { "type": "select", "id": "tone", "label": "Background", "default": "sand", "options": [ { "value": "sand", "label": "Sand" }, { "value": "paper", "label": "Paper" }, { "value": "white", "label": "White" } ] }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "limit": 4, "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ]}
  ],
  "presets": [{ "name": "Web kit — numbered steps", "blocks": [ { "type": "step" }, { "type": "step" }, { "type": "step" } ] }]
}
{% endschema %}
