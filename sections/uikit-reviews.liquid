{%- comment -%}
  UI kit — customer reviews as text. Three reviews side by side: stars, title, the
  review in the buyer's words, then "NAME, DATE · PRODUCT". No photos, no carousel.
  Sits under the endorsements band, the way AG1 follows its endorsers with
  "What people are saying".

  Claims guide §4.H / 16 CFR Part 465: only real reviews we earned, copied verbatim
  from Judge.me. The rating line at the bottom reads Judge.me's shop metafields.
{%- endcomment -%}
{%- render 'uikit-fonts' -%}
{{ 'uikit.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign rv_count = shop.metafields.judgeme.all_reviews_count | plus: 0
  assign rv_rating = shop.metafields.judgeme.all_reviews_rating | plus: 0.0
  assign rv_count_text = rv_count
  if rv_count > 999
    assign rv_k = rv_count | divided_by: 1000
    assign rv_r = rv_count | modulo: 1000 | prepend: '000' | slice: -3, 3
    assign rv_count_text = rv_k | append: ',' | append: rv_r
  endif
-%}
<div class="uikit uikit-section uikit-reviews"{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %}>
  <div class="uikit-container">
    {%- if s.heading != blank -%}<h2 class="uikit-h2 uikit-reviews__heading">{{ s.heading }}</h2>{%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="uikit-reviews__grid uikit-reviews__grid--{{ section.blocks.size }}" role="list">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <li class="uikit-reviews__item" {{ block.shopify_attributes }}>
            <span class="uikit-reviews__stars" aria-label="{{ b.rating }} out of 5">{%- for i in (1..5) -%}<span aria-hidden="true">{% if i <= b.rating %}★{% else %}☆{% endif %}</span>{%- endfor -%}</span>
            {%- if b.title != blank -%}<h3 class="uikit-reviews__title">{{ b.title }}</h3>{%- endif -%}
            {%- if b.quote != blank -%}<blockquote class="uikit-body-m uikit-reviews__quote">&ldquo;{{ b.quote }}&rdquo;</blockquote>{%- endif -%}
            {%- capture meta -%}
              {{- b.name -}}
              {%- if b.date != blank %}, {{ b.date }}{% endif -%}
              {%- if b.product != blank %} · {{ b.product }} review{% endif -%}
              {%- if b.disclosure != blank %} · {{ b.disclosure }}{% endif -%}
            {%- endcapture -%}
            {%- if meta != blank -%}<span class="uikit-label-s uikit-reviews__meta">{{ meta | strip }}</span>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if s.show_rating and rv_count > 0 -%}
      <p class="uikit-reviews__foot uikit-body-s">
        <span class="uikit-reviews__stars uikit-reviews__stars--inline" aria-hidden="true">★★★★★</span>
        <span>{{ rv_rating | round: 1 }} from {{ rv_count_text }} reviews.</span>
        <a class="uikit-link" href="{{ s.all_reviews_link | default: 'https://judge.me/reviews/stores/seatopia' }}"{% if s.all_reviews_link == blank %} target="_blank" rel="noopener"{% endif %}>{{ s.all_reviews_label | default: 'Collected by Judge.me' }}</a>
      </p>
    {%- endif -%}
  </div>
</div>
<style>
  .uikit .uikit-reviews__heading { margin-bottom: 44px; }
  .uikit-reviews__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px 48px; list-style: none; margin: 0; padding: 0; }
  .uikit-reviews__grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .uikit-reviews__item { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .uikit-reviews__stars { color: var(--uk-gold); letter-spacing: 3px; font-size: 22px; line-height: 1; }
  .uikit-reviews__stars--inline { font-size: 15px; letter-spacing: 2px; }
  .uikit .uikit-reviews__title { font-family: var(--uk-font-body); font-size: 19px; font-weight: 600; line-height: 1.25; letter-spacing: 0; color: var(--uk-heading); margin: 2px 0 0; }
  .uikit .uikit-reviews__quote { margin: 0; color: var(--uk-text); }
  .uikit .uikit-reviews__meta { color: var(--uk-muted); letter-spacing: .08em; text-transform: uppercase; font-weight: 500; margin-top: 4px; }
  .uikit-reviews__foot { display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap; margin: 48px 0 0; color: var(--uk-muted); }
  @media (max-width: 989px) { .uikit-reviews__grid, .uikit-reviews__grid--2 { grid-template-columns: 1fr; gap: 32px; } .uikit .uikit-reviews__heading { margin-bottom: 32px; } }
</style>
{% schema %}
{
  "name": "UI kit — reviews",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Real reviews only, copied verbatim from Judge.me. Three read best side by side." },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "customer-reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What people are saying" },
    { "type": "checkbox", "id": "show_rating", "label": "Show the Judge.me rating and review count", "default": true },
    { "type": "url", "id": "all_reviews_link", "label": "All reviews link", "info": "Blank links to the Judge.me store page." },
    { "type": "text", "id": "all_reviews_label", "label": "All reviews link label", "default": "Collected by Judge.me" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Review title" },
        { "type": "textarea", "id": "quote", "label": "Review (verbatim)" },
        { "type": "text", "id": "name", "label": "Reviewer" },
        { "type": "text", "id": "date", "label": "Date", "info": "As shown on Judge.me, e.g. 10/02/2026" },
        { "type": "text", "id": "product", "label": "Product" },
        { "type": "text", "id": "disclosure", "label": "Disclosure", "default": "Verified buyer" }
      ]
    }
  ],
  "presets": [{ "name": "UI kit — reviews" }]
}
{% endschema %}
