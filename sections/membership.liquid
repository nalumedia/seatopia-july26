{%- comment -%}
  Seatopia Membership landing page.
  Renders inside the standard theme layout via templates/page.membership.json.

  Everything visual comes from the Concept theme:
  - side margins: .page-width
  - headings, eyebrows, body text, badges, links, buttons: the theme's own classes and button markup
  - spacing, radius, borders, placeholders: theme tokens (--sp-*, --rounded-block, --color-border, --color-placeholder)
  - white bands inherit the site's global colours; the cream, sage and dark bands take their colours
    from this section's colour settings (Theme editor > Membership) instead of hardcoded values.

  The <style> block only handles layout (grids, card structure, the certificate rows, FAQ toggle).
  It contains no font sizes, no hex colours and no pixel spacing.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign hero_img = images['DrCaseyMeans-Seatopia-29.jpg']
  assign health_img = images['DrCaseyMeans-Seatopia-34.jpg']
-%}

<style>
  #shopify-section-{{ section.id }} {
    --mbr-band-space: {{ s.band_padding }}px;
    --mbr-band-space-mobile: {{ s.band_padding_mobile }}px;
  }

  {%- assign tones = 'cream,sage,dark' | split: ',' -%}
  {%- for tone in tones -%}
    {%- case tone -%}
      {%- when 'cream' -%}{%- assign bg = s.cream_background -%}{%- assign fg = s.cream_text -%}
      {%- when 'sage' -%}{%- assign bg = s.sage_background -%}{%- assign fg = s.sage_text -%}
      {%- when 'dark' -%}{%- assign bg = s.dark_background -%}{%- assign fg = s.dark_text -%}
    {%- endcase -%}
    {%- assign border = fg | color_mix: bg, 18 -%}
    #shopify-section-{{ section.id }} .mbr-tone--{{ tone }} {
      --color-background: {{ bg.red }} {{ bg.green }} {{ bg.blue }};
      --color-foreground: {{ fg.red }} {{ fg.green }} {{ fg.blue }};
      --color-border: {{ border | color_extract: 'red' }} {{ border | color_extract: 'green' }} {{ border | color_extract: 'blue' }};
      color: rgb(var(--color-foreground));
    }
  {%- endfor -%}

  #shopify-section-{{ section.id }} .mbr-band--hero {
    background: radial-gradient(125% 120% at 82% 4%, {{ s.dark_background | color_lighten: 8 }} 0%, rgb(var(--color-background)) 46%);
  }

  .membership :where(h1, h2, h3, p, figure, blockquote) { margin: 0; }

  /* Bands */
  .mbr-band {
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    padding-block: var(--mbr-band-space);
  }
  .mbr-band--cta { padding-block: calc(var(--mbr-band-space) * 1.25); }
  @media (max-width: 767px) {
    .mbr-band { padding-block: var(--mbr-band-space-mobile); }
    .mbr-band--cta { padding-block: calc(var(--mbr-band-space-mobile) * 1.25); }
  }
  .mbr-narrow { max-width: 52rem; margin-inline: auto; }

  /* Section heads (theme title-wrapper markup; only width and spacing here) */
  .mbr-head { max-width: 45rem; margin-block-end: var(--sp-8); }
  .mbr-head--center { align-items: center; text-align: center; margin-inline: auto; }
  .mbr-head--row { max-width: none; flex-direction: row; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; }

  /* Grids */
  .mbr-grid { display: grid; gap: var(--sp-6); }
  .mbr-grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .mbr-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .mbr-grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  @media (max-width: 1023px) { .mbr-grid--3, .mbr-grid--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px) { .mbr-grid--2, .mbr-grid--3, .mbr-grid--4 { grid-template-columns: 1fr; } }

  /* Hero */
  .mbr-hero { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(var(--sp-8), 5vw, calc(var(--sp-8) * 1.75)); align-items: center; }
  @media (max-width: 1023px) { .mbr-hero { grid-template-columns: 1fr; gap: var(--sp-8); } }
  .mbr-hero__copy { display: flex; flex-direction: column; gap: var(--sp-5); align-items: flex-start; }
  .mbr-hero__media { overflow: hidden; border-radius: var(--rounded-block); background: rgb(var(--color-placeholder)); }
  .mbr-hero__media img { display: block; width: 100%; height: auto; object-fit: cover; }
  .mbr-lede { max-width: 38rem; }
  .mbr-cta-row { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
  .mbr-cta-row--center { justify-content: center; }

  .mbr-trust { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--sp-2); }
  .mbr-trust li { position: relative; padding-inline-start: 1.5em; }
  .mbr-trust li::before {
    content: ""; position: absolute; inset-inline-start: 0.1em; top: 0.45em;
    width: 0.8em; height: 0.4em;
    border-inline-start: 2px solid rgb(var(--color-button-background));
    border-block-end: 2px solid rgb(var(--color-button-background));
    transform: rotate(-45deg);
  }
  .mbr-trust--center { flex-direction: row; flex-wrap: wrap; justify-content: center; gap: var(--sp-2) var(--sp-6); margin-block-start: var(--sp-5); }

  /* Standard strip */
  .mbr-strip { margin-block-start: calc(var(--sp-8) * 1.5); padding-block-start: var(--sp-8); border-block-start: 1px solid rgb(var(--color-border)); }
  .mbr-strip__eyebrow { margin-block-end: var(--sp-6); }
  .mbr-strip__item { display: flex; flex-direction: column; gap: var(--sp-1d5); }

  /* Cards */
  .mbr-card {
    display: flex; flex-direction: column; gap: var(--sp-3);
    padding: var(--sp-6);
    background: rgb(var(--color-background));
    border: 1px solid rgb(var(--color-border));
    border-radius: var(--rounded-block);
  }
  .mbr-tone--cream .mbr-card:not(.mbr-card--dark),
  .mbr-tone--sage .mbr-card:not(.mbr-card--dark) { background: rgb(var(--color-foreground) / 0.03); }
  .mbr-card--dark { border-color: transparent; }
  .mbr-pill { align-self: flex-start; margin-block-start: var(--sp-2); padding: var(--sp-2) var(--sp-3); border-radius: var(--rounded-block); background: rgb(var(--color-foreground) / 0.06); }
  .mbr-tagline { text-align: center; margin-block-start: calc(var(--sp-8) * 1.25); }

  /* Certificate of analysis */
  .mbr-coa { max-width: 49rem; margin-inline: auto; padding: var(--sp-2) var(--sp-6) var(--sp-6); background: rgb(var(--color-foreground) / 0.06); border: 1px solid rgb(var(--color-border)); border-radius: var(--rounded-block); }
  .mbr-coa__head { margin-block: var(--sp-5) var(--sp-2); }
  .mbr-coa__row { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--sp-5); padding-block: var(--sp-5); border-block-start: 1px solid rgb(var(--color-border)); }
  .mbr-coa__data { display: flex; flex-direction: column; gap: var(--sp-1d5); max-width: 80%; }
  .mbr-coa__tag { flex: none; white-space: nowrap; }
  .mbr-coa__foot { margin-block-start: var(--sp-4); }

  /* Health */
  .mbr-health { align-items: stretch; }
  .mbr-stack { display: flex; flex-direction: column; gap: var(--sp-4); }
  .mbr-badge-card { justify-content: center; }
  .mbr-badge-card__img { overflow: hidden; margin-block-end: var(--sp-4); border-radius: var(--rounded-block); aspect-ratio: 16 / 10; background: rgb(var(--color-placeholder)); }
  .mbr-badge-card__img img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .mbr-note { max-width: 45rem; margin: var(--sp-8) auto 0; text-align: center; display: flex; flex-direction: column; gap: var(--sp-1d5); }

  /* Perks and steps */
  .mbr-perk, .mbr-step { display: flex; flex-direction: column; gap: var(--sp-2); }
  .mbr-perk { padding-block-start: var(--sp-4); border-block-start: 2px solid rgb(var(--color-border)); }
  .mbr-commit {
    margin-block-start: calc(var(--sp-8) * 1.25);
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-3) var(--sp-6);
    padding: var(--sp-5) var(--sp-6);
    background: rgb(var(--color-foreground) / 0.03);
    border: 1px solid rgb(var(--color-border));
    border-radius: var(--rounded-block);
  }
  .mbr-commit__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--sp-2) var(--sp-6); }
  .mbr-commit__list li { position: relative; padding-inline-start: 1em; }
  .mbr-commit__list li::before { content: "·"; position: absolute; inset-inline-start: 0.2em; font-weight: 700; color: rgb(var(--color-button-background)); }

  /* Curated boxes */
  .mbr-box {
    display: flex; flex-direction: column; overflow: hidden;
    color: rgb(var(--color-foreground)); text-decoration: none;
    background: rgb(var(--color-foreground) / 0.03);
    border: 1px solid rgb(var(--color-border));
    border-radius: var(--rounded-block);
    transition: border-color var(--animation-primary, 0.3s ease);
  }
  .mbr-box:hover, .mbr-box:focus-visible { border-color: rgb(var(--color-foreground) / 0.5); }
  .mbr-box__media { position: relative; aspect-ratio: 1 / 1; overflow: hidden; background: rgb(var(--color-placeholder)); }
  .mbr-box__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .mbr-box__tag { position: absolute; top: var(--sp-4); inset-inline-start: var(--sp-4); z-index: 1; }
  .mbr-box__body { display: flex; flex-direction: column; gap: var(--sp-2); padding: var(--sp-5); }
  .mbr-box__price { margin-block-start: var(--sp-2); }
  .mbr-box__price s { margin-inline: var(--sp-1d5); }

  /* Testimonials */
  .mbr-stars { color: rgb(var(--color-rating)); letter-spacing: 0.2em; }
  .mbr-quote { display: flex; flex-direction: column; gap: var(--sp-4); padding: var(--sp-6); background: rgb(var(--color-foreground) / 0.05); border: 1px solid rgb(var(--color-border)); border-radius: var(--rounded-block); }
  .mbr-quote figcaption { display: flex; flex-direction: column; gap: var(--sp-1d5); }

  /* FAQ */
  .mbr-faq { border-block-start: 1px solid rgb(var(--color-border)); }
  .mbr-faq__item { border-block-end: 1px solid rgb(var(--color-border)); }
  .mbr-faq__item summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: var(--sp-6); padding-block: var(--sp-5); }
  .mbr-faq__item summary::-webkit-details-marker { display: none; }
  .mbr-faq__icon { flex: none; width: 1.25em; height: 1.25em; transition: transform var(--animation-primary, 0.3s ease); }
  .mbr-faq__item[open] .mbr-faq__icon { transform: rotate(45deg); }
  .mbr-faq__a { padding: 0 var(--sp-8) var(--sp-5) 0; }

  .mbr-band--cta .mbr-lede { margin-inline: auto; }

  @media (max-width: 767px) {
    .mbr-card, .mbr-quote { padding: var(--sp-5); }
    .mbr-coa { padding-inline: var(--sp-4); }
    .mbr-coa__row { flex-direction: column; gap: var(--sp-2); }
    .mbr-coa__data { max-width: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mbr-box, .mbr-faq__icon { transition: none; }
  }
</style>

{%- comment -%} Theme eyebrow (same markup as the theme's own section subheadings) {%- endcomment -%}
{%- capture eyebrow_class -%}heading normal-case font-medium subtext-lg leading-none tracking-none{%- endcapture -%}
{%- capture kicker_class -%}text-sm font-medium text-opacity leading-tight{%- endcapture -%}

<div class="membership">

  {%- comment -%} ============================ HERO ============================ {%- endcomment -%}
  <section class="mbr-band mbr-band--hero mbr-tone--dark" data-testid="hero-membership">
    <div class="page-width">
      <div class="mbr-hero">
        <div class="mbr-hero__copy">
          <p class="{{ eyebrow_class }}">The Seatopia Membership</p>
          <h1 class="heading title-xl tracking-heading">Not just healthy. <em>Measurable</em> — month after month.</h1>
          <p class="mbr-lede text-lg leading-normal text-opacity">Become a Seatopian. Make clean, lab-verified, omega-rich seafood a monthly ritual — delivered on ocean time. The benefits of the sea compound with consistency, and we prove every claim with a lab report.</p>
          <div class="mbr-cta-row">
            <a class="button button--primary button--md" href="/collections/curated-boxes" is="hover-link">
              <span class="btn-fill" data-fill></span>
              <span class="btn-text">Build your subscription</span>
            </a>
            <a class="button button--secondary button--md" href="#perks" is="hover-link">
              <span class="btn-fill" data-fill></span>
              <span class="btn-text">See member benefits</span>
            </a>
          </div>
          <ul class="mbr-trust text-sm leading-normal text-opacity">
            <li>Third-party lab verified for DHA, EPA, mercury &amp; microplastics</li>
            <li>Tested to ≤ 0.1 ppm mercury &ndash; a tenth of the FDA action level &middot; no microplastics detected in third-party testing</li>
            <li>134+ published product quality reports</li>
          </ul>
        </div>
        <div class="mbr-hero__media">
          {%- if hero_img != blank -%}
            {{ hero_img | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 1024px) 45vw, 100vw', widths: '600,800,1000,1200,1400', alt: 'Seatopia yellowtail crudo with herb oil and edible flowers' }}
          {%- else -%}
            <img src="https://seatopia.fish/cdn/shop/files/DrCaseyMeans-Seatopia-29.jpg?width=1400" alt="Seatopia yellowtail crudo with herb oil and edible flowers" loading="eager" width="700" height="560">
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Standard strip 01–04 {%- endcomment -%}
      <div class="mbr-strip">
        <p class="mbr-strip__eyebrow {{ kicker_class }}">SEATOPIA STANDARD™ · Verified clean · a certificate behind every claim</p>
        <div class="mbr-grid mbr-grid--4">
          {%- assign strip_n = 'Clean seafood, monthly|Member value|Guidance, not guesswork|On ocean time' | split: '|' -%}
          {%- assign strip_d = 'Clean seafood, third-party lab tested at the supplier level, delivered snap-frozen on a rhythm you set.|10% off every order, member gifts &amp; rewards, and quarterly access to limited harvests.|Free 1:1 chef classes and a dedicated concierge for questions, cooking, and scheduling.|Monthly or bi-monthly, pause up to 3 months, change size and cadence, or cancel anytime.' | split: '|' -%}
          {%- for item in strip_n -%}
            <div class="mbr-strip__item">
              <span class="{{ kicker_class }}">{{ forloop.index | prepend: '0' }}</span>
              <h3 class="heading text-xl leading-tight">{{ item }}</h3>
              <p class="text-sm leading-normal text-opacity">{{ strip_d[forloop.index0] }}</p>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ============== SEPTEMBER MEMBER REWARDS (campaign) ==============
    Campaign content lives in snippets/member-rewards.liquid — one source of
    truth for every placement. Remove this render when the campaign ends.
  {%- endcomment -%}
  {%- render 'member-rewards', cta_link: '/collections/curated-boxes' -%}

  {%- comment -%} ==================== USPs: three things ==================== {%- endcomment -%}
  <section class="mbr-band" id="usps">
    <div class="page-width">
      <div class="mbr-head title-wrapper leading-none flex flex-col gap-4 relative z-1">
        <p class="{{ eyebrow_class }}">The Seatopia Standard</p>
        <h2 class="heading title-lg">Three things we can prove about every supplier.</h2>
      </div>
      <div class="mbr-grid mbr-grid--3">
        <div class="mbr-card">
          <p class="{{ kicker_class }}">Certified Marine Nutrition</p>
          <h3 class="heading title-sm">Not just healthy. Measurable.</h3>
          <p class="leading-normal text-opacity">Every product is third-party lab tested for nutrients — EPA, DHA, omega-3:6 ratios, and micronutrients — measured and published per SKU.</p>
          <p class="mbr-pill text-sm font-medium">up to 3,434 mg EPA+DHA / serving <span class="text-opacity">(king salmon)</span></p>
        </div>
        <div class="mbr-card">
          <p class="{{ kicker_class }}">Verified Safe &amp; Clean</p>
          <h3 class="heading title-sm">When we say clean, there's a certificate behind it.</h3>
          <p class="leading-normal text-opacity">Seatopia third-party lab tests every supplier, and then continues to audit them regularly to ensure that they consistently meet their standards. The result is a downloadable Certificate of Analysis, not a marketing word.</p>
          <p class="mbr-pill text-sm font-medium">mercury &le; 0.1 ppm · 0 microplastics</p>
        </div>
        <div class="mbr-card">
          <p class="{{ kicker_class }}">Precision Frozen</p>
          <h3 class="heading title-sm">Precision freezing you can taste.</h3>
          <p class="leading-normal text-opacity">From harvest to precision freezing and cold-chain delivery, every step protects quality, texture, and safety — meeting or exceeding FDA guidelines.</p>
          <p class="mbr-pill text-sm font-medium">snap-frozen at peak freshness</p>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ==================== Why a membership ==================== {%- endcomment -%}
  <section class="mbr-band mbr-tone--cream" id="why">
    <div class="page-width">
      <div class="mbr-head title-wrapper leading-none flex flex-col gap-4 relative z-1">
        <p class="{{ eyebrow_class }}">Why a membership</p>
        <h2 class="heading title-lg">Don't just buy seafood. Build a practice.</h2>
        <div class="description rte leading-normal subtext-md text-opacity">
          <p>Seafood fueled human evolution — the marine omega-3s that shaped our brains and longevity came from the sea. That benefit is real, but it lives in the repetition, not the occasional splurge.</p>
        </div>
      </div>
      <div class="mbr-grid mbr-grid--2">
        <div class="mbr-card">
          <p class="{{ kicker_class }}">The idea</p>
          <h3 class="heading title-sm">The benefit is in the repetition.</h3>
          <p class="leading-normal text-opacity">One great piece of fish is a lovely dinner. Eating clean, omega-rich seafood three to four times a week is what actually moves your numbers — and that only happens when it's already in your kitchen.</p>
        </div>
        <div class="mbr-card mbr-card--dark mbr-tone--dark">
          <p class="{{ kicker_class }}">The membership</p>
          <h3 class="heading title-sm">We make repetition effortless.</h3>
          <p class="leading-normal text-opacity">A box you customize, delivered on ocean time, third-party lab tested at the supplier level — with chef classes and a concierge so cooking it stays a pleasure, not a project. The habit does the rest.</p>
        </div>
      </div>
      <p class="mbr-tagline heading title-sm"><em>Food as medicine, not marketing.</em></p>
    </div>
  </section>

  {%- comment -%} ==================== Certificate / confidence (dark anchor) ==================== {%- endcomment -%}
  <section class="mbr-band mbr-tone--dark" id="standard">
    <div class="page-width">
      <div class="mbr-head title-wrapper leading-none flex flex-col gap-4 relative z-1">
        <p class="{{ eyebrow_class }}">Proof over poetry</p>
        <h2 class="heading title-lg">Other brands sell seafood. We sell confidence.</h2>
        <div class="description rte leading-normal subtext-md text-opacity">
          <p>Every health claim we make is grounded in product-level lab data. Read it like a certificate of analysis — because that's exactly what it is.</p>
        </div>
      </div>
      <div class="mbr-coa" data-testid="coa-card">
        <p class="mbr-coa__head {{ kicker_class }}">CERTIFICATE OF ANALYSIS — SEATOPIA STANDARD™ · THIRD-PARTY VERIFIED</p>
        <div class="mbr-coa__row">
          <div class="mbr-coa__data"><p class="text-sm text-opacity">Methylmercury</p><p class="heading title-sm">&le; 0.1 ppm</p><p class="text-sm leading-normal text-opacity">Held to a &le; 0.1 ppm ceiling, and quantified batch by batch — not estimated.</p></div>
          <span class="mbr-coa__tag badge font-medium leading-none rounded-full">Within standard</span>
        </div>
        <div class="mbr-coa__row">
          <div class="mbr-coa__data"><p class="text-sm text-opacity">Microplastics</p><p class="heading title-sm">0 detected</p><p class="text-sm leading-normal text-opacity">No microplastics detected in third-party testing.</p></div>
          <span class="mbr-coa__tag badge font-medium leading-none rounded-full">Within standard</span>
        </div>
        <div class="mbr-coa__row">
          <div class="mbr-coa__data"><p class="text-sm text-opacity">Omega-3 · EPA + DHA</p><p class="heading title-sm">3,434 mg / serving*</p><p class="text-sm leading-normal text-opacity">Marine EPA + DHA in bioavailable form, measured per species and published.</p></div>
          <span class="mbr-coa__tag badge font-medium leading-none rounded-full">Nutrient dense</span>
        </div>
        <p class="mbr-coa__foot {{ kicker_class }}">134+ PUBLISHED PRODUCT QUALITY REPORTS · A CERTIFICATE OF ANALYSIS PER SKU · *KING SALMON, VARIES BY SPECIES</p>
      </div>
    </div>
  </section>

  {%- comment -%} ==================== Health you can measure ==================== {%- endcomment -%}
  <section class="mbr-band" id="health">
    <div class="page-width">
      <div class="mbr-head title-wrapper leading-none flex flex-col gap-4 relative z-1">
        <p class="{{ eyebrow_class }}">Health you can measure</p>
        <h2 class="heading title-lg">The whole point is a number you can move.</h2>
        <div class="description rte leading-normal subtext-md text-opacity">
          <p>The Omega-3 Index measures the EPA and DHA in your red blood cells. A higher index is associated with better long-term heart and brain health — and unlike a feeling, it's something you can actually test.</p>
        </div>
      </div>
      <div class="mbr-grid mbr-grid--2 mbr-health">
        <div class="mbr-card mbr-card--dark mbr-tone--dark mbr-badge-card">
          <div class="mbr-badge-card__img">
            {%- if health_img != blank -%}
              {{ health_img | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 768px) 50vw, 100vw', widths: '500,700,1000', alt: 'Dr. Casey Means and James Arthur Smith sharing a Seatopia meal' }}
            {%- else -%}
              <img src="https://seatopia.fish/cdn/shop/files/DrCaseyMeans-Seatopia-34.jpg?width=1000" alt="Dr. Casey Means and James Arthur Smith sharing a Seatopia meal" loading="lazy" width="500" height="316">
            {%- endif -%}
          </div>
          <p class="heading title-xl leading-none">8%</p>
          <p class="leading-normal text-opacity">Three to four Seatopia meals a week can help support an Omega-3 Index in the desirable range — an index above 8% is associated with better long-term heart and brain health. Consistency is the mechanism, and a monthly box is how you keep it.</p>
        </div>
        <div class="mbr-stack">
          <div class="mbr-card">
            <h3 class="heading title-sm">Brain &amp; cognition</h3>
            <p class="leading-normal text-opacity">DHA is a primary structural fat in the brain. It's the marine omega-3 most associated with cognitive function across a lifetime.</p>
            <p class="{{ kicker_class }}">DHA · Structural brain fat</p>
          </div>
          <div class="mbr-card">
            <h3 class="heading title-sm">Heart &amp; longevity</h3>
            <p class="leading-normal text-opacity">EPA and DHA support a healthy inflammatory response and cardiovascular function — the biological reasons seafood has always been called a superfood.</p>
            <p class="{{ kicker_class }}">EPA + DHA · Cardiovascular</p>
          </div>
          <div class="mbr-card">
