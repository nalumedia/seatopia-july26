{%- comment -%}
  Omegamaxxing: a practical guide to getting more omega-3s from your food.
  Rendered by templates/page.omegamaxxing.json, from the Omegamaxxing PDF guide.

  The section renders in two parts so the template can put native shop sections between them,
  the way the seasonal guides do:
  - part one: hero, intro, basics, testing, omega-6s and labels, choosing your seafood
  - part two: cooking, absorbing, putting it together, recipe ideas, what arrives, references

  Built like the freshness page: the theme's type (heading / title-* / subtext-* / text-*),
  layout (page-width, --sp-*, --rounded-block) and motion (animate-picture, media-element
  parallax, theme.Animation fade-ups via data-om-animate). Chips fly in and the oil bars grow
  when they scroll into view; both sit still under prefers-reduced-motion.

  Copy follows brand/claims-guide.md v0.32. Lines marked "verbatim" are the guide's green
  wording: do not reword them. The PDF's inflammation spread, its fertility and pregnancy
  chapter, its omega-3 index bands and its population statistics are not on this page; they
  are waiting on Clark. A lab figure must keep all three parts in one unit at one weight:
  product name, number with serving size, and the variance note.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign part = s.part
  assign eyebrow_class = 'heading normal-case font-medium subtext-lg leading-none tracking-none'
  assign kicker_class = 'text-sm font-medium text-opacity leading-tight'
-%}

{%- capture om_check -%}<svg class="om-chip__check" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="12" fill="currentColor" opacity=".16"/><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}

<style>
  #shopify-section-{{ section.id }} {
    --om-band-space: {{ s.band_padding }}px;
    --om-band-space-mobile: {{ s.band_padding_mobile }}px;
  }
  {%- assign tones = 'sage,dark' | split: ',' -%}
  {%- for tone in tones -%}
    {%- case tone -%}
      {%- when 'sage' -%}{%- assign bg = s.sage_background -%}{%- assign fg = s.sage_text -%}
      {%- when 'dark' -%}{%- assign bg = s.dark_background -%}{%- assign fg = s.dark_text -%}
    {%- endcase -%}
    {%- assign border = fg | color_mix: bg, 18 -%}
    #shopify-section-{{ section.id }} .om-tone--{{ tone }} {
      --color-background: {{ bg.red }} {{ bg.green }} {{ bg.blue }};
      --color-foreground: {{ fg.red }} {{ fg.green }} {{ fg.blue }};
      --color-border: {{ border | color_extract: 'red' }} {{ border | color_extract: 'green' }} {{ border | color_extract: 'blue' }};
      background: rgb(var(--color-background));
      color: rgb(var(--color-foreground));
    }
  {%- endfor -%}
</style>

{%- if part == 'one' -%}
<style>
  .om :where(h1, h2, h3, p, figure, dl, dd, ol, ul) { margin: 0; }
  .om :where(h1, h2, h3) { color: inherit; }
  .om-band { padding-block: var(--om-band-space); }
  @media (max-width: 767px) { .om-band { padding-block: var(--om-band-space-mobile); } }
  .om-reading { max-width: 46rem; }
  .om-center { margin-inline: auto; text-align: center; }
  .om-stack { display: flex; flex-direction: column; gap: var(--sp-5); }
  .om-head { display: flex; flex-direction: column; gap: var(--sp-4); }
  .om [id^="om-"] { scroll-margin-block-start: calc(var(--header-height, 80px) + var(--sp-6)); }

  /* Media */
  .om-media { position: relative; overflow: hidden; border-radius: var(--rounded-block); background: rgb(var(--color-placeholder)); }
  .om-media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .om-media--tall { aspect-ratio: 4 / 5; }
  .om-media--wide { aspect-ratio: 16 / 7; }
  .om-media--land { aspect-ratio: 3 / 2; }
  .om-media--square { aspect-ratio: 1 / 1; }
  @media (max-width: 767px) { .om-media--wide { aspect-ratio: 4 / 3; } }

  /* Chips: glass pills with a check, as in the guide */
  .om-chips { display: flex; flex-wrap: wrap; gap: var(--sp-3); list-style: none; padding: 0; }
  .om-chip { display: inline-flex; align-items: center; gap: var(--sp-2d5); padding: var(--sp-2) var(--sp-5) var(--sp-2) var(--sp-2); border-radius: 999px; border: 1px solid rgb(255 255 255 / .28); background: rgb(70 60 55 / .42); color: #fff; -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); text-decoration: none; font-weight: 500; line-height: 1.1; }
  .om-chip__check { flex: none; width: 1.75rem; height: 1.75rem; color: #7bd389; }
  a.om-chip:hover { border-color: rgb(255 255 255 / .6); }
  .om-chip--light { background: rgb(255 255 255 / .9); color: rgb(var(--color-foreground)); border-color: rgb(var(--color-border)); }
  .om-chip--light .om-chip__check { color: #3f8f53; }
  [data-om-fly] .om-chip { opacity: 0; transform: translate3d(-32px, 10px, 0); transition: opacity .6s ease var(--om-delay, 0ms), transform .8s cubic-bezier(.2,.8,.2,1) var(--om-delay, 0ms); }
  [data-om-fly].is-in .om-chip { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { [data-om-fly] .om-chip { opacity: 1; transform: none; transition: none; } }

  /* Hero */
  .om-hero { position: relative; min-height: min(92vh, 880px); display: flex; align-items: flex-end; overflow: hidden; color: #fff; background: #1f211f; }
  .om-hero__bg { position: absolute; inset: 0; }
  .om-hero__bg img { width: 100%; height: 100%; object-fit: cover; }
  .om-hero__bg::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(20 20 18 / .55) 0%, rgb(20 20 18 / .15) 45%, rgb(20 20 18 / .6) 100%); }
  .om-hero__inner { position: relative; width: 100%; padding-block: calc(var(--sp-8) * 2) var(--sp-8); display: flex; flex-direction: column; gap: var(--sp-6); }
  .om-hero__deck { max-width: 30rem; font-family: var(--font-heading-family); }
  .om-wordmark { white-space: nowrap; font-family: var(--font-body-family); font-weight: 600; font-size: clamp(3rem, 12.6vw, 15rem); line-height: .85; letter-spacing: -.045em; margin-block-start: var(--sp-6); }
  .om-hero .om-chips { margin-block-start: var(--sp-2); }
  .om-hero__inner, .om-hero__inner :where(p, h1) { color: #fff; }

  /* Intro + contents */
  .om-intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(var(--sp-8), 6vw, calc(var(--sp-8) * 2.5)); align-items: start; }
  .om-contents { list-style: none; padding: 0; counter-reset: om; }
  .om-contents li { border-block-start: 1px solid rgb(var(--color-border)); }
  .om-contents li:last-child { border-block-end: 1px solid rgb(var(--color-border)); }
  .om-contents a { display: grid; grid-template-columns: 2.5rem 1fr; gap: var(--sp-3); padding-block: var(--sp-4); text-decoration: none; color: inherit; }
  .om-contents a:hover .om-contents__title { text-decoration: underline; text-underline-offset: .2em; }
  .om-contents__n { font-variant-numeric: tabular-nums; padding-block-start: .3em; }
  .om-contents__sub { font-family: var(--font-heading-family); font-style: italic; }
  @media (max-width: 989px) { .om-intro { grid-template-columns: 1fr; } }

  /* Split: copy beside a photo */
  .om-split { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(var(--sp-8), 5vw, calc(var(--sp-8) * 2)); align-items: start; }
  .om-split--flip > :first-child { order: 2; }
  .om-split__media { position: sticky; top: calc(var(--header-height, 80px) + var(--sp-6)); }
  @media (max-width: 989px) {
    .om-split { grid-template-columns: 1fr; }
    .om-split--flip > :first-child { order: 0; }
    .om-split__media { position: static; }
  }

  /* Rows: label column + text */
  .om-rows > * { display: grid; grid-template-columns: 11rem 1fr; gap: var(--sp-6); padding-block: var(--sp-5); border-block-start: 1px solid rgb(var(--color-border)); }
  .om-rows > *:last-child { border-block-end: 1px solid rgb(var(--color-border)); }
  .om-rows dt { display: flex; flex-direction: column; gap: var(--sp-1d5); }
  .om-rows dd { display: flex; flex-direction: column; gap: var(--sp-1d5); }
  .om-type { font-family: var(--font-body-family); font-weight: 600; font-size: clamp(2rem, 3.4vw, 2.75rem); letter-spacing: -.03em; line-height: 1; }
  .om-italic { font-family: var(--font-heading-family); font-style: italic; }
  .om-tags { font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; display: flex; flex-wrap: wrap; gap: .25rem .75rem; }
  .om-tags a { color: inherit; }
  @media (max-width: 767px) { .om-rows > * { grid-template-columns: 1fr; gap: var(--sp-2); } }

  /* Numbered cards */
  .om-grid { display: grid; gap: var(--sp-6); }
  .om-grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .om-grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .om-num { display: flex; flex-direction: column; gap: var(--sp-2); padding-block-start: var(--sp-4); border-block-start: 1px solid rgb(var(--color-border)); }
  .om-num__n { font-variant-numeric: tabular-nums; }
  @media (max-width: 989px) { .om-grid--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 599px) { .om-grid--2, .om-grid--4 { grid-template-columns: 1fr; } }

  /* Takeaway */
  .om-takeaway { display: flex; flex-direction: column; gap: var(--sp-2); padding-block-start: var(--sp-5); border-block-start: 1px solid rgb(var(--color-border)); }
  .om-takeaway p:last-child { font-family: var(--font-heading-family); font-style: italic; }

  /* Levers */
  .om-levers { list-style: none; padding: 0; }
  .om-levers li { border-block-start: 1px solid rgb(var(--color-border)); }
  .om-levers li:last-child { border-block-end: 1px solid rgb(var(--color-border)); }
  .om-levers a { display: grid; grid-template-columns: 2.5rem 1fr; gap: var(--sp-3); padding-block: var(--sp-4); color: inherit; text-decoration: none; }
  .om-levers a:hover strong { text-decoration: underline; text-underline-offset: .2em; }

  /* Oil chart */
  .om-oils { width: 100%; border-collapse: collapse; }
  .om-oils caption { text-align: start; padding-block-end: var(--sp-4); }
  .om-oils th, .om-oils td { padding-block: var(--sp-3); border-block-start: 1px solid rgb(var(--color-border)); text-align: start; vertical-align: middle; font-weight: 400; }
  .om-oils tr:last-child > * { border-block-end: 1px solid rgb(var(--color-border)); }
  .om-oils__bar { width: 34%; padding-inline: var(--sp-4); }
  .om-oils__track { display: block; height: .75rem; }
  .om-oils__fill { display: block; height: 100%; width: var(--om-w); background: rgb(var(--color-foreground)); border-radius: 2px; transform-origin: left center; }
  .om-oils__fill--mid { opacity: .55; }
  .om-oils__fill--low { opacity: .3; }
  .om-oils__pct { white-space: nowrap; font-variant-numeric: tabular-nums; font-weight: 500; padding-inline-end: var(--sp-4); }
  .om-oils__note { font-family: var(--font-heading-family); font-style: italic; }
  [data-om-bars] .om-oils__fill { transform: scaleX(0); transition: transform 1s cubic-bezier(.2,.8,.2,1); }
  [data-om-bars].is-in .om-oils__fill { transform: none; }
  @media (prefers-reduced-motion: reduce) { [data-om-bars] .om-oils__fill { transform: none; transition: none; } }
  @media (max-width: 767px) {
    .om-oils__bar { display: none; }
    .om-oils th { width: 50%; }
  }

  /* Label phrases */
  .om-phrase h3 { font-family: var(--font-body-family); font-weight: 600; letter-spacing: -.02em; }

  /* Published result: product, number with serving, and variance note in one unit at one weight */
  .om-result { display: flex; flex-direction: column; gap: var(--sp-4); padding: var(--sp-6); border: 1px solid rgb(var(--color-border)); border-radius: var(--rounded-block); background: rgb(var(--color-foreground) / .03); }
  .om-links { display: flex; flex-wrap: wrap; gap: var(--sp-2) var(--sp-5); }
</style>

<article class="om" id="omegamaxxing" aria-labelledby="om-title">

  {%- comment -%} ============================ HERO ============================ {%- endcomment -%}
  {%- liquid
    assign hero_desk = images['omegamaxxing-01-hero-salmon-platter.jpg']
    assign hero_mob = images['omegamaxxing-02-hero-mobile-garnish.jpg']
  -%}
  <section class="om-hero">
    <div class="om-hero__bg">
      <picture is="animate-picture" data-animate="zoom-out" class="block w-full h-full">
        {%- if hero_mob != blank -%}
          <source media="(max-width: 749px)" srcset="{{ hero_mob | image_url: width: 750 }} 750w, {{ hero_mob | image_url: width: 1100 }} 1100w, {{ hero_mob | image_url: width: 1333 }} 1333w" sizes="100vw">
        {%- endif -%}
        {%- if hero_desk != blank -%}
          {{ hero_desk | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '900,1200,1600,2000,2400', alt: 'Sliced salmon fanned out on a teal ceramic platter.' }}
        {%- endif -%}
      </picture>
    </div>
    <div class="page-width om-hero__inner">
      <p class="{{ eyebrow_class }}">Seatopia · A practical guide</p>
      <p class="om-hero__deck title-sm leading-tight">A practical guide to getting more omega-3s from your food.</p>
      <ul class="om-chips" role="list" data-om-fly>
        <li style="--om-delay: 0ms;"><a class="om-chip" href="#om-buy">{{ om_check }}what to buy</a></li>
        <li style="--om-delay: 140ms;"><a class="om-chip" href="#om-cook">{{ om_check }}how to cook it</a></li>
        <li style="--om-delay: 280ms;"><a class="om-chip" href="#om-test">{{ om_check }}how to test</a></li>
      </ul>
      <h1 id="om-title" class="om-wordmark">omegamaxxing</h1>
    </div>
  </section>

  {%- comment -%} ============================ INTRO + CONTENTS ============================ {%- endcomment -%}
  <section class="om-band">
    <div class="page-width om-intro">
      <div class="om-stack">
        <p class="{{ eyebrow_class }}">omegamaxxing</p>
        <h2 class="heading title-lg tracking-heading leading-tight" data-om-animate>A practical guide to getting more omega-3s from your food: what to buy, how to cook it, and how to test.</h2>
        <p class="text-lg leading-normal">This guide takes a functional medicine approach. Instead of one number for everyone, it looks at what’s happening in your body: how much omega-3 actually reaches your cells, how well you absorb it, and what’s competing with it.</p>
      </div>
      <nav aria-label="Contents">
        <p class="{{ kicker_class }}" style="margin-block-end: var(--sp-3); letter-spacing: .12em; text-transform: uppercase;">Contents</p>
        <ol class="om-contents" role="list">
          {%- capture om_toc -%}om-basics|Omega-3 basics|the three types and what they do^om-test|Test, don’t guess|two numbers worth knowing^om-labels|Omega-6s and reading labels|seed oils ranked^om-buy|Choosing your seafood|what to buy first^om-cook|Cooking to protect omega-3s|methods ranked^om-absorb|Absorbing and using omega-3s|what to eat them with^om-together|Putting it all together|weekly target and checklist^om-recipes|Recipe ideas|raw dishes, soups, bakes and more{%- endcapture -%}
          {%- assign toc = om_toc | split: '^' -%}
          {%- for row in toc -%}
            {%- assign r = row | split: '|' -%}
            <li><a href="#{{ r[0] }}">
              <span class="om-contents__n text-sm text-opacity">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="flex flex-col gap-1">
                <span class="om-contents__title heading title-sm leading-tight">{{ r[1] }}</span>
                <span class="om-contents__sub text-base text-opacity">{{ r[2] }}</span>
              </span>
            </a></li>
          {%- endfor -%}
        </ol>
      </nav>
    </div>
  </section>

  {%- comment -%} ============================ 01 BASICS ============================ {%- endcomment -%}
  {%- assign img_a = images['omegamaxxing-18-chopsticks-bite.jpg'] -%}
  {%- assign img_b = images['omegamaxxing-07-eggs-roe-avocado-plate.jpg'] -%}
  <section class="om-band" id="om-basics" style="padding-block-start: 0;">
    <div class="page-width om-split">
      <div class="om-stack">
        <div class="om-head" data-om-animate>
          <p class="{{ kicker_class }}" style="letter-spacing: .12em; text-transform: uppercase;">Chapter 1</p>
          <h2 class="heading title-xl tracking-heading leading-none">Omega-3 basics</h2>
        </div>
        <p class="heading title-sm leading-tight om-italic">What is an omega-3?</p>
        <p class="text-lg leading-normal">An omega-3 is a type of fat (a polyunsaturated fatty acid). It’s called essential because your body can’t make it on its own, so you have to get it from food or supplements.</p>

        <p class="{{ kicker_class }}" style="margin-block-start: var(--sp-4); letter-spacing: .12em; text-transform: uppercase;">The three types</p>
        <dl class="om-rows">
          <div>
            <dt><span class="om-type">ALA</span><span class="om-italic text-base text-opacity">the plant omega-3</span></dt>
            <dd><strong class="text-lg">Flax, chia, walnuts, canola oil</strong><span class="text-base leading-normal">Your body has to convert it into EPA and DHA, and it does this poorly.</span></dd>
          </div>
          <div>
            <dt><span class="om-type">EPA</span><span class="om-italic text-base text-opacity">a marine omega-3</span></dt>
            <dd><strong class="text-lg">Fatty fish, already formed</strong><span class="text-base leading-normal">One of the two marine omega-3s. We publish how much is in every product.</span></dd>
          </div>
          <div>
            <dt><span class="om-type">DHA</span><span class="om-italic text-base text-opacity">a marine omega-3</span></dt>
            {%- comment -%} Verbatim: claims guide §4.E short owned form (Clark, accepted risk). No verb of action. {%- endcomment -%}
            <dd><strong class="text-lg">Fatty fish, already formed</strong><span class="text-base leading-normal">DHA is one of the main structural fats in the brain. We publish how much is in every product.</span></dd>
          </div>
        </dl>
        <p class="text-base leading-normal om-italic">This guide focuses on EPA and DHA, the two “marine” omega-3s. Fish already contains them in the form your body uses, so there’s no conversion step.</p>

        <div class="om-head" style="margin-block-start: var(--sp-8);" data-om-animate>
          <p class="{{ kicker_class }}" style="letter-spacing: .12em; text-transform: uppercase;">Why they matter</p>
          <h3 class="heading title-lg tracking-heading leading-tight">EPA and DHA do two jobs.</h3>
        </div>
        <div class="om-grid om-grid--2">
          <div class="om-num" data-om-animate>
            <span class="om-num__n text-sm text-opacity">01</span>
            <h4 class="heading title-sm leading-tight">They build your cells.</h4>
            <p class="text-base leading-normal">They’re part of the outer layer (membrane) of every cell, where they keep it flexible and working well.</p>
          </div>
          <div class="om-num" data-om-animate data-om-delay="120">
            <span class="om-num__n text-sm text-opacity">02</span>
            <h4 class="heading title-sm leading-tight">They send signals.</h4>
            <p class="text-base leading-normal">Your body uses them to make signaling molecules.</p>
          </div>
        </div>
      </div>
      <div class="om-split__media om-stack">
        <media-element class="om-media om-media--tall block" data-parallax="0.12" data-parallax-dir="vertical">
          <picture class="block w-full h-full" is="animate-picture" data-animate="zoom-out">
            {%- if img_a != blank -%}{{ img_a | image_url: width: 1333 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 45vw, 100vw', widths: '500,800,1100,1333', alt: 'A slice of salmon held up with chopsticks outdoors.' }}{%- endif -%}
          </picture>
        </media-element>
        <div class="om-media om-media--land">
          {%- if img_b != blank -%}{{ img_b | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 45vw, 100vw', widths: '500,800,1200,1600', alt: 'Soft scrambled eggs topped with salmon roe, beside sliced avocado and greens.' }}{%- endif -%}
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ============================ 02 TEST ============================ {%- endcomment -%}
  {%- assign img_c = images['omegamaxxing-04-salmon-roe-tin.jpg'] -%}
  <section class="om-band om-tone--sage" id="om-test">
    <div class="page-width om-split om-split--flip">
      <div class="om-stack">
        <div class="om-head" data-om-animate>
          <p class="{{ kicker_class }}" style="letter-spacing: .12em; text-transform: uppercase;">Chapter 2 · Your numbers</p>
          <h2 class="heading title-xl tracking-heading leading-none">Test, don’t guess.</h2>
        </div>
        {%- comment -%} Verbatim: claims guide §8.15. {%- endcomment -%}
        <p class="heading title-sm leading-tight om-italic">Guidelines count servings. We think you should count what’s in your blood.</p>
        <p class="text-lg leading-normal">Functional medicine starts with testing. One at-home finger-prick test gives you two numbers that tell you more than any food log.</p>
        <div class="om-grid om-grid--2">
          <div class="om-num" data-om-animate>
            <span class="om-num__n text-sm text-opacity">Number 1</span>
            <h3 class="heading title-sm leading-tight">Your Omega-3 Index</h3>
            <p class="text-base leading-normal">The percentage of EPA+DHA in the membranes of your red blood cells. Red blood cells live about 120 days, so the result shows your average intake over the past 3–4 months, not what you ate yesterday.</p>
          </div>
          <div class="om-num" data-om-animate data-om-delay="120">
            <span class="om-num__n text-sm text-opacity">Number 2</span>
            <h3 class="heading title-sm leading-tight">Your omega-6 to omega-3 ratio</h3>
            <p class="text-base leading-normal">How the two families of fat compare. You improve it from both sides: eat more EPA and DHA, and cut back on refined seed oils and ultra-processed foods.</p>
          </div>
        </div>
        {%- comment -%} Verbatim: claims guide §8.15, green building block 2. {%- endcomment -%}
        <p class="text-lg leading-normal">Researchers who study the omega-3 index measure blood levels rather than servings, and target higher intakes than general guidelines.</p>
        <div class="om-takeaway">
          <p class="{{ kicker_class }}" style="letter-spacing: .12em; text-transform: uppercase;">Takeaway</p>
          {%- comment -%} Verbatim: claims guide §8.15. {%- endcomment -%}
          <p class="title-sm leading-tight">There’s a finger-prick test for your omega-3 index. Take it, change one thing, retest in four months.</p>
        </div>
        {%- if s.test_product != blank -%}
          <div>
            <a class="button button--primary button--md" href="{{ s.test_product.url }}" is="hover-link">
              <span class="btn-fill" data-fill></span>
              <span class="btn-text">Get the {{ s.test_product.title | split: ', ' | last }}</span>
            </a>
          </div>
        {%- endif -%}
      </div>
      <div class="om-split__media">
        <div class="om-media om-media--tall">
          {%- if img_c != blank -%}{{ img_c | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 45vw, 100vw', widths: '500,800,1200,1600', alt: 'An open tin of salmon roe, close up.' }}{%- endif -%}
        </div>
      </div>
    </div>
  </section>

  <section class="om-band">
    <div class="page-width">
      <div class="om-split">
        <div class="om-head" data-om-animate>
          <p class="{{ kicker_class }}" style="letter-spacing: .12em; text-transform: uppercase;">Chapter 2 · Your numbers</p>
          <h2 class="heading title-lg tracking-heading leading-tight">The five levers</h2>
          <p class="text-lg leading-normal">Getting more omega-3s isn’t just about eating more fish. Five things work together:</p>
        </div>
        <ol class="om-levers" role="list">
          {%- capture om_levers -%}om-test|Know your starting point|test your levels^om-labels|Keep omega-6s in check|read labels for seed oils^om-buy|Choose high-EPA/DHA seafood|Chapter 4^om-cook|Cook it without damaging the fat|Chapter 5^om-absorb|Eat it in a way that helps your body absorb it|Chapter 6{%- endcapture -%}
          {%- assign levers = om_levers | split: '^' -%}
          {%- for row in levers -%}
            {%- assign r = row | split: '|' -%}
            <li data-om-animate data-om-delay="{{ forloop.index0 | times: 80 }}"><a href="#{{ r[0] }}">
              <span class="text-sm text-opacity" style="padding-block-start: .35em;">{{ forloop.index | prepend: '0' }}</span>
              <span class="text-lg leading-snug"><strong>{{ r[1] }}</strong> — {{ r[2] }}</span>
            </a></li>
          {%- endfor -%}
        </ol>
      </div>
    </div>
  </section>

  {%- comment -%} ============================ 03 OMEGA-6S ============================ {%- endcomment -%}
  <section class="om-band" id="om-labels" style="padding-block-start: 0;">
    <div class="page-width om-stack" style="gap: var(--sp-8);">
      <div class="om-split" style="align-items: end;">
        <div class="om-head" data-om-animate>
          <p class="{{ kicker_class }}" style="letter-spacing: .12em; text-transform: uppercase;">Chapter 3</p>
          <h2 class="heading title-xl tracking-heading leading-none">Omega-6s and reading labels</h2>
        </div>
        <div class="om-stack">
          <p class="text-lg leading-normal">The main omega-6 in the Western diet is linoleic acid, and most of it comes from refined seed oils. These oils show up in almost everything packaged: alternative milks, dressings, snacks, baked goods and restaurant fryers.</p>
          <p class="text-lg leading-normal">Whole foods like nuts and seeds also contain omega-6, but they come with fiber, vitamin E and antioxidants. The focus here is refined oils in processed food.</p>
        </div>
      </div>

      {%- capture om_oils -%}Safflower oil (regular)|75|~75%|Limit — highest|hi^Grapeseed oil|70|~70%|Limit|hi^Sunflower oil (regular)|65|~65%|Limit|hi^Corn oil|55|~55%|Limit|hi^Cottonseed oil|52|~50–55%|Limit|hi^Soybean oil / “vegetable oil”|52|~50–55%|Limit — the most common|hi^Rice bran oil|35|~35%|Moderate|mid^Peanut oil|30|~30%|Moderate|mid^Canola / rapeseed oil|20|~20%|Middle ground; also has some plant omega-3|mid^High-oleic sunflower or safflower|10|~5–15%|Better choice|low^Olive oil, avocado oil|10|~10%|Good choice|low^Coconut oil, butter, ghee|3|~2–3%|Low omega-6 (but mostly saturated fat)|low{%- endcapture -%}
      {%- assign oils = om_oils | split: '^' -%}
      <div data-om-bars>
        <table class="om-oils">
          <caption><span class="heading title-sm">Oils ranked by omega-6</span> <span class="om-italic text-base text-opacity">Percent of the oil’s fat that is linoleic acid (approximate)</span></caption>
          <tbody>
            {%- for row in oils -%}
              {%- assign o = row | split: '|' -%}
              <tr>
                <th scope="row" class="text-base">{{ o[0] }}</th>
                <td class="om-oils__bar" aria-hidden="true"><span class="om-oils__track"><span class="om-oils__fill om-oils__fill--{{ o[4] }}" style="--om-w: {{ o[1] | times: 1.33 }}%; transition-delay: {{ forloop.index0 | times: 50 }}ms;"></span></span></td>
                <td class="om-oils__pct text-base">{{ o[2] }}</td>
                <td class="om-oils__note text-base text-opacity">{{ o[3] }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>

      <div class="om-head" data-om-animate>
        <p class="{{ kicker_class }}" style="letter-spacing: .12em; text-transform: uppercase;">Chapter 3 · Omega-6s and reading labels</p>
        <h3 class="heading title-lg tracking-heading leading-tight">Label phrases to watch for</h3>
      </div>
      <div class="om-grid om-grid--4">
        <div class="om-num om-phrase" data-om-animate><h4 class="title-sm leading-tight">“Vegetable oil”</h4><p class="text-base leading-normal">“Vegetable oil” or “contains one or more of the following: soybean, corn…” usually means the cheapest high-omega-6 oils.</p></div>
        <div class="om-num om-phrase" data-om-animate data-om-delay="80"><h4 class="title-sm leading-tight">“Sunflower oil”</h4><p class="text-base leading-normal">“Sunflower oil” or “safflower oil” without “high-oleic.” High-oleic versions are bred to be low in omega-6, so that word matters.</p></div>
        <div class="om-num om-phrase" data-om-animate data-om-delay="160"><h4 class="title-sm leading-tight">“Expeller-pressed”</h4><p class="text-base leading-normal">“Expeller-pressed” or “cold-pressed” describes how the oil was extracted, not what’s in it. Expeller-pressed sunflower oil is still high in omega-6.</p></div>
        <div class="om-num om-phrase" data-om-animate data-om-delay="240"><h4 class="title-sm leading-tight">Position in the list</h4><p class="text-base leading-normal">Ingredients are listed by weight. An oil in the top three is a real source; near the end, it’s minor.</p></div>
      </div>
      <div class="om-takeaway">
        <p class="{{ kicker_class }}" style="letter-spacing: .12em; text-transform: uppercase;">Takeaway</p>
        <p class="title-sm leading-tight">Check the oil on the label. Choose olive, avocado or high-oleic oils, which are more heat-stable, and cut back on products made with soybean, corn, sunflower or “vegetable” oil.</p>
      </div>
    </div>
  </section>

  {%- comment -%} ============================ 04 CHOOSING YOUR SEAFOOD ============================ {%- endcomment -%}
  {%- assign img_d = images['omegamaxxing-11-salmon-fillets.jpg'] -%}
  {%- assign img_e = images['omegamaxxing-14-dressing-platter-kitchen.jpg'] -%}
  <section class="om-band om-tone--dark" id="om-buy">
    <div class="page-width om-split">
      <div class="om-stack">
        <div class="om-head" data-om-animate>
          <p class="{{ kicker_class }}" style="letter-spacing: .12em; text-transform: uppercase;">Chapter 4</p>
          <h2 class="heading title-xl tracking-heading leading-none">Choosing your seafood</h2>
        </div>
        <h3 class="heading title-sm leading-tight">Rule of thumb for shopping</h3>
        <p class="text-lg leading-normal">Fattier, cold-water fish (king salmon, steelhead, Atlantic salmon) carry more omega-3s per ounce than lean whitefish or shellfish. If your goal is more EPA/DHA, build your week around salmon and steelhead. Treat whitefish and shellfish as flavor and variety, not your main omega-3 source.</p>
        <h3 class="heading title-sm leading-tight" style="margin-block-start: var(--sp-4);">Why lab-tested numbers matter</h3>
        <p class="text-lg leading-normal">We publish lab-tested omega-3 values for our products, backed by third-party Certificates of Analysis from Edacious. That lets you compare options by the number.</p>
        {%- comment -%} Verbatim: claims guide §4.E published-result format. All three parts, one unit, one weight. {%- endcomment -%}
        <div class="om-result" data-om-animate>
          <p class="{{ kicker_class }}" style="letter-spacing: .12em; text-transform: uppercase;">Published result</p>
          <p class="heading title-md leading-tight">Our King Salmon tested at 2,414 mg EPA+DHA per 6 oz serving. Values vary by sample and season.</p>
        </div>
        {%- comment -%} Verbatim: the always-safe sentence, claims guide §3. {%- endcomment -%}
        <p class="text-base leading-normal text-opacity">Every supplier is third-party tested for nutrition, mercury and microplastics, then randomly audited to ensure consistent compliance with the Seatopia Standard.</p>
        <div class="om-links text-base">
          <a class="link font-medium" href="/products/king-salmon">King Salmon</a>
          <a class="link font-medium" href="/products/atlantic-salmon-2x-6oz-portions">Atlantic Salmon</a>
          <a class="link font-medium" href="/products/steelhead-sashimi-loin-12oz">Steelhead Sashimi Loin</a>
          <a class="link font-medium" href="/products/salmon-box">Salmon Lover’s Box</a>
        </div>
      </div>
      <div class="om-split__media om-stack">
        <media-element class="om-media om-media--land block" data-parallax="0.12" data-parallax-dir="vertical">
          <picture class="block w-full h-full" is="animate-picture" data-animate="zoom-out">
            {%- if img_d != blank -%}{{ img_d | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 45vw, 100vw', widths: '500,800,1200,1800', alt: 'Raw salmon fillets on a board, ready to cook.' }}{%- endif -%}
          </picture>
        </media-element>
        <div class="om-media om-media--land">
          {%- if img_e != blank -%}{{ img_e | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 45vw, 100vw', widths: '500,800,1200,1800', alt: 'Dressing a platter of sliced salmon in a home kitchen.' }}{%- endif -%}
        </div>
      </div>
    </div>
  </section>
</article>

{%- else -%}

