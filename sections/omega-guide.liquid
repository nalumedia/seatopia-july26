<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var reveal = function (sel) {
      var els = root.querySelectorAll(sel);
      if (!els.length) return;
      if (!('IntersectionObserver' in window)) { els.forEach(function (el) { el.classList.add('is-in'); }); return; }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
      }, { threshold: 0.3 });
      els.forEach(function (el) { io.observe(el); });
    };
    reveal('[data-om-fly]');
    reveal('[data-om-bars]');

    /* Fade-ups through the theme's own Animation class, as on the freshness page. */
    var run = function () {
      if (!window.theme || !theme.Animation || !window.Motion || theme.config.motionReduced) return;
      root.querySelectorAll('[data-om-animate]').forEach(function (el) {
        el.setAttribute('data-animate', 'fade-up');
        if (el.hasAttribute('data-om-delay')) el.setAttribute('data-animate-delay', el.getAttribute('data-om-delay'));
        var a = new theme.Animation(el);
        a.type = 'fade-up';
        a.beforeLoad();
        Motion.inView(el, function () { a.load(); }, { margin: '0px 0px -10% 0px' });
      });
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
    else run();
  })();
</script>

