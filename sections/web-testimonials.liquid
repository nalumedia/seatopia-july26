{%- comment -%}
  Web kit — testimonials. Figma 4593:639: centred heading, two white cards with a round
  portrait, a Crimson quote, name, role and stars, then the Judge.me shop rating.

  CLAIMS GUIDE §4.H / 16 CFR Part 465: only real, attributable quotes. A paid partner
  or affiliate is disclosed inside the card (the Disclosure field), never elsewhere.
  The rating line reads Judge.me's shop metafields and is never typed.
{%- endcomment -%}
{%- render 'uikit-fonts' -%}
{{ 'web-kit.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign rv_count = shop.metafields.judgeme.all_reviews_count | plus: 0
  assign rv_rating = shop.metafields.judgeme.all_reviews_rating | plus: 0.0
-%}
<div class="wk wk-section wk-section--{{ section.settings.tone }}">
  <div class="wk-container wk-testi">
    {%- if section.settings.heading != blank -%}<h2 class="wk-display wk-testi__heading">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<p class="wk-body wk-muted wk-testi__intro">{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="wk-testi__cards" role="list">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <li class="wk-testi__card" {{ block.shopify_attributes }}>
            {%- if b.image != blank -%}
              <span class="wk-media wk-testi__avatar">{{ b.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120,160,240', sizes: '80px', alt: '' }}</span>
            {%- endif -%}
            <div class="wk-testi__body">
              <blockquote class="wk-testi__quote">{{ b.quote }}</blockquote>
              <div class="wk-testi__byline">
                <div class="wk-testi__who">
                  <span class="wk-testi__name">{{ b.name }}</span>
                  {%- if b.role != blank -%}<span class="wk-body-s wk-muted--75 wk-testi__role">{{ b.role }}</span>{%- endif -%}
                  {%- if b.disclosure != blank -%}<span class="wk-body-xs wk-muted--75 wk-testi__disclosure">{{ b.disclosure }}</span>{%- endif -%}
                </div>
                {%- if b.rating != blank -%}
                  <span class="wk-stars wk-testi__stars" aria-label="{{ b.rating }} out of 5">{%- for i in (1..5) -%}<span aria-hidden="true">{% if i <= b.rating %}★{% else %}☆{% endif %}</span>{%- endfor -%} {{ b.rating }}.0</span>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if section.settings.show_rating and rv_count > 0 -%}
      <p class="wk-testi__summary">
        <span class="wk-stars" aria-hidden="true">★★★★★</span>
        <span class="wk-testi__summary-score">{{ rv_rating | round: 1 }} out of 5</span>
        <span class="wk-body-s wk-muted--75">Based on {{ rv_count }} reviews · <a href="{{ section.settings.reviews_link | default: '/pages/reviews' }}">Collected by Judge.me</a></span>
      </p>
    {%- endif -%}
  </div>
</div>

<style>
  .wk-testi { display: flex; flex-direction: column; align-items: center; gap: 20px; }
  .wk .wk-testi__heading { text-align: center; max-width: 900px; }
  .wk-testi__intro { text-align: center; margin-bottom: 36px; }
  .wk-testi__cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 24px; width: 100%; list-style: none; margin: 0; padding: 0; }
  .wk-testi__card { display: flex; gap: 28px; align-items: flex-start; padding: 40px; background: var(--wk-white); }
  .wk-testi__avatar { flex: none; width: 80px; height: 80px; border-radius: 50%; }
  .wk-testi__body { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .wk-testi__quote { margin: 0; font-family: var(--wk-font-heading); font-weight: 300; font-size: 26px; line-height: 1.05; letter-spacing: -0.03em; color: var(--wk-ink); }
  .wk-testi__byline { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .wk-testi__who { display: flex; flex-direction: column; gap: 2px; }
  .wk-testi__name { font-size: 16px; font-weight: 500; color: var(--wk-ink); }
  .wk-testi__role, .wk-testi__disclosure { font-size: 14px; }
  .wk-testi__stars { font-size: 14px; }
  .wk-testi__summary { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; justify-content: center; padding-top: 24px; }
  .wk-testi__summary .wk-stars { font-size: 18px; }
  .wk-testi__summary-score { font-size: 16px; font-weight: 500; color: var(--wk-ink); }
  .wk-testi__summary a { color: inherit; }
  @media (max-width: 749px) {
    .wk-testi__card { flex-direction: column; gap: 20px; padding: 28px; }
    .wk-testi__quote { font-size: 22px; }
    .wk-testi__intro { margin-bottom: 16px; }
  }
</style>

{% schema %}
{
  "name": "Web kit — testimonials",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "§4.H / 16 CFR Part 465: only real, attributable quotes. Disclose any paid or affiliate relationship in the card's Disclosure field." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our community trusts us for clean, healthy seafood" },
    { "type": "text", "id": "text", "label": "Intro" },
    { "type": "checkbox", "id": "show_rating", "label": "Show the Judge.me shop rating", "default": true },
    { "type": "url", "id": "reviews_link", "label": "Rating links to" },
    { "type": "select", "id": "tone", "label": "Background", "default": "sand", "options": [ { "value": "sand", "label": "Sand" }, { "value": "paper", "label": "Paper" }, { "value": "white", "label": "White" } ] }
  ],
  "blocks": [
    { "type": "review", "name": "Testimonial", "settings": [
      { "type": "image_picker", "id": "image", "label": "Portrait" },
      { "type": "textarea", "id": "quote", "label": "Quote (verbatim, with the quote marks)" },
      { "type": "text", "id": "name", "label": "Name" },
      { "type": "text", "id": "role", "label": "Role" },
      { "type": "text", "id": "disclosure", "label": "Disclosure", "info": "e.g. Paid partner and affiliate. Required for anyone we pay." },
      { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 }
    ]}
  ],
  "presets": [{ "name": "Web kit — testimonials" }]
}
{% endschema %}
