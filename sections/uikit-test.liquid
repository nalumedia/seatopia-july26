{%- comment -%}
  UI kit — at-home test explainer. Copy on the left (what the test measures, when you take it),
  an illustration of the account results page on the right. The illustration shows one example
  value and a pending retest, never a before-and-after: a depicted change reads as a typical
  result (claims guide §8.17). The real page is sections/omega-quant-account.liquid.
{%- endcomment -%}

<div class="uikit uikit-section"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}>
  <div class="uikit-container uikit-test">
    <div class="uikit-test__body">
      {%- if section.settings.eyebrow != blank -%}<p class="uikit-overline">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="uikit-h2 uikit-test__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="uikit-body-m uikit-prose uikit-test__text">{{ section.settings.text }}</div>{%- endif -%}

      {%- assign measures = section.blocks | where: 'type', 'measure' -%}
      {%- if measures.size > 0 -%}
        <details class="uikit-test__measures" open>
          <summary class="uikit-label-m">{{ section.settings.measures_label | default: 'What each test measures' }}</summary>
          <dl class="uikit-test__grid">
            {%- for block in measures -%}
              <div class="uikit-test__measure" {{ block.shopify_attributes }}>
                <dt class="uikit-label-s">{{ block.settings.title }}</dt>
                <dd class="uikit-body-s">{{ block.settings.text }}</dd>
              </div>
            {%- endfor -%}
          </dl>
        </details>
      {%- endif -%}

      {%- assign steps = section.blocks | where: 'type', 'step' -%}
      {%- if steps.size > 0 -%}
        <ol class="uikit-test__steps" role="list">
          {%- for block in steps -%}
            <li class="uikit-test__step" {{ block.shopify_attributes }}>
              <span class="uikit-label-s uikit-test__when">{{ block.settings.when }}</span>
              <span class="uikit-body-s">{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a class="uikit-btn uikit-btn--primary" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>

    <figure class="uikit-test__figure">
      <div class="uikit-test__mock" aria-hidden="true">
        <p class="uikit-test__mock-eyebrow">Your account</p>
        <p class="uikit-test__mock-title">Your Omega-3 Index</p>
        <div class="uikit-test__mock-row">
          <div>
            <p class="uikit-label-s">Test 1 · Baseline</p>
            <p class="uikit-body-s uikit-muted">{{ section.settings.mock_first_when }}</p>
          </div>
          <p class="uikit-test__mock-value">{{ section.settings.mock_value }}<span>%</span></p>
        </div>
        <div class="uikit-test__mock-row uikit-test__mock-row--pending">
          <div>
            <p class="uikit-label-s">Test 2 · Retest</p>
            <p class="uikit-body-s uikit-muted">{{ section.settings.mock_second_when }}</p>
          </div>
          <p class="uikit-test__mock-pending">Pending</p>
        </div>
      </div>
      {%- if section.settings.caption != blank -%}
        <figcaption class="uikit-body-s uikit-muted">{{ section.settings.caption }}</figcaption>
      {%- endif -%}
    </figure>
  </div>
</div>

<style>
  .uikit-test { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 60px; align-items: center; }
  .uikit-test__body { display: flex; flex-direction: column; align-items: flex-start; gap: 22px; }
  .uikit-test__heading { margin: 0; }
  .uikit-test__text { color: var(--uk-heading); }
  .uikit-test__text a { color: inherit; }
  .uikit-test__measures { width: 100%; border-top: 1px solid var(--uk-rule); border-bottom: 1px solid var(--uk-rule); padding: 16px 0; }
  .uikit-test__measures summary { cursor: pointer; color: var(--uk-heading); list-style: none; display: flex; justify-content: space-between; align-items: center; }
  .uikit-test__measures summary::-webkit-details-marker { display: none; }
  .uikit-test__measures summary::after { content: '+'; font-weight: 400; font-size: 20px; color: var(--uk-gold); }
  .uikit-test__measures[open] summary::after { content: '–'; }
  .uikit-test__grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 18px 24px; margin: 16px 0 0; }
  .uikit-test__measure dt { color: var(--uk-heading); margin-bottom: 4px; }
  .uikit-test__measure dd { margin: 0; color: var(--uk-text); }
  .uikit-test__steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; width: 100%; }
  .uikit-test__step { display: grid; grid-template-columns: 96px minmax(0,1fr); gap: 12px; align-items: baseline; }
  .uikit-test__when { color: var(--uk-gold); text-transform: uppercase; letter-spacing: .08em; font-size: 12px; }
  .uikit-test__figure { margin: 0; display: flex; flex-direction: column; gap: 12px; }
  .uikit-test__mock { background: var(--uk-white); border: 1px solid var(--uk-rule); border-radius: var(--uk-radius-card); padding: 28px; box-shadow: 0 18px 40px rgba(46,75,89,.10); font-family: var(--uk-font-body); }
  .uikit-test__mock p { margin: 0; }
  .uikit-test__mock-eyebrow { text-transform: uppercase; letter-spacing: .14em; font-size: 12px; color: var(--uk-gold); }
  .uikit-test__mock-title { font-family: var(--uk-font-heading); font-size: 30px; line-height: 1.1; color: var(--uk-heading); margin: 6px 0 18px !important; }
  .uikit-test__mock-row { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 0; border-top: 1px solid var(--uk-rule); color: var(--uk-heading); }
  .uikit-test__mock-value { font-family: var(--uk-font-heading); font-size: 40px; line-height: 1; color: var(--uk-heading); }
  .uikit-test__mock-value span { font-size: 18px; margin-left: 2px; color: var(--uk-muted); }
  .uikit-test__mock-pending { font-size: 13px; font-weight: 600; padding: 6px 12px; border-radius: var(--uk-radius-pill); border: 1px dashed var(--uk-gray-2); color: var(--uk-muted); }
  .uikit-test__mock-row--pending .uikit-label-s { color: var(--uk-muted); }
  @media (max-width: 989px) {
    .uikit-test { grid-template-columns: 1fr; gap: 40px; }
  }
  @media (max-width: 559px) {
    .uikit-test__grid { grid-template-columns: 1fr; }
    .uikit-test__step { grid-template-columns: 1fr; gap: 2px; }
    .uikit-test__mock { padding: 20px; }
  }
</style>

{% schema %}
{
  "name": "UI kit — test explainer",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor", "info": "Lets a button link to #anchor." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "measures_label", "label": "Measures heading", "default": "What each test measures" },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "header", "content": "Account illustration" },
    { "type": "paragraph", "content": "One example value and a pending retest. Never show a before-and-after (claims guide §8.17)." },
    { "type": "text", "id": "mock_value", "label": "Example value", "default": "5.2" },
    { "type": "text", "id": "mock_first_when", "label": "Test 1 note", "default": "Kit in box 1" },
    { "type": "text", "id": "mock_second_when", "label": "Test 2 note", "default": "Kit in box 3" },
    { "type": "text", "id": "caption", "label": "Caption" }
  ],
  "blocks": [
    {
      "type": "measure", "name": "Measure",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "step", "name": "Step",
      "settings": [
        { "type": "text", "id": "when", "label": "When" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "UI kit — test explainer" }]
}
{% endschema %}
