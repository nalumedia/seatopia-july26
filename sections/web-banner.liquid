{%- comment -%}
  Web kit — full-bleed banner. Figma 4592:539 (hero, 860px) and 4594:685 (final CTA,
  720px). With no heading, text or button it is a plain image band (4592:564, 640px).
{%- endcomment -%}
{%- render 'uikit-fonts' -%}
{{ 'web-kit.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign has_copy = false
  if s.heading != blank or s.text != blank or s.cta_label != blank
    assign has_copy = true
  endif
  assign fp = 'auto'
  if s.eager == 'eager'
    assign fp = 'high'
  endif
-%}
<div class="wk wk-banner{% unless has_copy %} wk-banner--band{% endunless %}" style="--wk-banner-h: {{ s.height }}px; --wk-banner-overlay: {{ s.overlay | divided_by: 100.0 }};">
  {%- if s.image != blank -%}
    {{ s.image | image_url: width: 2600 | image_tag: loading: s.eager, fetchpriority: fp, sizes: '100vw', widths: '800,1200,1600,2000,2600', class: 'wk-banner__img', alt: s.image.alt | default: '' }}
  {%- endif -%}
  {%- if has_copy -%}
    <div class="wk-banner__overlay" aria-hidden="true"></div>
    <div class="wk-banner__content">
      {%- if s.heading != blank -%}
        <h{{ s.heading_tag }} class="wk-display{% if s.heading_size == 'xl' %} wk-display--xl{% endif %} wk-banner__heading">{{ s.heading }}</h{{ s.heading_tag }}>
      {%- endif -%}
      {%- if s.text != blank -%}
        <div class="wk-body-l wk-banner__text">{{ s.text }}</div>
      {%- endif -%}
      {%- if s.cta_label != blank -%}
        <a class="wk-btn wk-btn--coral wk-banner__btn" href="{{ s.cta_link | default: '#' }}">{{ s.cta_label }}{% render 'web-kit-icon', name: 'arrow-right' %}</a>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

<style>
  .wk-banner { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: var(--wk-banner-h, 720px); padding: 64px var(--wk-gutter); background: var(--wk-ink); overflow: hidden; }
  .wk-banner--band { padding: 0; }
  .wk-banner__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* A band-shaped scrim: strongest behind the copy, lighter at the edges, plus a soft text shadow. The photo under the hero is bright and busy. */
  .wk-banner__overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(27, 46, 55, calc(var(--wk-banner-overlay, .52) * .7)) 0%, rgba(27, 46, 55, var(--wk-banner-overlay, .52)) 30%, rgba(27, 46, 55, var(--wk-banner-overlay, .52)) 70%, rgba(27, 46, 55, calc(var(--wk-banner-overlay, .52) * .7)) 100%); }
  .wk-banner__content { position: relative; display: flex; flex-direction: column; align-items: center; gap: 28px; width: 100%; max-width: 1040px; text-align: center; }
  .wk .wk-banner__heading { color: var(--wk-white); max-width: 1040px; text-shadow: 0 1px 2px rgba(0, 0, 0, .35), 0 10px 40px rgba(0, 0, 0, .3); }
  .wk-banner__text { color: var(--wk-white); max-width: 640px; display: flex; flex-direction: column; gap: 14px; font-weight: 500; text-shadow: 0 1px 2px rgba(0, 0, 0, .45), 0 6px 24px rgba(0, 0, 0, .3); }
  .wk-banner__btn { margin-top: 4px; }
  @media (max-width: 749px) {
    .wk-banner { min-height: calc(var(--wk-banner-h, 720px) * 0.7); padding-block: 48px; }
    .wk-banner--band { min-height: 56vw; }
    .wk-banner__content { gap: 20px; }
    .wk-banner__text { font-size: 17px; }
  }
</style>

{% schema %}
{
  "name": "Web kit — banner",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "height", "label": "Height", "min": 320, "max": 960, "step": 20, "unit": "px", "default": 720 },
    { "type": "range", "id": "overlay", "label": "Overlay", "min": 0, "max": 80, "step": 2, "unit": "%", "default": 60 },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "default": "display", "options": [ { "value": "display", "label": "Display" }, { "value": "xl", "label": "Extra large" } ] },
    { "type": "select", "id": "heading_tag", "label": "Heading tag", "default": "h2", "options": [ { "value": "h1", "label": "H1 (page title)" }, { "value": "h2", "label": "H2" } ] },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "select", "id": "eager", "label": "Image loading", "default": "lazy", "info": "Eager for the first banner on the page.", "options": [ { "value": "eager", "label": "Eager" }, { "value": "lazy", "label": "Lazy" } ] }
  ],
  "presets": [{ "name": "Web kit — banner" }]
}
{% endschema %}
