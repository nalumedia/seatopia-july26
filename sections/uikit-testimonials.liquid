{%- comment -%}
  UI kit — testimonials. Figma node 47:493

  CLAIMS GUIDE §4.H / 16 CFR Part 465 (eff. Oct 2024, civil penalties
  ~$53k per violation): never a review, testimonial or follower count we did
  not earn. Blocks ship EMPTY on purpose — paste real, attributable reviews.
  If a reviewer is a paid partner or affiliate, the material connection must be
  disclosed in the same visual unit (use the "Disclosure" field).
{%- endcomment -%}

<div class="uikit uikit-section">
  <div class="uikit-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="uikit-h2 uikit-revs__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="uikit-body-m uikit-muted uikit-revs__intro">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="uikit-revs" role="list">
        {%- for block in section.blocks -%}
          <li class="uikit-revs__item" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <span class="uikit-media uikit-revs__media" style="--uk-ratio: 1 / 1;">
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200,400,600', alt: '' }}
              </span>
            {%- endif -%}
            {%- if block.settings.rating != blank -%}
              <span class="uikit-revs__stars" aria-label="{{ block.settings.rating }} out of 5">
                {%- for i in (1..5) -%}<span aria-hidden="true">{% if i <= block.settings.rating %}★{% else %}☆{% endif %}</span>{%- endfor -%}
              </span>
            {%- endif -%}
            <blockquote class="uikit-body-s uikit-revs__text">{{ block.settings.quote }}</blockquote>
            <span class="uikit-label-s uikit-revs__name">{{ block.settings.name }}</span>
            {%- if block.settings.disclosure != blank -%}
              <span class="uikit-body-s uikit-muted">{{ block.settings.disclosure }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

<style>
  .uikit-revs__heading { text-align: center; max-width: 720px; margin-inline: auto; }
  .uikit-revs__intro { text-align: center; max-width: 620px; margin: 12px auto 48px; }
  .uikit-revs { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 24px; list-style: none; margin: 0; padding: 0; }
  .uikit-revs__item { display: flex; flex-direction: column; gap: 10px; background: var(--uk-white); border-radius: var(--uk-radius-card); padding: 24px; }
  .uikit-revs__media { aspect-ratio: 1 / 1; border-radius: var(--uk-radius-card); }
  .uikit-revs__stars { color: var(--uk-gold); letter-spacing: 2px; }
  .uikit-revs__text { margin: 0; }
  .uikit-revs__name { color: var(--uk-heading); }
  @media (max-width: 989px) { .uikit-revs { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "UI kit — testimonials",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "§4.H / 16 CFR Part 465: only real, attributable reviews. Disclose any paid or affiliate relationship in the Disclosure field." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The choice of thousands of subscribers" },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "Join thousands of Seatopia subscribers." }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "textarea", "id": "quote", "label": "Quote (must be a real review)" },
      { "type": "text", "id": "name", "label": "Name" },
      { "type": "text", "id": "disclosure", "label": "Disclosure (e.g. Paid partner)" }
    ]}
  ],
  "presets": [{ "name": "UI kit — testimonials" }]
}
{% endschema %}
