{% doc %}
  @prompt
    Create a "Blog Posts Collage" section that replicates the existing collage blog posts section layout and functionality, but adds the ability to filter blog posts by a specific tag. The section should have a setting where the merchant can enter a tag name, and only blog posts matching that tag will be displayed in the collage. All other existing collage settings (blog source, number of posts, heading, layout, colors, etc.) should remain intact.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-collage-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
  }

  .ai-blog-collage-{{ ai_gen_id }}__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }

  .ai-blog-collage-{{ ai_gen_id }}__heading {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_font.weight }};
    line-height: 1.15;
  }

  .ai-blog-collage-{{ ai_gen_id }}__tag {
    margin: 8px 0 0;
    color: {{ block.settings.muted_color }};
    font-size: 13px;
  }

  .ai-blog-collage-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
  }

  .ai-blog-collage-{{ ai_gen_id }}__card {
    position: relative;
    display: flex;
    min-height: 280px;
    grid-column: span 4;
    overflow: hidden;
    border-radius: {{ block.settings.card_radius }}px;
    background: {{ block.settings.card_background }};
    text-decoration: none;
    color: {{ block.settings.card_text_color }};
  }

  .ai-blog-collage-{{ ai_gen_id }}__card:first-child {
    grid-column: span 8;
    min-height: 520px;
  }

  .ai-blog-collage-{{ ai_gen_id }}__image,
  .ai-blog-collage-{{ ai_gen_id }}__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ai-blog-collage-{{ ai_gen_id }}__image {
    object-fit: cover;
  }

  .ai-blog-collage-{{ ai_gen_id }}__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ block.settings.placeholder_background }};
  }

  .ai-blog-collage-{{ ai_gen_id }}__placeholder svg {
    width: 42%;
    height: 42%;
    color: {{ block.settings.muted_color }};
  }

  .ai-blog-collage-{{ ai_gen_id }}__shade {
    position: absolute;
    inset: 35% 0 0;
    background: linear-gradient(transparent, rgba(0, 0, 0, .72));
  }

  .ai-blog-collage-{{ ai_gen_id }}__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: end;
    width: 100%;
    margin-top: auto;
    padding: 28px;
  }

  .ai-blog-collage-{{ ai_gen_id }}__date {
    margin: 0 0 8px;
    font-size: 12px;
    opacity: .9;
  }

  .ai-blog-collage-{{ ai_gen_id }}__title {
    margin: 0;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-size: 24px;
    line-height: 1.2;
  }

  .ai-blog-collage-{{ ai_gen_id }}__card:not(:first-child) .ai-blog-collage-{{ ai_gen_id }}__title {
    font-size: 19px;
  }

  .ai-blog-collage-{{ ai_gen_id }}__empty {
    grid-column: 1 / -1;
    padding: 32px;
    border-radius: {{ block.settings.card_radius }}px;
    background: {{ block.settings.card_background }};
    text-align: center;
    color: {{ block.settings.muted_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-blog-collage-{{ ai_gen_id }}__header { align-items: start; flex-direction: column; margin-bottom: 22px; }
    .ai-blog-collage-{{ ai_gen_id }}__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .ai-blog-collage-{{ ai_gen_id }}__card,
    .ai-blog-collage-{{ ai_gen_id }}__card:first-child { grid-column: span 1; min-height: 260px; }
    .ai-blog-collage-{{ ai_gen_id }}__card:first-child { grid-column: 1 / -1; min-height: 390px; }
    .ai-blog-collage-{{ ai_gen_id }}__content { padding: 20px; }
  }
{% endstyle %}

<div class="ai-blog-collage-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank or block.settings.tag_filter != blank %}
    <div class="ai-blog-collage-{{ ai_gen_id }}__header">
      {% if block.settings.heading != blank %}<h2 class="ai-blog-collage-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
      {% if block.settings.tag_filter != blank %}<p class="ai-blog-collage-{{ ai_gen_id }}__tag">Showing: {{ block.settings.tag_filter | escape }}</p>{% endif %}
    </div>
  {% endif %}

  <div class="ai-blog-collage-{{ ai_gen_id }}__grid">
    {% if block.settings.blog != blank %}
      {% assign displayed_posts = 0 %}
      {% for article in block.settings.blog.articles %}
        {% if displayed_posts < block.settings.post_count %}
          {% assign include_article = true %}
          {% if block.settings.tag_filter != blank %}
            {% assign include_article = false %}
            {% if article.tags contains block.settings.tag_filter %}{% assign include_article = true %}{% endif %}
          {% endif %}
          {% if include_article %}
            <a class="ai-blog-collage-{{ ai_gen_id }}__card" href="{{ article.url }}">
              {% if article.image %}
                <img class="ai-blog-collage-{{ ai_gen_id }}__image" src="{{ article.image | image_url: width: 1400 }}" alt="{{ article.image.alt | default: article.title | escape }}" loading="lazy" width="{{ article.image.width }}" height="{{ article.image.height }}">
              {% else %}
                <div class="ai-blog-collage-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
              {% endif %}
              <span class="ai-blog-collage-{{ ai_gen_id }}__shade"></span>
              <span class="ai-blog-collage-{{ ai_gen_id }}__content">
                {% if block.settings.show_date %}<span class="ai-blog-collage-{{ ai_gen_id }}__date">{{ article.published_at | date: '%B %d, %Y' }}</span>{% endif %}
                <span class="ai-blog-collage-{{ ai_gen_id }}__title">{{ article.title | escape }}</span>
              </span>
            </a>
            {% assign displayed_posts = displayed_posts | plus: 1 %}
          {% endif %}
        {% endif %}
      {% endfor %}
      {% if displayed_posts == 0 %}<div class="ai-blog-collage-{{ ai_gen_id }}__empty">No blog posts match this tag.</div>{% endif %}
    {% else %}
      <div class="ai-blog-collage-{{ ai_gen_id }}__empty">Select a blog to display posts.</div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Blog posts collage",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "blog", "id": "blog", "label": "Blog source" },
    { "type": "text", "id": "tag_filter", "label": "Filter by tag", "info": "Enter the exact tag name. Leave blank to show all posts." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the journal" },
    { "type": "range", "id": "post_count", "label": "Number of posts", "min": 3, "max": 12, "step": 1, "default": 5 },
    { "type": "checkbox", "id": "show_date", "label": "Show dates", "default": true },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "gap", "label": "Grid gap", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#2E4B59" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2E4B59" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#F7EFE6" },
    { "type": "color", "id": "card_text_color", "label": "Card text", "default": "#FFFFFF" },
    { "type": "color", "id": "placeholder_background", "label": "Placeholder", "default": "#CDD9D1" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#497991" },
    { "type": "header", "content": "Typography" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "crimson_pro_n4" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 64, "step": 2, "unit": "px", "default": 40 }
  ],
  "presets": [{ "name": "Blog posts collage" }],
  "tag": null,
  "class": "blog-posts-collage-block"
}
{% endschema %}