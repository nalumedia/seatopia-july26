{% doc %}
  @prompt
    I need a section that compares subscription vs one time order. It needs to be a block divided 50/50 in space on the vertical axis and have an image for each and copy below it, ideally in table form that one can understand at a glance "this is with subscription, this is with OPT". You can also make your own draft choices based around good practice for this, Let's make sure this ties into global css on the styling level, it looks different in styling right now, especially headlines, Styling looks better, at least correct font. The heading (choose what works for you) seems to have the wrong class, as it is quite small. I think it needs to be an h3, Still small, check if anything else limits the size of the heading, and if not go to a h2 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-order-compare-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: {{ block.settings.space_top }}px auto {{ block.settings.space_bottom }}px;
    color: rgb(var(--color-foreground, 29 61 62));
    font-family: var(--font-body-family, inherit);
  }

  .ai-order-compare-{{ ai_gen_id }}__heading {
    display: block;
    width: 100%;
    max-width: none;
    margin: 0 0 28px;
    color: rgb(var(--color-foreground, 29 61 62));
    text-align: center;
    font-family: var(--font-heading-family, inherit);
    font-style: var(--font-heading-style, normal);
    font-weight: var(--font-heading-weight, 500);
    letter-spacing: var(--font-heading-letter-spacing, normal);
    line-height: var(--font-heading-line-height, 1.2);
    font-size: clamp(2rem, 4vw, 3.25rem) !important;
  }

  .ai-order-compare-{{ ai_gen_id }}__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    align-items: stretch;
  }

  .ai-order-compare-{{ ai_gen_id }}__card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(var(--color-foreground, 29 61 62), 0.18);
    border-radius: 12px;
    background: {{ block.settings.card_background }};
  }

  .ai-order-compare-{{ ai_gen_id }}__card--featured {
    border-color: rgb(var(--color-foreground, 29 61 62));
    box-shadow: 0 4px 18px rgba(var(--color-foreground, 29 61 62), 0.1);
  }

  .ai-order-compare-{{ ai_gen_id }}__image-wrap {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: rgb(var(--color-background, 255 255 255));
  }

  .ai-order-compare-{{ ai_gen_id }}__image-wrap img,
  .ai-order-compare-{{ ai_gen_id }}__image-wrap svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-order-compare-{{ ai_gen_id }}__image-placeholder {
    width: 100%;
    height: 100%;
  }

  .ai-order-compare-{{ ai_gen_id }}__body {
    padding: 22px;
  }

  .ai-order-compare-{{ ai_gen_id }}__label {
    display: inline-block;
    margin: 0 0 8px;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(var(--color-foreground, 29 61 62), 0.1);
    color: rgb(var(--color-foreground, 29 61 62));
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .ai-order-compare-{{ ai_gen_id }}__card--featured .ai-order-compare-{{ ai_gen_id }}__label {
    background: rgb(var(--color-foreground, 29 61 62));
    color: rgb(var(--color-background, 255 255 255));
  }

  .ai-order-compare-{{ ai_gen_id }}__title {
    margin: 0 0 8px;
    color: rgb(var(--color-foreground, 29 61 62));
    font-family: var(--font-heading-family, inherit);
    font-style: var(--font-heading-style, normal);
    font-weight: var(--font-heading-weight, 500);
    letter-spacing: var(--font-heading-letter-spacing, normal);
    line-height: var(--font-heading-line-height, 1.25);
    font-size: 1.5em;
  }

  .ai-order-compare-{{ ai_gen_id }}__description {
    margin: 0 0 16px;
    color: rgb(var(--color-foreground, 29 61 62));
    font-family: var(--font-body-family, inherit);
    font-size: 1em;
    line-height: var(--font-body-line-height, 1.5);
  }

  .ai-order-compare-{{ ai_gen_id }}__list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-order-compare-{{ ai_gen_id }}__item {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding: 11px 0;
    border-top: 1px solid rgba(var(--color-foreground, 29 61 62), 0.14);
    color: rgb(var(--color-foreground, 29 61 62));
    font-family: var(--font-body-family, inherit);
    font-size: 0.95em;
    line-height: var(--font-body-line-height, 1.5);
  }

  .ai-order-compare-{{ ai_gen_id }}__item-icon {
    flex: 0 0 18px;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }

  .ai-order-compare-{{ ai_gen_id }}__item-icon--yes,
  .ai-order-compare-{{ ai_gen_id }}__item-icon--no {
    color: rgb(var(--color-foreground, 29 61 62));
  }

  @media screen and (max-width: 749px) {
    .ai-order-compare-{{ ai_gen_id }}__columns {
      gap: 12px;
    }

    .ai-order-compare-{{ ai_gen_id }}__body {
      padding: 16px;
    }

    .ai-order-compare-{{ ai_gen_id }}__title {
      font-size: 1.25em;
    }
  }

  @media screen and (max-width: 520px) {
    .ai-order-compare-{{ ai_gen_id }}__columns {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
{% endstyle %}

<div class="ai-order-compare-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-order-compare-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}
  <div class="ai-order-compare-{{ ai_gen_id }}__columns">
    {% for i in (1..2) %}
      {% if i == 1 %}
        {% assign card_image = block.settings.subscription_image %}
        {% assign card_label = block.settings.subscription_label %}
        {% assign card_title = block.settings.subscription_title %}
        {% assign card_description = block.settings.subscription_description %}
        {% assign card_points = block.settings.subscription_points | newline_to_br | split: '<br />' %}
        {% assign card_featured = true %}
      {% else %}
        {% assign card_image = block.settings.one_time_image %}
        {% assign card_label = block.settings.one_time_label %}
        {% assign card_title = block.settings.one_time_title %}
        {% assign card_description = block.settings.one_time_description %}
        {% assign card_points = block.settings.one_time_points | newline_to_br | split: '<br />' %}
        {% assign card_featured = false %}
      {% endif %}
      <article class="ai-order-compare-{{ ai_gen_id }}__card{% if card_featured %} ai-order-compare-{{ ai_gen_id }}__card--featured{% endif %}">
        <div class="ai-order-compare-{{ ai_gen_id }}__image-wrap">
          {% if card_image != blank %}
            <img src="{{ card_image | image_url: width: 1200 }}" alt="{{ card_image.alt | default: card_title | escape }}" loading="lazy" width="{{ card_image.width }}" height="{{ card_image.height }}">
          {% else %}
            <div class="ai-order-compare-{{ ai_gen_id }}__image-placeholder">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        <div class="ai-order-compare-{{ ai_gen_id }}__body">
          {% if card_label != blank %}<p class="ai-order-compare-{{ ai_gen_id }}__label">{{ card_label | escape }}</p>{% endif %}
          {% if card_title != blank %}<h3 class="ai-order-compare-{{ ai_gen_id }}__title">{{ card_title | escape }}</h3>{% endif %}
          {% if card_description != blank %}<p class="ai-order-compare-{{ ai_gen_id }}__description">{{ card_description | escape }}</p>{% endif %}
          <ul class="ai-order-compare-{{ ai_gen_id }}__list">
            {% for point in card_points %}
              {% assign point_text = point | strip_html | strip %}
              {% if point_text != blank %}
                <li class="ai-order-compare-{{ ai_gen_id }}__item">
                  {% if forloop.index == 1 and i == 1 %}
                    <svg class="ai-order-compare-{{ ai_gen_id }}__item-icon ai-order-compare-{{ ai_gen_id }}__item-icon--yes" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m4 10 4 4 8-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {% else %}
                    <svg class="ai-order-compare-{{ ai_gen_id }}__item-icon ai-order-compare-{{ ai_gen_id }}__item-icon--no" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.7"/><path d="M7 10h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                  {% endif %}
                  <span>{{ point_text | escape }}</span>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      </article>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Order comparison",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose what works for you" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "space_top", "label": "Top spacing", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 30 },
    { "type": "range", "id": "space_bottom", "label": "Bottom spacing", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 30 },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#FFFFFF" },
    { "type": "header", "content": "Subscription" },
    { "type": "image_picker", "id": "subscription_image", "label": "Image" },
    { "type": "text", "id": "subscription_label", "label": "Label", "default": "Best for regular deliveries" },
    { "type": "text", "id": "subscription_title", "label": "Title", "default": "Subscribe and save" },
    { "type": "textarea", "id": "subscription_description", "label": "Description", "default": "Set a delivery rhythm that fits your home and enjoy the convenience of recurring orders." },
    { "type": "textarea", "id": "subscription_points", "label": "Benefits (one per line)", "default": "Set your preferred delivery frequency\nManage or skip upcoming orders\nConvenient recurring deliveries" },
    { "type": "header", "content": "One-time order" },
    { "type": "image_picker", "id": "one_time_image", "label": "Image" },
    { "type": "text", "id": "one_time_label", "label": "Label", "default": "A single purchase" },
    { "type": "text", "id": "one_time_title", "label": "Title", "default": "Order one time" },
    { "type": "textarea", "id": "one_time_description", "label": "Description", "default": "Choose a one-time order when you want to shop as needed, with no recurring deliveries." },
    { "type": "textarea", "id": "one_time_points", "label": "Details (one per line)", "default": "Checkout once when you need it\nNo recurring delivery schedule\nGreat for trying something new" }
  ],
  "presets": [
    { "name": "Order comparison" }
  ],
  "tag": null,
  "class": "order-comparison-block"
}
{% endschema %}