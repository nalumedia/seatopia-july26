  {% comment %} Meta and GA4 event tracking for Alia popup {% endcomment %}
   <script>
    (function () {
      window.dataLayer = window.dataLayer || [];

      var firedSignups = new Set();

      document.addEventListener('alia:signup', function (e) {
        if (!e.detail) return;

        var detail = e.detail;

        // Deduplication key
        var email = detail.email ? String(detail.email).toLowerCase().trim() : '';
        var phone = detail.phone ? String(detail.phone).trim() : '';
        var identity = email || phone || 'unknown';
        var signupKey = String(detail.popupID || '') + '|' + identity;

        if (firedSignups.has(signupKey)) return;
        firedSignups.add(signupKey);

        var eventPayload = {
            popup_id: detail.popupID || '',
            campaign_id: detail.campaignID || '',
            campaign_title: detail.campaignTitle || ''
        };

        // ── Meta (Facebook) Event ──
        if (typeof fbq === 'function') {
            fbq('trackCustom', 'Email Signup', eventPayload);
        } else {
            console.warn('fbq not loaded — Meta event skipped');
        }

        // ── GA4 Event via dataLayer ──
        window.dataLayer.push({
            event: 'email_signup',
            ...eventPayload
        });
      });
    })();
   </script>

