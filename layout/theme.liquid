        /* -- runs immediately: no layout, no network -- */
        (h._heatmap_paq = h._heatmap_paq || []).push(['setTrackerUrl', (h.heatUrl = e) + a]);
        h.hErrorLogs = h.hErrorLogs || [];
        ['error', 'unhandledrejection'].forEach(function (ty) {
          h.addEventListener(ty, function (et) { h.hErrorLogs.push({ type: ty, event: et }); });
        });

        /* -- deferred: the actual tracker -- */
        var loaded = false;
        function loadHeatmap() {
          if (loaded) { return; }
          loaded = true;
          var ap = t.createElement('script');
          ap.src = h.heatUrl + 'heatmap.min.js?sid=' + m;
          ap.defer = true;
          t.head.appendChild(ap);
        }
        function schedule() {
          /* timeout caps how long an always-busy main thread can starve it,
             so sessions that bounce early still get tracked */
          if (typeof h.requestIdleCallback === 'function') {
            h.requestIdleCallback(loadHeatmap, { timeout: 3000 });
          } else {
            h.setTimeout(loadHeatmap, 1500);
          }
        }
        if (t.readyState === 'complete') {
          schedule();
        } else {
          h.addEventListener('load', schedule, { once: true });
        }
      })(window, 'https://c.heatmap.com/scripts/', 'heatmap.php', document, 2984);
    </script>

