{%- comment -%}
  Recipe blog filter navigation: category dropdowns + search.

  Accepts:
  - blog: {Object} Blog Liquid object
  - label1..label4 / tags1..tags4: {String} Category label + its comma/newline separated tag list
  - enable_search: {Boolean} Show the search field
  - search_placeholder: {String} Search input placeholder
{%- endcomment -%}

<div class="recipe-nav" data-recipe-nav>
  <div class="recipe-nav__inner">
    <nav class="recipe-nav__menus" aria-label="Recipe filters">
      {%- render 'recipe-nav-dropdown', label: label1, tags: tags1, blog: blog -%}
      {%- render 'recipe-nav-dropdown', label: label2, tags: tags2, blog: blog -%}
      {%- render 'recipe-nav-dropdown', label: label3, tags: tags3, blog: blog -%}
      {%- render 'recipe-nav-dropdown', label: label4, tags: tags4, blog: blog -%}
    </nav>

    {%- if enable_search -%}
      <form class="recipe-nav__search" action="{{ routes.search_url }}" method="get" role="search">
        <input type="hidden" name="type" value="article">
        <input type="hidden" name="options[prefix]" value="last">
        <svg class="recipe-nav__search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
          <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <input
          type="search"
          name="q"
          class="recipe-nav__search-input"
          value="{{ search.terms | escape }}"
          placeholder="{{ search_placeholder | default: 'Search recipes, species, chefs…' | escape }}"
          aria-label="{{ 'general.search.search' | t | escape }}"
          autocomplete="off"
        >
      </form>
    {%- endif -%}
  </div>
</div>

<style>
  .recipe-nav {
    border-bottom: 1px solid rgba(17, 24, 39, 0.12);
    margin-bottom: 32px;
  }
  .recipe-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px 24px;
    padding-top: 4px;
    padding-bottom: 0;
  }
  .recipe-nav__menus {
    display: flex;
    align-items: stretch;
    flex-wrap: wrap;
    gap: 4px 8px;
  }
  .recipe-nav__item { position: relative; }
  .recipe-nav__trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 14px 12px;
    font: inherit;
    font-size: 17px;
    font-weight: 500;
    color: #374151;
    border-bottom: 2px solid transparent;
    transition: color .15s ease, border-color .15s ease;
  }
  .recipe-nav__trigger:hover { color: #0f172a; }
  .recipe-nav__caret { transition: transform .2s ease; }
  .recipe-nav__item.is-open .recipe-nav__trigger {
    color: #0d9488;
    border-bottom-color: #0d9488;
  }
  .recipe-nav__item.is-open .recipe-nav__caret { transform: rotate(180deg); }

  .recipe-nav__panel {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 30;
    min-width: 240px;
    max-height: 60vh;
    overflow-y: auto;
    background: #fff;
    border: 1px solid rgba(17, 24, 39, 0.08);
    border-radius: 12px;
    box-shadow: 0 12px 32px rgba(16, 24, 40, 0.12);
    padding: 10px;
    margin-top: 2px;
  }
  .recipe-nav__panel[hidden] { display: none; }
  .recipe-nav__panel ul { list-style: none; margin: 0; padding: 0; }
  .recipe-nav__link {
    display: block;
    padding: 12px 14px;
    border-radius: 8px;
    font-size: 17px;
    color: #374151;
    text-decoration: none;
    transition: background .12s ease, color .12s ease;
  }
  .recipe-nav__link:hover { background: rgba(13, 148, 136, 0.08); color: #0f172a; }
  .recipe-nav__link.is-active { color: #0d9488; font-weight: 600; }

  .recipe-nav__search {
    position: relative;
    display: flex;
    align-items: center;
    flex: 0 1 360px;
    min-width: 220px;
    background: #fff;
    border: 1px solid rgba(17, 24, 39, 0.15);
    border-radius: 999px;
    padding: 0 18px;
    height: 48px;
  }
  .recipe-nav__search:focus-within { border-color: #0d9488; }
  .recipe-nav__search-icon { color: #9ca3af; flex: none; }
  .recipe-nav__search-input {
    border: none;
    outline: none;
    background: none;
    width: 100%;
    margin-left: 10px;
    font: inherit;
    font-size: 16px;
    color: #1f2937;
  }
  .recipe-nav__search-input::placeholder { color: #9ca3af; }

  @media (max-width: 767px) {
    .recipe-nav__inner { flex-direction: column; align-items: stretch; }
    .recipe-nav__menus { justify-content: space-between; }
    .recipe-nav__search { order: -1; flex-basis: auto; }
    .recipe-nav__trigger { font-size: 15px; padding: 12px 8px; }
  }
</style>

<script>
  (function () {
    if (window.__recipeNavInit) return;
    window.__recipeNavInit = true;

    function closeAll(except) {
      document.querySelectorAll('.recipe-nav__item.is-open').forEach(function (item) {
        if (item === except) return;
        item.classList.remove('is-open');
        var t = item.querySelector('[data-recipe-trigger]');
        var p = item.querySelector('[data-recipe-panel]');
        if (t) t.setAttribute('aria-expanded', 'false');
        if (p) p.hidden = true;
      });
    }

    document.addEventListener('click', function (e) {
      var trigger = e.target.closest('[data-recipe-trigger]');
      if (trigger) {
        var item = trigger.closest('[data-recipe-dropdown]');
        var panel = item.querySelector('[data-recipe-panel]');
        var isOpen = item.classList.contains('is-open');
        closeAll(item);
        if (isOpen) {
          item.classList.remove('is-open');
          trigger.setAttribute('aria-expanded', 'false');
          if (panel) panel.hidden = true;
        } else {
          item.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
          if (panel) panel.hidden = false;
        }
        return;
      }
      // Click outside any dropdown closes them.
      if (!e.target.closest('[data-recipe-panel]')) {
        closeAll(null);
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeAll(null);
    });
  })();
</script>
