 console.log("working rtx-pdp");
    // Fallback for Retextion API if not loaded
  if (!window.retextionApi) {
    console.warn('Retextion API not loaded, using fallback');
    window.retextionApi = {
      formatMoney: (price) => `$${(price / 100).toFixed(2)}`,
      sellingPlanPushHistory: () => {},
      productAdd: () => {}
    };
  }

  // Utility to wait for dynamically loaded elements (e.g., Replo components)
window.waitForElement = (selector, callback, timeout = 5000) => {
  let start = Date.now();
  let interval = setInterval(() => {
    let element = document.querySelector(selector);
    if (element) {
      clearInterval(interval);
      callback(element);
    } else if (Date.now() - start > timeout) {
      clearInterval(interval);
      console.warn(`Element ${selector} not found within ${timeout}ms`);
    }
  }, 100);
};



  // Initialize buyBox for subscription functionality
((buyBoxes) => {
  let buyBox = {
    boxId: "{{ product.id }}-product-",
    product: {{ product | json }},
    variantId: {{ product.first_available_variant.id | json }},
    root: null,
    form: null,
    subscriptionBox: null,
    sellingPlanSelector: null,
    quantitySelector: null,
    purchaseType: null,
    variantSelectors: null,
    labelOneTime: null,
    labelSubscription: null,
    cachedSellingPlanId: ''
  };

  // Initialize elements with retries for dynamic rendering
  let initElements = () => {
    buyBox.root = document.querySelector(`[data-rtx-subscription-${buyBox.boxId}]`);
    buyBox.form = buyBox.root?.closest('form[action="/cart/add"]') || 
                  document.querySelector('form[action="/cart/add"]') || 
                  document.documentElement;
    buyBox.subscriptionBox = buyBox.root?.querySelector('[data-retextion-subscription-box]');
    buyBox.sellingPlanSelector = buyBox.root?.querySelector('[name="selling_plan"]');
    buyBox.quantitySelector = buyBox.form.querySelector('[name="quantity"]');
    buyBox.purchaseType = buyBox.form.querySelectorAll('[name="purchaseType"]');
    buyBox.variantSelectors = buyBox.form.querySelectorAll('[name="id"]');
    buyBox.labelOneTime = buyBox.form.querySelector('[for="purchase_Real-time updates on breaking news storiesTypeOneTime"]');
    buyBox.labelSubscription = buyBox.form.querySelector('[for="purchaseTypeSubscription"]');
    buyBox.cachedSellingPlanId = buyBox.sellingPlanSelector?.value || '';

    // Log initialization status
    console.log('buyBox initialized:', {
      root: !!buyBox.root,
      form: !!buyBox.form,
      subscriptionBox: !!buyBox.subscriptionBox,
      sellingPlanSelector: !!buyBox.sellingPlanSelector,
      variantSelectors: buyBox.variantSelectors?.length || 0
    });

    // Setup event listeners after initialization
    setupEventListeners();
  };

  // Utility to wait for dynamically loaded elements
  window.waitForElement = (selector, callback, timeout = 5000) => {
    let start = Date.now();
    let interval = setInterval(() => {
      let element = document.querySelector(selector);
      if (element) {
        clearInterval(interval);
        callback(element);
      } else if (Date.now() - start > timeout) {
        clearInterval(interval);
        console.warn(`Element ${selector} not found within ${timeout}ms`);
      }
    }, 100);
  };

  // Wait for root element and initialize
  waitForElement(`[data-rtx-subscription-${buyBox.boxId}]`, () => {
    initElements();
    buyBox.updateSellingPlan(); // Initial update
  });

  // Reinitialize elements when popup is opened
  const reinitializeOnPopup = () => {
    console.log('Reinitializing buyBox for popup');
    initElements();
    buyBox.updateSellingPlan();
  };

  // Observe popup opening (example: modify based on your popup library)
  const observePopup = () => {
    const popupSelector = '.popup, .modal, [data-popup]'; // Adjust to your popup's class or ID
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.addedNodes.length) {
          const popup = document.querySelector(popupSelector);
          if (popup && popup.offsetParent !== null) { // Check if popup is visible
            reinitializeOnPopup();
          }
        }
      });
    });
    observer.observe(document.body, { childList: true, subtree: true });
  };

  // Start observing popup
  observePopup();

  // Remove empty selling plan option
  buyBox.removeEmptyOption = () => {
    if (!buyBox.sellingPlanSelector) return;
    let optEmpty = buyBox.sellingPlanSelector.querySelectorAll('[value=""]');
    optEmpty?.forEach(e => e.remove());
  };

  // Add empty selling plan option for one-time purchase
  buyBox.addEmptyOption = () => {
    if (!buyBox.sellingPlanSelector) return;
    let optEmpty = buyBox.sellingPlanSelector.querySelector('[value=""]');
    if (optEmpty) return;
    optEmpty = document.createElement('option');
    optEmpty.value = '';
    optEmpty.textContent = 'One-time purchase';
    buyBox.sellingPlanSelector.appendChild(optEmpty);
  };

  // Hide subscription box
  buyBox.hideSubscriptionBox = () => {
    if (!buyBox.subscriptionBox) return;
    buyBox.cachedSellingPlanId = buyBox.sellingPlanSelector?.value || '';
    buyBox.subscriptionBox.classList.remove('is-visible');
    buyBox.sellingPlanSelector.value = '';
    buyBox.updateSellingPlan();
    buyBox.labelOneTime?.classList.add('is-selected');
    buyBox.labelSubscription?.classList.remove('is-selected');
  };

  // Show subscription box
  buyBox.showSubscriptionBox = () => {
    if (!buyBox.subscriptionBox) return;
    buyBox.subscriptionBox.classList.add('is-visible');
    buyBox.sellingPlanSelector.value = buyBox.cachedSellingPlanId;
    // buyBox.removeEmptyOption();
    buyBox.updateSellingPlan();
    buyBox.labelOneTime?.classList.remove('is-selected');
    buyBox.labelSubscription?.classList.add('is-selected');
  };

  // Check if subscription box is visible
  buyBox.isSubscriptionBoxVisible = () => {
    return buyBox.subscriptionBox?.classList.contains('is-visible') || false;
  };

  // Get current selling plan ID
  buyBox.getSellingPlanId = () => {
    return parseInt(buyBox.sellingPlanSelector?.value) || 0;
  };

  // Set selling plan
  buyBox.setSellingPlan = (sellingPlan) => {
    if (!buyBox.sellingPlanSelector) return;
    sellingPlan = sellingPlan && sellingPlan.id ? sellingPlan.id : sellingPlan;
    buyBox.sellingPlanSelector.value = sellingPlan.toString();
  };

  // Update selling plan and prices
  buyBox.updateSellingPlan = () => {
    try {
      console.log('updateSellingPlan called, variantId:', buyBox.variantId);

      // Selectors for price display
      let discountLabels = buyBox.root?.querySelectorAll('[data-rtx-subscription-price]') || [];
      let percentageOff = buyBox.root?.querySelectorAll('.percentage-off') || [];
      let fullPriceLabels = buyBox.root?.querySelectorAll('[data-rtx-onetime-price]') || [];
      let prodPrice = document.querySelector('[data-product-price]') || 
                      document.querySelector('.product__price') || 
                      document.querySelector('[id^="Price-"]');
      let btnPrice = document.querySelector('.btn-price') || 
                     document.querySelector('.button--primary .btn-text') || 
                     document.querySelector('[id^="StickyPrice-"]');

      // Get selected variant
      let variant = buyBox.product.variants.find(v => v.id == buyBox.variantId) || {};
      let selectElement = document.querySelector('select[name="id"]') || 
                         document.querySelector('input[name="id"]:checked') || 
                         document.querySelector('[name="id"]') || 
                         document.querySelector('[data-replo-variant-select] [name="id"]') || 
                         document.querySelector('.replo-variant-picker [name="id"]');

      if (selectElement) {
        let variantSelect = selectElement.tagName === 'SELECT' ? selectElement.selectedOptions[0] : selectElement;
        console.log('Select Element:', selectElement, 'Variant Select:', variantSelect);

        if (variantSelect && variantSelect.getAttribute('data-json')) {
          try {
            variant = JSON.parse(variantSelect.getAttribute('data-json')) || variant;
          } catch (jsonError) {
            console.warn('Failed to parse variant JSON:', jsonError);
          }
        } else if (selectElement.value) {
          variant = buyBox.product.variants.find(v => v.id == parseInt(selectElement.value)) || variant;
        }
      } else {
        console.warn('No variant selector found, falling back to default variant');
      }
      console.log('Selected Variant:', variant);

      // Ensure selling_plan_allocations exists
      variant.selling_plan_allocations = variant.selling_plan_allocations || [];

      // Get selling plan details
      let sellingPlanId = buyBox.isSubscriptionBoxVisible() ? buyBox.getSellingPlanId() : undefined;
      console.log('Selling Plan ID:', sellingPlanId);
   
    $('.custom-selling-plan').val(sellingPlanId);
      $('select.rtx-subscription-dropdown').change(function(){
   var subscription_value = $(this).val();
    if(subscription_value){
        $('.custom-selling-plan').val(subscription_value)
    }else{
         $('.custom-selling-plan').val('');
    }
   $('#purchaseTypeSubscriptionid').click(function(){
    $('.cstm-purchaseTypeSubscription').addClass('active');
    $('.cstm-purchaseTypeOneTimeid ').removeClass('is-selected');
    $('.cstm-purchaseTypeOneTimeid ').removeClass('active');
  
    $('.custom-selling-plan').val(sellingPlanId);
});
})
     
      let sellingPlanAllocation = sellingPlanId
        ? variant.selling_plan_allocations.find(spa => spa.selling_plan_id == sellingPlanId)
        : undefined;
      let firstSellingPlanAllocation = variant.selling_plan_allocations.find(spa => spa.selling_plan_id == buyBox.getSellingPlanId()) ||
                                      variant.selling_plan_allocations[0] || { price: variant.price || 0 };

      // Calculate discount and percentage
      let strDiscount = '', strPercentage = '';
      if (firstSellingPlanAllocation && firstSellingPlanAllocation.price && variant.price && firstSellingPlanAllocation.price != variant.price) {
        let percentage = Math.round((1.0 - (firstSellingPlanAllocation.price / variant.price)) * 100);
        if (percentage != 0) {
          strPercentage = `${percentage.toFixed(0)}%`;
          strDiscount = `${window.retextionApi.formatMoney(firstSellingPlanAllocation.price)} <del>${window.retextionApi.formatMoney(variant.price)}</del>`;
        } else {
          strDiscount = `${window.retextionApi.formatMoney(firstSellingPlanAllocation.price)}`;
        }
      } else {
        strDiscount = variant.price ? window.retextionApi.formatMoney(variant.price) : '';
      }

      let strFullPrice = variant.price ? window.retextionApi.formatMoney(variant.price) : '';

      // Update price displays
      percentageOff.forEach(dl => dl.textContent = strPercentage);
      discountLabels.forEach(dl => dl.innerHTML = strDiscount);
      fullPriceLabels.forEach(fp => fp.textContent = strFullPrice);

      setTimeout(() => {
        let price_addCart = window.retextionApi.formatMoney(firstSellingPlanAllocation.price);
        let getAddToBtn = document.querySelector('product-buy-price'); 
        console.log(price_addCart, "price_addCart");
        if (price_addCart && getAddToBtn) {
          getAddToBtn.textContent = price_addCart;
        }
      }, 500);

      if (buyBox.isSubscriptionBoxVisible() && firstSellingPlanAllocation) {
        if (btnPrice) btnPrice.innerHTML = window.retextionApi.formatMoney(firstSellingPlanAllocation.price);
        if (prodPrice) prodPrice.innerHTML = window.retextionApi.formatMoney(firstSellingPlanAllocation.price);
      } else {
        if (btnPrice && strFullPrice) btnPrice.innerHTML = strFullPrice;
        if (prodPrice && strFullPrice) prodPrice.innerHTML = strFullPrice;
      }

      // Update selling plan history
      window.retextionApi.sellingPlanPushHistory({ sellingPlan: sellingPlanId });

      // Update subscription frequency display
      let selectedOption = buyBox.sellingPlanSelector?.querySelector(`[value="${buyBox.sellingPlanSelector.value}"]`);
      if (selectedOption) {
        let selectedFrequency = selectedOption.textContent;
        let subscriptionDay = buyBox.root?.querySelector('.subscription_day');
        if (subscriptionDay) {
          if (selectedFrequency.includes('2')) {
            subscriptionDay.textContent = '60';
          } else if (selectedFrequency.includes('3')) {
            subscriptionDay.textContent = '90';
          } else {
            subscriptionDay.textContent = '30';
          }
        }
      }
    } catch (error) {
      console.error('Error in updateSellingPlan:', error);
    }
  };

  // Setup event listeners
  let setupEventListeners = () => {
    // Purchase type change (one-time vs subscription)
    buyBox.purchaseType?.forEach(el => {
      el.addEventListener('change', e => {
        console.log('Purchase type changed:', el.value);
        if (el.value === 'purchaseTypeSubscription') {
          buyBox.showSubscriptionBox();
        } else {
          buyBox.hideSubscriptionBox();
        }
      });
    });

    // Selling plan change
    if (buyBox.sellingPlanSelector) {
      buyBox.sellingPlanSelector.addEventListener('change', () => {
        console.log('Selling plan changed:', buyBox.sellingPlanSelector.value);
        buyBox.updateSellingPlan();
      });
    } else {
      console.warn('Selling plan selector not found');
    }

    // Variant change (use event delegation for dynamic elements)
    document.addEventListener('change', (e) => {
      if (e.target.matches('[name="id"]')) {

        const button = $('#purchaseTypeSubscriptionid');
        function safeClick() {
          const scrollTop = $(window).scrollTop();
          button.trigger('click');
          $(window).scrollTop(scrollTop);
        }
        [0, 5, 10].forEach(function(delay) {
          setTimeout(safeClick, delay);
        });

        console.log('Variant changed:', e.target.value);
        buyBox.variantId = e.target.value;
        let variant = buyBox.product.variants.find(v => v.id == buyBox.variantId) || {};
        let selectedPlanId = buyBox.getSellingPlanId();
        if (!variant.selling_plan_allocations?.some(spa => spa.selling_plan_id == selectedPlanId)) {
          selectedPlanId = variant.selling_plan_allocations?.[0]?.selling_plan_id || '';
        }
        buyBox.setSellingPlan(selectedPlanId);

        // Update selling plan options
        if (buyBox.sellingPlanSelector) {
          buyBox.sellingPlanSelector.innerHTML = '';
          variant.selling_plan_allocations?.forEach(spa => {
            let sellingGroup = buyBox.product.selling_plan_groups.find(spg => spg.id === spa.selling_plan_group_id);
            if (sellingGroup?.app_id != {{ retextionAppId | json }}) return;
            let sellingPlan = sellingGroup.selling_plans.find(sp => sp.id === spa.selling_plan_id);
            let opt = document.createElement('option');
            opt.value = sellingPlan.id;
            opt.textContent = sellingPlan.name || 'Subscription';
            if (sellingPlan.id == selectedPlanId) opt.setAttribute('selected', 'selected');
            buyBox.sellingPlanSelector.appendChild(opt);
          });
          buyBox.updateSellingPlan();
        }
      }
    });

    // Handle Replo click events
    document.addEventListener('replo.click', (e) => {
      let target = e.target.closest('[data-replo-variant-select] [name="id"]');
      if (target) {
        console.log('Replo variant click detected:', target.value);
        buyBox.variantId = target.value;
        buyBox.updateSellingPlan();
      }
    });
  };




$(document).on("change", '[name="purchaseType"]', function () {
  console.log("Purchase type changed:", this.value);

  if (this.value === "purchaseTypeOneTime") {
    // Activate One-time
    $(".cstm-purchaseTypeOneTimeid").addClass("active is-selected");
    $(".cstm-purchaseTypeSubscription").removeClass("active is-selected");

    // Hide subscription UI
    $(".rtx-subscription-box").removeClass("is-visible");

    // Reset selling plan
    const sellingPlan = document.querySelector('[name="selling_plan"]');
    if (sellingPlan) sellingPlan.value = "";

    // Sync with main logic
    if (typeof buyBox !== "undefined") {
      buyBox.hideSubscriptionBox();
    }

  } else {
    // Activate Subscription
    $(".cstm-purchaseTypeSubscription").addClass("active is-selected");
    $(".cstm-purchaseTypeOneTimeid").removeClass("active is-selected");

    // Show subscription UI
    $(".rtx-subscription-box").addClass("is-visible");

    // Restore selling plan if exists
    const sellingPlan = document.querySelector('[name="selling_plan"]');
    if (sellingPlan && !sellingPlan.value) {
      let firstOption = sellingPlan.querySelector("option");
      if (firstOption) sellingPlan.value = firstOption.value;
    }

    // Sync with main logic
    if (typeof buyBox !== "undefined") {
      buyBox.showSubscriptionBox();
    }
  }
});









})();



    </script>
    

    

  {%- endif -%}
{% endunless %} 
