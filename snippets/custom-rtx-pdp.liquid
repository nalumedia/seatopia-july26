    {%- comment -%} Buy Box Styles {%- endcomment -%}
    <style type="text/css">
      .rtx-subscription,.rtx-subcription * {
        box-sizing: border-box;
      }
      .rtx-subscription {
        margin-bottom: 1.5rem;
      }
      .rtx-subscription-box {
        display: none;
      }
      .rtx-subscription-box.is-visible {
        display: block;
        padding-left: 30px;
      }
      .rtx-subscription-label {
        padding: 1rem;
        border-radius: 0.25rem;
        display: block;
      }
      .rtx-subscription-label__inner {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        cursor: pointer;
      }
      .rtx-subscription-label.is-selected {
        {% comment %} background: #EEE; {% endcomment %}
        color: #000;
      }
      .rtx-subscription-label__inner > span {
        display: block;
        margin-left: 0.5rem;
      }
      .rtx-subscription-dropdown.is-hidden {
        display: none;
      }
      .rtx-subscription-single-label {
        display: none;
        padding: 1rem 0 0 1.8rem;
      }
      .rtx-subscription-single-label.is-visible {
        display: block;
      }
      .subs-details{
        white-space: nowrap;
        padding: 8px;
      }
      div.rtx_popup__hover{
        display: inline-block;
        position: relative;
        height: 35px;
        clear: both;
        cursor: pointer;
        padding-left:8px;
      }
      .rtx_popup_label_wrapper{
        background: rgba(0,0,0,0);
        border: 0;
        outline: 0;
      }
      .rtx_popup__block{
        font-size: 12px;
        padding: 12px;
        width: 300px;
        z-index: 1000;
      }
      div.rtx_popup__block {
        display: none;
        position: absolute;
        top: 100%;
        cursor: default;
        left: 0;
        text-align: left;
        white-space: normal;
        background-color: #191D48 !important;
      }
      div.rtx_popup__block:before {
          display: block;
          content: "";
          color:#fff;
          width: 1px;
          border: 10px solid transparent;
          position: absolute;
          top: -20px;
          left: 0;
      }
      div.rtx_popup__block:hover,div.rtx_popup__hover:hover .rtx_popup__block {
          display: block
      }

      div.rtx_popup__hover--mobile div.rtx_popup__block:hover {
          display: none
      }
      .rtx_popup__hover:after {
        display: none;
        content: "";
        width: 1px;
        border: 10px solid rgba(0,0,0,0);
        position: absolute;
        top: 18px;
        border-bottom-color: #191D48;
      }
      .rtx_popup__hover:hover:after,  .rtx_popup__hover:hover div.rtx_popup__block__content {
        display: block;
        color: #fff;
      }
    </style>
    <div  data-rtx-subscription-{{ product.id }}-product- class="rtx-subscription">
