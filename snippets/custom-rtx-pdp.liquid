                  box
                {% else %}
                  {{ variant_title }}
                {% endif %}
                - Pause, skip, or cancel anytime.
              </span>
            </li>
          </ul>
        </label>



        {%- comment -%} Subscription Information Modal {%- endcomment -%}
        <div class="subs-details" style="display:none">
          <div class="rtx_popup__hover">
            <button
              class="rtx_popup_label_wrapper row"
              aria-label="Subscription details"
              aria-expanded="false"
