{%- comment -%}
  Renders a newsletter form

  Accepts:
  - context: {String}
  - section_id: {String} The ID of section to which this snippet belongs.
  Usage:
  {% render 'newsletter-form', section_id: section.id, context: 'section' %}
{%- endcomment -%}

{%- comment -%}
  `tags` is optional and defaults to 'newsletter', so every existing caller is
  unchanged. Pass a comma-separated list to tag signups by source, e.g.
  'newsletter,hyman-lp' — Shopify applies these to the customer record and the
  Klaviyo sync carries them through as profile tags you can segment on.
{%- endcomment -%}
{%- assign form_id = 'newsletter-' | append: section_id -%}
{%- assign form_tags = tags | default: 'newsletter' -%}
{%- form 'customer', id: form_id, class: 'newsletter-form grid gap-5' -%}
  <input type="hidden" name="contact[tags]" value="{{ form_tags | escape }}" />
  <input type="hidden" name="contact[context]" value="{{ context }}" />
  <div class="field relative">
    <input
      id="NewsletterForm--{{ section_id }}"
      class="input is-floating input--fill"
      type="email"
      name="contact[email]"
      value="{{ form.email }}"
      autocorrect="off"
      autocapitalize="off"
      autocomplete="email"
      placeholder="{{ 'general.newsletter.label' | t | escape }}"
      required
      {%- if form.errors %} autofocus{% endif -%}
    />
    <label class="label is-floating" for="NewsletterForm--{{ section_id }}">{{ 'general.newsletter.label' | t }}</label>
    <div class="self-submit-button absolute">
      <button type="submit" class="button button--primary self-button flex justify-center items-center" is="magnet-button" data-magnet="20" aria-label="{{ 'general.newsletter.submit' | t | escape }}">
        <span class="btn-text">
          <span class="newsletter-join-txt"> Join </span>
          {% comment %}<svg class="icon icon-arrow-right icon-xs transform" viewBox="0 0 16 16" stroke="currentColor" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2 8.00012H14M14 8.00012L9.33333 3.3335M14 8.00012L9.33333 12.6668"></path>
          </svg>{% endcomment %}
        </span>
      </button>
    </div>
  </div>
  
  {%- liquid
    if form.errors and form.context == context
      assign form_errors = form.errors | default_errors
      render 'alert', status: 'error', content: form_errors
    endif
  -%}

  {%- comment -%}
    `form.posted_successfully?` is true for EVERY newsletter form rendered on the
    page, not only the one submitted — the Hyman page has two. It cannot be scoped
    server-side: `form.context` is populated on the error render but not on the
    success one, which is why every other section in this theme gates success on
    `posted_successfully?` alone. Gating on context here suppressed the message
    entirely.

    So it is scoped client-side instead, using the one piece of information that
    does survive: Shopify posts to /contact with this form's id as the URL
    fragment, and the browser carries that fragment through the redirect.

    The icon is hidden because the message carries its own emoji.
  {%- endcomment -%}
  {%- if form.posted_successfully? -%}
    {%- assign success_message = 'general.newsletter.success' | t -%}
    <div data-newsletter-success="{{ form_id }}">
      {%- render 'alert', status: 'success', content: success_message, hide_icon: true -%}
    </div>

    <script>
      (function () {
        var formId = {{ form_id | json }};
        var box = document.querySelector('[data-newsletter-success="' + formId + '"]');
        if (!box) return;

        var hash = (window.location.hash || '').replace(/^#/, '');
        var addressed = hash.indexOf('newsletter-') === 0;

        // A different newsletter form was the one submitted — drop this copy of
        // the confirmation rather than showing it under every form on the page.
        if (addressed && hash !== formId) {
          box.style.display = 'none';
          return;
        }
        if (!addressed) return;

        var section = document.getElementById('shopify-section-{{ section_id }}');
        if (!section || !section.scrollIntoView) return;

        // The browser applies the fragment before this section's lazy background
        // and parallax transform have laid out, so the anchor resolves against a
        // much shorter document and leaves you well above the form. Re-assert the
        // scroll as things settle rather than betting on one moment being right.
        var reduce = window.matchMedia
          && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function hold(smooth) {
          section.scrollIntoView({
            behavior: smooth && !reduce ? 'smooth' : 'auto',
            block: 'center'
          });
        }

        hold(false);
        [100, 400, 900, 1600].forEach(function (ms, i) {
          setTimeout(function () { hold(i > 0); }, ms);
        });
        window.addEventListener('load', function () { setTimeout(hold, 120); });
      })();
    </script>
  {%- endif -%}
{%- endform -%}
