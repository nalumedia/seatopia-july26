{%- comment -%}
  The panel above the checkout button that explains the subscription minimum and offers
  one-tap fixes. The decision itself lives in cart-plan-state.liquid; this only renders it.

  Accepts:
  - state: {String} output of cart-plan-state (ok | below-min | sub-short)
  - part: {String} 'toggle' renders only the One-time / Subscribe & Save toggle (top of the
    cart); anything else renders the minimum panel (above checkout).
  - show_min: {Boolean} also explain below-min. The cart page passes false because its
    free-shipping bar already shows settings.threshold_message; the drawer does not show it.

  Layout, kept deliberately plain (Ryan, 2026-10-08):
  1. On subscription: the lines and their total.
  2. One-time: the lines and their total, each with a Subscribe button where it has a plan.
  3. "Make everything a subscription", ONLY when converting the one-time lines would get the
     subscription to the minimum. Otherwise, suggestions to add as a subscription.
  4. "Make it all one-time" as the way out.

  Conversions reuse the cart's existing plan (same delivery frequency) where the product
  offers it; otherwise the product's first plan. Lines with no plan stay one-time add-ons.
{%- endcomment -%}
{%- liquid
  # Suggested add-ons, offered as subscriptions when the subscription is short. Edit here.
  assign suggestion_handles = 'atlantic-salmon-2x-6oz-portions,king-salmon,lab-tested-salmon-roe-caviar,steelhead-2x-6oz-filets,black-tiger-shrimp-mangrove-regeneration' | split: ','
  assign suggestion_limit = 4

  assign plan_min = settings.threshold_amount | default: '125' | strip | times: 100
  assign sub_total = 0
  assign otp_total = 0
  assign convert_total = 0
  assign convertible = 0
  assign convertible_otp_total = 0
  assign sub_otp_equiv = 0
  assign plan_label = ''
  assign plan_name_full = ''
  assign gift_wrap_id = blank
  if linklists.gift-wrapping.links != blank and linklists.gift-wrapping.links.first.type == 'product_link'
    assign gift_wrap_id = linklists.gift-wrapping.links.first.object.variants.first.id
  endif

  assign preferred_plan = blank
  for item in cart.items
    if item.selling_plan_allocation
      assign preferred_plan = item.selling_plan_allocation.selling_plan.id
      break
    endif
  endfor

  assign in_cart_handles = ''
  for item in cart.items
    assign in_cart_handles = in_cart_handles | append: ',' | append: item.product.handle
    if gift_wrap_id != blank and item.variant_id == gift_wrap_id
      continue
    endif
    if item.selling_plan_allocation
      assign sub_total = sub_total | plus: item.final_line_price
      # what this line costs one-time (the variant's own price)
      assign line_otp = item.variant.price | times: item.quantity
      assign sub_otp_equiv = sub_otp_equiv | plus: line_otp
    else
      assign otp_total = otp_total | plus: item.final_line_price
      if item.variant.selling_plan_allocations.size > 0
        assign convertible = convertible | plus: 1
        assign convertible_otp_total = convertible_otp_total | plus: item.final_line_price
        assign alloc = item.variant.selling_plan_allocations.first
        for a in item.variant.selling_plan_allocations
          if a.selling_plan.id == preferred_plan
            assign alloc = a
            break
          endif
        endfor
        assign line_sub = alloc.price | times: item.quantity
        assign convert_total = convert_total | plus: line_sub
        if plan_label == ''
          assign plan_label = alloc.selling_plan.name | split: ' (' | first
          assign plan_name_full = alloc.selling_plan.name
        endif
      endif
    endif
  endfor
  assign in_cart_handles = in_cart_handles | append: ','

  assign sub_if_all = sub_total | plus: convert_total
  assign sub_gap = plan_min | minus: sub_total

  # Order gap uses the same total as cart-plan-state: cart total less gift wrap.
  assign order_total = cart.total_price
  for item in cart.items
    if gift_wrap_id != blank and item.variant_id == gift_wrap_id
      assign order_total = order_total | minus: item.final_line_price
    endif
  endfor
  assign cart_gap = plan_min | minus: order_total

  # Toggle figures. Subscribing everything converts the lines that have a plan; lines
  # without one stay one-time add-ons. The % is derived from the real prices, so the label
  # can never drift from what is charged.
  assign all_sub_order = order_total | minus: convertible_otp_total | plus: convert_total
  assign all_otp_order = order_total | minus: sub_total | plus: sub_otp_equiv
  assign toggle_pct = 0
  if convertible_otp_total > 0
    assign toggle_pct = convert_total | times: 100.0 | divided_by: convertible_otp_total | times: -1 | plus: 100 | round
  elsif sub_otp_equiv > 0
    assign toggle_pct = sub_total | times: 100.0 | divided_by: sub_otp_equiv | times: -1 | plus: 100 | round
  endif
  assign sub_if_all_gap = plan_min | minus: sub_if_all
-%}

{%- if part == 'toggle' -%}
  {%- if cart.item_count > 0 and convertible > 0 or cart.item_count > 0 and sub_total > 0 -%}
    {%- liquid
      assign mode = 'mixed'
      if sub_total == 0
        assign mode = 'onetime'
      elsif convertible == 0
        assign mode = 'subscribe'
      endif
      for item in cart.items
        if item.selling_plan_allocation
          assign plan_name_full = item.selling_plan_allocation.selling_plan.name
          break
        endif
      endfor
      # Only the plan's own published wording - no subscription terms beyond it (claims guide 4.F).
      assign plan_terms = plan_name_full | replace: ' (', ' · ' | remove: ')'
    -%}
    <cart-plan-gate class="plan-toggle" data-mode="{{ mode }}">
      <button type="button" class="plan-toggle__opt{% if mode == 'onetime' %} is-active{% endif %}" data-plan-all="onetime" aria-pressed="{% if mode == 'onetime' %}true{% else %}false{% endif %}">
        <span class="plan-toggle__dot" aria-hidden="true"></span>
        <span class="plan-toggle__name">One-time purchase</span>
        <span class="plan-toggle__price">{{ all_otp_order | money }}</span>
      </button>

      {%- if mode == 'subscribe' or sub_if_all >= plan_min -%}
        <button type="button" class="plan-toggle__opt{% if mode == 'subscribe' %} is-active{% endif %}" data-plan-all="subscribe" aria-pressed="{% if mode == 'subscribe' %}true{% else %}false{% endif %}">
          <span class="plan-toggle__dot" aria-hidden="true"></span>
          <span class="plan-toggle__name">Subscribe &amp; Save{% if toggle_pct > 0 %} {{ toggle_pct }}%{% endif %}</span>
          <span class="plan-toggle__price">
            {%- if mode == 'subscribe' -%}{{ order_total | money }} <s>{{ all_otp_order | money }}</s>{%- else -%}{{ all_sub_order | money }} <s>{{ all_otp_order | money }}</s>{%- endif -%}
          </span>
          <span class="plan-toggle__note">{{ plan_terms | escape }}</span>
        </button>
      {%- else -%}
        <div class="plan-toggle__opt is-locked" aria-disabled="true">
          <span class="plan-toggle__dot" aria-hidden="true"></span>
          <span class="plan-toggle__name">Subscribe &amp; Save{% if toggle_pct > 0 %} {{ toggle_pct }}%{% endif %}</span>
          <span class="plan-toggle__note">Subscriptions start at {{ plan_min | money_without_trailing_zeros }}. Add {{ sub_if_all_gap | money }} more to subscribe.</span>
        </div>
      {%- endif -%}

      <script type="application/json" data-plan-lines>
        [
          {%- assign first = true -%}
          {%- for item in cart.items -%}
            {%- if gift_wrap_id != blank and item.variant_id == gift_wrap_id -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign plan_id = null
              if item.selling_plan_allocation == null and item.variant.selling_plan_allocations.size > 0
                assign plan_id = item.variant.selling_plan_allocations.first.selling_plan.id
                for a in item.variant.selling_plan_allocations
                  if a.selling_plan.id == preferred_plan
                    assign plan_id = a.selling_plan.id
                    break
                  endif
                endfor
              endif
            -%}
            {%- unless first %},{% endunless -%}
            {"key": {{ item.key | json }}, "variant": {{ item.variant_id }}, "qty": {{ item.quantity }}, "sub": {% if item.selling_plan_allocation %}true{% else %}false{% endif %}, "plan": {{ plan_id | json }}}
            {%- assign first = false -%}
          {%- endfor -%}
        ]
      </script>
      <p class="plan-gate__error" data-plan-error hidden></p>
    </cart-plan-gate>
  {%- endif -%}
{%- else -%}

{%- if state == 'below-min' and show_min -%}
  <div class="plan-gate plan-gate--min">
    <p class="plan-gate__title">Orders start at {{ plan_min | money_without_trailing_zeros }}</p>
    <p class="plan-gate__text">Add {{ cart_gap | money }} more to check out.</p>
  </div>
{%- endif -%}

{%- if state == 'sub-short' -%}
  <cart-plan-gate class="plan-gate" data-state="{{ state }}">
    <p class="plan-gate__title">Subscriptions start at {{ plan_min | money_without_trailing_zeros }}</p>
    <p class="plan-gate__text">
      Your subscription is {{ sub_total | money }}. Bring it to {{ plan_min | money_without_trailing_zeros }},
      or check out with everything as a one-time order.
    </p>

    <div class="plan-gate__group">
      <p class="plan-gate__group-head"><span>On subscription</span><span>{{ sub_total | money }}</span></p>
      <ul class="plan-gate__lines" role="list">
        {%- for item in cart.items -%}
          {%- unless item.selling_plan_allocation -%}{%- continue -%}{%- endunless -%}
          <li class="plan-gate__line">
            <span class="plan-gate__line-name">{{ item.product.title | escape }}{% unless item.product.has_only_default_variant %} &middot; {{ item.variant.title | escape }}{% endunless %}{% if item.quantity > 1 %} &times; {{ item.quantity }}{% endif %}</span>
            <span class="plan-gate__line-price">{{ item.final_line_price | money }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <div class="plan-gate__group">
      <p class="plan-gate__group-head"><span>One-time</span><span>{{ otp_total | money }}</span></p>
      <ul class="plan-gate__lines" role="list">
        {%- for item in cart.items -%}
          {%- if item.selling_plan_allocation -%}{%- continue -%}{%- endif -%}
          {%- if gift_wrap_id != blank and item.variant_id == gift_wrap_id -%}{%- continue -%}{%- endif -%}
          <li class="plan-gate__line">
            <span class="plan-gate__line-name">{{ item.product.title | escape }}{% unless item.product.has_only_default_variant %} &middot; {{ item.variant.title | escape }}{% endunless %}{% if item.quantity > 1 %} &times; {{ item.quantity }}{% endif %}</span>
            {%- if item.variant.selling_plan_allocations.size > 0 -%}
              {%- liquid
                assign alloc = item.variant.selling_plan_allocations.first
                for a in item.variant.selling_plan_allocations
                  if a.selling_plan.id == preferred_plan
                    assign alloc = a
                    break
                  endif
                endfor
                assign line_sub = alloc.price | times: item.quantity
              -%}
              <button type="button" class="plan-gate__chip" data-plan-line="{{ item.key }}" data-plan-variant="{{ item.variant_id }}" data-plan-id="{{ alloc.selling_plan.id }}" data-plan-qty="{{ item.quantity }}">
                Subscribe &middot; {{ line_sub | money }}
              </button>
            {%- else -%}
              <span class="plan-gate__line-price">{{ item.final_line_price | money }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>

    {%- if convertible > 0 and sub_if_all >= plan_min -%}
      <button type="button" class="plan-gate__btn plan-gate__btn--primary" data-plan-all="subscribe">
        Make everything a subscription &middot; renews at {{ sub_if_all | money }}
      </button>
    {%- else -%}
      {%- capture suggestion_items -%}
        {%- assign shown = 0 -%}
        {%- for handle in suggestion_handles -%}
          {%- if shown >= suggestion_limit -%}{%- break -%}{%- endif -%}
          {%- assign needle = ',' | append: handle | append: ',' -%}
          {%- if in_cart_handles contains needle -%}{%- continue -%}{%- endif -%}
          {%- assign p = all_products[handle] -%}
          {%- assign v = p.selected_or_first_available_variant -%}
          {%- if p == blank or v.available == false or v.selling_plan_allocations.size == 0 -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign alloc = v.selling_plan_allocations.first
            for a in v.selling_plan_allocations
              if a.selling_plan.id == preferred_plan
                assign alloc = a
                break
              endif
            endfor
          -%}
          <li class="plan-gate__line">
            <span class="plan-gate__line-name">{{ p.title | escape }}{% unless p.has_only_default_variant %} &middot; {{ v.title | escape }}{% endunless %}</span>
            <button type="button" class="plan-gate__chip" data-plan-add="{{ v.id }}" data-plan-id="{{ alloc.selling_plan.id }}">
              Add &middot; {{ alloc.price | money }}
            </button>
          </li>
          {%- assign shown = shown | plus: 1 -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if suggestion_items != blank -%}
        <div class="plan-gate__group">
          <p class="plan-gate__group-head"><span>Add to your subscription</span><span>{{ sub_gap | money }} to go</span></p>
          <ul class="plan-gate__lines" role="list">{{ suggestion_items }}</ul>
        </div>
      {%- endif -%}
    {%- endif -%}

    <button type="button" class="plan-gate__btn" data-plan-all="onetime">
      Make it all one-time &middot; {{ order_total | money }}
    </button>

    <script type="application/json" data-plan-lines>
      [
        {%- assign first = true -%}
        {%- for item in cart.items -%}
          {%- if gift_wrap_id != blank and item.variant_id == gift_wrap_id -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign plan_id = null
            if item.selling_plan_allocation == null and item.variant.selling_plan_allocations.size > 0
              assign plan_id = item.variant.selling_plan_allocations.first.selling_plan.id
              for a in item.variant.selling_plan_allocations
                if a.selling_plan.id == preferred_plan
                  assign plan_id = a.selling_plan.id
                  break
                endif
              endfor
            endif
          -%}
          {%- unless first %},{% endunless -%}
          {"key": {{ item.key | json }}, "variant": {{ item.variant_id }}, "qty": {{ item.quantity }}, "sub": {% if item.selling_plan_allocation %}true{% else %}false{% endif %}, "plan": {{ plan_id | json }}}
          {%- assign first = false -%}
        {%- endfor -%}
      ]
    </script>
    <p class="plan-gate__error" data-plan-error hidden></p>
  </cart-plan-gate>
{%- endif -%}

{%- endif -%}

{%- comment -%} Always rendered: a refreshed drawer can gain the panel after page load, and
  scripts injected by innerHTML never run, so the element must already be defined. {%- endcomment -%}
<style>
  .plan-gate {
    display: grid;
    gap: 12px;
    border: 1px solid rgba(17, 24, 39, 0.14);
    border-radius: 14px;
    padding: 16px;
    background: #fff;
    line-height: 1.4;
  }
  .plan-gate__title { margin: 0; font-weight: 600; font-size: 16px; }
  .plan-gate__text { margin: -6px 0 0; font-size: 14px; opacity: .8; }
  .plan-gate__group { border-top: 1px solid rgba(17, 24, 39, 0.1); padding-top: 10px; }
  .plan-gate__group-head {
    display: flex; justify-content: space-between; gap: 10px;
    margin: 0 0 6px; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em;
  }
  .plan-gate__lines { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .plan-gate__lines:empty { display: none; }
  .plan-gate__line { display: flex; align-items: center; justify-content: space-between; gap: 10px; font-size: 14px; }
  .plan-gate__line-name { min-width: 0; }
  .plan-gate__line-price { flex: none; }
  .plan-gate__chip, .plan-gate__btn {
    font: inherit; cursor: pointer; border-radius: 999px;
    border: 1px solid rgba(17, 24, 39, 0.25); background: #fff; color: inherit;
  }
  .plan-gate__chip { flex: none; font-size: 13px; padding: 5px 12px; white-space: nowrap; }
  .plan-gate__btn { width: 100%; padding: 11px 14px; font-size: 14px; font-weight: 600; }
  .plan-gate__btn--primary { background: #2e4b59; border-color: #2e4b59; color: #fff; }
  .plan-gate [disabled], .plan-gate[data-plan-busy] { opacity: .55; cursor: default; }
  .plan-gate__error { margin: 0; font-size: 13px; color: #a33; }
  .plan-gate__error[hidden] { display: none; }
  .plan-gate--min { gap: 4px; }
  .plan-toggle { display: grid; gap: 8px; margin: 4px 0 8px; }
  .plan-toggle__opt {
    display: grid; grid-template-columns: 18px 1fr auto; column-gap: 10px; row-gap: 2px; align-items: center;
    width: 100%; padding: 12px 14px; border-radius: 12px; text-align: left; cursor: pointer;
    border: 1px solid rgba(17, 24, 39, 0.16); background: #fff; color: inherit; font: inherit;
  }
  .plan-toggle__opt.is-active { border-color: #2e4b59; box-shadow: 0 0 0 1px #2e4b59; }
  .plan-toggle__opt.is-locked { cursor: default; opacity: .75; }
  .plan-toggle__dot { width: 18px; height: 18px; border-radius: 50%; border: 1.5px solid rgba(17, 24, 39, 0.35); }
  .plan-toggle__opt.is-active .plan-toggle__dot { border: 5px solid #2e4b59; }
  .plan-toggle__name { font-size: 15px; font-weight: 500; }
  .plan-toggle__price { font-size: 15px; font-weight: 600; white-space: nowrap; }
  .plan-toggle__price s { font-weight: 400; opacity: .5; margin-left: 4px; }
  .plan-toggle__note { grid-column: 2 / -1; font-size: 12px; opacity: .65; }
  .plan-toggle[data-plan-busy] { opacity: .55; pointer-events: none; }
  .plan-gate--min .plan-gate__text { margin: 0; }
</style>

<script>
  (function () {
    if (window.SeatopiaCartPlan) return;

    const root = () => ((window.theme && theme.routes && theme.routes.root_url) || '/').replace(/\/?$/, '/');
    const getJSON = async (url, body) => {
      const res = await fetch(root() + url, body
        ? { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body) }
        : { headers: { Accept: 'application/json' } });
      const j = await res.json().catch(() => null);
      if (!res.ok || !j || j.status) throw new Error((j && (j.description || j.message)) || 'We could not update your cart.');
      return j;
    };

    /*
      Intents, not keys. A line key in the HTML can be stale by the time it is clicked
      (anything else on the page that writes to the cart changes keys without re-rendering
      the drawer), and Shopify answers a stale key with "no valid id or line parameter".
      So each intent names a variant and the plan state we want; the line is looked up in
      the LIVE cart, and after every change the cart Shopify returns is used for the next.
        { variant, plan }   plan = selling plan id to subscribe, or null for one-time
        { add: variant, plan }  add one unit as a subscription
    */
    async function apply(intents, scope) {
      if (intents.length === 1 && intents[0].allOneTime) {
        /* "All one-time" expands against the live cart, never the HTML */
        const live = await getJSON('cart.js').catch(() => ({ items: [] }));
        intents = (live.items || []).filter((l) => l.selling_plan_allocation).map((l) => ({ variant: l.variant_id, plan: null }));
      }
      if (!intents.length) return;
      const busy = scope || document.body;
      busy.setAttribute('data-plan-busy', '');
      const err = scope && scope.querySelector('[data-plan-error]');
      if (err) err.hidden = true;
      try {
        let cart = await getJSON('cart.js');
        for (const it of intents) {
          if (it.add) {
            const item = { id: Number(it.add), quantity: 1 };
            if (it.plan) item.selling_plan = Number(it.plan); /* no plan = one-time */
            await getJSON('cart/add.js', { items: [item] });
            cart = await getJSON('cart.js');
            continue;
          }
          const wantSub = it.plan != null;
          const line = (cart.items || []).find((l) =>
            String(l.variant_id) === String(it.variant) && !!l.selling_plan_allocation !== wantSub);
          if (!line) continue; /* already in the wanted state */
          cart = await getJSON('cart/change.js', {
            id: line.key,
            quantity: line.quantity,
            selling_plan: wantSub ? Number(it.plan) : null
          });
        }

        const cartPath = ((window.theme && theme.routes && theme.routes.cart_url) || '/cart').replace(/\/$/, '');
        if (window.location.pathname.replace(/\/$/, '') === cartPath) {
          window.location.reload();
          return;
        }
        /* Header count. Not via the cartUpdate pubsub: cart.js's cart-items handler reads
           event.cart.sections unguarded and would throw on a plain /cart.js payload. */
        document.querySelectorAll('cart-count').forEach((el) => {
          el.innerText = cart.item_count;
          el.hidden = cart.item_count === 0;
        });
        document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: { open: true } }));
      } catch (e) {
        /* Shown in place. Not followed by a drawer refresh, which would wipe the message;
           each step re-reads the live cart, so a half-applied change is very unlikely. */
        if (err) { err.textContent = e.message + ' Please refresh the page and try again.'; err.hidden = false; }
      } finally {
        busy.removeAttribute('data-plan-busy');
      }
    }

    document.addEventListener('click', (e) => {
      const el = e.target.closest('[data-plan-line], [data-plan-unsub], [data-plan-unsub-all], [data-plan-add], [data-plan-all]');
      if (!el) return;
      const gate = el.closest('cart-plan-gate');
      const scope = gate || el.closest('[data-cart-favs]') || el.closest('cart-items') || null;
      const d = el.dataset;

      if (el.hasAttribute('data-plan-line')) {
        apply([{ variant: d.planVariant, plan: d.planId }], scope);
      } else if (el.hasAttribute('data-plan-unsub')) {
        apply([{ variant: d.planVariant, plan: null }], scope);
      } else if (el.hasAttribute('data-plan-add')) {
        apply([{ add: d.planAdd, plan: d.planId }], scope);
      } else if (el.hasAttribute('data-plan-unsub-all') || (el.hasAttribute('data-plan-all') && d.planAll === 'onetime')) {
        apply([{ allOneTime: true }], scope);
      } else if (el.hasAttribute('data-plan-all') && d.planAll === 'subscribe' && gate) {
        let lines = [];
        try { lines = JSON.parse(gate.querySelector('[data-plan-lines]').textContent) || []; } catch (err) {}
        apply(lines.filter((l) => !l.sub && l.plan).map((l) => ({ variant: l.variant, plan: l.plan })), gate);
      }
    });

    window.SeatopiaCartPlan = { apply };
    if (!customElements.get('cart-plan-gate')) customElements.define('cart-plan-gate', class extends HTMLElement {});
  })();
</script>
