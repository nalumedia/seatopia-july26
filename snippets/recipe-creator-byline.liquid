{%- comment -%}
  "from {creator}" byline with avatar, for recipe cards.

  Reads article.metafields.custom.recipe_creators (list of recipe_creator metaobjects,
  managed in Shopify admin > Content > Metaobjects). Renders nothing when unset.
  Each name links to that creator's recipes via their filter tag.

  Accepts:
  - article: {Object} Article Liquid object
  - blog: {Object} Blog Liquid object, for the filter link

  Styles live in assets/custom-jtpl.css (.recipe-byline).
{%- endcomment -%}
{%- assign creators = article.metafields.custom.recipe_creators.value -%}
{%- if creators != blank and creators.size > 0 -%}
  <p class="recipe-byline">
    <span class="recipe-byline__faces" aria-hidden="true">
      {%- for creator in creators -%}
        {%- if creator.photo.value != blank -%}
          {{- creator.photo.value | image_url: width: 96 | image_tag: class: 'recipe-byline__face', width: 32, height: 32, loading: 'lazy', alt: '' -}}
        {%- endif -%}
      {%- endfor -%}
    </span>
    <span class="recipe-byline__text">
      from
      {%- for creator in creators -%}
        {%- if forloop.last and forloop.length > 1 %} &amp;{% elsif forloop.index > 1 %},{% endif %}
        {%- if creator.filter_tag.value != blank and blog %}
          <a class="recipe-byline__name" href="{{ blog.url }}/tagged/{{ creator.filter_tag.value | handleize }}">{{ creator.name.value | escape }}</a>
        {%- else %}
          <span class="recipe-byline__name">{{ creator.name.value | escape }}</span>
        {%- endif -%}
      {%- endfor -%}
    </span>
  </p>

{%- endif -%}
