{%- comment -%}
  Web kit icons, traced from the Figma "Seatopia Web / Components" set. Strokes use
  currentColor so one path serves the coral, ink and sand button variants.
  Accepts: name (arrow-right | plus | minus)
{%- endcomment -%}
{%- case name -%}
  {%- when 'arrow-right' -%}
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M2 8H14M9 13L14 8L9 3" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'plus' -%}
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false"><path d="M10 3V17M3 10H17" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
  {%- when 'minus' -%}
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false"><path d="M3 10H17" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
{%- endcase -%}
