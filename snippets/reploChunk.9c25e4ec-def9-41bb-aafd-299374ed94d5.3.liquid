et="https://cdn.shopify.com/s/files/1/0222/9882/0682/files/Frame_1_107821e0-fb33-436c-a230-2144fc573148.png?v=1722611000&amp;width=1800" media="(min-width: 821px) and (max-width: 1024px)"/><source srcSet="https://cdn.shopify.com/s/files/1/0222/9882/0682/files/Frame_1_107821e0-fb33-436c-a230-2144fc573148.png?v=1722611000&amp;width=2048" media="(min-width: 1025px)"/><img src="https://cdn.shopify.com/s/files/1/0222/9882/0682/files/Frame_1_107821e0-fb33-436c-a230-2144fc573148.png?v=1722611000" alt="A stylized leaf icon on a white background." class="r-1gbllrr" loading="eager"/></picture><div data-rid="5b6bdba2-fe7c-4295-803b-4247fb77c279" data-replo-repeated-index=".0.0.0.0.0" class="r-ljsjkt alchemy-rte"><span contenteditable="false" style="width:100%"><p><span>History & Origin</span></p></span></div><div data-rid="2295af04-1153-4a2a-9c5c-f8a8544b8c0a" data-replo-repeated-index=".0.0.0.0.0" class="r-u3ztwn alchemy-rte"><span contenteditable="false" style="width:100%"><p><span>A Mediterranean and Atlantic native, Branzino has been enjoyed for centuries, even gracing Roman mosaics!</span></p></span></div></div></div></div><div data-rid="1cbc249c-71a8-49c1-9e98-8ad477f522e2" data-replo-repeated-index=".0.0" class="r-frzq6z"><div data-rid="5cba5263-bbae-471d-a9dd-caf5a03540e9" data-replo-repeated-index=".0.0.0" class="r-1ev97qw"><div data-rid="aaf48e42-d9ac-4839-9759-2af6ec981fa0" data-replo-repeated-index=".0.0.0.0" class="r-uapisc alchemy-rte"><span contenteditable="false" style="width:100%"><p>How Seatopia delivers certified clean branzino</p></span></div><div data-rid="ef963434-5eeb-4dc9-9e98-637f1a71c1e0" data-replo-repeated-index=".0.0.0.0" class="r-1eadwyr alchemy-rte"><span contenteditable="false" style="width:100%"><p>We work with artisan farms around the world to source the best Branzino for you. Our farms are small-scale, and the fish are raised in low-density, antibiotic-free conditions, and fed micro-algae-based oils.</p></span></div><div data-rid="3788966c-d1