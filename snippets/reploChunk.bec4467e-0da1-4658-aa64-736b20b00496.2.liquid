        }
        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0);
            z-index:9;

        }
        .overlay-pause{
            position:relative;
        }
        .video-container.overlay-pause::before {
            content: ' ';
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: 10px;
            background-blend-mode: revert-layer;
            z-index:7;

        }
