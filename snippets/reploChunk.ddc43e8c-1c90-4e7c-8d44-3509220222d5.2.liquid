     <style>
        .video-container {
            position: relative;
            max-width: 500px;
            cursor:pointer;
        }
        .video-container video {
            width: 100%;
            border-radius:10px;
        }
        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0);
            z-index:9;

        }
        .overlay-pause{
            position:relative;
        }
        .video-container.overlay-pause::before {
            content: ' ';
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: 10px;
            background-blend-mode: revert-layer;
            z-index:7;

        }
.overlay-pause::after {
    content: ' ';
    width: 70px;
    height: 70px;
    position: absolute;
    z-index: 8;
    top: 50%;
    left: 50%;
    transform: translate(-31px, -34px);
    background: url('https://cdn.shopify.com/s/files/1/0222/9882/0682/files/play.png?v=1707355844');
    background-repeat: no-repeat;
    background-size: contain;
}
